[Unit]
Description=CMF Phone 1 Wi-Fi/Bluetooth bring-up (MT6878 connectivity, NVRAM calibration)
Documentation=file:///usr/local/sbin/cmf-wifi-calibrate
DefaultDependencies=no
After=systemd-udevd.service systemd-modules-load.service local-fs.target
# NetworkManager doesn't wait for it: it picks up wlan0 when it appears, so
# the network stack and the login session start ~14 s earlier.
Before=bluetooth.service
# Only on native boot with modules built for this kernel.
ConditionPathExists=/usr/local/lib/cmf-wifi/%v
ConditionPathExists=!/sys/class/net/wlan0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/cmf-wifi-calibrate
TimeoutStartSec=150

[Install]
WantedBy=sysinit.target
