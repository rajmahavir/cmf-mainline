[Unit]
Description=CMF Phone 1 Trustonic Kinibi (FF-A v1.0 + mcDrvModule-ffa)
After=systemd-udevd.service local-fs.target
ConditionPathExists=/etc/cmf-kinibi-enable
ConditionPathExists=/proc/device-tree/mobicore

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=CMF_ROOT=
ExecStart=/bin/busybox sh /usr/local/sbin/cmf-kinibi-boot
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
