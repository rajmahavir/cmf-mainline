	fem_rtc7620_wf0: rtc7620-wf0-state {
		pins-cmd-dat {
			pinmux = <0x2101 0x2201 0x2301>;
			mapping = <0x0 0x6 0x0 0x1 0xb 0x0 0x2 0x1 0x0>;
		};
	};
};

/ {
	connfem {
		compatible = "mediatek,mt6878-connfem";
		status = "disabled";
		pinctrl-names = "wlan7207h-wlan7207c",
			        "qm42195-qm45197",
			        "sky85320-sky85720",
			        "mxd7751s-mxd7751s",
			        "nofem-sky85732",
			        "nofem-qm45197",
			        "rtc7620-nofem";
		pinctrl-0 = <&fem_wlan7207h_wf0 &fem_wlan7207h_wf1 &fem_wlan7207c_wf0 &fem_wlan7207c_wf1>;
		pinctrl-1 = <&fem_qm42195_wf0 &fem_qm42195_wf1 &fem_qm45197_wf0 &fem_qm45197_wf1>;
		pinctrl-2 = <&fem_sky85320_wf0 &fem_sky85720_wf0>;
		pinctrl-3 = <&fem_mxd7751s_wf0>;
		pinctrl-4 = <&fem_sky85732_wf0>;
		pinctrl-5 = <&fem_qm45197_wf0 &fem_qm45197_wf1>;
		pinctrl-6 = <&fem_rtc7620_wf0>;

		fem_nofem: nofem {
			vid = <0x0>;
			pid = <0x0>;
		};

		fem_wlan7207h: wlan7207h {
			vid = <0x2>;
			pid = <0x4>;
		};

		fem_wlan7207c: wlan7207c {
			vid = <0x2>;
			pid = <0x7>;
		};

		fem_qm42195: qm42195 {
			vid = <0x3>;
			pid = <0x1>;
		};

		fem_qm45197: qm45197 {
			vid = <0x3>;
			pid = <0x2>;
		};

		fem_sky85320: sky85320 {
			vid = <0x1>;
			pid = <0x1>;
		};

		fem_sky85720: sky85720 {
			vid = <0x1>;
			pid = <0x2>;
		};

		fem_mxd7751s: mxd7751s {
			vid = <0x4>;
			pid = <0x1>;
		};

		fem_sky85732: sky85732 {
			vid = <0x1>;
			pid = <0x3>;
		};

		fem_rtc7620: rtc7620 {
			vid = <0x6>;
			pid = <0x1>;
		};

		epa-elna-mtk {
			parts = <&fem_nofem &fem_nofem &fem_nofem &fem_nofem
				 &fem_nofem &fem_nofem &fem_mxd7751s &fem_mxd7751s
				 &fem_sky85320 &fem_sky85720 &fem_sky85320 &fem_sky85720
				 &fem_qm42195 &fem_qm45197 &fem_wlan7207h &fem_wlan7207c
				 &fem_nofem &fem_sky85732 &fem_nofem &fem_sky85732
				 &fem_nofem &fem_qm45197 &fem_rtc7620 &fem_nofem>;

			hwid {
				gpio = <&{/soc@0/pinctrl} 131 0>,
				       <&{/soc@0/pinctrl} 132 0>,
				       <&{/soc@0/pinctrl} 92 0>;
			};

			wifi {
				flags-3 {
				};
				flags-4 {
				};
				flags-5 {
				};
				flags-6 {
				};
				flags-7 {
				};
				flags-8 {
				};
				flags-9 {
				};
				flags-10 {
				};
				flags-11 {
				};
			};

			bt {
				flags-3 {
					bypass;
				};
				flags-4 {
					bypass;
				};
				flags-5 {
					bypass;
				};
				flags-6 {
					epa-elna;
				};
				flags-7 {
					epa-elna;
				};
				flags-8 {
					epa-elna;
				};
				flags-9 {
					bypass;
				};
				flags-10 {
					epa-elna;
				};
				flags-11 {
					epa-elna;
				};
			};
		};
	};
};
