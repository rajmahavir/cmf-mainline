		mblock-2-pstore@48090000 {
			compatible = "ramoops";
			reg = <0x00 0x48090000 0x00 0xe0000>;
			no-map;
			record-size = <0x1000>;
			console-size = <0x40000>;
			pmsg-size = <0x80000>;
			ftrace-size = <0x1000>;
			flags = <0x01>;
			ecc-size = <0x00>;
			mem-type = <0x00>;
			max-reason = <0x02>;
		};

		mblock-1-aee_debug_kinfo {
			phandle = <0x311>;
			reg = <0x00 0x48080000 0x00 0x10000>;
			no-map;
			compatible = "mediatek,aee_debug_kinfo";
		};

		ccci-dpmaif-cache-memory {
			compatible = "mediatek,dpmaif-resv-cache-mem";
			size = <0x00 0x190000>;
			alignment = <0x00 0x1000>;
			alloc-ranges = <0x00 0x40000000 0x00 0xf0000000>;
			phandle = <0x14b>;
		};

		ccci-dpmaif-nocache-memory {
			compatible = "mediatek,dpmaif-resv-nocache-mem";
			no-map;
			size = <0x00 0x50000>;
			alignment = <0x00 0x1000>;
			alloc-ranges = <0x00 0x40000000 0x00 0xf0000000>;
			phandle = <0x14c>;
		};

		ssmr-reserved-cma-memory {
			alloc-ranges = <0x00 0x80000000 0x00 0xc0000000>;
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0xd000000>;
			alignment = <0x00 0x1000000>;
			phandle = <0x20>;
		};
	};

	aliases {
		serial0 = "/soc@0/serial@11001000";
	};

	chosen {
		bootargs = "clk_ignore_unused";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		simplefb@fe0d0000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0xfe0d0000 0x00 0xa08c00>;
			width = <0x438>;
			height = <0x960>;
			stride = <0x1100>;
			format = "a8r8g8b8";
			panel = <0x26>;

			fb-panel {
				width-mm = <0x4b>;
				height-mm = <0xa0>;
				phandle = <0x26>;
			};
		};
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x02 0x00>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x27>;
		pinctrl-names = "default";

		voldown-key {
			label = "Volume Down";
			linux,code = <0x72>;
			gpios = <0x16 0x36 0x01>;
		};
	};
};
/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
/* Apply after the v9 board tree. The radio consumers are staged disabled. */

&{/soc@0} {
	conn_infracfg: syscon@10001000 {
		compatible = "mediatek,mt6878-infra-ao", "syscon";
		reg = <0x10001000 0x1000>;
	};

	syscon@1c001000 {
		compatible = "syscon", "simple-mfd";
		reg = <0x1c001000 0x1000>;

		conn_power: power-controller {
			compatible = "mediatek,mt6878-power-controller";
			access-controllers = <&conn_infracfg>;
			#address-cells = <1>;
			#size-cells = <0>;
			#power-domain-cells = <1>;

			power-domain@1 {
				reg = <1>;
				#power-domain-cells = <0>;
			};
		};
	};

	spmi@1cc04000 {
		compatible = "mediatek,mt6878-spmi";
		reg = <0x1cc04000 0x8ff>, <0x1cc01000 0x100>;
		reg-names = "pmif", "spmimst";
		interrupts-extended = <&{/soc@0/pinctrl} 212 4>;
		interrupt-names = "rcs";
		interrupt-controller;
		#interrupt-cells = <3>;
		#address-cells = <2>;
		#size-cells = <0>;

		pmic@4 {
			compatible = "mediatek,mt6363-rf-regulators";
			reg = <4 0>;

			conninfra {
				compatible = "mediatek,mt6363-consys";
			};

			regulators {
				mt6363_vcn13: vcn13 {
					regulator-name = "mt6363_vcn13";
					regulator-min-microvolt = <900000>;
					regulator-max-microvolt = <1810000>;
					regulator-enable-ramp-delay = <180>;
					regulator-allowed-modes = <0 2>;
				};

				mt6363_vrfio18: vrfio18 {
					regulator-name = "mt6363_vrfio18";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <2100000>;
					regulator-enable-ramp-delay = <180>;
					regulator-allowed-modes = <0 2>;
				};
			};
		};

		pmic@5 {
			compatible = "mediatek,mt6369-rf-regulators";
			reg = <5 0>;

			conninfra {
				compatible = "mediatek,mt6369-consys";
			};

			regulators {
				mt6369_vcn33_1: vcn33-1 {
					regulator-name = "mt6369_vcn33_1";
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <3500000>;
					regulator-enable-ramp-delay = <680>;
					regulator-allowed-modes = <0 2>;
				};

				mt6369_vcn33_2: vcn33-2 {
					regulator-name = "mt6369_vcn33_2";
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <3500000>;
					regulator-enable-ramp-delay = <680>;
					regulator-allowed-modes = <0 2>;
				};

				mt6369_vant18: vant18 {
					regulator-name = "mt6369_vant18";
					regulator-min-microvolt = <600000>;
					regulator-max-microvolt = <2100000>;
					regulator-enable-ramp-delay = <680>;
					regulator-allowed-modes = <0 2>;
				};
			};
		};
	};
};

/ {
	consys@18000000 {
		compatible = "mediatek,mt6878-6631-consys";
		#thermal-sensor-cells = <0>;
		reg = <0 0x18000000 0 0x470>, <0 0x10001000 0 0xee4>,
		      <0 0x10005000 0 0xa7c>, <0 0x11ec0000 0 0xa04>,
		      <0 0x18001000 0 0x658>, <0 0x18003000 0 0x204>,
		      <0 0x1800e000 0 0x118>, <0 0x18011000 0 0x138>,
		      <0 0x18012000 0 0x98>, <0 0x18020000 0 0x4c>,
		      <0 0x18023000 0 0xe28>, <0 0x1803b000 0 0x18>,
		      <0 0x18040000 0 0x2c>, <0 0x18041000 0 0x140>,
		      <0 0x18042000 0 0x324>, <0 0x18046000 0 0x324>,
		      <0 0x1804b000 0 0x414>, <0 0x1804d000 0 0x41c>,
		      <0 0x1804f000 0 0x148>, <0 0x18053800 0 0x1000>,
		      <0 0x18060000 0 0xbf8>, <0 0x18070000 0 0x8004>,
		      <0 0x1c001000 0 0xfd0>, <0 0x1c00a000 0 0x51c>,
		      <0 0x1803c000 0 0x34>, <0 0x1803e000 0 0x34>;
		power-domains = <&conn_power 1>;
		mt6363_vcn13-supply = <&mt6363_vcn13>;
		mt6363_vrfio18-supply = <&mt6363_vrfio18>;
		mt6369_vcn33_1-supply = <&mt6369_vcn33_1>;
		mt6369_vcn33_2-supply = <&mt6369_vcn33_2>;
		mt6369_vant18-supply = <&mt6369_vant18>;
		emi-addr = <0 0x85e00000>;
		emi-size = <0xc00000>;
		ro-bt-emi-size = <0x2e0000>;
		ro-gps-emi-size = <0xa0000>;
		ro-wifi-emi-size = <0x300000>;
		ro-emi-size = <0x680000>;
		rw-emi-size = <0x480000>;
		emi-alignment = <0x100000>;
		emi-max-addr = <0x90000000>;
		adie-sku = <0 1>;
		status = "disabled";
	};

	wifi@18400000 {
		compatible = "mediatek,wifi";
		memory-region = <&{/reserved-memory/mblock-42-shared-dma-pool_wifi-reserve-memory_dma}>;
		remap-idx = <1>;
		reg = <0 0x18400000 0 0>, <0 0x18000000 0 0x700000>;
		interrupts = <0 0x1e4 4 0>, <0 0x2b4 4 0>;
		emi-addr = <0>;
		emi-size = <0x1400000>;
		emi-alignment = <0x1000000>;
		emi-max-addr = <0xc0000000>;
		status = "disabled";
	};
};

&{/soc@0/pinctrl} {
	fem_wlan7207h_wf0: wlan7207h-wf0-state {
		pins-cmd-dat {
			pinmux = <0x2101 0x2201 0x2301 0x2401>;
			mapping = <0x0 0x3 0x0 0x1 0x2 0x0 0x2 0x4 0x0>,
			          <0x3 0xb 0x0>;
		};
	};
	fem_wlan7207h_wf1: wlan7207h-wf1-state {
