diff --git a/drivers/regulator/mt636x-rf-regulator.c b/drivers/regulator/mt636x-rf-regulator.c
new file mode 100644
index 000000000..e24602527
--- /dev/null
+++ b/drivers/regulator/mt636x-rf-regulator.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RF LDO register and voltage data from the MediaTek MT6363/MT6369 vendor drivers. */
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/spmi.h>
+
+#define MT636X_SWCID		0x000b
+#define MT636X_LDO_ENABLE	BIT(0)
+#define MT636X_LDO_LOW_POWER	BIT(1)
+#define MT636X_LDO_VOSEL	GENMASK(3, 0)
+
+struct mt636x_rf_chip {
+	const struct regulator_desc *rails;
+	unsigned int count;
+};
+
+static const unsigned int mt6363_vcn13_uv[] = {
+	900000, 1000000, 1100000, 1200000, 1300000, 1700000, 1800000, 1810000,
+};
+
+static const unsigned int mt636x_rfio_uv[] = {
+	600000, 700000, 800000, 900000, 1000000, 1100000, 1200000, 1300000,
+	1400000, 1500000, 1600000, 1700000, 1800000, 1900000, 2000000, 2100000,
+};
+
+static const unsigned int mt6369_vcn33_uv[] = {
+	1200000, 1300000, 1500000, 1700000, 1800000, 2000000, 2500000, 2600000,
+	2700000, 2800000, 2900000, 3000000, 3100000, 3300000, 3400000, 3500000,
+};
+
+static unsigned int mt636x_rf_map_mode(unsigned int mode)
+{
+	switch (mode) {
+	case 0:
+		return REGULATOR_MODE_NORMAL;
+	case 2:
+		return REGULATOR_MODE_IDLE;
+	default:
+		return REGULATOR_MODE_INVALID;
+	}
+}
+
+static unsigned int mt636x_rf_get_mode(struct regulator_dev *rdev)
+{
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read(rdev->regmap, rdev->desc->enable_reg, &value);
+	if (ret)
+		return REGULATOR_MODE_INVALID;
+
+	return value & MT636X_LDO_LOW_POWER ? REGULATOR_MODE_IDLE : REGULATOR_MODE_NORMAL;
+}
+
+static int mt636x_rf_set_mode(struct regulator_dev *rdev, unsigned int mode)
+{
+	int ret;
+	bool changed;
+
+	if (mode != REGULATOR_MODE_NORMAL && mode != REGULATOR_MODE_IDLE)
+		return -EINVAL;
+
+	ret = regmap_update_bits_check(rdev->regmap, rdev->desc->enable_reg,
+				       MT636X_LDO_LOW_POWER,
+				       mode == REGULATOR_MODE_IDLE ? MT636X_LDO_LOW_POWER : 0,
+				       &changed);
+	if (!ret && changed && mode == REGULATOR_MODE_NORMAL)
+		udelay(100);
+
+	return ret;
+}
+
+static const struct regulator_ops mt636x_rf_ops = {
+	.enable = regulator_enable_regmap,
+	.disable = regulator_disable_regmap,
+	.is_enabled = regulator_is_enabled_regmap,
+	.list_voltage = regulator_list_voltage_table,
+	.map_voltage = regulator_map_voltage_iterate,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel = regulator_set_voltage_time_sel,
+	.get_mode = mt636x_rf_get_mode,
+	.set_mode = mt636x_rf_set_mode,
+};
+
+#define MT636X_RF_LDO(_id, _name, _control, _selector, _voltages) { \
+	.id = (_id), .name = (_name), .of_match = (_name), \
+	.regulators_node = "regulators", .type = REGULATOR_VOLTAGE, \
+	.owner = THIS_MODULE, .ops = &mt636x_rf_ops, \
+	.enable_reg = (_control), .enable_mask = MT636X_LDO_ENABLE, \
+	.vsel_reg = (_selector), .vsel_mask = MT636X_LDO_VOSEL, \
+	.volt_table = (_voltages), .n_voltages = ARRAY_SIZE(_voltages), \
+	.of_map_mode = mt636x_rf_map_mode, \
+}
+
+static const struct regulator_desc mt6363_rf_rails[] = {
+	MT636X_RF_LDO(0, "vcn13", 0x1d07, 0x1b3f, mt6363_vcn13_uv),
+	MT636X_RF_LDO(1, "vrfio18", 0x1bcd, 0x1f2c, mt636x_rfio_uv),
+};
+
+static const struct regulator_desc mt6369_rf_rails[] = {
+	MT636X_RF_LDO(0, "vcn33-1", 0x1c3f, 0x1db1, mt6369_vcn33_uv),
+	MT636X_RF_LDO(1, "vcn33-2", 0x1c4d, 0x1db5, mt6369_vcn33_uv),
+	MT636X_RF_LDO(2, "vant18", 0x1cb2, 0x1e09, mt636x_rfio_uv),
+};
+
+static const struct mt636x_rf_chip mt6363_rf = {
+	.rails = mt6363_rf_rails, .count = ARRAY_SIZE(mt6363_rf_rails),
+};
+
+static const struct mt636x_rf_chip mt6369_rf = {
+	.rails = mt6369_rf_rails, .count = ARRAY_SIZE(mt6369_rf_rails),
+};
+
+static const struct regmap_config mt636x_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xffff,
+	.fast_io = true,
+};
+
+static int mt636x_rf_probe(struct spmi_device *sdev)
+{
+	struct device *dev = &sdev->dev;
+	const struct mt636x_rf_chip *chip = device_get_match_data(dev);
+	struct device_node *regulators __free(device_node) = NULL;
+	struct regulator_config config = { .dev = dev };
+	unsigned int chip_id, i;
+	int ret;
+
+	if (!chip)
+		return -ENODEV;
+
+	regulators = of_get_child_by_name(dev->of_node, "regulators");
+	if (!regulators)
+		return dev_err_probe(dev, -EINVAL, "Missing RF regulators\n");
+
+	config.regmap = devm_regmap_init_spmi_ext(sdev, &mt636x_regmap_config);
+	if (IS_ERR(config.regmap))
+		return dev_err_probe(dev, PTR_ERR(config.regmap), "Cannot create PMIC regmap\n");
+
+	ret = regmap_read(config.regmap, MT636X_SWCID, &chip_id);
+	if (ret || !chip_id)
+		return dev_err_probe(dev, ret ?: -ENODEV, "Cannot read PMIC chip ID\n");
+
+	for (i = 0; i < chip->count; i++) {
+		const struct regulator_desc *rail = &chip->rails[i];
+		struct device_node *node __free(device_node) =
+			of_get_child_by_name(regulators, rail->of_match);
+		struct regulator_dev *rdev;
+
+		if (!node || !of_device_is_available(node))
+			continue;
+
+		rdev = devm_regulator_register(dev, rail, &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev), "Cannot register %s\n", rail->name);
+	}
+
+	/* Connectivity children use this parent's byte-addressed PMIC regmap. */
+	return devm_of_platform_populate(dev);
+}
+
+static const struct of_device_id mt636x_rf_of_match[] = {
+	{ .compatible = "mediatek,mt6363-rf-regulators", .data = &mt6363_rf },
+	{ .compatible = "mediatek,mt6369-rf-regulators", .data = &mt6369_rf },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt636x_rf_of_match);
+
+static struct spmi_driver mt636x_rf_driver = {
+	.probe = mt636x_rf_probe,
+	.driver = {
+		.name = "mt636x-rf-regulator",
+		.of_match_table = mt636x_rf_of_match,
+	},
+};
+module_spmi_driver(mt636x_rf_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6363 and MT6369 RF regulator driver");
+MODULE_LICENSE("GPL");
