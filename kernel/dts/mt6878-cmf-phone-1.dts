	bt@18800000 {
		compatible = "mediatek,bt";
		reg = <0x00 0x18800000 0x00 0x1000 0x00 0x18000000 0x00 0x1000 0x00 0x18001000 0x00 0x1000 0x00 0x18051000 0x00 0x1000 0x00 0x18060000 0x00 0x1000 0x00 0x18812000 0x00 0x1000 0x00 0x10001000 0x00 0x1000>;
		interrupts = <0x00 0x2b5 0x04 0x00 0x00 0x84 0x04 0x00>;
	};

	display-clock-voter {
		compatible = "mediatek,mt6878-display-clock-voter";
		mediatek,topckgen = <0x1a>;
		mediatek,hardware-voter = <0x15>;
		clocks = <0x1a 0x04 0x1a 0x05>;
		clock-names = "disp", "mminfra";
		#clock-cells = <0x01>;
		mediatek,retain-boot-clocks;
		mediatek,acquire-boot-clock-votes;
		phandle = <0x40>;
	};

	sound {
		compatible = "nothing,tetris-sound";
		model = "CMF Phone 1";
		mediatek,platform = <0x3f>;
		audio-routing = "Earpiece", "Receiver", "Speaker", "DAC Output", "AIN0", "Mic input 0", "AIN1", "Mic input 1", "AIN2", "Mic input 2";

		dai-link-1 {
			mediatek,clk-provider = "cpu";
			dai-format = "i2s";
			link-name = "I2SOUT4_BE";

			codec {
				sound-dai = <0x50e>;
			};
		};

		dai-link-0 {
			link-name = "ADDA_BE";

			codec {
				sound-dai = <0x50d>;
			};
		};
	};
};
