From 6bf36a1d8b6477fc79133d0b41a805667aabb545 Mon Sep 17 00:00:00 2001
From: CMF mainline <cmf-mainline@users.noreply.github.com>
Date: Sat, 28 Nov 2026 06:37:20 +0000
Subject: [PATCH] drm/mediatek: queue MT6878 backlight writes during video

Send the CMF panel brightness writes during vertical front porch while
DSC video runs. Preserve command mode for panel power sequences and
messages that cannot use the queue.

Poll the VM command completion separately from the legacy interrupt
handler. On timeout, give the command a final frame and check again
after stopping video before retrying it in command mode.

Signed-off-by: CMF mainline <cmf-mainline@users.noreply.github.com>
---
 drivers/gpu/drm/drm_mipi_dsi.c                |   2 +
 drivers/gpu/drm/mediatek/mtk_dsi.c            | 194 +++++++++++++++++-
 .../gpu/drm/panel/panel-samsung-s6e8fc3x02.c  |   7 +
 include/drm/drm_mipi_dsi.h                    |   4 +
 4 files changed, 202 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/drm_mipi_dsi.c b/drivers/gpu/drm/drm_mipi_dsi.c
index 3ac1dd5ad..e566beaf2 100644
--- a/drivers/gpu/drm/drm_mipi_dsi.c
+++ b/drivers/gpu/drm/drm_mipi_dsi.c
@@ -455,6 +455,8 @@ static ssize_t mipi_dsi_device_transfer(struct mipi_dsi_device *dsi,
 
 	if (dsi->mode_flags & MIPI_DSI_MODE_LPM)
 		msg->flags |= MIPI_DSI_MSG_USE_LPM;
+	if (dsi->mode_flags & MIPI_DSI_MODE_VIDEO_CMD)
+		msg->flags |= MIPI_DSI_MSG_VIDEO_CMD;
 
 	return ops->transfer(dsi->host, msg);
 }
diff --git a/drivers/gpu/drm/mediatek/mtk_dsi.c b/drivers/gpu/drm/mediatek/mtk_dsi.c
index 2541b056f..72a265764 100644
--- a/drivers/gpu/drm/mediatek/mtk_dsi.c
+++ b/drivers/gpu/drm/mediatek/mtk_dsi.c
@@ -8,6 +8,8 @@
 #include <linux/component.h>
 #include <linux/iopoll.h>
 #include <linux/irq.h>
+#include <linux/ktime.h>
+#include <linux/moduleparam.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_platform.h>
@@ -39,7 +41,9 @@
 #include "mtk_drm_drv.h"
 
 #define DSI_START		0x00
+#define DSI_START_EN		BIT(0)
 #define SLEEPOUT_START		BIT(2)
+#define VM_CMD_START		BIT(16)
 
 #define DSI_INTEN		0x08
 
@@ -48,11 +52,15 @@
 #define CMD_DONE_INT_FLAG		BIT(1)
 #define TE_RDY_INT_FLAG			BIT(2)
 #define VM_DONE_INT_FLAG		BIT(3)
+#define VM_CMD_DONE_INT_FLAG		BIT(5)
 #define SLEEPOUT_DONE_INT_FLAG		BIT(6)
 #define SLEEPIN_ULPS_DONE_INT_FLAG	BIT(15)
 #define EXT_TE_RDY_INT_FLAG		BIT(4)
 #define DSI_BUSY			BIT(31)
 
+#define DSI_TRANSFER_IRQ_FLAGS		(LPRX_RD_RDY_INT_FLAG | \
+					 CMD_DONE_INT_FLAG | VM_DONE_INT_FLAG)
+
 #define DSI_CON_CTRL		0x10
 #define DSI_RESET			BIT(0)
 #define DSI_EN				BIT(1)
@@ -160,7 +168,12 @@
 
 /* DSI_VM_CMD_CON */
 #define VM_CMD_EN			BIT(0)
+#define VM_CMD_LONG_PACKET		BIT(1)
+#define VM_CMD_RGB_INTERVAL		BIT(2)
 #define TS_VFP_EN			BIT(5)
+#define VM_CMD_DATA0			0x208
+#define VM_CMD_MAX_PAYLOAD		16
+#define VM_CMD_MAX_TIMEOUTS		3
 
 /* DSI_SHADOW_DEBUG */
 #define FORCE_COMMIT			BIT(0)
@@ -206,6 +219,10 @@
 	(type == MIPI_DSI_GENERIC_READ_REQUEST_2_PARAM) || \
 	(type == MIPI_DSI_DCS_READ))
 
+static bool vm_cmd_force_timeout;
+module_param_named(vm_cmd_force_timeout, vm_cmd_force_timeout, bool, 0600);
+MODULE_PARM_DESC(vm_cmd_force_timeout, "Skip triggering VM_CMD to test timeout recovery");
+
 struct mtk_phy_timing {
 	u32 lpx;
 	u32 da_hs_prepare;
@@ -237,6 +254,7 @@ struct mtk_dsi_driver_data {
 	bool has_size_ctl;
 	bool cmdq_long_packet_ctl;
 	bool support_per_frame_lp;
+	bool supports_vm_cmd;
 };
 
 struct mtk_dsi {
@@ -275,6 +293,8 @@ struct mtk_dsi {
 	int refcount;
 	bool enabled;
 	bool lanes_ready;
+	u8 vm_cmd_timeouts;
+	u8 vm_cmd_logged;
 	u32 irq_data;
 	/* Stage 83c: INTEN bits masked because their INTSTA bit stayed latched. */
 	u32 inten_masked;
@@ -744,12 +764,14 @@ static void mtk_dsi_restore_lk_regs(struct mtk_dsi *dsi)
 
 static void mtk_dsi_set_interrupt_enable(struct mtk_dsi *dsi)
 {
-	u32 inten = LPRX_RD_RDY_INT_FLAG | CMD_DONE_INT_FLAG | VM_DONE_INT_FLAG;
 	unsigned long flags;
 
+	/* VM_CMD_DONE is polled while video is running. */
+	BUILD_BUG_ON(DSI_TRANSFER_IRQ_FLAGS & VM_CMD_DONE_INT_FLAG);
+
 	spin_lock_irqsave(&dsi->inten_lock, flags);
 	dsi->inten_masked = 0;
-	writel(inten, dsi->regs + DSI_INTEN);
+	writel(DSI_TRANSFER_IRQ_FLAGS, dsi->regs + DSI_INTEN);
 	spin_unlock_irqrestore(&dsi->inten_lock, flags);
 }
 
@@ -796,9 +818,8 @@ static irqreturn_t mtk_dsi_irq(int irq, void *dev_id)
 {
 	struct mtk_dsi *dsi = dev_id;
 	u32 status, tmp;
-	u32 flag = LPRX_RD_RDY_INT_FLAG | CMD_DONE_INT_FLAG | VM_DONE_INT_FLAG;
 
-	status = readl(dsi->regs + DSI_INTSTA) & flag;
+	status = readl(dsi->regs + DSI_INTSTA) & DSI_TRANSFER_IRQ_FLAGS;
 
 	if (status) {
 		/*
@@ -823,7 +844,11 @@ static irqreturn_t mtk_dsi_irq(int irq, void *dev_id)
 						     "DSI busy after IRQ, INTSTA %#x\n", tmp);
 		}
 
-		mtk_dsi_mask(dsi, DSI_INTSTA, status, 0);
+		/* Preserve a concurrently latched video command completion. */
+		if (dsi->driver_data->supports_vm_cmd)
+			writel(~status, dsi->regs + DSI_INTSTA);
+		else
+			mtk_dsi_mask(dsi, DSI_INTSTA, status, 0);
 		/*
 		 * Stage 83c: in video mode with DSI_BUSY, a latched CMD_DONE does
 		 * not clear, and the level IRQ re-fires (~290k/s). Mask such bits
@@ -1194,6 +1219,7 @@ static void mtk_output_dsi_enable(struct mtk_dsi *dsi)
 	mtk_dsi_set_mode(dsi);
 	mtk_dsi_start(dsi);
 
+	dsi->vm_cmd_timeouts = 0;
 	dsi->enabled = true;
 }
 
@@ -1700,6 +1726,132 @@ static ssize_t mtk_dsi_host_send_cmd(struct mtk_dsi *dsi,
 		return 0;
 }
 
+static const char *mtk_dsi_vm_cmd_fallback_reason(struct mtk_dsi *dsi,
+						  const struct mipi_dsi_msg *msg)
+{
+	if (dsi->vm_cmd_timeouts >= VM_CMD_MAX_TIMEOUTS)
+		return "queue disabled";
+	if (!dsi->enabled || !dsi->bridge_powered || !dsi->lanes_ready ||
+	    !dsi->active_has_dsc || !(readl(dsi->regs + DSI_START) & DSI_START_EN))
+		return "no active DSC video stream";
+	if (MTK_DSI_HOST_IS_READ(msg->type) || msg->rx_len)
+		return "read";
+	if (msg->flags & (MIPI_DSI_MSG_USE_LPM | MIPI_DSI_MSG_REQ_ACK))
+		return "LP or ACK requested";
+	if (!(msg->flags & MIPI_DSI_MSG_VIDEO_CMD))
+		return "command mode requested";
+	if (!msg->tx_buf || !msg->tx_len || msg->tx_len > VM_CMD_MAX_PAYLOAD)
+		return "payload length";
+	if (msg->channel)
+		return "virtual channel";
+
+	switch (msg->type) {
+	case MIPI_DSI_DCS_SHORT_WRITE:
+	case MIPI_DSI_GENERIC_SHORT_WRITE_1_PARAM:
+		return msg->tx_len == 1 ? NULL : "short packet length";
+	case MIPI_DSI_DCS_SHORT_WRITE_PARAM:
+	case MIPI_DSI_GENERIC_SHORT_WRITE_2_PARAM:
+		return msg->tx_len == 2 ? NULL : "short packet length";
+	case MIPI_DSI_DCS_LONG_WRITE:
+	case MIPI_DSI_GENERIC_LONG_WRITE:
+		return NULL;
+	default:
+		return "packet type";
+	}
+}
+
+static void mtk_dsi_vm_cmd_finish(struct mtk_dsi *dsi)
+{
+	/* INTSTA is write-zero-to-clear. Preserve all other status bits. */
+	writel(~(u32)VM_CMD_DONE_INT_FLAG, dsi->regs + DSI_INTSTA);
+	writel(VM_CMD_EN | TS_VFP_EN, dsi->regs + dsi->driver_data->reg_vm_cmd_off);
+}
+
+static int mtk_dsi_host_send_vm_cmd(struct mtk_dsi *dsi,
+				    const struct mipi_dsi_msg *msg)
+{
+	static const char fmt[] =
+		"VM_CMD type=%#x len=%zu cmd=%#x clear=%#x start=%#x done=%#x time=%lld us\n";
+	struct mipi_dsi_packet packet;
+	const u8 *payload;
+	unsigned int i, j;
+	u32 control, after_clear, after_start, status;
+	ktime_t start;
+	s64 elapsed;
+	int ret;
+
+	lockdep_assert_held(&dsi->lock);
+	ret = mipi_dsi_create_packet(&packet, msg);
+	if (ret)
+		return ret;
+
+	/* The host mutex also serializes video start/stop and power changes. */
+	mtk_dsi_mask(dsi, DSI_START, VM_CMD_START, 0);
+	writel(~(u32)VM_CMD_DONE_INT_FLAG, dsi->regs + DSI_INTSTA);
+	after_clear = readl(dsi->regs + DSI_INTSTA);
+	if (after_clear & VM_CMD_DONE_INT_FLAG) {
+		dsi->vm_cmd_timeouts = VM_CMD_MAX_TIMEOUTS;
+		dev_warn(dsi->dev, "VM_CMD status %#x did not clear; disabling queue\n",
+			 after_clear);
+		mtk_dsi_vm_cmd_finish(dsi);
+		return -EIO;
+	}
+
+	control = VM_CMD_EN | VM_CMD_RGB_INTERVAL | TS_VFP_EN |
+		  ((u32)packet.header[0] << 8) | ((u32)packet.header[1] << 16) |
+		  ((u32)packet.header[2] << 24);
+	payload = packet.payload;
+	if (mipi_dsi_packet_format_is_long(msg->type)) {
+		control |= VM_CMD_LONG_PACKET;
+		for (i = 0; i < packet.payload_length; i += sizeof(u32)) {
+			u32 word = 0;
+
+			for (j = 0; j < sizeof(word) && i + j < packet.payload_length; j++)
+				word |= (u32)payload[i + j] << (j * 8);
+			writel(word, dsi->regs + VM_CMD_DATA0 + i);
+		}
+	}
+	writel(control, dsi->regs + dsi->driver_data->reg_vm_cmd_off);
+
+	start = ktime_get();
+	if (!READ_ONCE(vm_cmd_force_timeout))
+		mtk_dsi_mask(dsi, DSI_START, VM_CMD_START, VM_CMD_START);
+	after_start = readl(dsi->regs + DSI_INTSTA);
+	ret = readl_poll_timeout(dsi->regs + DSI_INTSTA, status,
+				 status & VM_CMD_DONE_INT_FLAG, 150, 50000);
+	mtk_dsi_mask(dsi, DSI_START, VM_CMD_START, 0);
+	if (ret)
+		/* Keep the packet intact for one more frame in case it completes. */
+		ret = readl_poll_timeout(dsi->regs + DSI_INTSTA, status,
+					 status & VM_CMD_DONE_INT_FLAG, 150, 17000);
+	elapsed = ktime_us_delta(ktime_get(), start);
+
+	if (dsi->vm_cmd_logged < 20) {
+		dsi->vm_cmd_logged++;
+		dev_info(dsi->dev, fmt, msg->type, msg->tx_len,
+			 ((const u8 *)msg->tx_buf)[0], after_clear, after_start, status, elapsed);
+	} else {
+		dev_dbg_ratelimited(dsi->dev, fmt, msg->type, msg->tx_len,
+				    ((const u8 *)msg->tx_buf)[0], after_clear,
+				    after_start, status, elapsed);
+	}
+
+	if (ret)
+		/* The fallback checks the latched bit again after video stops. */
+		return ret;
+
+	if ((after_start & VM_CMD_DONE_INT_FLAG) || elapsed < 5) {
+		dsi->vm_cmd_timeouts = VM_CMD_MAX_TIMEOUTS;
+		dev_warn(dsi->dev, "VM_CMD completed too early; disabling queue\n");
+	} else {
+		dsi->vm_cmd_timeouts = 0;
+		if (elapsed > 17000)
+			dev_warn_ratelimited(dsi->dev, "VM_CMD took %lld us\n", elapsed);
+	}
+	mtk_dsi_vm_cmd_finish(dsi);
+	return 0;
+}
+
 static ssize_t mtk_dsi_host_transfer_locked(struct mipi_dsi_host *host,
 				     const struct mipi_dsi_msg *msg)
 {
@@ -1709,6 +1861,7 @@ static ssize_t mtk_dsi_host_transfer_locked(struct mipi_dsi_host *host,
 	u8 read_data[16];
 	void *src_addr;
 	u8 irq_flag = CMD_DONE_INT_FLAG;
+	bool vm_cmd_pending = false;
 	u32 dsi_mode;
 	int ret, i;
 
@@ -1718,8 +1871,38 @@ static ssize_t mtk_dsi_host_transfer_locked(struct mipi_dsi_host *host,
 
 	dsi_mode = readl(dsi->regs + DSI_MODE_CTRL);
 	if (dsi_mode & MODE) {
+		if (dsi->driver_data->supports_vm_cmd) {
+			const char *reason = mtk_dsi_vm_cmd_fallback_reason(dsi, msg);
+
+			if (!reason) {
+				ret = mtk_dsi_host_send_vm_cmd(dsi, msg);
+				if (!ret)
+					return 0;
+				vm_cmd_pending = ret == -ETIMEDOUT;
+				reason = vm_cmd_pending ? "timeout" : "queue error";
+			}
+			dev_dbg_ratelimited(dsi->dev, "VM_CMD fallback: %s\n", reason);
+		}
+
 		mtk_dsi_stop(dsi);
 		ret = mtk_dsi_switch_to_cmd_mode(dsi, VM_DONE_INT_FLAG, 500);
+		if (vm_cmd_pending) {
+			bool sent = readl(dsi->regs + DSI_INTSTA) & VM_CMD_DONE_INT_FLAG;
+
+			mtk_dsi_vm_cmd_finish(dsi);
+			if (sent) {
+				dsi->vm_cmd_timeouts = 0;
+				dev_warn_ratelimited(dsi->dev, "VM_CMD completed during video stop\n");
+				recv_cnt = 0;
+				goto restore_dsi_mode;
+			}
+			if (++dsi->vm_cmd_timeouts == VM_CMD_MAX_TIMEOUTS)
+				dev_warn(dsi->dev, "VM_CMD timed out three times; disabling queue\n");
+			/*
+			 * Retry only writes the panel opted in as repeatable.
+			 * Sleep and display power commands never use the queue.
+			 */
+		}
 		if (ret)
 			goto restore_dsi_mode;
 	}
@@ -1931,6 +2114,7 @@ static const struct mtk_dsi_driver_data mt6878_dsi_driver_data = {
 	.has_size_ctl = true,
 	.cmdq_long_packet_ctl = true,
 	.has_n4 = true,
+	.supports_vm_cmd = true,
 };
 
 static const struct of_device_id mtk_dsi_of_match[] = {
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c b/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c
index 09dcbe544..b28c76226 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c
@@ -29,6 +29,7 @@ struct s6e8fc3x02 {
 	struct gpio_desc *vci_en;
 	struct mutex lock;
 	bool prepared;
+	bool backlight_unblank;
 };
 
 static const struct drm_dsc_config s6e8fc3x02_dsc = {
@@ -210,6 +211,7 @@ static int s6e8fc3x02_unprepare(struct drm_panel *panel)
 		mipi_dsi_msleep(&dsi_ctx, 160);
 		s6e8fc3x02_power_off(ctx);
 		ctx->prepared = false;
+		ctx->backlight_unblank = false;
 	}
 	mutex_unlock(&ctx->lock);
 
@@ -278,6 +280,7 @@ static int s6e8fc3x02_bl_update_status(struct backlight_device *bl)
 	u16 level = backlight_get_brightness(bl);
 	u8 brightness[] = { 0x51, 0x00, 0x00 };
 	unsigned long flags;
+	bool unblank = !backlight_is_blank(bl);
 
 	/* Preserve the panel vendor's normal-brightness exclusion range. */
 	if (level >= 417 && level <= 424)
@@ -292,10 +295,14 @@ static int s6e8fc3x02_bl_update_status(struct backlight_device *bl)
 	/* The vendor backlight command pack is sent in HS mode. */
 	flags = ctx->dsi->mode_flags;
 	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	/* The panel bridge also calls this for its backlight power changes. */
+	if (unblank && ctx->backlight_unblank)
+		ctx->dsi->mode_flags |= MIPI_DSI_MODE_VIDEO_CMD;
 	s6e8fc3x02_write_seq(&dsi_ctx, 0x53, 0x20);
 	s6e8fc3x02_write(&dsi_ctx, brightness, sizeof(brightness));
 	s6e8fc3x02_write_seq(&dsi_ctx, 0xf7, 0x0b);
 	ctx->dsi->mode_flags = flags;
+	ctx->backlight_unblank = unblank && !dsi_ctx.accum_err;
 out:
 	mutex_unlock(&ctx->lock);
 	return dsi_ctx.accum_err;
diff --git a/include/drm/drm_mipi_dsi.h b/include/drm/drm_mipi_dsi.h
index b429acde4..7a8c95d46 100644
--- a/include/drm/drm_mipi_dsi.h
+++ b/include/drm/drm_mipi_dsi.h
@@ -20,6 +20,8 @@ struct drm_dsc_picture_parameter_set;
 #define MIPI_DSI_MSG_REQ_ACK	BIT(0)
 /* use Low Power Mode to transmit message */
 #define MIPI_DSI_MSG_USE_LPM	BIT(1)
+/* allow a host to send this write while its video stream is running */
+#define MIPI_DSI_MSG_VIDEO_CMD	BIT(2)
 
 /**
  * struct mipi_dsi_msg - read/write DSI buffer
@@ -138,6 +140,8 @@ struct mipi_dsi_host *of_find_mipi_dsi_host_by_node(struct device_node *node);
 #define MIPI_DSI_MODE_LPM		BIT(11)
 /* transmit data ending at the same time for all lanes within one hsync */
 #define MIPI_DSI_HS_PKT_END_ALIGNED	BIT(12)
+/* allow commands to be inserted in the current video stream */
+#define MIPI_DSI_MODE_VIDEO_CMD		BIT(13)
 
 enum mipi_dsi_pixel_format {
 	MIPI_DSI_FMT_RGB888,
-- 
