diff --git a/drivers/mailbox/mtk-gpueb-mailbox.c b/drivers/mailbox/mtk-gpueb-mailbox.c
index f6d2beccd..ac708fd30 100644
--- a/drivers/mailbox/mtk-gpueb-mailbox.c
+++ b/drivers/mailbox/mtk-gpueb-mailbox.c
@@ -116,8 +116,14 @@ static irqreturn_t mtk_gpueb_mbox_thread(int irq, void *data)
 
 		mtk_gpueb_mbox_read_rx(buf, ch);
 		writel(BIT(ch->num), ch->ebm->mbox_ctl + GPUEB_MBOX_CTL_IRQ_CLR);
-		mbox_chan_received_data(&ch->ebm->mbox.chans[ch->num], buf);
+		/*
+		 * The data is copied out, so the channel can send again. Do this
+		 * before the client sees the reply: a client that sends its next
+		 * message from there would get -EBUSY, and the mailbox core keeps
+		 * such a message queued without ever retrying it.
+		 */
 		atomic_set(&ch->rx_status, 0);
+		mbox_chan_received_data(&ch->ebm->mbox.chans[ch->num], buf);
 		return IRQ_HANDLED;
 	}
 
@@ -163,8 +169,15 @@ static int mtk_gpueb_mbox_startup(struct mbox_chan *chan)
 
 	writel(BIT(ch->num), ch->ebm->mbox_ctl + GPUEB_MBOX_CTL_IRQ_CLR);
 
+	/*
+	 * NO_SUSPEND: the GPU power domain is switched from the noirq phases
+	 * of system suspend (genpd), and its provider waits for the EB's
+	 * reply through this interrupt. The IRQ thread is not frozen, so the
+	 * reply is delivered with the other device interrupts disabled.
+	 */
 	ret = devm_request_threaded_irq(ch->ebm->dev, ch->ebm->irq, mtk_gpueb_mbox_isr,
-					mtk_gpueb_mbox_thread, IRQF_SHARED | IRQF_ONESHOT,
+					mtk_gpueb_mbox_thread,
+					IRQF_SHARED | IRQF_ONESHOT | IRQF_NO_SUSPEND,
 					ch->full_name, ch);
 	if (ret) {
 		dev_err(ch->ebm->dev, "Failed to request IRQ: %pe\n",
@@ -224,7 +237,11 @@ static int mtk_gpueb_mbox_probe(struct platform_device *pdev)
 	if (ebm->irq < 0)
 		return ebm->irq;
 
-	ebm->clk = devm_clk_get_prepared(ebm->dev, NULL);
+	/*
+	 * On some SoCs, such as the MT6878, the GPUEB runs from a PLL of its
+	 * own that the boot firmware sets up, and there is no clock to hold.
+	 */
+	ebm->clk = devm_clk_get_optional_prepared(ebm->dev, NULL);
 	if (IS_ERR(ebm->clk))
 		return dev_err_probe(ebm->dev, PTR_ERR(ebm->clk),
 				     "Failed to get 'eb' clock\n");
@@ -299,7 +316,30 @@ static const struct mtk_gpueb_mbox_variant mtk_gpueb_mbox_mt8196 = {
 	},
 };
 
+/*
+ * MT6878: same controller, one 0x280 byte mailbox. The layout follows the
+ * channel sizes the GPUEB firmware expects: all the outgoing slots first,
+ * then the incoming ones, in channel order.
+ */
+static const struct mtk_gpueb_mbox_variant mtk_gpueb_mbox_mt6878 = {
+	.num_channels = 11,
+	.channels = {
+		{ "fast-dvfs-event", 0, 0x0000, 16, 0x00d8, 16 },
+		{ "gpufreq",         1, 0x0010, 32, 0x00e8, 32 },
+		{ "sleep",           2, 0x0030, 12, 0x0108,  4 },
+		{ "timer",           3, 0x003c, 24, 0x010c,  4 },
+		{ "fhctl",           4, 0x0054, 36, 0x0110,  4 },
+		{ "ccf",             5, 0x0078, 16, 0x0114, 16 },
+		{ "gpumpu",          6, 0x0088, 24, 0x0124,  4 },
+		{ "fast-dvfs",       7, 0x00a0, 24, 0x0128, 24 },
+		{ "ipir-c-met",      8, 0x00b8,  4, 0x0140, 16 },
+		{ "ipis-c-met",      9, 0x00bc, 16, 0x0150,  4 },
+		{ "brisket",        10, 0x00cc, 12, 0x0154, 12 },
+	},
+};
+
 static const struct of_device_id mtk_gpueb_mbox_of_ids[] = {
+	{ .compatible = "mediatek,mt6878-gpueb-mbox", .data = &mtk_gpueb_mbox_mt6878 },
 	{ .compatible = "mediatek,mt8196-gpueb-mbox", .data = &mtk_gpueb_mbox_mt8196 },
 	{ /* Sentinel */ }
 };
