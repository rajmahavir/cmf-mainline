+		value = readl(mmsys->regs + config->offset);
+		value = (value & ~config->mask) | mmsys->dsc_path_saved[count];
+		writel(value, mmsys->regs + config->offset);
+	}
+	/* Flush the last write before the bus/domain reference can be released. */
+	readl(mmsys->regs + mt6878_dsc_path[0].offset);
