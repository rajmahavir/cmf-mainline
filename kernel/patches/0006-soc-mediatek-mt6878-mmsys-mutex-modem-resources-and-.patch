+		config = &mt6878_dsc_path[i];
+		value = readl(mmsys->regs + config->offset);
+		value = (value & ~config->mask) | config->value;
+		writel(value, mmsys->regs + config->offset);
+		if (config->readback_mask &&
+		    (readl(mmsys->regs + config->offset) & config->readback_mask) !=
+		    (config->value & config->readback_mask)) {
+			dev_warn(dev, "Stage 85c: DSC route %#x readback %#x, want %#x\n",
+				 config->offset, readl(mmsys->regs + config->offset),
+				 config->value & config->readback_mask);
+			mtk_mmsys_dsc_path_restore(mmsys, i + 1);
+			pm_runtime_put_sync(dev);
+			ret = -EIO;
+			goto out;
+		}
+	}
