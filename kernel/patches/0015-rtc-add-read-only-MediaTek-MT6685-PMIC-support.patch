From 86e802e7dd4b2b4331fcf2dda3efa21203a2a844 Mon Sep 17 00:00:00 2001
From: CMF mainline <cmf-mainline@users.noreply.github.com>
Date: Fri, 27 Nov 2026 11:57:40 +0000
Subject: [PATCH] rtc: add read-only MediaTek MT6685 PMIC support

Read the live calendar counters over the existing SPMI function.
Verify the seconds before accepting a snapshot so a tick cannot combine
fields from different times. Expose the clock without touching the PMIC
clock gates or write trigger.
---
 .../bindings/rtc/mediatek,mt6685-rtc.yaml     |  30 ++++
 drivers/rtc/Kconfig                           |  10 ++
 drivers/rtc/Makefile                          |   1 +
 drivers/rtc/rtc-mt6685.c                      | 133 ++++++++++++++++++
 4 files changed, 174 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/rtc/mediatek,mt6685-rtc.yaml
 create mode 100644 drivers/rtc/rtc-mt6685.c

diff --git a/Documentation/devicetree/bindings/rtc/mediatek,mt6685-rtc.yaml b/Documentation/devicetree/bindings/rtc/mediatek,mt6685-rtc.yaml
new file mode 100644
index 000000000..3578ae997
--- /dev/null
+++ b/Documentation/devicetree/bindings/rtc/mediatek,mt6685-rtc.yaml
@@ -0,0 +1,30 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/rtc/mediatek,mt6685-rtc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6685 PMIC RTC
+
+maintainers:
+  - CMF mainline <cmf-mainline@users.noreply.github.com>
+
+description:
+  Real-time clock in the MT6685 PMIC, accessed through the parent SPMI device.
+  The parent describes child addresses as PMIC register offsets with no size.
+
+allOf:
+  - $ref: rtc.yaml#
+
+properties:
+  compatible:
+    const: mediatek,mt6685-rtc
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
diff --git a/drivers/rtc/Kconfig b/drivers/rtc/Kconfig
index 01def8231..fc145d14e 100644
--- a/drivers/rtc/Kconfig
+++ b/drivers/rtc/Kconfig
@@ -1956,6 +1956,16 @@ config RTC_DRV_MT6397
 
 	  If you want to use MediaTek(R) RTC interface, select Y or M here.
 
+config RTC_DRV_MT6685
+	tristate "MediaTek MT6685 PMIC RTC"
+	depends on OF && SPMI
+	help
+	  Enable read access to the real-time clock in the MediaTek MT6685
+	  PMIC over SPMI. This driver supports reading the clock counters.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called rtc-mt6685.
+
 config RTC_DRV_MT7622
 	tristate "MediaTek SoC based RTC"
 	depends on ARCH_MEDIATEK || COMPILE_TEST
diff --git a/drivers/rtc/Makefile b/drivers/rtc/Makefile
index 0347645b0..57f69cb13 100644
--- a/drivers/rtc/Makefile
+++ b/drivers/rtc/Makefile
@@ -115,6 +115,7 @@ obj-$(CONFIG_RTC_DRV_SSD202D)	+= rtc-ssd202d.o
 obj-$(CONFIG_RTC_DRV_MSM6242)	+= rtc-msm6242.o
 obj-$(CONFIG_RTC_DRV_MT2712)	+= rtc-mt2712.o
 obj-$(CONFIG_RTC_DRV_MT6397)	+= rtc-mt6397.o
+obj-$(CONFIG_RTC_DRV_MT6685)	+= rtc-mt6685.o
 obj-$(CONFIG_RTC_DRV_MT7622)	+= rtc-mt7622.o
 obj-$(CONFIG_RTC_DRV_MV)	+= rtc-mv.o
 obj-$(CONFIG_RTC_DRV_MXC)	+= rtc-mxc.o
diff --git a/drivers/rtc/rtc-mt6685.c b/drivers/rtc/rtc-mt6685.c
new file mode 100644
index 000000000..a5d8664aa
--- /dev/null
+++ b/drivers/rtc/rtc-mt6685.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MediaTek MT6685 RTC counter reader. */
+
+#include <linux/limits.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/rtc.h>
+#include <linux/spmi.h>
+#include <linux/unaligned.h>
+
+#define MT6685_RTC_TC_SEC	0x12
+#define MT6685_RTC_TC_YEAR	0x1e
+#define MT6685_RTC_YEAR_BASE	1968
+
+struct mt6685_rtc {
+	struct spmi_device *spmi;
+	u16 base;
+};
+
+static int mt6685_rtc_read_counter(struct mt6685_rtc *rtc, u16 offset)
+{
+	u8 data[2];
+	int ret;
+
+	ret = spmi_ext_register_readl(rtc->spmi, rtc->base + offset,
+				      data, sizeof(data));
+	if (ret)
+		return ret;
+
+	return get_unaligned_le16(data);
+}
+
+static int mt6685_rtc_read_time(struct device *dev, struct rtc_time *tm)
+{
+	struct mt6685_rtc *rtc = dev_get_drvdata(dev);
+	u16 counters[7];
+	int attempt, i, ret;
+
+	/* The PMIC exposes live counters. Retry a snapshot spanning a tick. */
+	for (attempt = 0; attempt < 3; attempt++) {
+		for (i = 0; i < ARRAY_SIZE(counters); i++) {
+			ret = mt6685_rtc_read_counter(rtc, MT6685_RTC_TC_SEC + 2 * i);
+			if (ret < 0)
+				return ret;
+			counters[i] = ret;
+		}
+
+		ret = mt6685_rtc_read_counter(rtc, MT6685_RTC_TC_SEC);
+		if (ret < 0)
+			return ret;
+		if ((ret & 0x3f) == (counters[0] & 0x3f))
+			break;
+	}
+	if (attempt == 3)
+		return -EAGAIN;
+
+	tm->tm_sec = counters[0] & 0x3f;
+	tm->tm_min = counters[1] & 0x3f;
+	tm->tm_hour = counters[2] & 0x1f;
+	tm->tm_mday = counters[3] & 0x1f;
+	tm->tm_mon = (counters[5] & 0x0f) - 1;
+	tm->tm_year = (counters[6] & 0x7f) + MT6685_RTC_YEAR_BASE - 1900;
+
+	ret = rtc_valid_tm(tm);
+	if (ret)
+		return ret;
+	/* Derive weekday and yearday from the date, as weekday can be stale. */
+	rtc_time64_to_tm(rtc_tm_to_time64(tm), tm);
+
+	return 0;
+}
+
+static const struct rtc_class_ops mt6685_rtc_ops = {
+	.read_time = mt6685_rtc_read_time,
+};
+
+static int mt6685_rtc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rtc_device *rtc_dev;
+	struct mt6685_rtc *rtc;
+	u32 base;
+	int ret;
+
+	if (!dev->parent ||
+	    !of_device_is_compatible(dev->parent->of_node,
+				     "mediatek,mt6685-consys-regmap"))
+		return -ENODEV;
+
+	ret = device_property_read_u32(dev, "reg", &base);
+	if (ret)
+		return dev_err_probe(dev, ret, "Cannot read RTC register base\n");
+	if (base > U16_MAX - MT6685_RTC_TC_YEAR - 1)
+		return -EINVAL;
+
+	rtc = devm_kzalloc(dev, sizeof(*rtc), GFP_KERNEL);
+	if (!rtc)
+		return -ENOMEM;
+
+	rtc->spmi = to_spmi_device(dev->parent);
+	rtc->base = base;
+	platform_set_drvdata(pdev, rtc);
+
+	rtc_dev = devm_rtc_allocate_device(dev);
+	if (IS_ERR(rtc_dev))
+		return PTR_ERR(rtc_dev);
+
+	rtc_dev->ops = &mt6685_rtc_ops;
+	rtc_dev->range_min = 0;
+	rtc_dev->range_max = 3976214399LL; /* 2095-12-31 23:59:59 UTC */
+
+	return devm_rtc_register_device(rtc_dev);
+}
+
+static const struct of_device_id mt6685_rtc_of_match[] = {
+	{ .compatible = "mediatek,mt6685-rtc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6685_rtc_of_match);
+
+static struct platform_driver mt6685_rtc_driver = {
+	.probe = mt6685_rtc_probe,
+	.driver = {
+		.name = "mt6685-rtc",
+		.of_match_table = mt6685_rtc_of_match,
+	},
+};
+module_platform_driver(mt6685_rtc_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6685 RTC counter reader");
+MODULE_LICENSE("GPL");
-- 
2.53.0

