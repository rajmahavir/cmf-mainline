diff --git a/drivers/power/supply/cmf-mt6375-battery.c b/drivers/power/supply/cmf-mt6375-battery.c
new file mode 100644
index 000000000..bf56851e9
--- /dev/null
+++ b/drivers/power/supply/cmf-mt6375-battery.c
@@ -0,0 +1,402 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/power_supply.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#include "cmf-battery-curve.h"
+
+#define CMF_FULL_UAH 5000000
+#define FG_LATCH 0x70
+#define FG_LATCH_STATUS 0x6f
+#define FG_LATCH_READ BIT(0)
+#define FG_LATCH_CLEAR BIT(3)
+#define FG_LATCH_ACTIVE BIT(7)
+
+static struct i2c_client *pmu, *gauge;
+static struct power_supply *battery, *usb;
+static struct delayed_work poll;
+static DEFINE_MUTEX(sample_lock);
+
+struct cmf_sample {
+	int voltage_uv, current_ua, vbus_uv, capacity, charge_uah;
+	s32 counter;
+};
+
+static struct cmf_sample sample;
+static s32 initial_counter;
+static int initial_charge_uah;
+static bool sample_valid, seeded;
+
+static int read_reg(struct i2c_client *client, u8 reg, void *buf, u16 len)
+{
+	struct i2c_msg msg[] = {
+		{ .addr = client->addr, .len = 1, .buf = &reg },
+		{ .addr = client->addr, .flags = I2C_M_RD, .len = len, .buf = buf },
+	};
+	int ret = i2c_transfer(client->adapter, msg, ARRAY_SIZE(msg));
+
+	return ret == ARRAY_SIZE(msg) ? 0 : ret < 0 ? ret : -EIO;
+}
+
+static int read_byte(struct i2c_client *client, u8 reg)
+{
+	u8 value;
+	int ret = read_reg(client, reg, &value, 1);
+
+	return ret < 0 ? ret : value;
+}
+
+static int wait_mask(struct i2c_client *client, u8 reg, u8 mask, bool set)
+{
+	int i, ret;
+
+	for (i = 0; i < 25; i++) {
+		ret = read_byte(client, reg);
+		if (ret < 0)
+			return ret;
+		if (!!(ret & mask) == set)
+			return 0;
+		usleep_range(200, 500);
+	}
+	return -ETIMEDOUT;
+}
+
+static int read_adc(unsigned int channel, unsigned int scale, int *value)
+{
+	u8 data[2];
+	int ret;
+
+	ret = wait_mask(pmu, 0xa6, GENMASK(7, 4), false);
+	if (ret)
+		return ret;
+	ret = i2c_smbus_write_byte_data(pmu, 0xa6, channel << 4);
+	if (ret)
+		return ret;
+	usleep_range(4400, 6600);
+	ret = wait_mask(pmu, 0xa6, GENMASK(7, 4), false);
+	if (ret)
+		return ret;
+	ret = read_reg(pmu, 0xaa + (channel - 1) * 2, data, sizeof(data));
+	if (!ret)
+		*value = get_unaligned_be16(data) * scale;
+	return ret;
+}
+
+static int read_gauge(struct cmf_sample *next)
+{
+	u8 current_raw[2], counter[4];
+	int ctrl, ret, release, restore;
+	s32 current_counts;
+	u32 raw;
+
+	ctrl = read_byte(gauge, FG_LATCH);
+	if (ctrl < 0)
+		return ctrl;
+	if (ctrl & (FG_LATCH_READ | FG_LATCH_CLEAR))
+		return -EBUSY;
+
+	ret = i2c_smbus_write_byte_data(gauge, FG_LATCH, ctrl | FG_LATCH_READ);
+	if (!ret)
+		ret = wait_mask(gauge, FG_LATCH_STATUS, FG_LATCH_ACTIVE, true);
+	if (!ret)
+		ret = read_reg(gauge, 0xe7, current_raw, sizeof(current_raw));
+	if (!ret)
+		ret = read_reg(gauge, 0x78, counter, sizeof(counter));
+	release = i2c_smbus_write_byte_data(gauge, FG_LATCH, ctrl | FG_LATCH_CLEAR);
+	if (!release)
+		release = wait_mask(gauge, FG_LATCH_STATUS, FG_LATCH_ACTIVE, false);
+	restore = i2c_smbus_write_byte_data(gauge, FG_LATCH, ctrl);
+	if (restore || release || ret)
+		return restore ?: release ?: ret;
+
+	/* The gauge uses one's complement for negative readings. */
+	raw = get_unaligned_le16(current_raw);
+	current_counts = (raw & BIT(15)) ? (s32)raw - U16_MAX : raw;
+	next->current_ua = div_s64((s64)current_counts * 610352, 1000);
+	raw = get_unaligned_le32(counter);
+	next->counter = (raw & BIT(31)) ? (s32)(raw + 1) : raw;
+	return 0;
+}
+
+/* The stock battery0 profile at 25 C uses 100 uV and 100 uAh units. */
+static int estimate_initial_charge(const struct cmf_sample *next)
+{
+	int i, before, after, v_before, v_after;
+	/* Approximate the terminal-voltage drop using the profile's typical 50 mOhm. */
+	int ocv = (next->voltage_uv - next->current_ua / 20) / 100;
+
+	if (ocv >= cmf_curve[0].voltage)
+		return CMF_FULL_UAH;
+	for (i = 1; i < ARRAY_SIZE(cmf_curve); i++) {
+		v_before = cmf_curve[i - 1].voltage;
+		v_after = cmf_curve[i].voltage;
+		if (ocv < v_after || v_before <= v_after)
+			continue;
+		before = cmf_curve[i - 1].discharged;
+		after = cmf_curve[i].discharged;
+		return clamp(CMF_FULL_UAH - before * 100 -
+			     (ocv < v_before ? (v_before - ocv) * (after - before) *
+			      100 / (v_before - v_after) : 0), 0, CMF_FULL_UAH);
+	}
+	return 0;
+}
+
+static int collect(struct cmf_sample *next)
+{
+	s32 delta;
+	int ret;
+
+	ret = read_adc(4, 1250, &next->voltage_uv);
+	if (!ret)
+		ret = read_adc(11, 25000, &next->vbus_uv);
+	if (!ret)
+		ret = read_gauge(next);
+	if (ret)
+		return ret;
+	if (next->voltage_uv < 2500000 || next->voltage_uv > 4700000)
+		return -ERANGE;
+	if (!seeded) {
+		initial_charge_uah = estimate_initial_charge(next);
+		initial_counter = next->counter;
+		seeded = true;
+	}
+	delta = (s32)((u32)next->counter - (u32)initial_counter);
+	next->charge_uah = clamp(initial_charge_uah +
+				 (int)div_s64((s64)delta * 85, 1000), 0, CMF_FULL_UAH);
+	next->capacity = DIV_ROUND_CLOSEST(next->charge_uah, CMF_FULL_UAH / 100);
+	return 0;
+}
+
+static bool is_online(const struct cmf_sample *reading)
+{
+	return reading->vbus_uv >= 4000000;
+}
+
+static enum power_supply_property battery_props[] = {
+	POWER_SUPPLY_PROP_PRESENT, POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW, POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CAPACITY, POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN, POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+};
+
+static int battery_property(struct power_supply *psy,
+			    enum power_supply_property prop,
+			    union power_supply_propval *val)
+{
+	int ret = 0;
+
+	mutex_lock(&sample_lock);
+	if (!sample_valid) {
+		ret = -ENODATA;
+		goto done;
+	}
+	switch (prop) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		if (!is_online(&sample) || sample.current_ua < -30000)
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		else if (sample.current_ua > 30000)
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		val->intval = sample.voltage_uv;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		val->intval = sample.current_ua;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = sample.capacity;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		val->intval = sample.charge_uah;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = CMF_FULL_UAH;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = 3300000;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+done:
+	mutex_unlock(&sample_lock);
+	return ret;
+}
+
+static enum power_supply_property usb_props[] = { POWER_SUPPLY_PROP_ONLINE };
+
+static int usb_property(struct power_supply *psy, enum power_supply_property prop,
+			union power_supply_propval *val)
+{
+	int ret = 0;
+
+	if (prop != POWER_SUPPLY_PROP_ONLINE)
+		return -EINVAL;
+	mutex_lock(&sample_lock);
+	if (sample_valid)
+		val->intval = is_online(&sample);
+	else
+		ret = -ENODATA;
+	mutex_unlock(&sample_lock);
+	return ret;
+}
+
+static const struct power_supply_desc battery_desc = {
+	.name = "cmf-battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = battery_props,
+	.num_properties = ARRAY_SIZE(battery_props),
+	.get_property = battery_property,
+};
+
+static const struct power_supply_desc usb_desc = {
+	.name = "cmf-usb-input",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = usb_props,
+	.num_properties = ARRAY_SIZE(usb_props),
+	.get_property = usb_property,
+};
+
+static void poll_battery(struct work_struct *work)
+{
+	struct cmf_sample next;
+	int ret = collect(&next);
+
+	mutex_lock(&sample_lock);
+	sample_valid = !ret;
+	if (!ret)
+		sample = next;
+	mutex_unlock(&sample_lock);
+	power_supply_changed(battery);
+	power_supply_changed(usb);
+	schedule_delayed_work(&poll, msecs_to_jiffies(5000));
+}
+
+static int cmf_battery_try(void)
+{
+	struct i2c_adapter *adapter = i2c_get_adapter(5);
+	struct power_supply_config config = {};
+	struct device_node *charger_bus;
+	int ret;
+
+	if (!adapter)
+		return -ENODEV;
+	charger_bus = of_find_node_by_path("/soc@0/i2c@11280000");
+	if (!charger_bus || charger_bus != adapter->dev.of_node) {
+		of_node_put(charger_bus);
+		ret = -ENODEV;
+		goto put_adapter;
+	}
+	of_node_put(charger_bus);
+
+	pmu = i2c_new_dummy_device(adapter, 0x34);
+	if (IS_ERR(pmu)) {
+		ret = PTR_ERR(pmu);
+		goto put_adapter;
+	}
+	gauge = i2c_new_dummy_device(adapter, 0x1a);
+	if (IS_ERR(gauge)) {
+		ret = PTR_ERR(gauge);
+		goto remove_pmu;
+	}
+
+	ret = read_byte(pmu, 0x00);
+	if (ret < 0 || (ret & 0xf0) != 0x70) {
+		ret = ret < 0 ? ret : -ENODEV;
+		goto remove_gauge;
+	}
+	ret = read_byte(pmu, 0xa4);
+	if (ret < 0 || !(ret & BIT(7))) {
+		ret = ret < 0 ? ret : -ENODATA;
+		goto remove_gauge;
+	}
+	ret = collect(&sample);
+	if (ret)
+		goto remove_gauge;
+	sample_valid = true;
+
+	battery = power_supply_register(&pmu->dev, &battery_desc, &config);
+	if (IS_ERR(battery)) {
+		ret = PTR_ERR(battery);
+		goto remove_gauge;
+	}
+	usb = power_supply_register(&pmu->dev, &usb_desc, &config);
+	if (IS_ERR(usb)) {
+		ret = PTR_ERR(usb);
+		power_supply_unregister(battery);
+		goto remove_gauge;
+	}
+	INIT_DELAYED_WORK(&poll, poll_battery);
+	schedule_delayed_work(&poll, msecs_to_jiffies(5000));
+	i2c_put_adapter(adapter);
+	return 0;
+
+remove_gauge:
+	i2c_unregister_device(gauge);
+remove_pmu:
+	i2c_unregister_device(pmu);
+put_adapter:
+	i2c_put_adapter(adapter);
+	return ret;
+}
+
+/*
+ * Built in, init can run before I2C adapter 5 (i2c@11280000) has probed.
+ * Retry every 500 ms for up to 60 s while the bus or chip is missing.
+ */
+static struct delayed_work cmf_battery_work;
+static unsigned int cmf_battery_tries;
+static bool cmf_battery_done;
+
+static void cmf_battery_retry(struct work_struct *work)
+{
+	int ret = cmf_battery_try();
+
+	if (!ret) {
+		cmf_battery_done = true;
+		pr_info("cmf-battery: registered after %u attempt(s)\n",
+			cmf_battery_tries + 1);
+		return;
+	}
+	if (ret == -ENODEV && ++cmf_battery_tries < 120) {
+		schedule_delayed_work(&cmf_battery_work, msecs_to_jiffies(500));
+		return;
+	}
+	pr_err("cmf-battery: giving up: %d\n", ret);
+}
+
+static int __init cmf_battery_init(void)
+{
+	INIT_DELAYED_WORK(&cmf_battery_work, cmf_battery_retry);
+	schedule_delayed_work(&cmf_battery_work, 0);
+	return 0;
+}
+
+static void __exit cmf_battery_exit(void)
+{
+	cancel_delayed_work_sync(&cmf_battery_work);
+	if (!cmf_battery_done)
+		return;
+	cancel_delayed_work_sync(&poll);
+	power_supply_unregister(usb);
+	power_supply_unregister(battery);
+	i2c_unregister_device(gauge);
+	i2c_unregister_device(pmu);
+}
+module_init(cmf_battery_init);
+module_exit(cmf_battery_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("CMF Phone 1 MT6375 battery telemetry with estimated capacity");
+
-- 
