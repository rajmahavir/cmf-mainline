+			      AUDIO_TOP_CON0, PDN_DL0_PREDIS_SFT, 1, NULL, 0),
+	SND_SOC_DAPM_SUPPLY_S("ADDA_UL0_ADC_CG", SUPPLY_SEQ_ADDA_CG,
