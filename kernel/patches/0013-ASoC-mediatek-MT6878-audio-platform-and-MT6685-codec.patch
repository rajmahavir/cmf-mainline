+static int mt6878_afe_pcm_open(struct snd_soc_component *component,
+			       struct snd_pcm_substream *substream)
+{
+	/* set the wait_for_avail to 2 sec */
+	substream->wait_time = msecs_to_jiffies(2 * 1000);
+
+	return 0;
+}
+
+static void mt6878_afe_pcm_free(struct snd_soc_component *component,
+				struct snd_pcm *pcm)
+{
+	snd_pcm_lib_preallocate_free_for_all(pcm);
+}
+
+/* a hostless front end has no memory interface and no position */
+static snd_pcm_uframes_t mt6878_afe_pcm_pointer(struct snd_soc_component *component,
+						struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	if (snd_soc_rtd_to_cpu(rtd, 0)->id >= MT6878_MEMIF_NUM)
+		return 0;
+
+	return mtk_afe_pcm_pointer(component, substream);
+}
