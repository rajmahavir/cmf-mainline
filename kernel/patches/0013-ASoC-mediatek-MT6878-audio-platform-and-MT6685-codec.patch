+static void mtk_dai_etdm_in4_config(struct mtk_base_afe *afe,
+				    struct mtk_afe_i2s_priv *i2s_priv,
+				    unsigned int rate, snd_pcm_format_t format,
+				    unsigned int channels)
+{
+	struct regmap *map = afe->regmap;
+
+	regmap_update_bits(map, ETDM_IN4_CON1, REG_INITIAL_COUNT_MASK_SFT,
+			   0x5 << REG_INITIAL_COUNT_SFT);
+	/* 3: pad top 5: no pad top */
+	regmap_update_bits(map, ETDM_IN4_CON1, REG_INITIAL_POINT_MASK_SFT,
+			   0x3 << REG_INITIAL_POINT_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON1, REG_LRCK_RESET_MASK_SFT,
+			   0x1 << REG_LRCK_RESET_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON2, REG_CLOCK_SOURCE_SEL_MASK_SFT,
+			   ETDM_CLK_SOURCE_APLL << REG_CLOCK_SOURCE_SEL_SFT);
+	/* 0: manual 1: auto */
+	regmap_update_bits(map, ETDM_IN4_CON2, REG_CK_EN_SEL_AUTO_MASK_SFT,
+			   0x1 << REG_CK_EN_SEL_AUTO_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON3, REG_FS_TIMING_SEL_MASK_SFT,
+			   get_etdm_rate(rate) << REG_FS_TIMING_SEL_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON4, REG_RELATCH_1X_EN_SEL_MASK_SFT,
+			   get_etdm_inconn_rate(rate) << REG_RELATCH_1X_EN_SEL_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON8, REG_ETDM_USE_AFIFO_MASK_SFT,
+			   0x0 << REG_ETDM_USE_AFIFO_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON8, REG_AFIFO_MODE_MASK_SFT,
+			   0x0 << REG_AFIFO_MODE_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON9, REG_ALMOST_END_CH_COUNT_MASK_SFT,
+			   0x0 << REG_ALMOST_END_CH_COUNT_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON9, REG_ALMOST_END_BIT_COUNT_MASK_SFT,
+			   0x0 << REG_ALMOST_END_BIT_COUNT_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON9, REG_OUT2LATCH_TIME_MASK_SFT,
+			   0x6 << REG_OUT2LATCH_TIME_SFT);
+
+	/* format: 0 i2s, 4 dsp_a */
+	regmap_update_bits(map, ETDM_IN4_CON0, REG_FMT_MASK_SFT,
+			   i2s_priv->format << REG_FMT_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON0, REG_CH_NUM_MASK_SFT,
+			   (channels - 1) << REG_CH_NUM_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON0, REG_SYNC_MODE_MASK_SFT, 0);
+
+	/* APLL */
+	regmap_update_bits(map, ETDM_IN4_CON0,
+			   REG_RELATCH_1X_EN_DOMAIN_SEL_MASK_SFT,
+			   ETDM_RELATCH_SEL_APLL << REG_RELATCH_1X_EN_DOMAIN_SEL_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON0, REG_BIT_LENGTH_MASK_SFT,
+			   get_etdm_lrck_width(format) << REG_BIT_LENGTH_SFT);
+	regmap_update_bits(map, ETDM_IN4_CON0, REG_WORD_LENGTH_MASK_SFT,
+			   get_etdm_wlen(format) << REG_WORD_LENGTH_SFT);
+
+	/* ---etdm cowork --- */
+	regmap_update_bits(map, ETDM_4_7_COWORK_CON0, ETDM_IN4_SLAVE_SEL_MASK_SFT,
+			   ETDM_SLAVE_SEL_ETDMOUT4_MASTER << ETDM_IN4_SLAVE_SEL_SFT);
+}
+
+static void mtk_dai_etdm_out4_config(struct mtk_base_afe *afe,
+				     struct mtk_afe_i2s_priv *i2s_priv,
+				     unsigned int rate, snd_pcm_format_t format,
+				     unsigned int channels)
+{
+	struct regmap *map = afe->regmap;
+	unsigned int wlen = get_etdm_wlen(format);
+
+	regmap_update_bits(map, ETDM_OUT4_CON1, OUT_REG_INITIAL_COUNT_MASK_SFT,
+			   0x5 << OUT_REG_INITIAL_COUNT_SFT);
+	regmap_update_bits(map, ETDM_OUT4_CON1, OUT_REG_INITIAL_POINT_MASK_SFT,
+			   0x6 << OUT_REG_INITIAL_POINT_SFT);
+
+	/* clock speed > 22M need to set relatch time to avoid duplicate point */
+	if (rate * channels * (wlen + 1) >= ETDM_22M_CLOCK_THRES)
+		regmap_update_bits(map, ETDM_OUT4_CON2, OUT_REG_IN2LATCH_TIME_MASK_SFT,
+				   (wlen - 2) << OUT_REG_IN2LATCH_TIME_SFT);
+	else
+		regmap_update_bits(map, ETDM_OUT4_CON2, OUT_REG_IN2LATCH_TIME_MASK_SFT,
+				   0x6 << OUT_REG_IN2LATCH_TIME_SFT);
+
+	regmap_update_bits(map, ETDM_OUT4_CON1, OUT_REG_LRCK_RESET_MASK_SFT,
+			   0x1 << OUT_REG_LRCK_RESET_SFT);
+	regmap_update_bits(map, ETDM_OUT4_CON4, OUT_REG_FS_TIMING_SEL_MASK_SFT,
+			   get_etdm_rate(rate) << OUT_REG_FS_TIMING_SEL_SFT);
+	regmap_update_bits(map, ETDM_OUT4_CON4, OUT_REG_CLOCK_SOURCE_SEL_MASK_SFT,
+			   ETDM_CLK_SOURCE_APLL << OUT_REG_CLOCK_SOURCE_SEL_SFT);
+	regmap_update_bits(map, ETDM_OUT4_CON4, OUT_REG_RELATCH_EN_SEL_MASK_SFT,
+			   get_etdm_inconn_rate(rate) << OUT_REG_RELATCH_EN_SEL_SFT);
+
+	/* format: 0 i2s, 4 dsp_a */
+	regmap_update_bits(map, ETDM_OUT4_CON0, OUT_REG_FMT_MASK_SFT,
+			   i2s_priv->format << OUT_REG_FMT_SFT);
+	regmap_update_bits(map, ETDM_OUT4_CON0, REG_CH_NUM_MASK_SFT,
+			   (channels - 1) << REG_CH_NUM_SFT);
+	regmap_update_bits(map, ETDM_OUT4_CON0, REG_SYNC_MODE_MASK_SFT, 0);
+
+	/* APLL */
+	regmap_update_bits(map, ETDM_OUT4_CON0, OUT_REG_RELATCH_DOMAIN_SEL_MASK_SFT,
+			   ETDM_RELATCH_SEL_APLL << OUT_REG_RELATCH_DOMAIN_SEL_SFT);
+	regmap_update_bits(map, ETDM_OUT4_CON0, OUT_REG_BIT_LENGTH_MASK_SFT,
+			   get_etdm_lrck_width(format) << OUT_REG_BIT_LENGTH_SFT);
+	regmap_update_bits(map, ETDM_OUT4_CON0, OUT_REG_WORD_LENGTH_MASK_SFT,
+			   wlen << OUT_REG_WORD_LENGTH_SFT);
+
+	/* ---etdm cowork --- */
+	regmap_update_bits(map, ETDM_4_7_COWORK_CON0, ETDM_OUT4_SLAVE_SEL_MASK_SFT,
+			   ETDM_SLAVE_SEL_ETDMIN4_MASTER << ETDM_OUT4_SLAVE_SEL_SFT);
+}
+
+/* i2s dai ops */
+static int mtk_dai_i2s_config(struct mtk_base_afe *afe,
+			      struct snd_pcm_hw_params *params,
+			      int i2s_id)
+{
+	struct mt6878_afe_private *afe_priv = afe->platform_priv;
+	struct mtk_afe_i2s_priv *i2s_priv = afe_priv->dai_priv[i2s_id];
+	unsigned int rate = params_rate(params);
+	snd_pcm_format_t format = params_format(params);
+	unsigned int channels = params_channels(params);
+
+	if (!i2s_priv)
+		return -EINVAL;
+
+	dev_dbg(afe->dev, "id: %d, rate: %d, pcm_fmt: %d, fmt: %d, ch: %d\n",
+		i2s_id, rate, format, i2s_priv->format, channels);
+
+	i2s_priv->rate = rate;
+
+	switch (i2s_id) {
+	case MT6878_DAI_I2S_IN4:
+		mtk_dai_etdm_in4_config(afe, i2s_priv, rate, format, channels);
+		break;
+	case MT6878_DAI_I2S_OUT4:
+		mtk_dai_etdm_out4_config(afe, i2s_priv, rate, format, channels);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* the clock master of a cowork pair runs with the same setup */
+	if (i2s_priv->share_i2s_id >= 0) {
+		struct mtk_afe_i2s_priv *share_priv =
+			afe_priv->dai_priv[i2s_priv->share_i2s_id];
+
+		share_priv->format = i2s_priv->format;
+		return mtk_dai_i2s_config(afe, params, i2s_priv->share_i2s_id);
+	}
+
+	return 0;
+}
+
+static int mtk_dai_i2s_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params,
+				 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+
+	return mtk_dai_i2s_config(afe, params, dai->id);
+}
+
+static int mtk_dai_i2s_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6878_afe_private *afe_priv = afe->platform_priv;
+	struct mtk_afe_i2s_priv *i2s_priv = afe_priv->dai_priv[dai->id];
+
+	if (!i2s_priv)
+		return -EINVAL;
+
+	/* the AFE provides BCK/LRCK */
+	if ((fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) != SND_SOC_DAIFMT_BP_FP)
+		return -EINVAL;
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		i2s_priv->format = MTK_DAI_ETDM_FORMAT_I2S;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		i2s_priv->format = MTK_DAI_ETDM_FORMAT_LJ;
+		break;
+	case SND_SOC_DAIFMT_RIGHT_J:
+		i2s_priv->format = MTK_DAI_ETDM_FORMAT_RJ;
+		break;
+	case SND_SOC_DAIFMT_DSP_A:
+		i2s_priv->format = MTK_DAI_ETDM_FORMAT_DSPA;
+		break;
+	case SND_SOC_DAIFMT_DSP_B:
+		i2s_priv->format = MTK_DAI_ETDM_FORMAT_DSPB;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops mtk_dai_i2s_ops = {
+	.hw_params = mtk_dai_i2s_hw_params,
+	.set_fmt = mtk_dai_i2s_set_fmt,
+};
+
+/* dai driver */
+#define MTK_ETDM_RATES (SNDRV_PCM_RATE_8000_192000)
+#define MTK_ETDM_FORMATS (SNDRV_PCM_FMTBIT_S16_LE |\
+			  SNDRV_PCM_FMTBIT_S24_LE |\
+			  SNDRV_PCM_FMTBIT_S32_LE)
+
+#define MT6878_I2S_DAI(_name, _id, max_ch, dir) \
+{ \
+	.name = #_name, \
+	.id = _id, \
+	.dir = { \
+		.stream_name = #_name, \
+		.channels_min = 1, \
+		.channels_max = max_ch, \
+		.rates = MTK_ETDM_RATES, \
+		.formats = MTK_ETDM_FORMATS, \
+	}, \
+	.ops = &mtk_dai_i2s_ops, \
+}
+
+static struct snd_soc_dai_driver mtk_dai_i2s_driver[] = {
+	MT6878_I2S_DAI(I2SIN4, MT6878_DAI_I2S_IN4, 2, capture),
+	MT6878_I2S_DAI(I2SOUT4, MT6878_DAI_I2S_OUT4, 2, playback),
+};
+
+int mt6878_dai_i2s_register(struct mtk_base_afe *afe)
+{
+	struct mt6878_afe_private *afe_priv = afe->platform_priv;
+	struct mtk_afe_i2s_priv *in4, *out4;
+	struct mtk_base_afe_dai *dai;
+
+	dai = devm_kzalloc(afe->dev, sizeof(*dai), GFP_KERNEL);
+	in4 = devm_kzalloc(afe->dev, sizeof(*in4), GFP_KERNEL);
+	out4 = devm_kzalloc(afe->dev, sizeof(*out4), GFP_KERNEL);
+	if (!dai || !in4 || !out4)
+		return -ENOMEM;
+
+	/* I2SOUT4 always runs from the I2SIN4 clocks (pinmux of the board) */
+	in4->share_i2s_id = -1;
+	out4->share_i2s_id = MT6878_DAI_I2S_IN4;
+	afe_priv->dai_priv[MT6878_DAI_I2S_IN4] = in4;
+	afe_priv->dai_priv[MT6878_DAI_I2S_OUT4] = out4;
+
+	dai->dai_drivers = mtk_dai_i2s_driver;
+	dai->num_dai_drivers = ARRAY_SIZE(mtk_dai_i2s_driver);
+	dai->dapm_widgets = mtk_dai_i2s_widgets;
+	dai->num_dapm_widgets = ARRAY_SIZE(mtk_dai_i2s_widgets);
+	dai->dapm_routes = mtk_dai_i2s_routes;
+	dai->num_dapm_routes = ARRAY_SIZE(mtk_dai_i2s_routes);
+
+	list_add(&dai->list, &afe->sub_dais);
+
+	return 0;
+}
diff --git a/sound/soc/mediatek/mt6878/mt6878-dai-pcm.c b/sound/soc/mediatek/mt6878/mt6878-dai-pcm.c
new file mode 100644
index 000000000..d8cad1eff
--- /dev/null
+++ b/sound/soc/mediatek/mt6878/mt6878-dai-pcm.c
@@ -0,0 +1,260 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *  MediaTek ALSA SoC Audio DAI PCM Control
+ *
+ *  PCM 1 is the in-SoC voice interface of the modem (MD1): during a call
+ *  the modem's speech downlink arrives on PCM 1 capture and is routed by
+ *  the interconnect to ADDA DL or I2SOUT4; the microphones (ADDA UL) and an
+ *  echo reference go back on PCM 1 playback. No sample data passes the
+ *  AP. The interface settings are those of the MediaTek downstream MT6878
+ *  driver, the structure follows the mainline MT8189 driver.
+ *
+ *  Copyright (c) 2023 MediaTek Inc.
+ *  Author: Tina Tsai <tina.tsai@mediatek.com>
+ *  Copyright (c) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#include <linux/regmap.h>
+
+#include <sound/pcm_params.h>
+
+#include "mt6878-afe-common.h"
+#include "mt6878-interconnection.h"
+
+enum {
+	AUD_PCM_AFIFO_ASRC,
+	/* the modem runs from the same crystal */
+	AUD_PCM_AFIFO_AFIFO,
+};
+
+enum {
+	AUD_PCM_WLEN_32_BCK_CYCLES,
+	AUD_PCM_WLEN_64_BCK_CYCLES,
+};
+
+enum {
+	AUD_PCM_FMT_I2S,
+	AUD_PCM_FMT_EIAJ,
+	AUD_PCM_FMT_PCM_MODE_A,
+	AUD_PCM_FMT_PCM_MODE_B,
+};
+
+enum {
+	AUD_PCM_1X_EN_DOMAIN_HOPPING_26M,
+	AUD_PCM_1X_EN_DOMAIN_APLL,
+};
+
+/* PCM1_MODE */
+enum {
+	AUD_PCM_MODE_8K,
+	AUD_PCM_MODE_16K,
+	AUD_PCM_MODE_32K,
+	AUD_PCM_MODE_48K,
+};
+
+static int mt6878_pcm_rate(unsigned int rate, unsigned int *mode,
+			   unsigned int *x_mode)
+{
+	switch (rate) {
+	case 8000:
+		*mode = AUD_PCM_MODE_8K;
+		*x_mode = MTK_AFE_IPM2P0_RATE_8K;
+		break;
+	case 16000:
+		*mode = AUD_PCM_MODE_16K;
+		*x_mode = MTK_AFE_IPM2P0_RATE_16K;
+		break;
+	case 32000:
+		*mode = AUD_PCM_MODE_32K;
+		*x_mode = MTK_AFE_IPM2P0_RATE_32K;
+		break;
+	case 48000:
+		*mode = AUD_PCM_MODE_48K;
+		*x_mode = MTK_AFE_IPM2P0_RATE_48K;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/* dai component: AP -> modem channels */
+static const struct snd_kcontrol_new mtk_pcm_1_playback_ch1_mix[] = {
+	SOC_DAPM_SINGLE_AUTODISABLE("ADDA_UL_CH1", AFE_CONN102_0,
+				    I_ADDA_UL_CH1, 1, 0),
+	SOC_DAPM_SINGLE_AUTODISABLE("ADDA_UL_CH2", AFE_CONN102_0,
+				    I_ADDA_UL_CH2, 1, 0),
+};
+
+static const struct snd_kcontrol_new mtk_pcm_1_playback_ch2_mix[] = {
+	SOC_DAPM_SINGLE_AUTODISABLE("ADDA_UL_CH1", AFE_CONN103_0,
+				    I_ADDA_UL_CH1, 1, 0),
+	SOC_DAPM_SINGLE_AUTODISABLE("ADDA_UL_CH2", AFE_CONN103_0,
+				    I_ADDA_UL_CH2, 1, 0),
+};
+
+/* channels 4/5: echo reference for the modem's echo canceller */
+static const struct snd_kcontrol_new mtk_pcm_1_playback_ch4_mix[] = {
+	SOC_DAPM_SINGLE_AUTODISABLE("DL0_CH1", AFE_CONN105_1,
+				    I_DL0_CH1, 1, 0),
+	SOC_DAPM_SINGLE_AUTODISABLE("I2SIN4_CH1", AFE_CONN105_4,
+				    I_I2SIN4_CH1, 1, 0),
+	SOC_DAPM_SINGLE_AUTODISABLE("I2SIN4_CH2", AFE_CONN105_4,
+				    I_I2SIN4_CH2, 1, 0),
+};
+
+static const struct snd_kcontrol_new mtk_pcm_1_playback_ch5_mix[] = {
+	SOC_DAPM_SINGLE_AUTODISABLE("DL0_CH2", AFE_CONN106_1,
+				    I_DL0_CH2, 1, 0),
+	SOC_DAPM_SINGLE_AUTODISABLE("I2SIN4_CH2", AFE_CONN106_4,
+				    I_I2SIN4_CH2, 1, 0),
+};
+
+static const struct snd_soc_dapm_widget mtk_dai_pcm_widgets[] = {
+	/* inter-connections */
+	SND_SOC_DAPM_MIXER("PCM_1_PB_CH1", SND_SOC_NOPM, 0, 0,
+			   mtk_pcm_1_playback_ch1_mix,
+			   ARRAY_SIZE(mtk_pcm_1_playback_ch1_mix)),
+	SND_SOC_DAPM_MIXER("PCM_1_PB_CH2", SND_SOC_NOPM, 0, 0,
+			   mtk_pcm_1_playback_ch2_mix,
+			   ARRAY_SIZE(mtk_pcm_1_playback_ch2_mix)),
+	SND_SOC_DAPM_MIXER("PCM_1_PB_CH4", SND_SOC_NOPM, 0, 0,
+			   mtk_pcm_1_playback_ch4_mix,
+			   ARRAY_SIZE(mtk_pcm_1_playback_ch4_mix)),
+	SND_SOC_DAPM_MIXER("PCM_1_PB_CH5", SND_SOC_NOPM, 0, 0,
+			   mtk_pcm_1_playback_ch5_mix,
+			   ARRAY_SIZE(mtk_pcm_1_playback_ch5_mix)),
+
+	SND_SOC_DAPM_SUPPLY("PCM_1_CG", AUDIO_TOP_CON0, PDN_PCM1_SFT, 1,
+			    NULL, 0),
+	SND_SOC_DAPM_SUPPLY("PCM_1_EN", AFE_PCM1_INTF_CON0, PCM1_EN_SFT, 0,
+			    NULL, 0),
+
+	SND_SOC_DAPM_INPUT("MD1_TO_AFE"),
+	SND_SOC_DAPM_OUTPUT("AFE_TO_MD1"),
+};
+
+static const struct snd_soc_dapm_route mtk_dai_pcm_routes[] = {
+	{"PCM 1 Playback", NULL, "PCM_1_PB_CH1"},
+	{"PCM 1 Playback", NULL, "PCM_1_PB_CH2"},
+	{"PCM 1 Playback", NULL, "PCM_1_PB_CH4"},
+	{"PCM 1 Playback", NULL, "PCM_1_PB_CH5"},
+
+	{"PCM_1_EN", NULL, "PCM_1_CG"},
+	{"PCM 1 Playback", NULL, "PCM_1_EN"},
+	{"PCM 1 Capture", NULL, "PCM_1_EN"},
+
+	{"AFE_TO_MD1", NULL, "PCM 1 Playback"},
+	{"PCM 1 Capture", NULL, "MD1_TO_AFE"},
+
+	{"PCM_1_PB_CH4", "DL0_CH1", "DL0"},
+	{"PCM_1_PB_CH5", "DL0_CH2", "DL0"},
+	{"PCM_1_PB_CH4", "I2SIN4_CH1", "I2SIN4"},
+	{"PCM_1_PB_CH4", "I2SIN4_CH2", "I2SIN4"},
+	{"PCM_1_PB_CH5", "I2SIN4_CH2", "I2SIN4"},
+};
+
+/* dai ops */
+static int mtk_dai_pcm_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params,
+				 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct snd_soc_dapm_widget *p_w =
+		snd_soc_dai_get_widget(dai, SNDRV_PCM_STREAM_PLAYBACK);
+	struct snd_soc_dapm_widget *c_w =
+		snd_soc_dai_get_widget(dai, SNDRV_PCM_STREAM_CAPTURE);
+	unsigned int rate = params_rate(params);
+	unsigned int mode, x_mode, con0, con1;
+
+	if (mt6878_pcm_rate(rate, &mode, &x_mode)) {
+		dev_err(afe->dev, "PCM 1: rate %u not supported\n", rate);
+		return -EINVAL;
+	}
+
+	dev_dbg(afe->dev, "PCM 1: stream %d, rate %u\n",
+		substream->stream, rate);
+
+	/* both directions share the interface: configure it once */
+	if ((p_w && p_w->active) || (c_w && c_w->active))
+		return 0;
+
+	con0 = 0 << PCM1_TX_LCH_RPT_SFT;	/* no left channel repeat */
+	con0 |= 0 << PCM1_VBT_16K_MODE_SFT;
+	con0 |= 0 << PCM1_BT_MODE_SFT;		/* dual mic on TX */
+	con0 |= AUD_PCM_AFIFO_AFIFO << PCM1_AFIFO_SFT;
+	con0 |= AUD_PCM_WLEN_32_BCK_CYCLES << PCM1_WLEN_SFT;
+	con0 |= mode << PCM1_MODE_SFT;
+	con0 |= AUD_PCM_FMT_PCM_MODE_B << PCM1_FMT_SFT;
+
+	con1 = AUD_PCM_1X_EN_DOMAIN_HOPPING_26M << PCM1_1X_EN_DOMAIN_SFT;
+	con1 |= x_mode << PCM1_1X_EN_MODE_SFT;
+
+	/* everything but the enable bit, which is a DAPM supply */
+	regmap_update_bits(afe->regmap, AFE_PCM1_INTF_CON0,
+			   ~(unsigned int)PCM1_EN_MASK_SFT, con0);
+	regmap_update_bits(afe->regmap, AFE_PCM1_INTF_CON1,
+			   PCM1_1X_EN_DOMAIN_MASK_SFT |
+			   PCM1_1X_EN_MODE_MASK_SFT, con1);
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops mtk_dai_pcm_ops = {
+	.hw_params = mtk_dai_pcm_hw_params,
+};
+
+/* dai driver */
+#define MTK_PCM_RATES (SNDRV_PCM_RATE_8000 |\
+		       SNDRV_PCM_RATE_16000 |\
+		       SNDRV_PCM_RATE_32000 |\
+		       SNDRV_PCM_RATE_48000)
+
+#define MTK_PCM_FORMATS (SNDRV_PCM_FMTBIT_S16_LE |\
+			 SNDRV_PCM_FMTBIT_S24_LE |\
+			 SNDRV_PCM_FMTBIT_S32_LE)
+
+static struct snd_soc_dai_driver mtk_dai_pcm_driver[] = {
+	{
+		.name = "PCM 1",
+		.id = MT6878_DAI_PCM_1,
+		.playback = {
+			.stream_name = "PCM 1 Playback",
+			.channels_min = 1,
+			.channels_max = 2,
+			.rates = MTK_PCM_RATES,
+			.formats = MTK_PCM_FORMATS,
+		},
+		.capture = {
+			.stream_name = "PCM 1 Capture",
+			.channels_min = 1,
+			.channels_max = 2,
+			.rates = MTK_PCM_RATES,
+			.formats = MTK_PCM_FORMATS,
+		},
+		.ops = &mtk_dai_pcm_ops,
+		.symmetric_rate = 1,
+		.symmetric_sample_bits = 1,
+	},
+};
+
+int mt6878_dai_pcm_register(struct mtk_base_afe *afe)
+{
+	struct mtk_base_afe_dai *dai;
+
+	dai = devm_kzalloc(afe->dev, sizeof(*dai), GFP_KERNEL);
+	if (!dai)
+		return -ENOMEM;
+
+	dai->dai_drivers = mtk_dai_pcm_driver;
+	dai->num_dai_drivers = ARRAY_SIZE(mtk_dai_pcm_driver);
+	dai->dapm_widgets = mtk_dai_pcm_widgets;
+	dai->num_dapm_widgets = ARRAY_SIZE(mtk_dai_pcm_widgets);
+	dai->dapm_routes = mtk_dai_pcm_routes;
+	dai->num_dapm_routes = ARRAY_SIZE(mtk_dai_pcm_routes);
+
+	list_add(&dai->list, &afe->sub_dais);
+
+	return 0;
+}
diff --git a/sound/soc/mediatek/mt6878/mt6878-interconnection.h b/sound/soc/mediatek/mt6878/mt6878-interconnection.h
new file mode 100644
index 000000000..60dc5c3ff
--- /dev/null
+++ b/sound/soc/mediatek/mt6878/mt6878-interconnection.h
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Mediatek MT6878 audio driver interconnection definition
+ *
+ * Copyright (c) 2023 MediaTek Inc.
+ * Author: Shu-wei Hsu <Shu-wei.Hsu@mediatek.com>
+ */
+
+#ifndef _MT6878_INTERCONNECTION_H_
+#define _MT6878_INTERCONNECTION_H_
+
+/* in port define */
+#define I_CONNSYS_I2S_CH1 0
+#define I_CONNSYS_I2S_CH2 1
+#define I_GAIN0_OUT_CH1 6
+#define I_GAIN0_OUT_CH2 7
+#define I_GAIN1_OUT_CH1 8
+#define I_GAIN1_OUT_CH2 9
+#define I_GAIN2_OUT_CH1 10
+#define I_GAIN2_OUT_CH2 11
+#define I_GAIN3_OUT_CH1 12
+#define I_GAIN3_OUT_CH2 13
+#define I_STF_CH1 14
+#define I_ADDA_UL_CH1 16
+#define I_ADDA_UL_CH2 17
+#define I_ADDA_UL_CH3 18
+#define I_ADDA_UL_CH4 19
+#define I_UL_PROX_CH1 20
+#define I_UL_PROX_CH2 21
+#define I_ADDA_UL_CH5 24
+#define I_ADDA_UL_CH6 25
+#define I_DMIC0_CH1 28
+#define I_DMIC0_CH2 29
+#define I_DMIC1_CH1 30
+#define I_DMIC1_CH2 31
+
+/* in port define >= 32 */
+#define I_32_OFFSET 32
+#define I_DL0_CH1 (32 - I_32_OFFSET)
+#define I_DL0_CH2 (33 - I_32_OFFSET)
+#define I_DL1_CH1 (34 - I_32_OFFSET)
+#define I_DL1_CH2 (35 - I_32_OFFSET)
+#define I_DL2_CH1 (36 - I_32_OFFSET)
+#define I_DL2_CH2 (37 - I_32_OFFSET)
+#define I_DL3_CH1 (38 - I_32_OFFSET)
+#define I_DL3_CH2 (39 - I_32_OFFSET)
+#define I_DL4_CH1 (40 - I_32_OFFSET)
+#define I_DL4_CH2 (41 - I_32_OFFSET)
+#define I_DL5_CH1 (42 - I_32_OFFSET)
+#define I_DL5_CH2 (43 - I_32_OFFSET)
+#define I_DL6_CH1 (44 - I_32_OFFSET)
+#define I_DL6_CH2 (45 - I_32_OFFSET)
+#define I_DL7_CH1 (46 - I_32_OFFSET)
+#define I_DL7_CH2 (47 - I_32_OFFSET)
+#define I_DL8_CH1 (48 - I_32_OFFSET)
+#define I_DL8_CH2 (49 - I_32_OFFSET)
+#define I_DL_24CH_CH1 (54 - I_32_OFFSET)
+#define I_DL_24CH_CH2 (55 - I_32_OFFSET)
+#define I_DL_24CH_CH3 (56 - I_32_OFFSET)
+#define I_DL_24CH_CH4 (57 - I_32_OFFSET)
