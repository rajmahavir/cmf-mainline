+/* topckgen audio test registers used by the MTKAIF calibration */
+#define CKSYS_AUD_TOP_CFG	0x032c
+#define CKSYS_AUD_TOP_MON	0x0330
+
+#define MT6878_MTKAIF_CALIB_PHASES	42	/* phase steps of the codec */
+
