diff --git a/drivers/memory/Kconfig b/drivers/memory/Kconfig
index e5527020f..8558cf462 100644
--- a/drivers/memory/Kconfig
+++ b/drivers/memory/Kconfig
@@ -177,6 +177,17 @@ config MTK_SMI
 	  mainly help enable/disable iommu and control the power domain and
 	  clocks for each local arbiter.
 
+config MTK_SMI_MT6878_NATIVE
+	bool "MT6878 native display SMI Gen3 commons"
+	depends on MTK_SMI=y
+	depends on PM && PM_GENERIC_DOMAINS && OF && HAS_IOMEM
+	help
+	  Built-in support for the native MT6878 display common and its two
+	  sub-commons. This uses the dedicated cold-only display power provider,
+	  explicit runtime supplier ownership and no fabricated clock inputs.
+	  Live bootloader takeover and removal are unsupported. Leave disabled
+	  until the complete native display and IOMMU graph is validated.
+
