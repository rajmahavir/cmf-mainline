diff --git a/drivers/memory/mtk-smi-mt6878.c b/drivers/memory/mtk-smi-mt6878.c
new file mode 100644
index 000000000..8a1b8a115
--- /dev/null
+++ b/drivers/memory/mtk-smi-mt6878.c
@@ -0,0 +1,356 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6878 display SMI Gen3 commons; fixed, built-in native ownership. */
+#include <dt-bindings/power/mediatek,mt6878-power.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/export.h>
+#include <soc/mediatek/mt6878-smi.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_device.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+
+#define MT6878_SMI_SUPPLIERS 2
+#define MT6878_SMI_DEBUG_MISC 0x440
+#define MT6878_SMI_IDLE BIT(0)
+#define MT6878_SMI_DEBUG_S1 0x404
+#define MT6878_SMI_OSTD_COUNT GENMASK(26, 13)
+
+struct mt6878_smi_reg {
+	u32 offset;
+	u32 value;
+};
+
+struct mt6878_smi_profile {
+	resource_size_t address;
+	unsigned int suppliers;
+	const struct mt6878_smi_reg *init;
+	unsigned int init_count;
+	unsigned int first_supplier;
+	const char *supplier_compatible;
+};
+
+struct mt6878_smi {
+	struct device *dev;
+	void __iomem *base;
+	const struct mt6878_smi_profile *profile;
+	struct device *suppliers[MT6878_SMI_SUPPLIERS];
+	struct device_link *links[MT6878_SMI_SUPPLIERS];
+	bool held[MT6878_SMI_SUPPLIERS];
+	bool active;
+};
+
+/* Non-padding entries from the vendor MT6878 common IDs 0, 3, 4 and 9. */
+static const struct mt6878_smi_reg mt6878_smi_common_init[] = {
+	{ 0x100, 0xb }, { 0x220, 0x4444 }, { 0x234, 0xe100e10 },
+	{ 0x238, 0x506090a }, { 0x23c, 0x506090a }, { 0x300, 0x4f1 },
+	{ 0x444, 0x1 },
+};
+
+static const struct mt6878_smi_reg mt6878_smi_sub_init[] = {
+	{ 0x100, 0xa }, { 0x244, 0x2105 }, { 0x444, 0x1 },
+};
+
+static const struct mt6878_smi_reg mt6878_smi_gce_init[] = {
+	{ 0x100, 0xa }, { 0x244, 0x2146 }, { 0x444, 0x1 },
+};
+
+static const struct mt6878_smi_profile mt6878_smi_profiles[] = {
+	{ .address = 0x1e801000, .suppliers = 2, .init = mt6878_smi_common_init,
+	  .init_count = ARRAY_SIZE(mt6878_smi_common_init), .first_supplier = 1,
+	  .supplier_compatible = "mediatek,mt6878-smi-sub-common-native" },
+	{ .address = 0x1e807000, .init = mt6878_smi_sub_init,
+	  .init_count = ARRAY_SIZE(mt6878_smi_sub_init) },
+	{ .address = 0x1e808000, .init = mt6878_smi_sub_init,
+	  .init_count = ARRAY_SIZE(mt6878_smi_sub_init) },
+	{ .address = 0x1e809000, .suppliers = 1, .init = mt6878_smi_gce_init,
+	  .init_count = ARRAY_SIZE(mt6878_smi_gce_init),
+	  .supplier_compatible = "mediatek,mt6878-smi-common-native" },
+};
+
+static int mt6878_smi_domain(struct device_node *node, struct device_node **domain)
+{
+	struct of_phandle_args args;
+	int ret;
+
+	if (of_count_phandle_with_args(node, "power-domains", "#power-domain-cells") != 1)
+		return -EINVAL;
+	ret = of_parse_phandle_with_args(node, "power-domains", "#power-domain-cells", 0, &args);
+	if (ret)
+		return ret;
+	if (!of_device_is_available(args.np) ||
+	    !of_device_is_compatible(args.np, "mediatek,mt6878-display-power-controller") ||
+	    args.args_count != 1 || args.args[0] != MT6878_POWER_DOMAIN_MM_INFRA) {
+		of_node_put(args.np);
+		return -EINVAL;
+	}
+	*domain = args.np;
+	return 0;
+}
+
+static void mt6878_smi_release_links(void *data)
+{
+	struct mt6878_smi *smi = data;
+	int i;
+
+	/* Live removal is unsupported; normal use is a fixed built-in provider. */
+	WARN_ON(smi->active || smi->held[0] || smi->held[1]);
+	for (i = MT6878_SMI_SUPPLIERS - 1; i >= 0; i--) {
+		if (smi->links[i])
+			device_link_del(smi->links[i]);
+		put_device(smi->suppliers[i]);
+	}
+}
+
+static int mt6878_smi_link_suppliers(struct mt6878_smi *smi, struct device_node *domain)
+{
+	struct device *dev = smi->dev;
+	struct device_node *node;
+	unsigned int i;
+	int ret;
+
+	if (!smi->profile->suppliers)
+		return of_find_property(dev->of_node, "mediatek,smi-suppliers", NULL) ? -EINVAL : 0;
+	if (of_count_phandle_with_args(dev->of_node, "mediatek,smi-suppliers", NULL) !=
+	    (int)smi->profile->suppliers)
+		return -EINVAL;
+	for (i = 0; i < smi->profile->suppliers; i++) {
+		unsigned int profile_id = smi->profile->first_supplier + i;
+		struct device_node *supplier_domain = NULL;
+		struct platform_device *supplier;
+		struct resource resource;
+
+		node = of_parse_phandle(dev->of_node, "mediatek,smi-suppliers", i);
+		if (!node)
+			return -EINVAL;
+		if (node == dev->of_node || !of_device_is_available(node) ||
+		    !of_device_is_compatible(node, smi->profile->supplier_compatible)) {
+			ret = -EINVAL;
+			goto put_node;
+		}
+		ret = of_address_to_resource(node, 0, &resource);
+		if (ret)
+			goto put_node;
+		if (resource.start != mt6878_smi_profiles[profile_id].address ||
+		    resource_size(&resource) != 0x1000) {
+			ret = -EINVAL;
+			goto put_node;
+		}
+		ret = mt6878_smi_domain(node, &supplier_domain);
+		if (ret)
+			goto put_node;
+		ret = supplier_domain == domain ? 0 : -EINVAL;
+		of_node_put(supplier_domain);
+		if (ret)
+			goto put_node;
+		supplier = of_find_device_by_node(node);
+		of_node_put(node);
+		if (!supplier)
+			return -EPROBE_DEFER;
+		smi->suppliers[i] = &supplier->dev;
+		if (!device_is_bound(&supplier->dev))
+			return -EPROBE_DEFER;
+		if (!supplier->dev.pm_domain || !pm_runtime_enabled(&supplier->dev))
+			return -EOPNOTSUPP;
+		/* Explicit runtime gets reject EACCES; automatic link PM ignores it. */
+		smi->links[i] = device_link_add(dev, &supplier->dev, DL_FLAG_STATELESS);
+		if (!smi->links[i])
+			return -ENODEV;
+	}
+	return 0;
+
+put_node:
+	of_node_put(node);
+	return ret;
+}
+
+static void mt6878_smi_put_suppliers(struct mt6878_smi *smi)
+{
+	int i, ret;
+
+	for (i = MT6878_SMI_SUPPLIERS - 1; i >= 0; i--) {
+		if (!smi->held[i])
+			continue;
+		smi->held[i] = false;
+		ret = pm_runtime_put_sync(smi->suppliers[i]);
+		/* A failed idle leaves the supplier active; its usage ref is dropped. */
+		if (ret < 0)
+			dev_dbg(smi->dev, "supplier %d remains active (%d)\n", i, ret);
+	}
+}
+
+static int mt6878_smi_resume(struct device *dev)
+{
+	struct mt6878_smi *smi = dev_get_drvdata(dev);
+	unsigned int i;
+	int ret;
+
+	if (pm_runtime_is_irq_safe(dev))
+		return -EOPNOTSUPP;
+	if (smi->active)
+		return 0;
+	for (i = 0; i < smi->profile->suppliers; i++) {
+		ret = pm_runtime_resume_and_get(smi->suppliers[i]);
+		if (ret < 0) {
+			mt6878_smi_put_suppliers(smi);
+			return ret;
+		}
+		smi->held[i] = true;
+	}
+	/* The exact native MM_INFRA genpd owns power before this callback. */
+	for (i = 0; i < 8; i++)
+		writel_relaxed(0, smi->base + 0x104 + i * 4);
+	for (i = 0; i < smi->profile->init_count; i++)
+		writel_relaxed(smi->profile->init[i].value,
+			       smi->base + smi->profile->init[i].offset);
+	/* Complete configuration writes before exposing this bank as active. */
+	wmb();
+	smi->active = true;
+	return 0;
+}
+
+/*
+ * Stock MT6878 uses ID 9 input 1's outstanding count in its DISP
+ * power-off check. Use it as an additional veto on the aggregate idle
+ * bit, without assuming it accounts for every GCE-D transaction.
+ */
+static bool mt6878_smi_gce_is_quiet(void __iomem *base)
+{
+	if (!(readl(base + MT6878_SMI_DEBUG_MISC) & MT6878_SMI_IDLE))
+		return false;
+	if (readl(base + MT6878_SMI_DEBUG_S1) & MT6878_SMI_OSTD_COUNT)
+		return false;
+
+	return readl(base + MT6878_SMI_DEBUG_MISC) & MT6878_SMI_IDLE;
+}
+
+/*
+ * The mailbox holds the supplier through its runtime PM device link.
+ * This can run under a channel spinlock, so never resume the supplier.
+ */
+int mt6878_smi_gce_wait_idle(struct device *dev)
+{
+	struct mt6878_smi *smi;
+	bool quiet;
+	int ret;
+
+	if (!dev || !dev->of_node ||
+	    !of_device_is_compatible(dev->of_node, "mediatek,mt6878-smi-gce-sub-common-native"))
+		return -EINVAL;
+	if (pm_runtime_get_if_active(dev) <= 0)
+		return -EHOSTDOWN;
+
+	smi = dev_get_drvdata(dev);
+	if (!smi || !smi->active || smi->profile->address != 0x1e809000)
+		ret = -ENODEV;
+	else
+		ret = read_poll_timeout_atomic(mt6878_smi_gce_is_quiet, quiet, quiet,
+					       10, 1000, false, smi->base);
+
+	pm_runtime_put_noidle(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6878_smi_gce_wait_idle);
+
+static int mt6878_smi_suspend(struct device *dev)
+{
+	struct mt6878_smi *smi = dev_get_drvdata(dev);
+	u32 val;
+	int ret;
+
+	if (pm_runtime_is_irq_safe(dev))
+		return -EOPNOTSUPP;
+	if (!smi->active)
+		return 0;
+	ret = readl_poll_timeout(smi->base + MT6878_SMI_DEBUG_MISC, val,
+				 val & MT6878_SMI_IDLE, 10, 1000);
+	if (ret)
+		return -EBUSY;
+	smi->active = false;
+	mt6878_smi_put_suppliers(smi);
+	return 0;
+}
+
+static int mt6878_smi_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	const struct mt6878_smi_profile *role = of_device_get_match_data(dev);
+	struct device_node *domain = NULL;
+	struct resource *resource;
+	struct mt6878_smi *smi;
+	unsigned int i;
+	int ret;
+
+	if (!role || !dev->pm_domain)
+		return -EINVAL;
+	if (of_find_property(dev->of_node, "clocks", NULL) ||
+	    of_find_property(dev->of_node, "clock-names", NULL))
+		return -EINVAL;
+	resource = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!resource || resource_size(resource) != 0x1000 ||
+	    platform_get_resource(pdev, IORESOURCE_MEM, 1))
+		return -EINVAL;
+	smi = devm_kzalloc(dev, sizeof(*smi), GFP_KERNEL);
+	if (!smi)
+		return -ENOMEM;
+	smi->dev = dev;
+	for (i = 0; i < ARRAY_SIZE(mt6878_smi_profiles); i++)
+		if (mt6878_smi_profiles[i].suppliers == role->suppliers &&
+		    mt6878_smi_profiles[i].address == resource->start)
+			smi->profile = &mt6878_smi_profiles[i];
+	if (!smi->profile)
+		return -EINVAL;
+	ret = mt6878_smi_domain(dev->of_node, &domain);
+	if (ret)
+		return ret;
+	smi->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(smi->base)) {
+		ret = PTR_ERR(smi->base);
+		goto put_domain;
+	}
+	ret = devm_add_action_or_reset(dev, mt6878_smi_release_links, smi);
+	if (ret)
+		goto put_domain;
+	ret = mt6878_smi_link_suppliers(smi, domain);
+	if (ret)
+		goto put_domain;
+	platform_set_drvdata(pdev, smi);
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		platform_set_drvdata(pdev, NULL);
+
+put_domain:
+	of_node_put(domain);
+	return ret;
+}
+
+static const struct dev_pm_ops mt6878_smi_pm_ops = {
+	RUNTIME_PM_OPS(mt6878_smi_suspend, mt6878_smi_resume, NULL)
+};
+
+static const struct of_device_id mt6878_smi_of_match[] = {
+	{ .compatible = "mediatek,mt6878-smi-common-native", .data = &mt6878_smi_profiles[0] },
+	{ .compatible = "mediatek,mt6878-smi-sub-common-native", .data = &mt6878_smi_profiles[1] },
+	{
+		.compatible = "mediatek,mt6878-smi-gce-sub-common-native",
+		.data = &mt6878_smi_profiles[3],
+	},
+	{ /* sentinel */ }
+};
+
+static struct platform_driver mt6878_smi_driver = {
+	.probe = mt6878_smi_probe,
+	.driver = {
+		.name = "mt6878-smi-native",
+		.of_match_table = mt6878_smi_of_match,
+		.pm = &mt6878_smi_pm_ops,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(mt6878_smi_driver);
