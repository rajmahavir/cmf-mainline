From 1fc641503c03c66f941c9ae68240e04f96e77fa5 Mon Sep 17 00:00:00 2001
From: CMF mainline <cmf-mainline@users.noreply.github.com>
Date: Fri, 27 Nov 2026 09:51:46 +0000
Subject: [PATCH] ASoC: codecs: aw88261: load the tuning file late if missing
 at probe

When the driver is built in, its tuning file usually lives on the root
filesystem, which is not mounted yet when the codec probes. Failing the
component probe then takes the whole sound card down (microphones, earpiece
and call audio included), and rebinding the card later is not safe.

Treat a missing file (-ENOENT) as not yet available: register the codec,
keep the amplifier off and retry quietly every 5 s for 5 minutes, and once
more before each playback until the file loads. The background retry
matters: on the CMF Phone 1 the amplifier fails to start when its
configuration was written just before the start, so a load at playback
time loses that first playback.
---
 sound/soc/codecs/aw88261.c | 69 +++++++++++++++++++++++++++++++++++---
 sound/soc/codecs/aw88261.h |  3 ++
 2 files changed, 67 insertions(+), 5 deletions(-)

diff --git a/sound/soc/codecs/aw88261.c b/sound/soc/codecs/aw88261.c
index 549783d3e..e6589b060 100644
--- a/sound/soc/codecs/aw88261.c
+++ b/sound/soc/codecs/aw88261.c
@@ -8,6 +8,7 @@
 // Author: Weidong Wang <wangweidong.a@awinic.com>
 //
 
+#include <linux/devm-helpers.h>
 #include <linux/i2c.h>
 #include <linux/firmware.h>
 #include <linux/bitops.h>
@@ -1032,12 +1033,21 @@ static const struct snd_kcontrol_new aw88261_controls[] = {
 		aw88261_profile_get, aw88261_profile_set),
 };
 
+static int aw88261_request_firmware_file(struct aw88261 *aw88261, bool quiet);
+
 static int aw88261_playback_event(struct snd_soc_dapm_widget *w,
 				struct snd_kcontrol *k, int event)
 {
 	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
 	struct aw88261 *aw88261 = snd_soc_component_get_drvdata(component);
 
+	if (event == SND_SOC_DAPM_PRE_PMU && !READ_ONCE(aw88261->aw_cfg)) {
+		mutex_lock(&aw88261->fw_lock);
+		if (!aw88261->aw_cfg && !aw88261_request_firmware_file(aw88261, true))
+			dev_info(aw88261->aw_pa->dev, "tuning file loaded on playback\n");
+		mutex_unlock(&aw88261->fw_lock);
+	}
+
 	mutex_lock(&aw88261->lock);
 	switch (event) {
 	case SND_SOC_DAPM_PRE_PMU:
@@ -1150,7 +1160,7 @@ static int aw88261_dev_init(struct aw88261 *aw88261, struct aw_container *aw_cfg
 	return 0;
 }
 
-static int aw88261_request_firmware_file(struct aw88261 *aw88261)
+static int aw88261_request_firmware_file(struct aw88261 *aw88261, bool quiet)
 {
 	const struct firmware *cont = NULL;
 	struct aw_container *aw_cfg;
@@ -1163,10 +1173,16 @@ static int aw88261_request_firmware_file(struct aw88261 *aw88261)
 	if (ret)
 		fw_name = AW88261_ACF_FILE;
 
-	ret = request_firmware(&cont, fw_name, aw88261->aw_pa->dev);
-	if (ret)
+	if (quiet)
+		ret = firmware_request_nowarn(&cont, fw_name, aw88261->aw_pa->dev);
+	else
+		ret = request_firmware(&cont, fw_name, aw88261->aw_pa->dev);
+	if (ret) {
+		if (quiet)
+			return ret;
 		return dev_err_probe(aw88261->aw_pa->dev, ret,
 					"load [%s] failed!", fw_name);
+	}
 
 	dev_info(aw88261->aw_pa->dev, "loaded %s - size: %zu\n",
 			fw_name, cont ? cont->size : 0);
@@ -1198,14 +1214,53 @@ static int aw88261_request_firmware_file(struct aw88261 *aw88261)
 	return ret;
 }
 
+/*
+ * Retry the tuning file every 5 s for 5 minutes after boot. Loading it well
+ * before the first playback matters: the amplifier fails to start when its
+ * configuration was written just before (seen on the CMF Phone 1).
+ */
+#define AW88261_FW_RETRY_MS	5000
+#define AW88261_FW_RETRIES	60
+
+static void aw88261_fw_work(struct work_struct *work)
+{
+	struct aw88261 *aw88261 = container_of(to_delayed_work(work),
+					       struct aw88261, fw_work);
+	int ret = 0;
+
+	mutex_lock(&aw88261->fw_lock);
+	if (!aw88261->aw_cfg) {
+		ret = aw88261_request_firmware_file(aw88261, true);
+		if (!ret)
+			dev_info(aw88261->aw_pa->dev, "tuning file loaded\n");
+	}
+	mutex_unlock(&aw88261->fw_lock);
+
+	if (ret == -ENOENT && ++aw88261->fw_tries < AW88261_FW_RETRIES)
+		schedule_delayed_work(&aw88261->fw_work,
+				      msecs_to_jiffies(AW88261_FW_RETRY_MS));
+}
+
 static int aw88261_codec_probe(struct snd_soc_component *component)
 {
 	struct snd_soc_dapm_context *dapm = snd_soc_component_to_dapm(component);
 	struct aw88261 *aw88261 = snd_soc_component_get_drvdata(component);
 	int ret;
 
-	ret = aw88261_request_firmware_file(aw88261);
-	if (ret)
+	mutex_lock(&aw88261->fw_lock);
+	ret = aw88261_request_firmware_file(aw88261, false);
+	mutex_unlock(&aw88261->fw_lock);
+	if (ret == -ENOENT) {
+		/*
+		 * The tuning file is often not available this early (built-in
+		 * driver, firmware on the root filesystem). Register the codec
+		 * anyway so the rest of the sound card works, and retry in the
+		 * background and on playback; the amplifier stays off until then.
+		 */
+		dev_warn(aw88261->aw_pa->dev, "tuning file not found yet, retrying\n");
+		schedule_delayed_work(&aw88261->fw_work,
+				      msecs_to_jiffies(AW88261_FW_RETRY_MS));
+	} else if (ret)
 		return dev_err_probe(aw88261->aw_pa->dev, ret,
 				"aw88261_request_firmware_file failed\n");
 
@@ -1312,6 +1367,10 @@ static int aw88261_i2c_probe(struct i2c_client *i2c)
 	aw88261->rxr_slotvld_mask = 1 << AW88261_I2S_RXR_SLOTVLD_START_BIT;
 
 	mutex_init(&aw88261->lock);
+	mutex_init(&aw88261->fw_lock);
+	ret = devm_delayed_work_autocancel(&i2c->dev, &aw88261->fw_work, aw88261_fw_work);
+	if (ret)
+		return ret;
 
 	i2c_set_clientdata(i2c, aw88261);
 
diff --git a/sound/soc/codecs/aw88261.h b/sound/soc/codecs/aw88261.h
index 270ccf375..e8cc8348e 100644
--- a/sound/soc/codecs/aw88261.h
+++ b/sound/soc/codecs/aw88261.h
@@ -590,6 +590,9 @@ enum {
 struct aw88261 {
 	struct aw_device *aw_pa;
 	struct mutex lock;
+	struct mutex fw_lock;		/* serializes late tuning-file loads */
+	struct delayed_work fw_work;
+	unsigned int fw_tries;
 	struct gpio_desc *reset_gpio;
 	struct regmap *regmap;
 	struct aw_container *aw_cfg;
-- 
2.53.0

