+static int scpsys_retain_boot(struct scpsys_domain *pd)
+{
+	unsigned int vote = pd->hwv_data ? CLK_MT6878_MMINFRA_VOTE : CLK_MT6878_DISP_VOTE;
+	unsigned int i;
+	int ret;
+
+	/* The native binding has no supply, avoiding regulator state changes. */
+	if (pd->supply || pd->num_clks != 1)
+		return -EINVAL;
+	ret = mt6878_display_vote_check_boot(pd->clks[0].clk, vote);
+	if (ret)
+		return ret;
+	ret = scpsys_boot_check(pd, pd->scpsys->boot_on_adoption);
+	if (ret)
+		return ret;
+	if (!scpsys_clock_is_boot_held(pd->clks[0].clk))
+		return -EHOSTDOWN;
+	if (pd->data) {
+		ret = scpsys_display_gates(pd, false);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < pd->num_subsys_clks; i++) {
+		/*
+		 * LK never uses MDP, so MDP_SMI0 is gated at boot (Stage 61,
+		 * MDP CG 0x1f000100 = 0xffffffff). Adoption ungates such a
+		 * subsystem gate below instead of requiring a boot hold.
+		 */
+		if (!scpsys_clock_is_boot_held(pd->subsys_clks[i].clk) &&
+		    !pd->scpsys->boot_on_adoption)
+			return -EHOSTDOWN;
+	}
+
+	/* After this point a failed adoption retains handles until reboot. */
+	pd->boot_retained = true;
+	pd->scpsys->boot_acquisition_started = true;
+	ret = clk_bulk_prepare_enable(pd->num_clks, pd->clks);
+	if (ret)
+		goto fault;
+	if (pd->hwv_data)
+		pd->hwv_clks_held = true;
+	else
+		pd->display_clks_held = true;
+
+	ret = clk_bulk_prepare_enable(pd->num_subsys_clks, pd->subsys_clks);
+	if (ret)
+		goto fault;
+	if (pd->scpsys->boot_on_adoption && pd->hwv_data) {
+		ret = scpsys_adopt_boot_hwv(pd);
+		if (ret)
+			goto fault;
+	}
+	ret = scpsys_boot_is_on(pd);
+	if (ret)
+		goto fault;
+
+	if (pd->hwv_data) {
+		pd->hwv_supply_held = true;
+		pd->hwv_on = true;
+	} else {
+		pd->display_supply_held = true;
+		pd->display_subsys_held = true;
+		pd->display_on = true;
+	}
+	if (pd->hwv_data || !pd->data) {
+		pd->genpd.flags |= GENPD_FLAG_ALWAYS_ON;
+		pd->genpd.power_on = scpsys_boot_power_on;
+		pd->genpd.power_off = scpsys_boot_power_off;
+	} else {
+		/* Stage 82: real DISP callbacks; OFF gated by disp_power_cycle. */
+		pd->genpd.power_on = scpsys_display_power_on;
+		pd->genpd.power_off = scpsys_display_power_off;
+		/*
+		 * Stage 84b: sync_state never runs for this provider (the DSC node
+		 * is a DT consumer without a bound driver), so genpd's boot stay_on
+		 * would pin DISP on forever. disp_power_cycle (default off) already
+		 * refuses OFF until enabled at runtime.
+		 */
+		pd->genpd.flags |= GENPD_FLAG_NO_STAY_ON;
+	}
+	return 0;
+
+fault:
+	WRITE_ONCE(pd->scpsys->display_faulted, true);
+	WRITE_ONCE(mt6878_boot_power_failed, true);
+	return ret;
+}
+
+static int scpsys_display_poll(struct scpsys_domain *pd, u32 mask, u32 expected)
+{
+	u32 val;
+
+	return regmap_read_poll_timeout(pd->scpsys->base, pd->data->ctl_offs,
+					val, (val & mask) == expected,
+					MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+}
+
+static int scpsys_display_update(struct scpsys_domain *pd, u32 mask, u32 value)
+{
+	return regmap_update_bits(pd->scpsys->base, pd->data->ctl_offs, mask, value);
+}
+
+/* Only the fixed MT6878 DISP table uses these callbacks. */
+static int scpsys_display_bus(struct scpsys_domain *pd, bool protect)
+{
+	const struct scpsys_bus_prot_data *bpd = &pd->data->bp_cfg[0];
+	struct regmap *map = scpsys_bus_protect_get_regmap(pd, bpd);
+	struct regmap *sta = scpsys_bus_protect_get_sta_regmap(pd, bpd);
+	u32 val;
+	int ret;
+
+	ret = regmap_write(map, protect ? bpd->bus_prot_set : bpd->bus_prot_clr,
+			   bpd->bus_prot_set_clr_mask);
+	/* The vendor DISP table deliberately omits the clear ACK. */
+	if (ret || !protect)
+		return ret;
+	return regmap_read_poll_timeout(sta, bpd->bus_prot_sta, val,
+					(val & bpd->bus_prot_sta_mask) == bpd->bus_prot_sta_mask,
+					MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+}
+
+static int scpsys_display_sram(struct scpsys_domain *pd, bool on)
+{
+	u32 bits = pd->data->sram_pdn_bits;
+	int ret;
+
+	ret = scpsys_display_update(pd, bits, on ? 0 : bits);
+	if (ret)
+		return ret;
+	bits = pd->data->sram_pdn_ack_bits;
+	return scpsys_display_poll(pd, bits, on ? 0 : bits);
+}
+
+/*
+ * Stage 85: LK leaves every display SMI larb port in IOMMU bypass, and the
+ * native scanout pool relies on it. A DISP power cycle resets NON_SEC_CON
+ * (0x380 + 4 * port) bit 0 (MMU_EN) to 1. Restore bypass after power-on.
+ */
+static void scpsys_display_larb_bypass(struct scpsys_domain *pd)
+{
+	static const struct { phys_addr_t base; unsigned int ports; } larbs[] = {
+		{ 0x1401e000, 7 }, { 0x1401f000, 6 },
+	};
+	unsigned int i, p;
+
+	for (i = 0; i < ARRAY_SIZE(larbs); i++) {
+		void __iomem *base = ioremap(larbs[i].base, 0x400);
+
+		if (!base)
+			continue;
+		for (p = 0; p < larbs[i].ports; p++)
+			writel(0, base + 0x380 + 4 * p);
+		iounmap(base);
+	}
+	dev_info(pd->scpsys->dev, "Stage 85: larb0/larb1 ports restored to bypass\n");
+}
+
+static int scpsys_display_power_on(struct generic_pm_domain *genpd)
+{
+	struct scpsys_domain *pd = to_scpsys_domain(genpd);
+	u32 ack = pd->data->sta_mask | pd->data->sta2nd_mask;
+	int ret;
+
+	if (READ_ONCE(pd->scpsys->display_faulted))
+		return -EIO;
+	if (pd->display_on)
+		return 0;
+	ret = scpsys_display_gates(pd, true);
+	if (ret)
+		return scpsys_display_fault(pd, ret);
+	ret = scpsys_regulator_enable(pd->supply);
+	if (ret)
+		return ret;
+	pd->display_supply_held = true;
+	ret = clk_bulk_prepare_enable(pd->num_clks, pd->clks);
+	if (ret)
+		goto fault;
+	pd->display_clks_held = true;
+	ret = scpsys_display_update(pd, PWR_ON_BIT, PWR_ON_BIT);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_update(pd, PWR_ON_2ND_BIT, PWR_ON_2ND_BIT);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_poll(pd, ack, ack);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_update(pd, PWR_CLK_DIS_BIT, 0);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_update(pd, PWR_ISO_BIT, 0);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_update(pd, PWR_RST_B_BIT, PWR_RST_B_BIT);
+	if (ret)
+		goto fault;
+	ret = clk_bulk_prepare_enable(pd->num_subsys_clks, pd->subsys_clks);
+	if (ret)
+		goto fault;
+	pd->display_subsys_held = true;
+	ret = scpsys_display_sram(pd, true);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_bus(pd, false);
+	if (ret)
+		goto fault;
+	pd->display_on = true;
+	if (pd->boot_retained) {
+		/* The vendor DISP CLR has no ACK wait; Android saw it clear in ~7 ms. */
+		usleep_range(10000, 12000);
+		scpsys_display_larb_bypass(pd);
+		/* Stage 86: re-open MMSYS (firmware display-VA) and re-translate RDMA0. */
+		mt6878_disp_iommu_reapply();
+		dev_info(pd->scpsys->dev, "Stage 82: DISP powered on\n");
+	}
+	return 0;
+
+fault:
+	return scpsys_display_fault(pd, ret);
+}
+
+static int scpsys_display_power_off(struct generic_pm_domain *genpd)
+{
+	struct scpsys_domain *pd = to_scpsys_domain(genpd);
+	u32 ack = pd->data->sta_mask | pd->data->sta2nd_mask;
+	int ret;
+
+	if (READ_ONCE(pd->scpsys->display_faulted))
+		return -EIO;
+	if (pd->boot_retained && pd->display_on) {
+		int held;
+
+		if (!READ_ONCE(disp_power_cycle))
+			return -EBUSY;
+		/*
+		 * Stage 86b: after a power cycle the MMSYS crossbar stays locked
+		 * until the display-VA re-run, which needs translated scanout.
+		 * Never power off before the boot-time attach has passed.
+		 */
+		if (!mt6878_disp_iommu_attached())
+			return -EBUSY;
+		/* Refuse before any hardware access unless only our SMI gates remain. */
+		held = mt6878_display_gates_held(pd->subsys_clks[0].clk, false);
+		if (held != pd->num_subsys_clks) {
+			dev_info(pd->scpsys->dev, "Stage 82: DISP off refused, %d gates held (need %u)\n",
+				 held, pd->num_subsys_clks);
+			mt6878_display_gates_held(pd->subsys_clks[0].clk, true);
+			return -EBUSY;
+		}
+		dev_info(pd->scpsys->dev, "Stage 82: DISP power off\n");
+	}
+	ret = scpsys_display_gates(pd, !pd->display_on);
+	if (ret)
+		goto fault;
+	if (!pd->display_on)
+		return 0;
+	ret = scpsys_display_bus(pd, true);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_sram(pd, false);
+	if (ret)
+		goto fault;
+	clk_bulk_disable_unprepare(pd->num_subsys_clks, pd->subsys_clks);
+	pd->display_subsys_held = false;
+	/* Void unprepare cannot report a failed close: consult provider state. */
+	ret = scpsys_display_gates(pd, true);
+	if (ret)
+		goto fault;
+	if (pd->boot_retained) {
+		ret = mt6878_display_gates_power_lost(pd->subsys_clks[0].clk);
+		if (ret)
+			goto fault;
+	}
+	ret = scpsys_display_update(pd, PWR_ISO_BIT, PWR_ISO_BIT);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_update(pd, PWR_CLK_DIS_BIT, PWR_CLK_DIS_BIT);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_update(pd, PWR_RST_B_BIT, 0);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_update(pd, PWR_ON_2ND_BIT, 0);
+	if (ret)
+		goto fault;
+	ret = scpsys_display_update(pd, PWR_ON_BIT, 0);
+	if (ret)
+		goto fault;
+	/* Both ACKs must be clear; one missing ACK is not a powered-off domain. */
+	ret = scpsys_display_poll(pd, ack, 0);
+	if (ret)
+		goto fault;
+	clk_bulk_disable_unprepare(pd->num_clks, pd->clks);
+	pd->display_clks_held = false;
+	ret = scpsys_regulator_disable(pd->supply);
+	if (ret)
+		goto fault;
+	pd->display_supply_held = false;
+	pd->display_on = false;
+	return 0;
+
+fault:
+	return scpsys_display_fault(pd, ret);
+}
