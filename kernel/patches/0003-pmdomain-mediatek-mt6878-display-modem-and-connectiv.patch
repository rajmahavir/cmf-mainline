+/* Runtime-PM consumers must pass this even when genpd still reports ON. */
+static int scpsys_display_start(struct device *dev)
+{
+	struct scpsys_domain *pd;
+
+	if (!dev->pm_domain)
+		return -EINVAL;
+	pd = to_scpsys_domain(pd_to_genpd(dev->pm_domain));
+	if (READ_ONCE(pd->scpsys->display_faulted) || READ_ONCE(pd->hwv_faulted))
+		return -EIO;
+	if (pd->hwv_data)
+		return READ_ONCE(pd->hwv_on) && READ_ONCE(pd->hwv_supply_held) &&
+			READ_ONCE(pd->hwv_clks_held) ? 0 : -EHOSTDOWN;
+	return READ_ONCE(pd->display_on) && READ_ONCE(pd->display_supply_held) &&
+		READ_ONCE(pd->display_clks_held) && READ_ONCE(pd->display_subsys_held) ?
+		0 : -EHOSTDOWN;
+}
