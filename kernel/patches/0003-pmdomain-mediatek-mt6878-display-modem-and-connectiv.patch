+static int scpsys_display_sleep_check(struct device *dev, struct scpsys_domain **out)
+{
+	struct scpsys_domain *pd;
+
+	if (!dev->pm_domain)
+		return -EINVAL;
+	pd = to_scpsys_domain(pd_to_genpd(dev->pm_domain));
+	if (READ_ONCE(pd->scpsys->display_faulted) || READ_ONCE(pd->hwv_faulted))
+		return -EIO;
+	if (out)
+		*out = pd;
+	return 0;
+}
