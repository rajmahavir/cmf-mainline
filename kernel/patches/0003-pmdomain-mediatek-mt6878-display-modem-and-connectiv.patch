+static bool scpsys_clock_is_boot_held(struct clk *clk)
+{
+	struct clk_hw *hw = __clk_get_hw(clk);
+
+	return hw && (clk_hw_get_flags(hw) & CLK_IS_CRITICAL) &&
+	       clk_hw_is_prepared(hw) && __clk_is_enabled(clk);
+}
