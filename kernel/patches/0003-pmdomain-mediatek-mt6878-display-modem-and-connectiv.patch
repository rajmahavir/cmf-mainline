+	pd->genpd_sleep_prepare = pd->genpd.domain.ops.prepare;
+	pd->genpd.domain.ops.prepare = scpsys_display_sleep_prepare;
+	pd->genpd.domain.ops.suspend_noirq = scpsys_display_sleep_suspend_noirq;
+	pd->genpd.domain.ops.resume_noirq = scpsys_display_sleep_resume_noirq;
+	pd->genpd.domain.ops.freeze_noirq = scpsys_display_sleep_refuse;
+	pd->genpd.domain.ops.thaw_noirq = scpsys_display_sleep_refuse;
