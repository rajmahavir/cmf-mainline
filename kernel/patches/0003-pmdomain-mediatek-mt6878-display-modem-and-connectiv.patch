+/* MT6878 native DISP only: failures retain resources until reboot. */
+static int scpsys_display_fault(struct scpsys_domain *pd, int ret)
+{
+	WRITE_ONCE(pd->scpsys->display_faulted, true);
+	dev_err(pd->scpsys->dev, "native DISP failed (%d); hierarchy retained until reboot\n", ret);
+	return ret;
+}
