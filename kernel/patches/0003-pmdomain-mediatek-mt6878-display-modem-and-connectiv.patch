+static int scpsys_display_gates(struct scpsys_domain *pd, bool idle)
+{
+	int i, ret;
+
+	if (pd->num_subsys_clks != 2)
+		return -EINVAL;
+	for (i = 0; i < pd->num_subsys_clks; i++) {
+		ret = mt6878_display_gates_check(pd->subsys_clks[i].clk, i, idle);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int scpsys_boot_hwv_state(struct scpsys_domain *pd, bool *voted)
+{
+	const struct scpsys_hwv_domain_data *hwv = pd->hwv_data;
+	u32 regs[] = { hwv->done, hwv->set, hwv->en, hwv->set_sta, hwv->clr_sta };
+	u32 values[ARRAY_SIZE(regs)], mask = BIT(hwv->setclr_bit);
+	int ret;
+
+	ret = regmap_multi_reg_read(pd->hwv_base, regs, values, ARRAY_SIZE(regs));
+	if (ret)
+		return ret;
+	if (!(values[0] & mask) || ((values[1] ^ values[2]) & mask) ||
+	    ((values[3] | values[4]) & mask))
+		return -EHOSTDOWN;
+
+	*voted = values[2] & mask;
+	return 0;
+}
+
+static int scpsys_boot_check(struct scpsys_domain *pd, bool allow_unvoted)
+{
+	const struct scpsys_bus_prot_data *bpd;
+	u32 value, required, blocked, sta_mask;
+	bool voted;
+	int ret;
+
+	if (pd->hwv_data) {
+		ret = scpsys_boot_hwv_state(pd, &voted);
+		if (ret)
+			return ret;
+		return voted || allow_unvoted ? 0 : -EHOSTDOWN;
+	}
+
+	required = PWR_RST_B_BIT | PWR_ON_BIT | PWR_ON_2ND_BIT |
+		   pd->data->sta_mask | pd->data->sta2nd_mask;
+	blocked = PWR_ISO_BIT | PWR_CLK_DIS_BIT | pd->data->sram_pdn_bits |
+		  pd->data->sram_pdn_ack_bits;
+	ret = regmap_read(pd->scpsys->base, pd->data->ctl_offs, &value);
+	if (ret)
+		return ret;
+	if ((value & (required | blocked)) != required)
+		return -EHOSTDOWN;
+
+	bpd = &pd->data->bp_cfg[0];
+	sta_mask = bpd->bus_prot_sta_mask;
+	if (pd->scpsys->boot_on_adoption) {
+		/* MT6878 DISP protection request lives in INFRACFG. */
+		ret = regmap_read(scpsys_bus_protect_get_regmap(pd, bpd), 0x0c10, &value);
+		if (ret)
+			return ret;
+		if (value & bpd->bus_prot_set_clr_mask)
+			return -EBUSY;
+
+		/* Trial exception for the observed retained-LK status only. */
+		sta_mask &= ~BIT(18);
+	}
+	ret = regmap_read(scpsys_bus_protect_get_sta_regmap(pd, bpd),
+			  bpd->bus_prot_sta, &value);
+	if (ret)
+		return ret;
+	return value & sta_mask ? -EBUSY : 0;
+}
+
+static int scpsys_boot_is_on(struct scpsys_domain *pd)
+{
+	return scpsys_boot_check(pd, false);
+}
+
+/* Called only after the retained clocks and failure latch are armed. */
+static int scpsys_adopt_boot_hwv(struct scpsys_domain *pd)
+{
+	const struct scpsys_hwv_domain_data *hwv = pd->hwv_data;
+	u32 value, mask = BIT(hwv->setclr_bit);
+	bool voted;
+	int ret, status;
+
+	ret = scpsys_boot_hwv_state(pd, &voted);
+	if (ret || voted)
+		return ret;
+
+	ret = regmap_write(pd->hwv_base, hwv->set, mask);
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout(pd->hwv_base, hwv->set, value, value & mask,
+				       MTK_HWV_PREPARE_DELAY_US, MTK_HWV_PREPARE_TIMEOUT);
+	if (ret)
+		return ret;
+
+	ret = read_poll_timeout(scpsys_mixed_hwv_status, status, status != 0,
+				MTK_HWV_POLL_DELAY_US, MTK_HWV_POLL_TIMEOUT,
+				false, pd, true);
+	return ret ?: (status < 0 ? status : 0);
+}
