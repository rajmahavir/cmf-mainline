+/* Hibernation (and system sleep unless disp_system_sleep) stays refused. */
+static int scpsys_display_sleep_refuse(struct device *dev)
+{
+	int ret = scpsys_display_sleep_check(dev, NULL);
+
+	return ret ? ret : -EOPNOTSUPP;
+}
+
+static int scpsys_display_sleep_prepare(struct device *dev)
+{
+	struct scpsys_domain *pd;
+	int ret = scpsys_display_sleep_check(dev, &pd);
+
+	if (ret)
+		return ret;
+	if (!READ_ONCE(disp_system_sleep) || !pd->genpd_sleep_prepare)
+		return -EOPNOTSUPP;
+	return pd->genpd_sleep_prepare(dev);
+}
+
+/* Reached only after prepare passed: no genpd power transition here. */
+static int scpsys_display_sleep_suspend_noirq(struct device *dev)
+{
