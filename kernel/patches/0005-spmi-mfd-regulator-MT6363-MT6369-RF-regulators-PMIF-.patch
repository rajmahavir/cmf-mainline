diff --git a/drivers/regulator/mt636x-rf-regulator.c b/drivers/regulator/mt636x-rf-regulator.c
new file mode 100644
index 000000000..2b9905d07
--- /dev/null
+++ b/drivers/regulator/mt636x-rf-regulator.c
@@ -0,0 +1,441 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RF LDO register and voltage data from the MediaTek MT6363/MT6369 vendor drivers. */
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/mutex.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/of_platform.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/spmi.h>
+
+#define MT636X_SWCID		0x000b
+#define MT636X_LDO_ENABLE	BIT(0)
+#define MT636X_LDO_LOW_POWER	BIT(1)
+#define MT636X_LDO_VOSEL	GENMASK(3, 0)
+
+struct mt636x_rf_chip {
+	const struct regulator_desc *rails;
+	unsigned int count;
+};
+
+static const unsigned int mt6363_vcn13_uv[] = {
+	900000, 1000000, 1100000, 1200000, 1300000, 1700000, 1800000, 1810000,
+};
+
+static const unsigned int mt636x_rfio_uv[] = {
+	600000, 700000, 800000, 900000, 1000000, 1100000, 1200000, 1300000,
+	1400000, 1500000, 1600000, 1700000, 1800000, 1900000, 2000000, 2100000,
+};
+
+static const unsigned int mt6369_vcn33_uv[] = {
+	1200000, 1300000, 1500000, 1700000, 1800000, 2000000, 2500000, 2600000,
+	2700000, 2800000, 2900000, 3000000, 3100000, 3300000, 3400000, 3500000,
+};
+
+static unsigned int mt636x_rf_map_mode(unsigned int mode)
+{
+	switch (mode) {
+	case 0:
+		return REGULATOR_MODE_NORMAL;
+	case 2:
+		return REGULATOR_MODE_IDLE;
+	default:
+		return REGULATOR_MODE_INVALID;
+	}
+}
+
+static unsigned int mt636x_rf_get_mode(struct regulator_dev *rdev)
+{
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read(rdev->regmap, rdev->desc->enable_reg, &value);
+	if (ret)
+		return REGULATOR_MODE_INVALID;
+
+	return value & MT636X_LDO_LOW_POWER ? REGULATOR_MODE_IDLE : REGULATOR_MODE_NORMAL;
+}
+
+static int mt636x_rf_set_mode(struct regulator_dev *rdev, unsigned int mode)
+{
+	int ret;
+	bool changed;
+
+	if (mode != REGULATOR_MODE_NORMAL && mode != REGULATOR_MODE_IDLE)
+		return -EINVAL;
+
+	ret = regmap_update_bits_check(rdev->regmap, rdev->desc->enable_reg,
+				       MT636X_LDO_LOW_POWER,
+				       mode == REGULATOR_MODE_IDLE ? MT636X_LDO_LOW_POWER : 0,
+				       &changed);
+	if (!ret && changed && mode == REGULATOR_MODE_NORMAL)
+		udelay(100);
+
+	return ret;
+}
+
+static const struct regulator_ops mt636x_rf_ops = {
+	.enable = regulator_enable_regmap,
+	.disable = regulator_disable_regmap,
+	.is_enabled = regulator_is_enabled_regmap,
+	.list_voltage = regulator_list_voltage_table,
+	.map_voltage = regulator_map_voltage_iterate,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel = regulator_set_voltage_time_sel,
+	.get_mode = mt636x_rf_get_mode,
+	.set_mode = mt636x_rf_set_mode,
+};
+
+#define MT636X_RF_LDO(_id, _name, _control, _selector, _voltages) { \
+	.id = (_id), .name = (_name), .of_match = (_name), \
+	.regulators_node = "regulators", .type = REGULATOR_VOLTAGE, \
+	.owner = THIS_MODULE, .ops = &mt636x_rf_ops, \
+	.enable_reg = (_control), .enable_mask = MT636X_LDO_ENABLE, \
+	.vsel_reg = (_selector), .vsel_mask = MT636X_LDO_VOSEL, \
+	.volt_table = (_voltages), .n_voltages = ARRAY_SIZE(_voltages), \
+	.of_map_mode = mt636x_rf_map_mode, \
+}
+
+static const struct regulator_desc mt6363_rf_rails[] = {
+	MT636X_RF_LDO(0, "vcn13", 0x1d07, 0x1b3f, mt6363_vcn13_uv),
+	MT636X_RF_LDO(1, "vrfio18", 0x1bcd, 0x1f2c, mt636x_rfio_uv),
+};
+
+/* Card power follows the stock MT6369 VMCH_EINT_LOW sequence. */
+static int mt6369_vmch_eint_low_enable(struct regulator_dev *rdev)
+{
+	int ret;
+
+	ret = regmap_update_bits(rdev->regmap, 0x1ca3, BIT(2), 0);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(rdev->regmap, 0x1c95, BIT(0), BIT(0));
+	if (ret)
+		return ret;
+	return regulator_enable_regmap(rdev);
+}
+
+static int mt6369_vmch_eint_low_disable(struct regulator_dev *rdev)
+{
+	int ret;
+
+	ret = regmap_update_bits(rdev->regmap, 0x1c95, BIT(0), 0);
+	if (ret)
+		return ret;
+	udelay(1500);
+	return regulator_disable_regmap(rdev);
+}
+
+static const struct regulator_ops mt6369_vmch_eint_ops = {
+	.enable = mt6369_vmch_eint_low_enable,
+	.disable = mt6369_vmch_eint_low_disable,
+	.is_enabled = regulator_is_enabled_regmap,
+	.list_voltage = regulator_list_voltage_table,
+	.map_voltage = regulator_map_voltage_iterate,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel = regulator_set_voltage_time_sel,
+};
+
+static const struct regulator_desc mt6369_rf_rails[] = {
+	MT636X_RF_LDO(0, "vcn33-1", 0x1c3f, 0x1db1, mt6369_vcn33_uv),
+	MT636X_RF_LDO(1, "vcn33-2", 0x1c4d, 0x1db5, mt6369_vcn33_uv),
+	MT636X_RF_LDO(2, "vant18", 0x1cb2, 0x1e09, mt636x_rfio_uv),
+	MT636X_RF_LDO(3, "vmc", 0x1ca4, 0x1dad, mt6369_vcn33_uv),
+	MT636X_RF_LDO(5, "vtp", 0x1c15, 0x1da5, mt6369_vcn33_uv),
+	{
+		.id = 4, .name = "vmch-eint-low", .of_match = "vmch-eint-low",
+		.regulators_node = "regulators", .type = REGULATOR_VOLTAGE,
+		.owner = THIS_MODULE, .ops = &mt6369_vmch_eint_ops,
+		.enable_reg = 0x1ca3, .enable_mask = BIT(0),
+		.vsel_reg = 0x1da9, .vsel_mask = MT636X_LDO_VOSEL,
+		.volt_table = mt6369_vcn33_uv,
+		.n_voltages = ARRAY_SIZE(mt6369_vcn33_uv),
+	},
+};
+
+static const struct mt636x_rf_chip mt6363_rf = {
+	.rails = mt6363_rf_rails, .count = ARRAY_SIZE(mt6363_rf_rails),
+};
+
+static const struct mt636x_rf_chip mt6369_rf = {
+	.rails = mt6369_rf_rails, .count = ARRAY_SIZE(mt6369_rf_rails),
+};
+
+static const struct regmap_config mt636x_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xffff,
+	.fast_io = true,
+};
+
+#define MT6363_IRQ_SUMMARY	0x04e
+#define MT6363_IRQ_SUMMARY_PSC	BIT(2)
+#define MT6363_RCS_INT_DONE	0x41b
+#define MT6363_PSC_IRQ_ENABLE	0x90f
+#define MT6363_PSC_IRQ_STATUS	0x91b
+#define MT6363_PSC_CHRDET_ENABLE	0x912
+#define MT6363_PSC_CHRDET_STATUS	0x91c
+#define MT6363_PSC_CHRDET_BITS	GENMASK(1, 0)
+#define MT6363_PSC_IRQ_BASE	48
+#define MT6363_PSC_IRQ_COUNT	8
+#define MT6363_PSC_KEY_BITS	(BIT(0) | BIT(1) | BIT(3) | BIT(4))
+
+struct mt6363_psc_irq {
+	struct device *dev;
+	struct regmap *regmap;
+	struct irq_domain *domain;
+	struct mutex lock;
+	unsigned int enabled;
+	bool armed;
+	int parent_irq;
+};
+
+static void mt6363_psc_bus_lock(struct irq_data *data)
+{
+	struct mt6363_psc_irq *psc = irq_data_get_irq_chip_data(data);
+
+	mutex_lock(&psc->lock);
+}
+
+static void mt6363_psc_bus_sync_unlock(struct irq_data *data)
+{
+	struct mt6363_psc_irq *psc = irq_data_get_irq_chip_data(data);
+	int ret;
+
+	ret = regmap_update_bits(psc->regmap, MT6363_PSC_IRQ_ENABLE,
+				 MT6363_PSC_KEY_BITS, psc->enabled);
+	/* Complete the boot-time RCS transaction after an IRQ is enabled. */
+	if (!ret && psc->enabled && !psc->armed)
+		ret = regmap_write(psc->regmap, MT6363_RCS_INT_DONE, 1);
+	if (!ret)
+		psc->armed = psc->enabled != 0;
+	if (ret)
+		dev_err_ratelimited(psc->dev, "Cannot sync PSC IRQ enables: %d\n", ret);
+	mutex_unlock(&psc->lock);
+}
+
+static void mt6363_psc_irq_mask(struct irq_data *data)
+{
+	struct mt6363_psc_irq *psc = irq_data_get_irq_chip_data(data);
+
+	psc->enabled &= ~BIT(data->hwirq - MT6363_PSC_IRQ_BASE);
+}
+
+static void mt6363_psc_irq_unmask(struct irq_data *data)
+{
+	struct mt6363_psc_irq *psc = irq_data_get_irq_chip_data(data);
+
+	psc->enabled |= BIT(data->hwirq - MT6363_PSC_IRQ_BASE);
+}
+
+static int mt6363_psc_irq_set_wake(struct irq_data *data, unsigned int on)
+{
+	struct mt6363_psc_irq *psc = irq_data_get_irq_chip_data(data);
+
+	return irq_set_irq_wake(psc->parent_irq, on);
+}
+
+static const struct irq_chip mt6363_psc_irq_chip = {
+	.name = "mt6363-psc",
+	.irq_mask = mt6363_psc_irq_mask,
+	.irq_unmask = mt6363_psc_irq_unmask,
+	.irq_bus_lock = mt6363_psc_bus_lock,
+	.irq_bus_sync_unlock = mt6363_psc_bus_sync_unlock,
+	.irq_set_wake = mt6363_psc_irq_set_wake,
+};
+
+static int mt6363_psc_irq_map(struct irq_domain *domain, unsigned int virq,
+			     irq_hw_number_t hwirq)
+{
+	if (hwirq < MT6363_PSC_IRQ_BASE ||
+	    hwirq >= MT6363_PSC_IRQ_BASE + MT6363_PSC_IRQ_COUNT ||
+	    !(MT6363_PSC_KEY_BITS & BIT(hwirq - MT6363_PSC_IRQ_BASE)))
+		return -EINVAL;
+
+	irq_set_chip_data(virq, domain->host_data);
+	irq_set_chip_and_handler(virq, &mt6363_psc_irq_chip, handle_simple_irq);
+	irq_set_nested_thread(virq, true);
+	irq_set_noprobe(virq);
+	return 0;
+}
+
+static const struct irq_domain_ops mt6363_psc_irq_ops = {
+	.map = mt6363_psc_irq_map,
+	.xlate = irq_domain_xlate_onecell,
+};
+
+static irqreturn_t mt6363_psc_irq_thread(int irq, void *data)
+{
+	struct mt6363_psc_irq *psc = data;
+	unsigned int summary, status, virq, bit;
+	unsigned long pending;
+	int ret;
+
+	ret = regmap_read(psc->regmap, MT6363_IRQ_SUMMARY, &summary);
+	if (ret)
+		goto err;
+	if (!(summary & MT6363_IRQ_SUMMARY_PSC))
+		goto complete;
+
+	ret = regmap_read(psc->regmap, MT6363_PSC_IRQ_STATUS, &status);
+	if (ret)
+		goto err;
+	pending = status & MT6363_PSC_KEY_BITS;
+	if (!pending)
+		goto complete;
+
+	for_each_set_bit(bit, &pending, MT6363_PSC_IRQ_COUNT) {
+		virq = irq_find_mapping(psc->domain, MT6363_PSC_IRQ_BASE + bit);
+		if (virq)
+			handle_nested_irq(virq);
+	}
+
+	ret = regmap_write(psc->regmap, MT6363_PSC_IRQ_STATUS, pending);
+	if (ret)
+		goto err;
+complete:
+	ret = regmap_write(psc->regmap, MT6363_RCS_INT_DONE, 1);
+	if (ret)
+		goto err;
+	return IRQ_HANDLED;
+
+err:
+	dev_err_ratelimited(psc->dev, "PSC IRQ register access failed: %d\n", ret);
+	return IRQ_NONE;
+}
+
+static void mt6363_psc_irq_remove(void *data)
+{
+	struct irq_domain *domain = data;
+	unsigned int hwirq, virq;
+
+	for (hwirq = MT6363_PSC_IRQ_BASE;
+	     hwirq < MT6363_PSC_IRQ_BASE + MT6363_PSC_IRQ_COUNT; hwirq++) {
+		virq = irq_find_mapping(domain, hwirq);
+		if (virq)
+			irq_dispose_mapping(virq);
+	}
+	irq_domain_remove(domain);
+}
+
+static int mt6363_psc_irq_init(struct device *dev, struct regmap *regmap)
+{
+	struct mt6363_psc_irq *psc;
+	int ret;
+
+	psc = devm_kzalloc(dev, sizeof(*psc), GFP_KERNEL);
+	if (!psc)
+		return -ENOMEM;
+
+	psc->dev = dev;
+	psc->regmap = regmap;
+	mutex_init(&psc->lock);
+	psc->parent_irq = of_irq_get(dev->of_node, 0);
+	if (psc->parent_irq <= 0)
+		return psc->parent_irq ?: -EINVAL;
+
+	/* Firmware leaves both unhandled MT6363 charger IRQs enabled. */
+	ret = regmap_clear_bits(regmap, MT6363_PSC_CHRDET_ENABLE, MT6363_PSC_CHRDET_BITS);
+	if (ret)
+		return ret;
+	ret = regmap_write(regmap, MT6363_PSC_CHRDET_STATUS, MT6363_PSC_CHRDET_BITS);
+	if (ret)
+		return ret;
+	ret = regmap_clear_bits(regmap, MT6363_PSC_IRQ_ENABLE, MT6363_PSC_KEY_BITS);
+	if (ret)
+		return ret;
+	ret = regmap_write(regmap, MT6363_PSC_IRQ_STATUS, MT6363_PSC_KEY_BITS);
+	if (ret)
+		return ret;
+	ret = regmap_write(regmap, MT6363_RCS_INT_DONE, 1);
+	if (ret)
+		return ret;
+
+	psc->domain = irq_domain_create_linear(dev_fwnode(dev),
+					       MT6363_PSC_IRQ_BASE + MT6363_PSC_IRQ_COUNT,
+					       &mt6363_psc_irq_ops, psc);
+	if (!psc->domain)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(dev, mt6363_psc_irq_remove, psc->domain);
+	if (ret)
+		return ret;
+
+	return devm_request_threaded_irq(dev, psc->parent_irq, NULL,
+					 mt6363_psc_irq_thread, IRQF_ONESHOT,
+					 "mt6363-psc", psc);
+}
+
+static int mt636x_rf_probe(struct spmi_device *sdev)
+{
+	struct device *dev = &sdev->dev;
+	const struct mt636x_rf_chip *chip = device_get_match_data(dev);
+	struct device_node *regulators __free(device_node) = NULL;
+	struct regulator_config config = { .dev = dev };
+	unsigned int chip_id, i;
+	int ret;
+
+	if (!chip)
+		return -ENODEV;
+
+	regulators = of_get_child_by_name(dev->of_node, "regulators");
+	if (!regulators)
+		return dev_err_probe(dev, -EINVAL, "Missing RF regulators\n");
+
+	config.regmap = devm_regmap_init_spmi_ext(sdev, &mt636x_regmap_config);
+	if (IS_ERR(config.regmap))
+		return dev_err_probe(dev, PTR_ERR(config.regmap), "Cannot create PMIC regmap\n");
+
+	ret = regmap_read(config.regmap, MT636X_SWCID, &chip_id);
+	if (ret || !chip_id)
+		return dev_err_probe(dev, ret ?: -ENODEV, "Cannot read PMIC chip ID\n");
+
+	for (i = 0; i < chip->count; i++) {
+		const struct regulator_desc *rail = &chip->rails[i];
+		struct device_node *node __free(device_node) =
+			of_get_child_by_name(regulators, rail->of_match);
+		struct regulator_dev *rdev;
+
+		if (!node || !of_device_is_available(node))
+			continue;
+
+		rdev = devm_regulator_register(dev, rail, &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev), "Cannot register %s\n", rail->name);
+	}
+
+	if (chip == &mt6363_rf && of_property_present(dev->of_node, "interrupts-extended")) {
+		ret = mt6363_psc_irq_init(dev, config.regmap);
+		if (ret)
+			return dev_err_probe(dev, ret, "Cannot initialize PSC IRQs\n");
+	}
+
+	/* Connectivity children use this parent's byte-addressed PMIC regmap. */
+	return devm_of_platform_populate(dev);
+}
+
+static const struct of_device_id mt636x_rf_of_match[] = {
+	{ .compatible = "mediatek,mt6363-rf-regulators", .data = &mt6363_rf },
+	{ .compatible = "mediatek,mt6369-rf-regulators", .data = &mt6369_rf },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt636x_rf_of_match);
+
+static struct spmi_driver mt636x_rf_driver = {
+	.probe = mt636x_rf_probe,
+	.driver = {
+		.name = "mt636x-rf-regulator",
+		.of_match_table = mt636x_rf_of_match,
+	},
+};
+module_spmi_driver(mt636x_rf_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6363 and MT6369 RF regulator driver");
+MODULE_LICENSE("GPL");
