diff --git a/drivers/input/keyboard/mt6363-keys.c b/drivers/input/keyboard/mt6363-keys.c
new file mode 100644
index 000000000..22d325353
--- /dev/null
+++ b/drivers/input/keyboard/mt6363-keys.c
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/bits.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define MT6363_TOPSTATUS	0x1e
+#define MT6363_POWER_RELEASED	BIT(1)
+#define MT6363_VOLUME_RELEASED	BIT(3)
+#define MT6363_POLL_INTERVAL	20
+
+static void mt6363_keys_poll(struct input_dev *input)
+{
+	struct regmap *regmap = input_get_drvdata(input);
+	unsigned int status;
+	int ret;
+
+	ret = regmap_read(regmap, MT6363_TOPSTATUS, &status);
+	if (ret) {
+		dev_err_ratelimited(input->dev.parent, "Unable to read PMIC keys: %d\n",
+				    ret);
+		return;
+	}
+
+	input_report_key(input, KEY_POWER, !(status & MT6363_POWER_RELEASED));
+	input_report_key(input, KEY_VOLUMEUP, !(status & MT6363_VOLUME_RELEASED));
+	input_sync(input);
+}
+
+static int mt6363_keys_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct input_dev *input;
+	struct regmap *regmap;
+	int ret;
+
+	regmap = dev_get_regmap(dev->parent, NULL);
+	if (!regmap)
+		return dev_err_probe(dev, -EPROBE_DEFER, "Waiting for PMIC regmap\n");
+
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return -ENOMEM;
+
+	input->name = "MT6363 PMIC keys";
+	input->id.bustype = BUS_HOST;
+	input_set_drvdata(input, regmap);
+	input_set_capability(input, EV_KEY, KEY_POWER);
+	input_set_capability(input, EV_KEY, KEY_VOLUMEUP);
+
+	/* The PMIC RCS line also carries boot-enabled charger interrupts. */
+	ret = input_setup_polling(input, mt6363_keys_poll);
+	if (ret)
+		return ret;
+
+	input_set_poll_interval(input, MT6363_POLL_INTERVAL);
+	return input_register_device(input);
+}
+
+static const struct of_device_id mt6363_keys_of_match[] = {
+	{ .compatible = "mediatek,mt6363-keys-polled" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6363_keys_of_match);
+
+static struct platform_driver mt6363_keys_driver = {
+	.probe = mt6363_keys_probe,
+	.driver = {
+		.name = "mt6363-keys-polled",
+		.of_match_table = mt6363_keys_of_match,
+	},
+};
+/* The stock audio DT already exposes conninfra under the MT6363. */
+static struct platform_device *mt6363_keys_device;
+
+static int mt6363_keys_try(void)
+{
+	struct device *child, *pmic;
+	struct device_node *polled __free(device_node) = NULL;
+	struct platform_device *pdev;
+	int ret;
+
+	child = bus_find_device_by_name(&platform_bus_type, NULL,
+				       "1cc04000.spmi:pmic@4:conninfra");
+	if (!child)
+		return -ENODEV;
+
+	pmic = child->parent;
+	if (!pmic->of_node ||
+	    !of_device_is_compatible(pmic->of_node, "mediatek,mt6363-rf-regulators") ||
+	    !dev_get_regmap(pmic, NULL)) {
+		ret = -ENODEV;
+		goto out_put;
+	}
+
+	/* New DTBs explicitly select the polled or interrupt-driven device. */
+	polled = of_get_child_by_name(pmic->of_node, "keys-polled");
+	if (polled) {
+		ret = 0;
+		goto out_put;
+	}
+
+	pdev = platform_device_register_data(pmic, "mt6363-keys-polled",
+					     PLATFORM_DEVID_NONE, NULL, 0);
+	ret = PTR_ERR_OR_ZERO(pdev);
+	if (!ret)
+		mt6363_keys_device = pdev;
+out_put:
+	put_device(child);
+	return ret;
+}
+
+/*
+ * Built in, init can run before the SPMI PMIC has created its conninfra
+ * child. Retry every 500 ms for up to 60 s instead of failing once.
+ */
+static struct delayed_work mt6363_keys_work;
+static unsigned int mt6363_keys_tries;
+
+static void mt6363_keys_retry(struct work_struct *work)
+{
+	int ret = mt6363_keys_try();
+
+	if (!ret) {
+		if (mt6363_keys_device)
+			pr_info("mt6363-keys: legacy device registered after %u attempt(s)\n",
+				mt6363_keys_tries + 1);
+		return;
+	}
+	if (ret == -ENODEV && ++mt6363_keys_tries < 120) {
+		schedule_delayed_work(&mt6363_keys_work, msecs_to_jiffies(500));
+		return;
+	}
+	pr_err("mt6363-keys: giving up: %d\n", ret);
+}
+
+static int __init mt6363_keys_init(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&mt6363_keys_driver);
+	if (ret)
+		return ret;
+
+	INIT_DELAYED_WORK(&mt6363_keys_work, mt6363_keys_retry);
+	schedule_delayed_work(&mt6363_keys_work, 0);
+	return 0;
+}
+module_init(mt6363_keys_init);
+
+static void __exit mt6363_keys_exit(void)
+{
+	cancel_delayed_work_sync(&mt6363_keys_work);
+	if (mt6363_keys_device)
+		platform_device_unregister(mt6363_keys_device);
+	platform_driver_unregister(&mt6363_keys_driver);
+}
+module_exit(mt6363_keys_exit);
+
+MODULE_DESCRIPTION("MediaTek MT6363 Power and Volume Up keys");
+MODULE_LICENSE("GPL");
