+		crclen = 0;
+	} else if (tsdata->version == EDT_M06) {
 		tsdata->tdata_cmd = 0xf9;
 		tsdata->tdata_offset = 5;
 		tsdata->point_len = 4;
@@ -1083,6 +1153,17 @@ static void edt_ft5x06_ts_set_regs(struct edt_ft5x06_ts_data *tsdata)
 		reg_addr->reg_num_y = NO_REGISTER;
 		break;
 
+	case EDT_FT3519:
+		reg_addr->reg_threshold = NO_REGISTER;
+		reg_addr->reg_report_rate = NO_REGISTER;
+		reg_addr->reg_gain = NO_REGISTER;
+		reg_addr->reg_offset = NO_REGISTER;
+		reg_addr->reg_offset_x = NO_REGISTER;
+		reg_addr->reg_offset_y = NO_REGISTER;
+		reg_addr->reg_num_x = NO_REGISTER;
+		reg_addr->reg_num_y = NO_REGISTER;
+		break;
+
 	case GENERIC_FT:
 		/* this is a guesswork */
 		reg_addr->reg_threshold = M09_REGISTER_THRESHOLD;
@@ -1157,6 +1238,7 @@ static int edt_ft5x06_ts_probe(struct i2c_client *client)
 	}
 
 	tsdata->max_support_points = chip_data->max_support_points;
+	tsdata->fts_v2 = chip_data->fts_v2;
 
 	tsdata->vcc = devm_regulator_get(&client->dev, "vcc");
 	if (IS_ERR(tsdata->vcc))
@@ -1261,6 +1343,12 @@ static int edt_ft5x06_ts_probe(struct i2c_client *client)
 	 */
 	regmap_read(tsdata->regmap, 0x00, &val);
 
+	if (tsdata->fts_v2) {
+		/* FTS working mode + active power mode (vendor FT3519 init). */
+		regmap_write(tsdata->regmap, 0x00, 0x00);
+		regmap_write(tsdata->regmap, 0xA5, 0x00);
