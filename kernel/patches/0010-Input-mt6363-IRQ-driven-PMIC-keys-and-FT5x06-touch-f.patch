diff --git a/drivers/input/touchscreen/edt-ft5x06.c b/drivers/input/touchscreen/edt-ft5x06.c
index d6c3d033b..b8786f896 100644
--- a/drivers/input/touchscreen/edt-ft5x06.c
+++ b/drivers/input/touchscreen/edt-ft5x06.c
@@ -92,6 +92,7 @@ enum edt_ver {
 	EDT_M12,
 	EV_FT,
 	GENERIC_FT,
+	EDT_FT3519,
 };
 
 struct edt_reg_addr {
@@ -134,6 +135,7 @@ struct edt_ft5x06_ts_data {
 	int offset_y;
 	int report_rate;
 	int max_support_points;
+	bool fts_v2;
 	int point_len;
 	u8 tdata_cmd;
 	int tdata_len;
@@ -150,6 +152,7 @@ struct edt_ft5x06_ts_data {
 
 struct edt_i2c_chip_data {
 	int  max_support_points;
+	bool fts_v2;
 };
 
 static const struct regmap_config edt_ft5x06_i2c_regmap_config = {
@@ -299,7 +302,7 @@ static irqreturn_t edt_ft5x06_ts_isr(int irq, void *dev_id)
 {
 	struct edt_ft5x06_ts_data *tsdata = dev_id;
 	struct device *dev = &tsdata->client->dev;
-	u8 rdbuf[63];
+	u8 rdbuf[128];
 	int i, type, x, y, id;
 	int error;
 
@@ -312,6 +315,57 @@ static irqreturn_t edt_ft5x06_ts_isr(int irq, void *dev_id)
 		goto out;
 	}
 
+	if (tsdata->version == EDT_FT3519) {
+		/* FTS v2 / default protocol select, points after the header. */
+		int proto = rdbuf[1] >> 4;
+		int points = rdbuf[1] & 0x0f;
+		bool active;
+
+		if (points > tsdata->max_support_points)
+			points = tsdata->max_support_points;
+		for (i = 0; i < points; i++) {
+			u8 *buf;
+			int flag;
+
+			if (proto == 0x02) {
+				buf = &rdbuf[4 + i * 8];
+				flag = buf[0] >> 6;
+				id = (buf[2] >> 4) & 0x0f;
+				x = ((buf[0] & 0x0f) << 12) |
+				    (buf[1] << 4) | ((buf[4] >> 4) & 0x0f);
+				y = ((buf[2] & 0x0f) << 12) |
+				    (buf[3] << 4) | (buf[4] & 0x0f);
+			} else {
+				buf = &rdbuf[2 + i * 6];
+				flag = buf[0] >> 6;
+				id = (buf[2] >> 4) & 0x0f;
+				x = ((buf[0] & 0x0f) << 8) | buf[1];
+				y = ((buf[2] & 0x0f) << 8) | buf[3];
+			}
+			if (id >= tsdata->max_support_points)
+				continue;
+			active = flag != TOUCH_EVENT_UP;
+			input_mt_slot(tsdata->input, id);
+			input_mt_report_slot_state(tsdata->input,
+						   MT_TOOL_FINGER, active);
+			if (active)
+				touchscreen_report_pos(tsdata->input,
+						       &tsdata->prop, x, y,
+						       true);
+		}
+		if (points == 0) {
+			/* No contact reported: release every slot so BTN_TOUCH drops. */
+			for (i = 0; i < tsdata->max_support_points; i++) {
+				input_mt_slot(tsdata->input, i);
+				input_mt_report_slot_state(tsdata->input,
+							   MT_TOOL_FINGER, false);
+			}
+		}
+		input_mt_report_pointer_emulation(tsdata->input, true);
+		input_sync(tsdata->input);
+		goto out;
+	}
+
 	for (i = 0; i < tsdata->max_support_points; i++) {
 		u8 *buf = &rdbuf[i * tsdata->point_len + tsdata->tdata_offset];
 
@@ -838,6 +892,12 @@ static int edt_ft5x06_ts_identify(struct i2c_client *client,
 	char *model_name = tsdata->name;
 	char *fw_version = tsdata->fw_version;
 
+	if (tsdata->fts_v2) {
+		tsdata->version = EDT_FT3519;
+		strscpy(model_name, "FocalTech FT3519", EDT_NAME_LEN);
+		return 0;
+	}
+
 	/* see what we find if we assume it is a M06 *
 	 * if we get less than EDT_NAME_LEN, we don't want
 	 * to have garbage in there
@@ -1021,13 +1081,23 @@ static void edt_ft5x06_ts_get_parameters(struct edt_ft5x06_ts_data *tsdata)
 		if (!regmap_read(regmap, reg_addr->reg_num_y, &val))
 			tsdata->num_y = val;
 	}
+
+	/* FT3519 reports 12-bit coordinates. */
+	if (tsdata->version == EDT_FT3519)
+		tsdata->num_x = tsdata->num_y = 64;
+
 }
 
 static void edt_ft5x06_ts_set_tdata_parameters(struct edt_ft5x06_ts_data *tsdata)
 {
 	int crclen;
 
-	if (tsdata->version == EDT_M06) {
+	if (tsdata->version == EDT_FT3519) {
+		tsdata->tdata_cmd = 0x01;
+		tsdata->tdata_offset = 4;
