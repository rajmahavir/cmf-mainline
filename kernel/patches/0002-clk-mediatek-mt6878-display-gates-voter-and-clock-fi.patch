+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6878 display gates with independent, cold registration. */
+
+#include <dt-bindings/clock/mediatek,mt6878-clock.h>
+#include <dt-bindings/clock/mediatek,mt6878-display-gates.h>
+#include <dt-bindings/clock/mediatek,mt6878-display-voter.h>
+#include <linux/atomic.h>
