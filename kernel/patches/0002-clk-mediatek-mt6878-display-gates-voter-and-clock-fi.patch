+#include <linux/soc/mediatek/mt6878-display-gates.h>
+
+#define MT6878_DISP_CTL		0xe70
+#define MT6878_DISP_ON		(BIT(0) | BIT(2) | BIT(3) | BIT(30) | BIT(31))
+#define MT6878_DISP_BLOCKED	(BIT(1) | BIT(4))
+#define MT6878_GATE_COUNT	(CLK_MM_NR_CLK + CLK_MDP_NR_CLK)
+
+struct mt6878_gate_desc {
+	const char *name;
+	u32 status;
+	u32 mask;
+	bool mdp;
+};
+
+static bool mt6878_boot_gates_attempted;
+static LIST_HEAD(mt6878_gate_blocks);
+static DEFINE_MUTEX(mt6878_gate_blocks_lock);
+
+struct mt6878_gate_block {
+	struct list_head entry;
+	struct clk_hw_onecell_data *clocks;
+	atomic_t held_count;
+	bool faulted;
+	struct device *dev;
+	struct regmap *spm;
+	struct regmap *mm;
+	struct regmap *mdp;
+	struct clk *parent;
+};
+
+struct mt6878_display_gate {
+	struct clk_hw hw;
+	struct mt6878_gate_block *block;
+	const struct mt6878_gate_desc *desc;
+	bool held;
+	bool faulted;
+	bool boot_retained;
+};
+
+#define MM_GATE(_name, _status, _bit) \
+	{ .name = _name, .status = _status, .mask = BIT(_bit) }
+#define MDP_GATE(_name, _bit) \
+	{ .name = _name, .status = 0x100, .mask = BIT(_bit), .mdp = true }
