+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6878 display clock votes, based on MediaTek's downstream MUX_HWV protocol. */
+
+#include <dt-bindings/clock/mediatek,mt6878-clock.h>
+#include <dt-bindings/clock/mediatek,mt6878-display-voter.h>
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/mfd/syscon.h>
+#include <linux/mutex.h>
+#include <linux/soc/mediatek/mt6878-display-voter.h>
+#include <linux/of.h>
+#include <linux/of_clk.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+
+#define MT6878_VOTE_SET		0x10
+#define MT6878_VOTE_CLR		0x14
+#define MT6878_VOTE_DONE		0x1c08
+#define MT6878_TOP_CFG1		0x20
+#define MT6878_VOTE_ACK_US	100000
+#define MT6878_VOTE_DONE_US	5000000
+
+struct mt6878_display_vote {
+	struct clk_hw hw;
+	struct clk *parent;
+	struct device *dev;
+	struct regmap *voter;
+	struct regmap *top;
+	u32 mask;
+	bool held;
+	bool faulted;
+	bool boot_retained;
+};
+
+struct mt6878_vote_desc {
+	const char *name;
+	const char *input;
+	u32 parent_id;
+	u32 mask;
+};
+
+static const struct mt6878_vote_desc mt6878_vote_descs[] = {
+	[CLK_MT6878_DISP_VOTE] = {
+		.name = "mt6878_disp0_vote", .input = "disp",
+		.parent_id = CLK_TOP_DISP0_SEL, .mask = BIT(7),
+	},
+	[CLK_MT6878_MMINFRA_VOTE] = {
+		.name = "mt6878_mminfra_vote", .input = "mminfra",
+		.parent_id = CLK_TOP_MMINFRA_SEL, .mask = BIT(15),
+	},
+};
+
+static bool mt6878_boot_voter_attempted;
+static DEFINE_MUTEX(mt6878_boot_votes_lock);
+static struct mt6878_display_vote *mt6878_boot_votes[CLK_MT6878_DISPLAY_VOTE_NR];
+
+#define to_mt6878_vote(_hw) container_of(_hw, struct mt6878_display_vote, hw)
+
+static int mt6878_vote_idle(struct regmap *voter, u32 mask)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read(voter, MT6878_VOTE_SET, &val);
+	if (ret)
+		return ret;
+	if (val & mask)
+		return -EBUSY;
+	ret = regmap_read(voter, MT6878_VOTE_DONE, &val);
+	if (ret)
+		return ret;
+	return (val & mask) == mask ? 0 : -EBUSY;
+}
+
+static int mt6878_vote_wait_ack(struct mt6878_display_vote *vote, bool on)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read_poll_timeout(vote->voter, MT6878_VOTE_SET, val,
+				       !!(val & vote->mask) == on, 10, MT6878_VOTE_ACK_US);
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout(vote->voter, MT6878_VOTE_DONE, val,
+				       val & vote->mask, 10, MT6878_VOTE_DONE_US);
+	if (ret || !on)
+		return ret;
+
+	/* Other voters may retain the physical clock after our vote is removed. */
+	return regmap_read_poll_timeout(vote->top, MT6878_TOP_CFG1, val,
+				       !(val & vote->mask), 10, MT6878_VOTE_DONE_US);
+}
+
+/* Process-context CCF prepare lock serializes state and both vote callbacks. */
+static int mt6878_vote_switch(struct mt6878_display_vote *vote, bool on, bool *issued)
+{
+	u32 val;
+	int ret;
+
+	*issued = false;
+	ret = regmap_read_poll_timeout(vote->voter, MT6878_VOTE_DONE, val,
+				       val & vote->mask, 10, MT6878_VOTE_DONE_US);
+	if (ret)
+		return ret;
+
+	/* A transport error does not prove that the write was rejected. */
+	*issued = true;
+	ret = regmap_write(vote->voter, on ? MT6878_VOTE_SET : MT6878_VOTE_CLR, vote->mask);
+	if (ret)
+		return ret;
+
+	return mt6878_vote_wait_ack(vote, on);
+}
+
+static int mt6878_vote_boot_sample(struct mt6878_display_vote *vote, bool *acked)
+{
+	u32 done, set, top;
+	int ret;
+
+	ret = regmap_read(vote->voter, MT6878_VOTE_DONE, &done);
+	if (ret)
+		return ret;
+	ret = regmap_read(vote->voter, MT6878_VOTE_SET, &set);
+	if (ret)
+		return ret;
+	ret = regmap_read(vote->top, MT6878_TOP_CFG1, &top);
+	if (ret)
+		return ret;
+
+	if (!(done & vote->mask) || (top & vote->mask))
+		return -EHOSTDOWN;
+	*acked = set & vote->mask;
+	return 0;
+}
+
+static int mt6878_vote_boot_status(struct mt6878_display_vote *vote)
+{
+	bool acked;
+	int ret;
+
+	ret = mt6878_vote_boot_sample(vote, &acked);
+	if (ret)
+		return ret;
+	return acked ? 0 : -EHOSTDOWN;
+}
+
+static int mt6878_vote_acquire_boot(struct mt6878_display_vote *vote)
+{
+	bool acked;
+	int ret;
+
+	ret = mt6878_vote_boot_sample(vote, &acked);
+	if (ret || acked)
+		return ret;
+
+	/*
+	 * The clock is already physically on. Acquire the AP vote without
+	 * a compensating CLR, even if the status of a SET write is uncertain.
+	 */
+	ret = regmap_write(vote->voter, MT6878_VOTE_SET, vote->mask);
+	if (ret)
+		return ret;
+
+	return mt6878_vote_wait_ack(vote, true);
+}
+
+/*
+ * Call during serialized boot adoption, with an independent permanent
+ * prepare reference to the topckgen parent. This marks an existing vote;
+ * it does not create or remove a hardware vote.
+ */
+int mt6878_display_vote_retain_boot(struct clk *clk)
+{
+	struct clk_hw *hw = __clk_get_hw(clk);
+	struct mt6878_display_vote *vote;
+	unsigned int i;
+	int ret = -EINVAL;
+
+	if (!hw)
+		return ret;
+	mutex_lock(&mt6878_boot_votes_lock);
+	for (i = 0; i < CLK_MT6878_DISPLAY_VOTE_NR; i++) {
+		vote = mt6878_boot_votes[i];
+		if (!vote || &vote->hw != hw)
+			continue;
+		if (vote->faulted) {
+			ret = -EIO;
+		} else if (vote->held) {
+			ret = -EBUSY;
+		} else {
+			ret = mt6878_vote_boot_status(vote);
+			if (!ret)
+				WRITE_ONCE(vote->boot_retained, true);
+		}
+		break;
+	}
+	mutex_unlock(&mt6878_boot_votes_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6878_display_vote_retain_boot);
+
+int mt6878_display_vote_check_boot(struct clk *clk, unsigned int index)
+{
+	struct clk_hw *hw = __clk_get_hw(clk);
+	struct mt6878_display_vote *vote;
+	int ret = -EHOSTDOWN;
+
+	if (!hw || index >= CLK_MT6878_DISPLAY_VOTE_NR)
+		return -EINVAL;
+	mutex_lock(&mt6878_boot_votes_lock);
+	vote = mt6878_boot_votes[index];
+	if (vote && &vote->hw == hw) {
+		if (READ_ONCE(vote->faulted))
+			ret = -EIO;
+		else if (READ_ONCE(vote->boot_retained) && READ_ONCE(vote->held))
+			ret = 0;
+	}
+	mutex_unlock(&mt6878_boot_votes_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6878_display_vote_check_boot);
+
+static void mt6878_vote_put_parent(struct mt6878_display_vote *vote)
+{
+	clk_disable_unprepare(vote->parent);
+	clk_rate_exclusive_put(vote->parent);
+	WRITE_ONCE(vote->held, false);
+}
+
+static int mt6878_vote_prepare(struct clk_hw *hw)
+{
+	struct mt6878_display_vote *vote = to_mt6878_vote(hw);
+	bool issued, undone;
+	int ret, rollback;
+
+	if (vote->faulted)
+		return -EIO;
+	if (vote->held)
+		return 0;
+
+	ret = clk_rate_exclusive_get(vote->parent);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(vote->parent);
+	if (ret) {
+		clk_rate_exclusive_put(vote->parent);
+		return ret;
+	}
+	WRITE_ONCE(vote->held, true);
+
+	if (READ_ONCE(vote->boot_retained)) {
+		ret = mt6878_vote_boot_status(vote);
+		if (ret) {
+			vote->faulted = true;
+			dev_err(vote->dev, "Inherited vote changed (%d); parent retained\n", ret);
+		}
+		return ret;
+	}
+	ret = mt6878_vote_switch(vote, true, &issued);
+	if (!ret)
+		return 0;
+	if (issued) {
+		rollback = mt6878_vote_switch(vote, false, &undone);
+		if (rollback) {
+			vote->faulted = true;
+			dev_err(vote->dev, "clock vote failed (%d), rollback failed (%d); parent pinned until reboot\n",
+				ret, rollback);
+			return ret;
+		}
+	}
+	mt6878_vote_put_parent(vote);
+	return ret;
+}
+
+static void mt6878_vote_unprepare(struct clk_hw *hw)
+{
+	struct mt6878_display_vote *vote = to_mt6878_vote(hw);
+	bool issued, undone;
+	int ret, rollback = 0;
+
+	if (!vote->held || vote->faulted || READ_ONCE(vote->boot_retained))
+		return;
+	ret = mt6878_vote_switch(vote, false, &issued);
+	if (ret) {
+		if (issued)
+			rollback = mt6878_vote_switch(vote, true, &undone);
+		vote->faulted = true;
+		dev_err(vote->dev, "clock unvote failed (%d), restore result %d; parent pinned until reboot\n",
+			ret, rollback);
+		return;
+	}
+	mt6878_vote_put_parent(vote);
+}
+
+/* No bank access from registration queries or atomic CCF enable/disable paths. */
+static int mt6878_vote_is_prepared(struct clk_hw *hw)
+{
+	return READ_ONCE(to_mt6878_vote(hw)->held);
+}
+
+static const struct clk_ops mt6878_vote_ops = {
+	.prepare = mt6878_vote_prepare,
+	.unprepare = mt6878_vote_unprepare,
+	.is_prepared = mt6878_vote_is_prepared,
+};
+
+static int mt6878_vote_check_parent(struct device_node *np, struct device_node *top,
+				    unsigned int index)
+{
+	struct of_phandle_args args;
+	int ret;
+
+	ret = of_parse_phandle_with_args(np, "clocks", "#clock-cells", index, &args);
+	if (ret)
+		return ret;
+	ret = args.np == top && args.args_count == 1 &&
+		args.args[0] == mt6878_vote_descs[index].parent_id ? 0 : -EINVAL;
+	of_node_put(args.np);
+	return ret;
+}
+
+static void mt6878_vote_unregister_boot_registry(void *arg)
+{
+	struct clk_hw_onecell_data *data = arg;
+	unsigned int i;
+
+	mutex_lock(&mt6878_boot_votes_lock);
+	for (i = 0; i < data->num; i++)
+		if (mt6878_boot_votes[i] && &mt6878_boot_votes[i]->hw == data->hws[i])
+			mt6878_boot_votes[i] = NULL;
+	mutex_unlock(&mt6878_boot_votes_lock);
+}
+
+static int mt6878_display_voter_probe(struct platform_device *pdev)
+{
+	struct clk_bulk_data boot_parents[CLK_MT6878_DISPLAY_VOTE_NR] = {};
+	struct device *dev = &pdev->dev;
+	struct clk_hw_onecell_data *data;
+	struct device_node *top_node;
+	struct regmap *voter, *top;
+	unsigned int i;
+	bool retain_boot = of_property_read_bool(dev->of_node, "mediatek,retain-boot-clocks");
+	bool acquire_boot;
+	int ret;
+
+	acquire_boot = of_property_read_bool(dev->of_node, "mediatek,acquire-boot-clock-votes");
+	if (acquire_boot && !retain_boot)
+		return -EINVAL;
+
+	if (of_clk_get_parent_count(dev->of_node) != CLK_MT6878_DISPLAY_VOTE_NR ||
+	    of_property_count_strings(dev->of_node, "clock-names") != CLK_MT6878_DISPLAY_VOTE_NR)
+		return -EINVAL;
+
+	top_node = of_parse_phandle(dev->of_node, "mediatek,topckgen", 0);
+	if (!top_node)
+		return -EINVAL;
+	if (!of_device_is_compatible(top_node, "mediatek,mt6878-topckgen")) {
+		of_node_put(top_node);
+		return -EINVAL;
+	}
+	for (i = 0; i < CLK_MT6878_DISPLAY_VOTE_NR; i++) {
+		ret = mt6878_vote_check_parent(dev->of_node, top_node, i);
+		if (ret) {
+			of_node_put(top_node);
+			return ret;
+		}
+	}
+	top = syscon_node_to_regmap(top_node);
+	of_node_put(top_node);
+	if (IS_ERR(top))
+		return PTR_ERR(top);
+	voter = syscon_regmap_lookup_by_phandle(dev->of_node, "mediatek,hardware-voter");
+	if (IS_ERR(voter))
+		return PTR_ERR(voter);
+	if (top == voter)
+		return -EINVAL;
+
+	if (!retain_boot) {
+		ret = mt6878_vote_idle(voter, BIT(7) | BIT(15));
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "display clock votes must be idle/unowned\n");
+	} else {
+		for (i = 0; i < CLK_MT6878_DISPLAY_VOTE_NR; i++) {
+			struct mt6878_display_vote probe = {
+				.voter = voter, .top = top, .mask = mt6878_vote_descs[i].mask,
+			};
+
+			bool acked;
+
+			ret = mt6878_vote_boot_sample(&probe, &acked);
+			if (!ret && !acked && !acquire_boot)
+				ret = -EHOSTDOWN;
+			if (ret)
+				return dev_err_probe(dev, ret,
+						     "inherited display vote is unstable\n");
+		}
+	}
+
+	data = devm_kzalloc(dev, struct_size(data, hws, CLK_MT6878_DISPLAY_VOTE_NR), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	data->num = CLK_MT6878_DISPLAY_VOTE_NR;
+	if (retain_boot) {
+		/* Resolve dependencies before a permanent registration attempt. */
+		for (i = 0; i < data->num; i++) {
+			boot_parents[i].clk = clk_get(dev, mt6878_vote_descs[i].input);
+			if (IS_ERR(boot_parents[i].clk)) {
+				ret = PTR_ERR(boot_parents[i].clk);
+				goto put_boot_parents;
+			}
+		}
+		mutex_lock(&mt6878_boot_votes_lock);
+		if (mt6878_boot_voter_attempted) {
+			mutex_unlock(&mt6878_boot_votes_lock);
+			ret = -EBUSY;
+			goto put_boot_parents;
+		}
+		mt6878_boot_voter_attempted = true;
+		mutex_unlock(&mt6878_boot_votes_lock);
+
+		/* Pin both live parent trees before critical registration can unwind. */
+		ret = clk_bulk_prepare_enable_if_active(data->num, boot_parents);
+		if (ret) {
+			mutex_lock(&mt6878_boot_votes_lock);
+			mt6878_boot_voter_attempted = false;
+			mutex_unlock(&mt6878_boot_votes_lock);
+			/*
+			 * The parent PLL trees are held by consumers that may probe
+			 * later (Stage 61: univpll unheld at 0.07 s); retry then.
+			 */
+			if (ret == -EAGAIN)
+				ret = -EPROBE_DEFER;
+			dev_err_probe(dev, ret, "cannot acquire inherited parent holds safely\n");
+			goto put_boot_parents;
+		}
+		/* Keep the handles and references until reboot, including on error. */
+	}
+	if (acquire_boot) {
+		static const unsigned int order[] = {
+			CLK_MT6878_MMINFRA_VOTE, CLK_MT6878_DISP_VOTE,
+		};
+
+		for (i = 0; i < data->num; i++) {
+			ret = clk_rate_exclusive_get(boot_parents[i].clk);
+			if (ret)
+				return ret;
+		}
+
+		/* Both parent trees are pinned before adding either AP vote. */
+		for (i = 0; i < ARRAY_SIZE(order); i++) {
+			const struct mt6878_vote_desc *desc = &mt6878_vote_descs[order[i]];
+			struct mt6878_display_vote boot = {
+				.voter = voter, .top = top, .mask = desc->mask,
+			};
+
+			ret = mt6878_vote_acquire_boot(&boot);
+			if (ret)
+				return dev_err_probe(dev, ret, "boot %s vote failed\n",
+						     desc->input);
+		}
+	}
+	for (i = 0; i < data->num; i++) {
+		const struct mt6878_vote_desc *desc = &mt6878_vote_descs[i];
+		struct clk_parent_data parent = { .fw_name = desc->input };
+		struct clk_init_data init = {
+			.name = desc->name, .ops = &mt6878_vote_ops,
+			.parent_data = &parent, .num_parents = 1,
+		};
+		struct mt6878_display_vote *vote;
+
+		if (of_property_match_string(dev->of_node, "clock-names", desc->input) != (int)i)
+			return -EINVAL;
+		vote = devm_kzalloc(dev, sizeof(*vote), GFP_KERNEL);
+		if (!vote)
+			return -ENOMEM;
+		if (retain_boot)
+			vote->parent = boot_parents[i].clk;
+		else
+			vote->parent = devm_clk_get(dev, desc->input);
+		if (IS_ERR(vote->parent))
+			return dev_err_probe(dev, PTR_ERR(vote->parent),
+					     "missing %s parent\n", desc->input);
+		vote->dev = dev;
+		vote->voter = voter;
+		vote->top = top;
+		vote->mask = desc->mask;
+		vote->boot_retained = retain_boot;
+		if (retain_boot)
+			init.flags |= CLK_IS_CRITICAL;
+		vote->hw.init = &init;
+		ret = devm_clk_hw_register(dev, &vote->hw);
+		if (ret)
+			return ret;
+		data->hws[i] = &vote->hw;
+	}
+
+	mutex_lock(&mt6878_boot_votes_lock);
+	for (i = 0; i < data->num; i++) {
+		if (mt6878_boot_votes[i]) {
+			mutex_unlock(&mt6878_boot_votes_lock);
+			return -EBUSY;
+		}
+	}
+	for (i = 0; i < data->num; i++)
+		mt6878_boot_votes[i] = to_mt6878_vote(data->hws[i]);
+	mutex_unlock(&mt6878_boot_votes_lock);
+	ret = devm_add_action_or_reset(dev, mt6878_vote_unregister_boot_registry, data);
+	if (ret)
+		return ret;
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, data);
+
+put_boot_parents:
+	while (i)
+		clk_put(boot_parents[--i].clk);
+	return ret;
+}
+
+static const struct of_device_id mt6878_display_voter_of_match[] = {
+	{ .compatible = "mediatek,mt6878-display-clock-voter" },
+	{ /* sentinel */ }
+};
+
+/* Built-in, fixed DT provider: pinned fault references have system lifetime. */
+static struct platform_driver mt6878_display_voter_driver = {
+	.probe = mt6878_display_voter_probe,
+	.driver = {
+		.name = "mt6878-display-clock-voter",
+		.of_match_table = mt6878_display_voter_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(mt6878_display_voter_driver);
diff --git a/drivers/clk/mediatek/clk-mt6878-gce.c b/drivers/clk/mediatek/clk-mt6878-gce.c
new file mode 100644
index 000000000..ce8ae2bd1
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6878-gce.c
@@ -0,0 +1,352 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6878 display GCE hardware-voted gates. */
+
+#include <dt-bindings/clock/mediatek,mt6878-display-voter.h>
+#include <dt-bindings/clock/mediatek,mt6878-gce-clocks.h>
+#include <dt-bindings/power/mediatek,mt6878-power.h>
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/of_address.h>
+#include <linux/of_clk.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+
+#define GCE_VOTE_POLL_US		10
+#define GCE_VOTE_TIMEOUT_US	100000
+
+struct mt6878_gce_gate_desc {
+	const char *name;
+	u32 set;
+	u32 clear;
+	u32 done;
+	u32 status;
+	u32 mask;
+};
+
+struct mt6878_gce_clocks {
+	struct device *dev;
+	struct regmap *voter;
+	void __iomem *base;
+	struct clk *parent;
+	bool faulted;
+};
+
+struct mt6878_gce_gate {
+	struct clk_hw hw;
+	struct mt6878_gce_clocks *clocks;
+	const struct mt6878_gce_gate_desc *desc;
+	bool held;
+};
+
+static const struct mt6878_gce_gate_desc mt6878_gce_gate_descs[] = {
+	[CLK_MT6878_GCE_D] = {
+		.name = "mt6878_gce_d", .set = 0x0, .clear = 0x4,
+		.done = 0x1c00, .status = 0x100, .mask = BIT(0),
+	},
+	[CLK_MT6878_GCE_TIMER] = {
+		.name = "mt6878_gce_timer", .set = 0x8, .clear = 0xc,
+		.done = 0x1c04, .status = 0x110, .mask = BIT(17),
+	},
+};
+
+#define to_gce_gate(_hw) container_of(_hw, struct mt6878_gce_gate, hw)
+
+static int mt6878_gce_vote(struct mt6878_gce_gate *gate, bool on, bool *issued)
+{
+	const struct mt6878_gce_gate_desc *desc = gate->desc;
+	struct mt6878_gce_clocks *clocks = gate->clocks;
+	u32 val;
+	int ret;
+
+	*issued = false;
+	ret = regmap_read_poll_timeout(clocks->voter, desc->done, val, val & desc->mask,
+				       GCE_VOTE_POLL_US, GCE_VOTE_TIMEOUT_US);
+	if (ret)
+		return ret;
+
+	if (!on) {
+		/* The vendor sequence first clears the voter bus idle indication. */
+		ret = regmap_read(clocks->voter, desc->clear, &val);
+		if (ret)
+			return ret;
+	}
+
+	*issued = true;
+	ret = regmap_write(clocks->voter, on ? desc->set : desc->clear, desc->mask);
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout(clocks->voter, desc->set, val,
+				       !!(val & desc->mask) == on,
+				       GCE_VOTE_POLL_US, GCE_VOTE_TIMEOUT_US);
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout(clocks->voter, desc->done, val, val & desc->mask,
+				       GCE_VOTE_POLL_US, GCE_VOTE_TIMEOUT_US);
+	if (ret || !on)
+		return ret;
+
+	return readl_poll_timeout(clocks->base + desc->status, val, !(val & desc->mask),
+				  GCE_VOTE_POLL_US, GCE_VOTE_TIMEOUT_US);
+}
+
+static void mt6878_gce_put(struct mt6878_gce_gate *gate)
+{
+	struct mt6878_gce_clocks *clocks = gate->clocks;
+
+	clk_disable_unprepare(clocks->parent);
+	/* Schedule idle outside the CCF prepare lock. */
+	pm_runtime_put(clocks->dev);
+	WRITE_ONCE(gate->held, false);
+}
+
+static int mt6878_gce_prepare(struct clk_hw *hw)
+{
+	struct mt6878_gce_gate *gate = to_gce_gate(hw);
+	struct mt6878_gce_clocks *clocks = gate->clocks;
+	bool issued, undone;
+	int ret;
+
+	if (clocks->faulted)
+		return -EIO;
+
+	/* A consumer must resume the supplier before taking the CCF lock. */
+	ret = pm_runtime_get_if_in_use(clocks->dev);
+	if (ret <= 0)
+		return ret ? ret : -EHOSTDOWN;
+
+	/* Keep an explicit parent reference if CCF unwinds after a fault. */
+	ret = clk_prepare_enable(clocks->parent);
+	if (ret) {
+		pm_runtime_put(clocks->dev);
+		return ret;
+	}
+	WRITE_ONCE(gate->held, true);
+
+	ret = mt6878_gce_vote(gate, true, &issued);
+	if (!ret)
+		return 0;
+	if (issued && mt6878_gce_vote(gate, false, &undone)) {
+		clocks->faulted = true;
+		dev_err(clocks->dev, "GCE vote rollback failed; retaining power and parent clock\n");
+		return ret;
+	}
+
+	mt6878_gce_put(gate);
+	return ret;
+}
+
+static void mt6878_gce_unprepare(struct clk_hw *hw)
+{
+	struct mt6878_gce_gate *gate = to_gce_gate(hw);
+	struct mt6878_gce_clocks *clocks = gate->clocks;
+	bool issued;
+
+	if (!gate->held || clocks->faulted)
+		return;
+	if (mt6878_gce_vote(gate, false, &issued)) {
+		clocks->faulted = true;
+		dev_err(clocks->dev, "GCE unvote failed; retaining power and parent clock\n");
+		return;
+	}
+
+	mt6878_gce_put(gate);
+}
+
+static int mt6878_gce_is_prepared(struct clk_hw *hw)
+{
+	return READ_ONCE(to_gce_gate(hw)->held);
+}
+
+static const struct clk_ops mt6878_gce_clk_ops = {
+	.prepare = mt6878_gce_prepare,
+	.unprepare = mt6878_gce_unprepare,
+	.is_prepared = mt6878_gce_is_prepared,
+};
+
+static int mt6878_gce_check_supplier(struct device_node *np, const char *property,
+				     const char *cells, const char *compatible, u32 id)
+{
+	struct of_phandle_args args;
+	int ret;
+
+	if (of_count_phandle_with_args(np, property, cells) != 1)
+		return -EINVAL;
+	ret = of_parse_phandle_with_args(np, property, cells, 0, &args);
+	if (ret)
+		return ret;
+	ret = of_device_is_available(args.np) && of_device_is_compatible(args.np, compatible) &&
+		args.args_count == 1 && args.args[0] == id ? 0 : -EINVAL;
+	of_node_put(args.np);
+
+	return ret;
+}
+
+static struct regmap *mt6878_gce_get_voter(struct device_node *np)
+{
+	struct device_node *voter;
+	struct resource res;
+	struct regmap *map;
+	int ret;
+
+	voter = of_parse_phandle(np, "mediatek,hardware-voter", 0);
+	if (!voter)
+		return ERR_PTR(-EINVAL);
+	ret = of_address_to_resource(voter, 0, &res);
+	if (ret || !of_device_is_available(voter) ||
+	    !of_device_is_compatible(voter, "mediatek,mt6878-hwv") ||
+	    res.start != 0x10320000 || resource_size(&res) < 0x2000)
+		map = ERR_PTR(ret ? ret : -EINVAL);
+	else
+		map = syscon_node_to_regmap(voter);
+	of_node_put(voter);
+
+	return map;
+}
+
+static int mt6878_gce_check_idle(struct regmap *voter, const struct mt6878_gce_gate_desc *desc)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read(voter, desc->set, &val);
+	if (ret || val & desc->mask)
+		return ret ?: -EBUSY;
+	ret = regmap_read(voter, desc->done, &val);
+	if (ret)
+		return ret;
+
+	return val & desc->mask ? 0 : -EBUSY;
+}
+
+static void mt6878_gce_unregister(void *hw)
+{
+	clk_hw_unregister(hw);
+}
+
+static int mt6878_gce_register_gate(struct mt6878_gce_clocks *clocks,
+				    struct clk_hw_onecell_data *data, unsigned int id)
+{
+	const struct mt6878_gce_gate_desc *desc = &mt6878_gce_gate_descs[id];
+	struct device *dev = clocks->dev;
+	struct clk_parent_data parent = { .fw_name = "mminfra" };
+	struct clk_init_data init = {
+		.name = desc->name,
+		.ops = &mt6878_gce_clk_ops,
+		.parent_data = &parent,
+		.num_parents = 1,
+	};
+	struct mt6878_gce_gate *gate;
+	int ret;
+
+	gate = devm_kzalloc(dev, sizeof(*gate), GFP_KERNEL);
+	if (!gate)
+		return -ENOMEM;
+	gate->desc = desc;
+	gate->clocks = clocks;
+	gate->hw.init = &init;
+
+	/* Keep CCF from automatically resuming this provider under its lock. */
+	ret = of_clk_hw_register(dev->of_node, &gate->hw);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, mt6878_gce_unregister, &gate->hw);
+	if (ret)
+		return ret;
+	data->hws[id] = &gate->hw;
+
+	return 0;
+}
+
+static int mt6878_gce_clocks_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct mt6878_gce_clocks *clocks;
+	struct clk_hw_onecell_data *data;
+	struct resource *res;
+	unsigned int id;
+	int ret;
+
+	for_each_compatible_node_scoped(node, NULL, "mediatek,mt6878-mminfra_config")
+		if (of_device_is_available(node))
+			return dev_err_probe(dev, -EBUSY,
+					     "legacy MM_INFRA clock provider is enabled\n");
+
+	ret = mt6878_gce_check_supplier(np, "power-domains", "#power-domain-cells",
+					"mediatek,mt6878-display-power-controller",
+					MT6878_POWER_DOMAIN_MM_INFRA);
+	if (ret || !dev->pm_domain)
+		return ret ?: -EINVAL;
+	ret = mt6878_gce_check_supplier(np, "clocks", "#clock-cells",
+					"mediatek,mt6878-display-clock-voter",
+					CLK_MT6878_MMINFRA_VOTE);
+	if (ret)
+		return ret;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || res->start != 0x1e800000 || resource_size(res) != 0x1000 ||
+	    platform_get_resource(pdev, IORESOURCE_MEM, 1))
+		return -EINVAL;
+	clocks = devm_kzalloc(dev, sizeof(*clocks), GFP_KERNEL);
+	if (!clocks)
+		return -ENOMEM;
+	clocks->dev = dev;
+	clocks->base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(clocks->base))
+		return PTR_ERR(clocks->base);
+	clocks->voter = mt6878_gce_get_voter(np);
+	if (IS_ERR(clocks->voter))
+		return PTR_ERR(clocks->voter);
+	clocks->parent = devm_clk_get(dev, "mminfra");
+	if (IS_ERR(clocks->parent))
+		return dev_err_probe(dev, PTR_ERR(clocks->parent),
+				     "missing MM_INFRA vote parent\n");
+
+	for (id = 0; id < ARRAY_SIZE(mt6878_gce_gate_descs); id++) {
+		if (!mt6878_gce_gate_descs[id].mask)
+			continue;
+		ret = mt6878_gce_check_idle(clocks->voter, &mt6878_gce_gate_descs[id]);
+		if (ret)
+			return dev_err_probe(dev, ret, "GCE vote must be idle before probe\n");
+	}
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	data = devm_kzalloc(dev, struct_size(data, hws, ARRAY_SIZE(mt6878_gce_gate_descs)),
+			    GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	data->num = ARRAY_SIZE(mt6878_gce_gate_descs);
+	for (id = 0; id < data->num; id++) {
+		if (!mt6878_gce_gate_descs[id].mask) {
+			data->hws[id] = ERR_PTR(-ENOENT);
+			continue;
+		}
+		ret = mt6878_gce_register_gate(clocks, data, id);
+		if (ret)
+			return ret;
+	}
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, data);
+}
+
+static const struct of_device_id mt6878_gce_clocks_of_match[] = {
+	{ .compatible = "mediatek,mt6878-gce-clocks" },
+	{ }
+};
+
+/* Fixed built-in provider; ambiguous clock votes retain resources until reboot. */
+static struct platform_driver mt6878_gce_clocks_driver = {
+	.probe = mt6878_gce_clocks_probe,
+	.driver = {
+		.name = "mt6878-gce-clocks",
+		.of_match_table = mt6878_gce_clocks_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(mt6878_gce_clocks_driver);
