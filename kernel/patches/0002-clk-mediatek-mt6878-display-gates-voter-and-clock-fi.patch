+	[CLK_MM_SMI_COMMON] = MM_GATE("native_mm_smi_common", 0x100, 31),
+	[CLK_MM_DSI0] = MM_GATE("native_mm_dsi0_ck", 0x110, 0),
+	[CLK_MM_DSI1] = MM_GATE("native_mm_dsi1_ck", 0x110, 1),
+	[CLK_MM_26M] = MM_GATE("native_mm_26m_ck", 0x110, 11),
+	[CLK_MM_NR_CLK + CLK_MDP_MUTEX0] = MDP_GATE("native_mdp_mutex0", 0),
+	[CLK_MM_NR_CLK + CLK_MDP_APB_BUS] = MDP_GATE("native_mdp_apb_bus", 1),
+	[CLK_MM_NR_CLK + CLK_MDP_SMI0] = MDP_GATE("native_mdp_smi0", 2),
+	[CLK_MM_NR_CLK + CLK_MDP_RDMA0] = MDP_GATE("native_mdp_rdma0", 3),
+	[CLK_MM_NR_CLK + CLK_MDP_HDR0] = MDP_GATE("native_mdp_hdr0", 5),
+	[CLK_MM_NR_CLK + CLK_MDP_AAL0] = MDP_GATE("native_mdp_aal0", 6),
+	[CLK_MM_NR_CLK + CLK_MDP_RSZ0] = MDP_GATE("native_mdp_rsz0", 7),
+	[CLK_MM_NR_CLK + CLK_MDP_TDSHP0] = MDP_GATE("native_mdp_tdshp0", 8),
+	[CLK_MM_NR_CLK + CLK_MDP_WROT0] = MDP_GATE("native_mdp_wrot0", 10),
+	[CLK_MM_NR_CLK + CLK_MDP_RDMA1] = MDP_GATE("native_mdp_rdma1", 15),
+	[CLK_MM_NR_CLK + CLK_MDP_RSZ1] = MDP_GATE("native_mdp_rsz1", 19),
+	[CLK_MM_NR_CLK + CLK_MDP_WROT1] = MDP_GATE("native_mdp_wrot1", 22),
+};
+
+#define to_mt6878_gate(_hw) container_of(_hw, struct mt6878_display_gate, hw)
+
+static int mt6878_gate_power(struct mt6878_gate_block *block, bool cold)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read(block->spm, MT6878_DISP_CTL, &val);
+	if (ret)
+		return ret;
+	if (cold)
+		return val & (BIT(2) | BIT(3) | BIT(30) | BIT(31)) ? -EBUSY : 0;
+	return (val & (MT6878_DISP_ON | MT6878_DISP_BLOCKED)) == MT6878_DISP_ON ?
+		0 : -EHOSTDOWN;
+}
+
+static int mt6878_gate_status(struct mt6878_display_gate *gate, u32 *val)
+{
+	struct mt6878_gate_block *block = gate->block;
+	int ret;
+
+	ret = mt6878_gate_power(block, false);
+	if (ret)
+		return ret;
+	return regmap_read(gate->desc->mdp ? block->mdp : block->mm,
+			   gate->desc->status, val);
+}
+
+/* Called only in process context under CCF's prepare lock. */
+static int mt6878_gate_switch(struct mt6878_display_gate *gate, bool on, bool *issued)
+{
+	struct mt6878_gate_block *block = gate->block;
+	u32 val;
+	int ret, poll;
+
+	*issued = false;
+	ret = mt6878_gate_power(block, false);
+	if (ret)
+		return ret;
+	*issued = true;
+	ret = regmap_write(gate->desc->mdp ? block->mdp : block->mm,
+			   gate->desc->status + (on ? 8 : 4), gate->desc->mask);
+	if (ret)
+		return ret;
+	poll = read_poll_timeout(mt6878_gate_status, ret,
+				 ret || (!!(val & gate->desc->mask) != on),
+				 10, 1000, false, gate, &val);
+	return ret ? ret : poll;
+}
+
+static void mt6878_gate_put_parent(struct mt6878_display_gate *gate)
+{
+	clk_disable_unprepare(gate->block->parent);
+	clk_rate_exclusive_put(gate->block->parent);
+	WRITE_ONCE(gate->held, false);
+	atomic_dec(&gate->block->held_count);
+}
+
+static int mt6878_gate_prepare(struct clk_hw *hw)
+{
+	struct mt6878_display_gate *gate = to_mt6878_gate(hw);
+	struct clk *parent = gate->block->parent;
+	bool issued, undone;
+	int ret, rollback;
+
+	if (READ_ONCE(gate->block->faulted))
+		return -EIO;
+	if (gate->held)
+		return 0;
+	ret = clk_rate_exclusive_get(parent);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(parent);
+	if (ret) {
+		clk_rate_exclusive_put(parent);
+		return ret;
+	}
+	WRITE_ONCE(gate->held, true);
+	atomic_inc(&gate->block->held_count);
+	if (READ_ONCE(gate->boot_retained)) {
+		u32 val;
+
+		ret = mt6878_gate_status(gate, &val);
+		if (!ret && (val & gate->desc->mask))
+			ret = -EHOSTDOWN;
+		if (ret) {
+			gate->faulted = true;
+			WRITE_ONCE(gate->block->faulted, true);
+		}
+		/* The inherited gate and acquired parent stay pinned on failure. */
+		return ret;
+	}
+	ret = mt6878_gate_switch(gate, true, &issued);
+	if (!ret)
+		return 0;
+	if (issued) {
+		rollback = mt6878_gate_switch(gate, false, &undone);
+		if (rollback) {
+			gate->faulted = true;
+			WRITE_ONCE(gate->block->faulted, true);
+			dev_err(gate->block->dev, "%s failed (%d), rollback failed (%d); parent pinned\n",
+				gate->desc->name, ret, rollback);
+			return ret;
+		}
+	}
+	mt6878_gate_put_parent(gate);
+	return ret;
+}
+
+static void mt6878_gate_unprepare(struct clk_hw *hw)
+{
+	struct mt6878_display_gate *gate = to_mt6878_gate(hw);
+	bool issued, undone;
+	int ret, rollback = 0;
+
+	if (!gate->held || gate->faulted)
+		return;
+	/*
+	 * Stage 82: a boot-retained gate stays open in hardware (LK's state),
+	 * but its Linux hold is released so the block can become idle. It is
+	 * closed only by the DISP power cut (mt6878_display_gates_power_lost).
+	 */
+	if (READ_ONCE(gate->boot_retained)) {
+		mt6878_gate_put_parent(gate);
+		return;
+	}
+	ret = mt6878_gate_switch(gate, false, &issued);
+	if (ret) {
+		if (issued)
+			rollback = mt6878_gate_switch(gate, true, &undone);
+		gate->faulted = true;
+		WRITE_ONCE(gate->block->faulted, true);
+		dev_err(gate->block->dev, "%s release failed (%d), restore %d; parent pinned\n",
+			gate->desc->name, ret, rollback);
+		return;
+	}
+	mt6878_gate_put_parent(gate);
+}
+
+/* Registration, unused-clock queries and atomic paths never access gate banks. */
+static int mt6878_gate_is_prepared(struct clk_hw *hw)
+{
+	return READ_ONCE(to_mt6878_gate(hw)->held);
+}
+
+static const struct clk_ops mt6878_gate_ops = {
+	.prepare = mt6878_gate_prepare,
+	.unprepare = mt6878_gate_unprepare,
+	.is_prepared = mt6878_gate_is_prepared,
+};
+
+/*
+ * Staged adoption primitive. Call before publishing consumers, while a
+ * separate Linux prepare reference permanently pins the DISP vote parent.
+ * Retention is monotonic and deliberately has no release operation.
+ */
+int mt6878_display_gate_retain_boot(struct clk *clk)
+{
+	struct clk_hw *hw = __clk_get_hw(clk);
+	struct mt6878_display_gate *gate;
+	struct mt6878_gate_block *block;
+	unsigned int i;
+	u32 val;
+	int ret = -EINVAL;
+
+	if (!hw)
+		return -EINVAL;
+	mutex_lock(&mt6878_gate_blocks_lock);
+	list_for_each_entry(block, &mt6878_gate_blocks, entry) {
+		for (i = 0; i < block->clocks->num; i++) {
+			if (block->clocks->hws[i] != hw)
+				continue;
+			gate = to_mt6878_gate(hw);
+			if (block->faulted || gate->faulted) {
+				ret = -EIO;
+				goto out;
+			}
+			if (gate->held) {
+				ret = -EBUSY;
+				goto out;
+			}
+			ret = mt6878_gate_status(gate, &val);
+			if (!ret && (val & gate->desc->mask))
+				ret = -EHOSTDOWN;
+			if (!ret)
+				WRITE_ONCE(gate->boot_retained, true);
+			goto out;
+		}
+	}
+out:
+	mutex_unlock(&mt6878_gate_blocks_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6878_display_gate_retain_boot);
+
+/* Cached process-context query: never takes the CCF lock or accesses MMIO. */
+int mt6878_display_gates_check(struct clk *clk, unsigned int smi, bool idle)
+{
+	struct mt6878_gate_block *block;
+	struct clk_hw *hw = __clk_get_hw(clk);
+	unsigned int i;
+	int ret = -EPROBE_DEFER;
+
+	if (!hw || smi > 1)
+		return -EINVAL;
+	mutex_lock(&mt6878_gate_blocks_lock);
+	if (!list_empty(&mt6878_gate_blocks))
+		ret = -EINVAL;
+	list_for_each_entry(block, &mt6878_gate_blocks, entry) {
+		for (i = 0; i < block->clocks->num; i++) {
+			if (block->clocks->hws[i] != hw)
+				continue;
+			if (i != (smi ? CLK_MM_NR_CLK + CLK_MDP_SMI0 : CLK_MM_SMI_COMMON)) {
+				ret = -EINVAL;
+				goto out;
+			}
+			ret = READ_ONCE(block->faulted) ? -EIO : 0;
+			if (!ret && idle && atomic_read(&block->held_count))
+				ret = -EBUSY;
+			goto out;
+		}
+	}
+out:
+	mutex_unlock(&mt6878_gate_blocks_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6878_display_gates_check);
+
+/* Caller holds mt6878_gate_blocks_lock. */
+static struct mt6878_gate_block *mt6878_gate_find_block(struct clk_hw *hw)
+{
+	struct mt6878_gate_block *block;
+	unsigned int i;
+
+	list_for_each_entry(block, &mt6878_gate_blocks, entry)
+		for (i = 0; i < block->clocks->num; i++)
+			if (block->clocks->hws[i] == hw)
+				return block;
+	return NULL;
+}
+
+int mt6878_display_gates_held(struct clk *clk, bool log)
+{
+	struct clk_hw *hw = __clk_get_hw(clk);
+	struct mt6878_gate_block *block;
+	unsigned int i;
+	int ret = -EINVAL;
+
+	if (!hw)
+		return -EINVAL;
+	mutex_lock(&mt6878_gate_blocks_lock);
+	block = mt6878_gate_find_block(hw);
+	if (block) {
+		ret = atomic_read(&block->held_count);
+		for (i = 0; log && i < block->clocks->num; i++) {
+			struct mt6878_display_gate *gate = to_mt6878_gate(block->clocks->hws[i]);
+
+			if (READ_ONCE(gate->held))
+				dev_info(block->dev, "held: %s%s\n", gate->desc->name,
+					 READ_ONCE(gate->boot_retained) ? " (boot)" : "");
+		}
+	}
+	mutex_unlock(&mt6878_gate_blocks_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6878_display_gates_held);
+
+/*
+ * Stage 82: DISP is about to lose power, so every gate returns to its reset
+ * state and LK's retained configuration no longer exists. Later prepares use
+ * the ordinary switch path. The block must be idle.
+ */
+int mt6878_display_gates_power_lost(struct clk *clk)
+{
+	struct clk_hw *hw = __clk_get_hw(clk);
+	struct mt6878_gate_block *block;
+	unsigned int i;
+	int ret = -EINVAL;
+
+	if (!hw)
+		return -EINVAL;
+	mutex_lock(&mt6878_gate_blocks_lock);
+	block = mt6878_gate_find_block(hw);
+	if (block) {
+		ret = 0;
+		if (READ_ONCE(block->faulted))
+			ret = -EIO;
+		else if (atomic_read(&block->held_count))
+			ret = -EBUSY;
+		for (i = 0; !ret && i < block->clocks->num; i++)
+			WRITE_ONCE(to_mt6878_gate(block->clocks->hws[i])->boot_retained, false);
+	}
+	mutex_unlock(&mt6878_gate_blocks_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6878_display_gates_power_lost);
+
+static void mt6878_gate_unregister_block(void *data)
+{
+	struct mt6878_gate_block *block = data;
+
+	mutex_lock(&mt6878_gate_blocks_lock);
+	list_del(&block->entry);
+	mutex_unlock(&mt6878_gate_blocks_lock);
+}
+
+static struct clk_hw *mt6878_gate_get(struct of_phandle_args *args, void *data)
+{
+	struct clk_hw_onecell_data *clocks = data;
+	u32 id, bank;
+
+	if (args->args_count != 2)
+		return ERR_PTR(-EINVAL);
+	bank = args->args[0];
+	id = args->args[1];
+	if (bank == MT6878_DISPLAY_GATE_MM && id < CLK_MM_NR_CLK)
+		return clocks->hws[id];
+	if (bank == MT6878_DISPLAY_GATE_MDP && id < CLK_MDP_NR_CLK)
+		return clocks->hws[CLK_MM_NR_CLK + id];
+	return ERR_PTR(-EINVAL);
+}
+
+static int mt6878_gate_legacy_check(void)
+{
+	static const char * const compatibles[] = {
+		"mediatek,mt6878-mmsys0", "mediatek,mt6878-mdpsys",
+	};
+	struct device_node *node;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(compatibles); i++)
+		for_each_compatible_node(node, NULL, compatibles[i])
+			if (of_device_is_available(node)) {
+				of_node_put(node);
+				return -EBUSY;
+			}
+	return 0;
+}
+
+static int mt6878_gate_parent_check(struct device_node *np)
+{
+	struct of_phandle_args args;
+	int ret;
+
+	if (of_clk_get_parent_count(np) != 1 ||
+	    of_property_count_strings(np, "clock-names") != 1 ||
+	    of_property_match_string(np, "clock-names", "disp") != 0)
+		return -EINVAL;
+	ret = of_parse_phandle_with_args(np, "clocks", "#clock-cells", 0, &args);
+	if (ret)
+		return ret;
+	ret = of_device_is_compatible(args.np, "mediatek,mt6878-display-clock-voter") &&
+		args.args_count == 1 && args.args[0] == CLK_MT6878_DISP_VOTE ? 0 : -EINVAL;
+	if (!ret && of_property_read_bool(np, "mediatek,retain-boot-clocks") &&
+	    !of_property_read_bool(args.np, "mediatek,retain-boot-clocks"))
+		ret = -EINVAL;
+	of_node_put(args.np);
+	return ret;
+}
+
+/* A generic debugfs register dump must not read a powered-off gate bank. */
+static bool mt6878_gate_precious(struct device *dev, unsigned int reg)
+{
+	return true;
+}
+
+static const struct regmap_config mt6878_mm_gate_config = {
+	.reg_bits = 32, .val_bits = 32, .reg_stride = 4, .max_register = 0x118,
+	.precious_reg = mt6878_gate_precious,
+};
+
+static const struct regmap_config mt6878_mdp_gate_config = {
+	.reg_bits = 32, .val_bits = 32, .reg_stride = 4, .max_register = 0x108,
+	.precious_reg = mt6878_gate_precious,
+};
+
+static int mt6878_display_gates_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mt6878_gate_block *block;
+	struct clk_hw_onecell_data *data;
+	struct device_node *mm_node, *spm_node;
+	struct resource *mdp_resource;
+	struct resource resource;
+	void __iomem *base;
+	unsigned int i;
+	bool retain_boot = of_property_read_bool(dev->of_node, "mediatek,retain-boot-clocks");
+	int ret;
+
+	ret = mt6878_gate_legacy_check();
+	if (ret)
+		return dev_err_probe(dev, ret, "legacy display gate providers must be disabled\n");
+	ret = mt6878_gate_parent_check(dev->of_node);
+	if (ret)
+		return ret;
+	block = devm_kzalloc(dev, sizeof(*block), GFP_KERNEL);
+	if (!block)
+		return -ENOMEM;
+	block->dev = dev;
+	spm_node = of_parse_phandle(dev->of_node, "mediatek,spm", 0);
+	if (!spm_node)
+		return -EINVAL;
+	ret = of_address_to_resource(spm_node, 0, &resource);
+	if (ret || resource.start != 0x1c001000 || resource_size(&resource) < 0xe74) {
+		of_node_put(spm_node);
+		return ret ? ret : -EINVAL;
+	}
+	block->spm = syscon_node_to_regmap(spm_node);
+	of_node_put(spm_node);
+	if (IS_ERR(block->spm))
+		return PTR_ERR(block->spm);
+	ret = mt6878_gate_power(block, !retain_boot);
+	if (ret)
+		return dev_err_probe(dev, ret, "invalid DISP state for gate registration\n");
+
+	mm_node = of_parse_phandle(dev->of_node, "mediatek,mmsys", 0);
+	if (!mm_node)
+		return -EINVAL;
+	if (!of_device_is_available(mm_node) ||
+	    !of_device_is_compatible(mm_node, "mediatek,mt6878-mmsys0-native")) {
+		of_node_put(mm_node);
+		return -EINVAL;
+	}
+	ret = of_address_to_resource(mm_node, 0, &resource);
+	of_node_put(mm_node);
+	if (ret)
+		return ret;
+	if (resource.start != 0x14000000 || resource_size(&resource) < 0x11c)
+		return -EINVAL;
+	/* Share the configuration bank with the powered MMSYS route controller. */
+	base = devm_ioremap(dev, resource.start, resource_size(&resource));
+	if (!base)
+		return -ENOMEM;
+	block->mm = devm_regmap_init_mmio(dev, base, &mt6878_mm_gate_config);
+	if (IS_ERR(block->mm))
+		return PTR_ERR(block->mm);
+	mdp_resource = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!mdp_resource || mdp_resource->start != 0x1f000000 ||
+	    resource_size(mdp_resource) < 0x10c)
+		return -EINVAL;
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	block->mdp = devm_regmap_init_mmio(dev, base, &mt6878_mdp_gate_config);
+	if (IS_ERR(block->mdp))
+		return PTR_ERR(block->mdp);
+	block->parent = devm_clk_get(dev, "disp");
+	if (IS_ERR(block->parent))
+		return dev_err_probe(dev, PTR_ERR(block->parent), "missing DISP vote clock\n");
+
+	data = devm_kzalloc(dev, struct_size(data, hws, MT6878_GATE_COUNT), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	data->num = MT6878_GATE_COUNT;
+	atomic_set(&block->held_count, 0);
+	if (retain_boot) {
+		mutex_lock(&mt6878_gate_blocks_lock);
+		if (mt6878_boot_gates_attempted) {
+			mutex_unlock(&mt6878_gate_blocks_lock);
+			return -EBUSY;
+		}
+		mt6878_boot_gates_attempted = true;
+		mutex_unlock(&mt6878_gate_blocks_lock);
+	}
+	for (i = 0; i < data->num; i++) {
+		struct clk_parent_data parent = { .fw_name = "disp" };
+		struct clk_init_data init = {
+			.name = mt6878_gates[i].name, .ops = &mt6878_gate_ops,
+			.parent_data = &parent, .num_parents = 1,
+		};
+		struct mt6878_display_gate *gate;
+
+		gate = devm_kzalloc(dev, sizeof(*gate), GFP_KERNEL);
+		if (!gate)
+			return -ENOMEM;
+		gate->block = block;
+		gate->desc = &mt6878_gates[i];
+		if (retain_boot) {
+			u32 status;
+
+			ret = mt6878_gate_status(gate, &status);
+			if (ret)
+				return ret;
+			/*
+			 * Stage 82: no CLK_IS_CRITICAL. Unused retained gates are
+			 * never prepared, so disable_unused skips them (is_prepared
+			 * is false) and they stay open as LK left them.
+			 */
+			gate->boot_retained = !(status & gate->desc->mask);
+		}
+		gate->hw.init = &init;
+		ret = devm_clk_hw_register(dev, &gate->hw);
+		if (ret)
+			return ret;
+		data->hws[i] = &gate->hw;
+	}
+	block->clocks = data;
+	mutex_lock(&mt6878_gate_blocks_lock);
+	/* Physical bank addresses are fixed: only one owner may register. */
+	if (!list_empty(&mt6878_gate_blocks)) {
+		mutex_unlock(&mt6878_gate_blocks_lock);
+		return -EBUSY;
+	}
+	list_add_tail(&block->entry, &mt6878_gate_blocks);
+	mutex_unlock(&mt6878_gate_blocks_lock);
+	ret = devm_add_action_or_reset(dev, mt6878_gate_unregister_block, block);
+	if (ret)
+		return ret;
+	return devm_of_clk_add_hw_provider(dev, mt6878_gate_get, data);
+}
+
+static const struct of_device_id mt6878_display_gates_of_match[] = {
+	{ .compatible = "mediatek,mt6878-display-gates" },
+	{ /* sentinel */ }
+};
+
+/* Fixed built-in provider; retained fault references require reboot. */
+static struct platform_driver mt6878_display_gates_driver = {
+	.probe = mt6878_display_gates_probe,
+	.driver = {
+		.name = "mt6878-display-gates",
+		.of_match_table = mt6878_display_gates_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(mt6878_display_gates_driver);
