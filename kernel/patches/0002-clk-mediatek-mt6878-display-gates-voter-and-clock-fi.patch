diff --git a/drivers/clk/clk.c b/drivers/clk/clk.c
index 048adfa86..93dd18ebe 100644
--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -4509,6 +4509,67 @@ static const struct clk_ops clk_nodrv_ops = {
 	.set_parent	= clk_nodrv_set_parent,
 };
 
+/**
+ * clk_bulk_prepare_enable_if_active - take references to held clock trees
+ * @num_clks: number of clocks
+ * @clks: clocks to acquire
+ *
+ * Require an existing prepare and enable reference at the root of each
+ * resolved tree. A clock below it may be unheld if taking its first
+ * reference needs neither runtime PM nor prepare/enable operations.
+ * Acquire the entire set without invoking those provider operations.
+ * This checks framework ownership, not hardware state.
+ *
+ * Call in sleepable context. Balance success with clk_bulk_disable_unprepare().
+ * Return: 0 on success, -EINVAL for a missing clock, or -EAGAIN if a tree
+ * has no held root, requires provider operations, or is unresolved or
+ * unregistered. Errors leave references unchanged.
+ */
+int clk_bulk_prepare_enable_if_active(int num_clks, const struct clk_bulk_data *clks)
+{
+	struct clk_core *core;
+	unsigned long flags;
+	int i, ret = 0;
+
+	clk_prepare_lock();
+	flags = clk_enable_lock();
+
+	for (i = 0; i < num_clks; i++) {
+		if (IS_ERR_OR_NULL(clks[i].clk)) {
+			ret = -EINVAL;
+			goto out_unlock;
+		}
+
+		for (core = clks[i].clk->core; core; core = core->parent) {
+			if (core->orphan || core->ops == &clk_nodrv_ops) {
+				ret = -EAGAIN;
+				goto out_unlock;
+			}
+			if (core->prepare_count && core->enable_count)
+				continue;
+			if (!core->parent || core->rpm_enabled ||
+			    core->ops->prepare || core->ops->unprepare ||
+			    core->ops->enable || core->ops->disable) {
+				ret = -EAGAIN;
+				goto out_unlock;
+			}
+		}
+	}
+
+	/* Both walks can only take references through callback-free paths. */
+	for (i = 0; i < num_clks; i++) {
+		core = clks[i].clk->core;
+		clk_core_prepare(core);
+		clk_core_enable(core);
+	}
+
+out_unlock:
+	clk_enable_unlock(flags);
+	clk_prepare_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(clk_bulk_prepare_enable_if_active);
+
 static void clk_core_evict_parent_cache_subtree(struct clk_core *root,
 						const struct clk_core *target)
 {
