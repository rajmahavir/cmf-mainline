diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_ccb.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_ccb.c
new file mode 100644
index 000000000..661633cfd
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_ccb.c
@@ -0,0 +1,194 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: the CCB ("CCCI buffer") rings of the modem loggers.
+ *
+ * The modem's DHL logger, its monitor (MDM) and META talk to the AP
+ * through rings in shared memory: the data in the CCB data regions, the
+ * ring headers in the 4 KiB CCB control area (SMEM user CCB_CTRL). One
+ * header pair (DL: modem to AP, UL: AP to modem) of 64 bytes per buffer,
+ * buffer i at i * 0x40, in the order of the table below.
+ *
+ * Before the modem is started the AP fills in each pair: indexes zero,
+ * the page and buffer sizes of both directions and the end guard
+ * 0xEEFF0011 ("AP initialised"). When the modem takes a buffer over it
+ * writes 0xDDBBCCAA into the start guards. Nothing else is signalled: no
+ * CCIF channel, no message. A logger attached later (not done here)
+ * would set the end guards to 0x1100FFEE.
+ *
+ * The table is the one of MediaTek's GPL downstream eccci driver
+ * (port_smem.c); the headers the modem expects to find before its first
+ * start are written here by the kernel.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/align.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/sizes.h>
+
+#include "mtk_ccci.h"
+
+/*
+ * The headers are written on the first modem start after
+ * the AP booted and never again: on a restart the modem finds the headers
+ * as it left them (start guards set). Whether it would also accept fresh
+ * ones is not known, so that is the default.
+ */
+static bool ccb_init_every_start;
+module_param(ccb_init_every_start, bool, 0644);
+MODULE_PARM_DESC(ccb_init_every_start,
+		 "write the CCB ring headers on every modem start (default: first start only)");
+
+#define MTK_CCCI_CCB_P_CORE		0
+
+/* header pair of one buffer in the control area (downstream buffer_header) */
+#define MTK_CCCI_CCB_HDR_SIZE		0x40
+#define MTK_CCCI_CCB_DL			0x00
+#define MTK_CCCI_CCB_UL			0x20
+/* within one direction */
+#define MTK_CCCI_CCB_GUARD_START	0x00	/* the modem: 0xDDBBCCAA */
+#define MTK_CCCI_CCB_PAGE_SIZE		0x14
+#define MTK_CCCI_CCB_BUF_SIZE		0x18	/* bytes, not pages */
+#define MTK_CCCI_CCB_GUARD_END		0x1c
+#define MTK_CCCI_CCB_DIR_SIZE		0x20
+
+#define MTK_CCCI_CCB_AP_INIT		0xeeff0011
+
+/* one CCB buffer: DL is modem to AP, UL is AP to modem */
+struct mtk_ccci_ccb_config {
+	u8 user;		/* SMEM user of the data: CCB_DHL..CCB_META */
+	u8 core;
+	u32 dl_page_size;
+	u32 ul_page_size;
+	u32 dl_buf_size;
+	u32 ul_buf_size;
+};
+
+#define CCB_CFG(u, dlp, ulp, dlb, ulb) {				\
+	.user = MTK_CCCI_SMEM_##u, .core = MTK_CCCI_CCB_P_CORE,		\
+	.dl_page_size = (dlp), .ul_page_size = (ulp),			\
+	.dl_buf_size = (dlb), .ul_buf_size = (ulb) }
+
+/* the buffers of one user must follow each other */
+static const struct mtk_ccci_ccb_config mtk_ccci_ccb_configs[] = {
+	CCB_CFG(CCB_DHL, 1024, 1024, 0x8000, 0x8000),		/* control */
+	CCB_CFG(CCB_DHL, 20480, 128, 0x1e000, 0x80),		/* exception */
+	CCB_CFG(CCB_DHL, 512, 1024, 0x9000, 0x8000),		/* PS */
+	CCB_CFG(CCB_DHL, 512, 128, 0x8000, 0x80),		/* HW logger 1 */
+	CCB_CFG(CCB_DHL, 512, 128, 0x8000, 0x80),		/* HW logger 2 */
+	CCB_CFG(CCB_DHL, 512, 128, 0x20000, 0x80),		/* HW logger 3 */
+	/* dummy buffers 6..16 */
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x80, 0x80),
+	CCB_CFG(CCB_DHL, 128, 128, 0x280, 0x80),		/* padding */
+	CCB_CFG(CCB_MD_MONITOR, 512, 1024, 0x4000, 0x4000),	/* MDM */
+	CCB_CFG(CCB_META, 66560, 66560, 0x82000, 0x82000),	/* META */
+};
+
+static void mtk_ccci_ccb_dir_init(void __iomem *p, u32 page_size,
+				  u32 buf_size)
+{
+	unsigned int off;
+
+	/* the indexes and the start guard first */
+	for (off = 0; off < MTK_CCCI_CCB_DIR_SIZE; off += 4)
+		writel(0, p + off);
+	writel(page_size, p + MTK_CCCI_CCB_PAGE_SIZE);
+	writel(buf_size, p + MTK_CCCI_CCB_BUF_SIZE);
+	writel(MTK_CCCI_CCB_AP_INIT, p + MTK_CCCI_CCB_GUARD_END);
+}
+
+/**
+ * mtk_ccci_ccb_init() - write the CCB ring headers before a modem start
+ * @ccci: driver state, the modem not running
+ *
+ * Writes the header pair of every buffer of the table into the CCB
+ * control area; the rest of the area is left alone. Only on the first
+ * start unless the module parameter ccb_init_every_start is set.
+ *
+ * Return: 0 or a negative error. The modem may still be started
+ * whether this worked or not.
+ */
+int mtk_ccci_ccb_init(struct mtk_ccci *ccci)
+{
+	const struct mtk_ccci_smem_region *r;
+	const struct mtk_ccci_ccb_config *c;
+	u32 size = ARRAY_SIZE(mtk_ccci_ccb_configs) * MTK_CCCI_CCB_HDR_SIZE;
+	void __iomem *p;
+	unsigned int i;
+
+	if (ccci->ccb_ctrl_init && !ccb_init_every_start)
+		return 0;
+
+	r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_CCB_CTRL);
+	if (!r)
+		return -ENODEV;
+	if (le32_to_cpu(r->size) < size) {
+		dev_err(ccci->dev, "CCB control area of %#x bytes, %#x needed\n",
+			le32_to_cpu(r->size), size);
+		return -ENOSPC;
+	}
+
+	/* inside the no-map shared memory carveout */
+	p = ioremap_wc(le64_to_cpu(r->ap_phys), size);
+	if (!p)
+		return -ENOMEM;
+	for (i = 0; i < ARRAY_SIZE(mtk_ccci_ccb_configs); i++) {
+		void __iomem *hdr = p + i * MTK_CCCI_CCB_HDR_SIZE;
+
+		c = &mtk_ccci_ccb_configs[i];
+		mtk_ccci_ccb_dir_init(hdr + MTK_CCCI_CCB_DL, c->dl_page_size,
+				      c->dl_buf_size);
+		mtk_ccci_ccb_dir_init(hdr + MTK_CCCI_CCB_UL, c->ul_page_size,
+				      c->ul_buf_size);
+	}
+	/* all of it in memory before the modem is released */
+	wmb();
+	iounmap(p);
+
+	if (!ccci->ccb_ctrl_init)
+		dev_info(ccci->dev, "CCB: %zu ring headers, %#x bytes at %#llx\n",
+			 ARRAY_SIZE(mtk_ccci_ccb_configs), size,
+			 le64_to_cpu(r->ap_phys));
+	ccci->ccb_ctrl_init = true;
+	return 0;
+}
+
+/**
+ * mtk_ccci_ccb_data_size() - the CCB data the buffers of the table need
+ *
+ * The users DHL, MDM and META back to back from the start of the CCB data,
+ * each the sum of its DL and UL buffers rounded up to 4 KiB, as the
+ * downstream driver places them (0x17c000 with the table above).
+ *
+ * Return: the size in bytes.
+ */
+u32 mtk_ccci_ccb_data_size(void)
+{
+	const struct mtk_ccci_ccb_config *c;
+	u32 total = 0, user_size = 0;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(mtk_ccci_ccb_configs); i++) {
+		c = &mtk_ccci_ccb_configs[i];
+		user_size += c->dl_buf_size + c->ul_buf_size;
+		if (i + 1 == ARRAY_SIZE(mtk_ccci_ccb_configs) ||
+		    mtk_ccci_ccb_configs[i + 1].user != c->user) {
+			total += ALIGN(user_size, SZ_4K);
+			user_size = 0;
+		}
+	}
+	return total;
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_ccif.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_ccif.c
new file mode 100644
index 000000000..750feddde
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_ccif.c
@@ -0,0 +1,950 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: the CCIF0 mailbox between the AP and the modem.
+ *
+ * Each side has a register window: writing a channel number to TCHNUM
+ * raises that channel at the peer (BUSY marks it pending until the peer
+ * acknowledges), RCHNUM shows the channels the peer raised, ACK clears
+ * them. Both windows also show a 512-byte SRAM, used for the boot
+ * handshake: the modem leaves HS1 and its feature query there and raises
+ * channel 15; the AP answers with its runtime data the same way.
+ *
+ * Two levels of access:
+ *  - passive (module parameter ccif_regs=1): registers and SRAM are only
+ *    read, and only while the hardware says the CCIF clocks are on;
+ *  - active (start/stop, called by the FSM on an explicit debugfs
+ *    command only): reset, SRAM setup, ring buffers, notifications.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/interrupt.h>
+#include <linux/pm_wakeup.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/seq_file.h>
+
+#include "mtk_ccci.h"
+
+/* CCIF register window, the same layout on both sides */
+#define CCIF_CON		0x00
+#define CCIF_BUSY		0x04
+#define CCIF_START		0x08
+#define CCIF_TCHNUM		0x0c
+#define CCIF_RCHNUM		0x10
+#define CCIF_ACK		0x14
+#define CCIF_CHDATA		0x100
+
+/* CCIF reset in infracfg (vendor "ccif-hw-reset-ver" 1) */
+#define INFRA_RST_SET		0xf50
+#define INFRA_RST_CLR		0xf54
+
+/* SPM: modem power control, PWR_ACK in bit 30 (see mtk-pm-domains) */
+#define SPM_MD_PWR_CON		0xe00
+#define SPM_PWR_ACK		BIT(30)
+
+/* topckgen register 0: modem clock gates, set = gated */
+#define TOPCKGEN_MD1_CLK_MOD	0x0
+#define TOPCKGEN_MD1_CLK_MASK	(BIT(8) | BIT(9))
+
+static bool ccif_regs;
+module_param(ccif_regs, bool, 0444);
+MODULE_PARM_DESC(ccif_regs,
+		 "read CCIF0 registers and SRAM (never write) for debugfs; needs the CCIF clocks on");
+
+static int mtk_ccci_read_regmap(struct regmap *map, unsigned int reg)
+{
+	unsigned int val;
+	int ret;
+
+	if (!map)
+		return -ENODEV;
+	ret = regmap_read(map, reg, &val);
+	if (ret)
+		return ret;
+	/* the bits we look at are below bit 31 */
+	return val & INT_MAX;
+}
+
+/**
+ * mtk_ccci_ccif_readable() - may CCIF0 be read now?
+ * @ccci: driver state
+ *
+ * Without its clocks, an access to CCIF stalls the bus. The clocks are
+ * only on because LK started the modem and the kernel runs with
+ * clk_ignore_unused, so ask the clock controller (a read of its gate
+ * status register) every time.
+ */
+bool mtk_ccci_ccif_readable(struct mtk_ccci *ccci)
+{
+	if (!ccif_regs && !ccci->clks_on)
+		return false;
+	if (ccci->clks_on)
+		return true;
+
+	return ccci->ccif_ap_clk && ccci->ccif_md_clk &&
+	       __clk_is_enabled(ccci->ccif_ap_clk) &&
+	       __clk_is_enabled(ccci->ccif_md_clk);
+}
+
+static void mtk_ccci_ccif_read_regs(void __iomem *base,
+				    struct mtk_ccci_ccif_regs *r)
+{
+	r->con = readl(base + CCIF_CON);
+	r->busy = readl(base + CCIF_BUSY);
+	r->start = readl(base + CCIF_START);
+	r->tchnum = readl(base + CCIF_TCHNUM);
+	r->rchnum = readl(base + CCIF_RCHNUM);
+}
+
+/**
+ * mtk_ccci_ccif_snapshot() - read CCIF0 and the modem power state
+ * @ccci: driver state
+ * @snap: filled in
+ *
+ * Only reads, and nothing at all unless ccif_regs=1 (or the driver runs
+ * CCIF itself). CCIF is read only if mtk_ccci_ccif_readable(); the SPM
+ * and topckgen registers are read through their syscon regmaps.
+ *
+ * Return: 0, or -EPERM/-EAGAIN if CCIF could not be read (the rest of
+ * @snap is still filled in).
+ */
+int mtk_ccci_ccif_snapshot(struct mtk_ccci *ccci,
+			   struct mtk_ccci_ccif_snap *snap)
+{
+	unsigned int i, words;
+
+	memset(snap, 0, sizeof(*snap));
+	snap->md_pwr_con = -EPERM;
+	snap->md1_clk_mod = -EPERM;
+	if (!ccif_regs && !ccci->clks_on)
+		return -EPERM;
+
+	snap->md_pwr_con = mtk_ccci_read_regmap(ccci->scpsys, SPM_MD_PWR_CON);
+	snap->md1_clk_mod = mtk_ccci_read_regmap(ccci->topckgen,
+						 TOPCKGEN_MD1_CLK_MOD);
+	if (!mtk_ccci_ccif_readable(ccci))
+		return -EAGAIN;
+
+	mtk_ccci_ccif_read_regs(ccci->ccif_ap, &snap->ap);
+	mtk_ccci_ccif_read_regs(ccci->ccif_md, &snap->md);
+
+	words = min_t(u32, ccci->ccif_sram_size, sizeof(snap->sram)) / 4;
+	for (i = 0; i < words; i++)
+		snap->sram[i] = readl(ccci->ccif_ap + CCIF_CHDATA + i * 4);
+	snap->valid = true;
+
+	return 0;
+}
+
+static const char * const mtk_ccif_ch_names[MTK_CCIF_CH_NUM] = {
+	[0] = "ringq0", [1] = "ringq1", [2] = "ringq2", [3] = "ringq3",
+	[4] = "ringq4", [5] = "ringq5", [6] = "ringq6", [7] = "ccb",
+	[MTK_CCIF_CH_SRAM] = "sram",
+	[MTK_CCIF_CH_EX_INIT] = "ex-init",
+	[MTK_CCIF_CH_EX_INIT_DONE] = "ex-init-done",
+	[MTK_CCIF_CH_EX_CLEARQ_DONE] = "ex-clearq-done",
+	[MTK_CCIF_CH_EX_ALLQ_RESET] = "ex-allq-reset",
+	[MTK_CCIF_CH_PEER_WAKEUP] = "peer-wakeup",
+	[MTK_CCIF_CH_SEQ_ERROR] = "seq-error",
+};
+
+static void mtk_ccci_seq_channels(struct seq_file *s, u32 mask)
+{
+	unsigned int ch;
+
+	if (!mask) {
+		seq_puts(s, " -");
+		return;
+	}
+	for (ch = 0; ch < MTK_CCIF_CH_NUM; ch++)
+		if (mask & BIT(ch))
+			seq_printf(s, " %s", mtk_ccif_ch_names[ch] ?: "?");
+}
+
+/*
+ * What the snapshot says about the modem. LK powers the modem up and
+ * lets it run; the modem then waits for the AP: it raises channel 15
+ * with HS1 in the SRAM once it is ready for the runtime data.
+ */
+enum mtk_ccci_md_guess {
+	MTK_CCCI_GUESS_UNKNOWN,
+	MTK_CCCI_GUESS_POWERED_OFF,
+	MTK_CCCI_GUESS_CLOCK_GATED,
+	MTK_CCCI_GUESS_SILENT,
+	MTK_CCCI_GUESS_HS1,
+	MTK_CCCI_GUESS_EXCEPTION,
+	MTK_CCCI_GUESS_TRAFFIC,
+};
+
+static const char * const mtk_ccci_guess_text[] = {
+	[MTK_CCCI_GUESS_UNKNOWN] = "unknown (CCIF not read)",
+	[MTK_CCCI_GUESS_POWERED_OFF] = "modem power domain off",
+	[MTK_CCCI_GUESS_CLOCK_GATED] = "modem clocks gated in topckgen",
+	[MTK_CCCI_GUESS_SILENT] =
+		"powered, no CCIF channel raised: still booting, or waiting before HS1",
+	[MTK_CCCI_GUESS_HS1] =
+		"HS1 pending: modem waits for the AP runtime data",
+	[MTK_CCCI_GUESS_EXCEPTION] = "exception channel raised",
+	[MTK_CCCI_GUESS_TRAFFIC] = "channels raised, not a plain HS1",
+};
+
+static bool mtk_ccci_snap_is_hs1(const struct mtk_ccci_ccif_snap *snap)
+{
+	const struct mtk_ccci_ccif_sram_hs *hs = (const void *)snap->sram;
+	u32 status = le32_to_cpu(hs->dl_header.status);
+
+	return FIELD_GET(MTK_CCCI_H_CHANNEL, status) == MTK_CCCI_CH_CONTROL_RX &&
+	       le32_to_cpu(hs->dl_header.data[1]) ==
+			MTK_CCCI_CTL_MD_INIT_START_BOOT &&
+	       le32_to_cpu(hs->dl_header.reserved) ==
+			MTK_CCCI_CTL_MD_INIT_CHK_ID;
+}
+
+static enum mtk_ccci_md_guess
+mtk_ccci_guess(const struct mtk_ccci_ccif_snap *snap)
+{
+	u32 rch = snap->ap.rchnum;
+
+	if (snap->md_pwr_con >= 0 && !(snap->md_pwr_con & SPM_PWR_ACK))
+		return MTK_CCCI_GUESS_POWERED_OFF;
+	if (snap->md1_clk_mod >= 0 &&
+	    (snap->md1_clk_mod & TOPCKGEN_MD1_CLK_MASK))
+		return MTK_CCCI_GUESS_CLOCK_GATED;
+	if (!snap->valid)
+		return MTK_CCCI_GUESS_UNKNOWN;
+	if (rch & (BIT(MTK_CCIF_CH_EX_INIT) | BIT(MTK_CCIF_CH_EX_INIT_DONE)))
+		return MTK_CCCI_GUESS_EXCEPTION;
+	if (rch == BIT(MTK_CCIF_CH_SRAM) && mtk_ccci_snap_is_hs1(snap))
+		return MTK_CCCI_GUESS_HS1;
+	if (!rch)
+		return MTK_CCCI_GUESS_SILENT;
+	return MTK_CCCI_GUESS_TRAFFIC;
+}
+
+/* one line for the kernel log at probe: survives in pstore/ramoops */
+void mtk_ccci_ccif_log_state(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_ccif_snap *snap;
+	int ret;
+
+	if (!ccif_regs)
+		return;
+	snap = kmalloc_obj(*snap);
+	if (!snap)
+		return;
+
+	ret = mtk_ccci_ccif_snapshot(ccci, snap);
+	if (ret == -EAGAIN)
+		dev_info(ccci->dev, "CCIF clocks off, CCIF not read\n");
+	dev_info(ccci->dev,
+		 "modem after LK: %s (spm %#x topck %#x rch %#x busy %#x md-rch %#x)\n",
+		 mtk_ccci_guess_text[mtk_ccci_guess(snap)],
+		 snap->md_pwr_con, snap->md1_clk_mod, snap->ap.rchnum,
+		 snap->ap.busy, snap->md.rchnum);
+	kfree(snap);
+}
+
+static void mtk_ccci_seq_regs(struct seq_file *s, const char *side,
+			      const struct mtk_ccci_ccif_regs *r)
+{
+	seq_printf(s, "%s: con %#010x busy %#010x start %#010x tchnum %#010x rchnum %#010x\n",
+		   side, r->con, r->busy, r->start, r->tchnum, r->rchnum);
+}
+
+static int mtk_ccci_ccif_show(struct seq_file *s, void *unused)
+{
+	struct mtk_ccci *ccci = s->private;
+	struct mtk_ccci_ccif_snap *snap;
+	unsigned int i, words;
+	int ret;
+
+	snap = kmalloc_obj(*snap);
+	if (!snap)
+		return -ENOMEM;
+
+	ret = mtk_ccci_ccif_snapshot(ccci, snap);
+	if (ret) {
+		seq_printf(s, "CCIF not read: %s\n", ret == -EAGAIN ?
+			   "CCIF clocks are off" : "ccif_regs=0");
+		goto out;
+	}
+
+	mtk_ccci_seq_regs(s, "ap", &snap->ap);
+	mtk_ccci_seq_regs(s, "md", &snap->md);
+	words = min_t(u32, ccci->ccif_sram_size, sizeof(snap->sram)) / 4;
+	for (i = 0; i < words; i += 4)
+		seq_printf(s, "sram+%03x %08x %08x %08x %08x\n", i * 4,
+			   snap->sram[i], snap->sram[i + 1], snap->sram[i + 2],
+			   snap->sram[i + 3]);
+out:
+	kfree(snap);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_ccif);
+
+static int mtk_ccci_ccif_state_show(struct seq_file *s, void *unused)
+{
+	struct mtk_ccci *ccci = s->private;
+	const struct mtk_ccci_ccif_sram_hs *hs;
+	struct mtk_ccci_ccif_snap *snap;
+	unsigned int i, words;
+	u32 status, *tail;
+
+	snap = kmalloc_obj(*snap);
+	if (!snap)
+		return -ENOMEM;
+	mtk_ccci_ccif_snapshot(ccci, snap);
+
+	seq_printf(s, "fsm:        %s\n", mtk_ccci_fsm_state_name(ccci->state));
+	seq_printf(s, "guess:      %s\n",
+		   mtk_ccci_guess_text[mtk_ccci_guess(snap)]);
+	if (snap->md_pwr_con >= 0)
+		seq_printf(s, "spm md:     PWR_CON %#010x, ack %d\n",
+			   snap->md_pwr_con,
+			   !!(snap->md_pwr_con & SPM_PWR_ACK));
+	else
+		seq_printf(s, "spm md:     not read (%d)\n", snap->md_pwr_con);
+	if (snap->md1_clk_mod >= 0)
+		seq_printf(s, "topckgen:   md1_clk_mod %#010x (%s)\n",
+			   snap->md1_clk_mod,
+			   snap->md1_clk_mod & TOPCKGEN_MD1_CLK_MASK ?
+			   "gated" : "running");
+	else
+		seq_printf(s, "topckgen:   not read (%d)\n", snap->md1_clk_mod);
+
+	if (!snap->valid) {
+		seq_puts(s, "ccif:       not read\n");
+		goto out;
+	}
+
+	seq_puts(s, "md raised: ");
+	mtk_ccci_seq_channels(s, snap->ap.rchnum);
+	seq_puts(s, "\nap raised: ");
+	mtk_ccci_seq_channels(s, snap->md.rchnum);
+	seq_puts(s, "\nap busy:   ");
+	mtk_ccci_seq_channels(s, snap->ap.busy);
+	seq_puts(s, "\n");
+
+	hs = (const void *)snap->sram;
+	status = le32_to_cpu(hs->dl_header.status);
+	seq_printf(s, "dl header:  data %#x %#x ch %lu seq %lu reserved %#x%s\n",
+		   le32_to_cpu(hs->dl_header.data[0]),
+		   le32_to_cpu(hs->dl_header.data[1]),
+		   FIELD_GET(MTK_CCCI_H_CHANNEL, status),
+		   FIELD_GET(MTK_CCCI_H_SEQ, status),
+		   le32_to_cpu(hs->dl_header.reserved),
+		   mtk_ccci_snap_is_hs1(snap) ? " (HS1)" : "");
+	seq_printf(s, "md query:   head %#010x tail %#010x%s\n",
+		   le32_to_cpu(hs->md_query.head_pattern),
+		   le32_to_cpu(hs->md_query.tail_pattern),
+		   le32_to_cpu(hs->md_query.head_pattern) ==
+			MTK_CCCI_MD_FEATURE_PATTERN ? " (valid)" : "");
+	if (le32_to_cpu(hs->md_query.head_pattern) ==
+	    MTK_CCCI_MD_FEATURE_PATTERN) {
+		seq_puts(s, "features:  ");
+		for (i = 0; i < MTK_CCCI_FEATURE_COUNT; i++)
+			if (hs->md_query.feature[i])
+				seq_printf(s, " %u:%#x", i,
+					   hs->md_query.feature[i]);
+		seq_puts(s, "\n");
+	}
+
+	words = min_t(u32, ccci->ccif_sram_size, sizeof(snap->sram)) / 4;
+	tail = &snap->sram[words - 3];
+	seq_printf(s, "sram tail:  %08x %08x %08x%s\n", tail[0], tail[1],
+		   tail[2], tail[0] == MTK_CCIF_SRAM_DBG_MAGIC ?
+		   " (debug area set)" : "");
+out:
+	kfree(snap);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_ccif_state);
+
+void mtk_ccci_ccif_debugfs_init(struct mtk_ccci *ccci)
+{
+	debugfs_create_file("ccif_state", 0400, ccci->debugfs, ccci,
+			    &mtk_ccci_ccif_state_fops);
+	if (ccif_regs)
+		debugfs_create_file("ccif", 0400, ccci->debugfs, ccci,
+				    &mtk_ccci_ccif_fops);
+}
+
+/**
+ * mtk_ccci_ccif_init() - find the CCIF resources, touch nothing
+ * @ccci: driver state
+ *
+ * Return: 0 or a negative error.
+ */
+int mtk_ccci_ccif_init(struct mtk_ccci *ccci)
+{
+	struct platform_device *pdev = to_platform_device(ccci->dev);
+	struct device *dev = ccci->dev;
+	struct device_node *np = dev->of_node;
+	int i;
+
+	ccci->ccif_ap = devm_platform_ioremap_resource_byname(pdev, "ccif-ap");
+	if (IS_ERR(ccci->ccif_ap))
+		return PTR_ERR(ccci->ccif_ap);
+	ccci->ccif_md = devm_platform_ioremap_resource_byname(pdev, "ccif-md");
+	if (IS_ERR(ccci->ccif_md))
+		return PTR_ERR(ccci->ccif_md);
+
+	/* only needed to reset CCIF, which the MediaTek downstream driver does on start */
+	if (platform_get_resource_byname(pdev, IORESOURCE_MEM, "infra")) {
+		ccci->infra = devm_platform_ioremap_resource_byname(pdev,
+								    "infra");
+		if (IS_ERR(ccci->infra))
+			return PTR_ERR(ccci->infra);
+	}
+	if (of_property_read_u32(np, "mediatek,ccif-reset-bit",
+				 &ccci->ccif_rst_bit) ||
+	    ccci->ccif_rst_bit > 31)
+		ccci->ccif_rst_bit = U32_MAX;
+
+	if (of_property_read_u32(np, "mediatek,ccif-sram-size",
+				 &ccci->ccif_sram_size))
+		ccci->ccif_sram_size = MTK_CCIF_SRAM_SIZE_DEFAULT;
+	if (ccci->ccif_sram_size < sizeof(struct mtk_ccci_ccif_sram_hs) + 12 ||
+	    ccci->ccif_sram_size > MTK_CCIF_SRAM_SIZE_DEFAULT ||
+	    ccci->ccif_sram_size % 16)
+		return dev_err_probe(dev, -EINVAL, "bad CCIF SRAM size %u\n",
+				     ccci->ccif_sram_size);
+
+	/* get only: enabling comes with an explicit start */
+	ccci->num_clks = devm_clk_bulk_get_all(dev, &ccci->clks);
+	if (ccci->num_clks < 0)
+		return dev_err_probe(dev, ccci->num_clks,
+				     "failed to get clocks\n");
+	for (i = 0; i < ccci->num_clks; i++) {
+		if (!strcmp(ccci->clks[i].id, "ccif-ap"))
+			ccci->ccif_ap_clk = ccci->clks[i].clk;
+		else if (!strcmp(ccci->clks[i].id, "ccif-md"))
+			ccci->ccif_md_clk = ccci->clks[i].clk;
+	}
+
+	/* read-only views of the modem power and clock state */
+	ccci->scpsys = syscon_regmap_lookup_by_phandle_optional(np,
+							"mediatek,scpsys");
+	if (IS_ERR(ccci->scpsys))
+		ccci->scpsys = NULL;
+	ccci->topckgen = syscon_regmap_lookup_by_phandle_optional(np,
+							"mediatek,topckgen");
+	if (IS_ERR(ccci->topckgen))
+		ccci->topckgen = NULL;
+
+	/* requested only while the driver runs the modem */
+	ccci->irq_ccif[0] = platform_get_irq_byname_optional(pdev, "ccif0");
+	ccci->irq_ccif[1] = platform_get_irq_byname_optional(pdev, "ccif1");
+	ccci->irq_wdt = platform_get_irq_byname_optional(pdev, "wdt");
+	for (i = 0; i < ARRAY_SIZE(ccci->irq_ccif); i++)
+		if (ccci->irq_ccif[i] == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+	if (ccci->irq_wdt == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
+
+	return 0;
+}
+
+/* --- active part: only reached from an explicit FSM command --- */
+
+u32 mtk_ccci_ccif_pending(struct mtk_ccci *ccci)
+{
+	return readl(ccci->ccif_ap + CCIF_RCHNUM);
+}
+
+void mtk_ccci_ccif_ack(struct mtk_ccci *ccci, u32 channels)
+{
+	writel(channels, ccci->ccif_ap + CCIF_ACK);
+}
+
+/**
+ * mtk_ccci_ccif_notify() - raise a channel at the modem
+ * @ccci: driver state
+ * @channel: CCIF channel
+ *
+ * Return: 0, or -EBUSY if the modem has not taken the last one yet.
+ */
+int mtk_ccci_ccif_notify(struct mtk_ccci *ccci, unsigned int channel)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (channel >= MTK_CCIF_CH_NUM)
+		return -EINVAL;
+
+	spin_lock_irqsave(&ccci->ccif_lock, flags);
+	if (readl(ccci->ccif_ap + CCIF_BUSY) & BIT(channel)) {
+		ret = -EBUSY;
+	} else {
+		writel(BIT(channel), ccci->ccif_ap + CCIF_BUSY);
+		writel(channel, ccci->ccif_ap + CCIF_TCHNUM);
+	}
+	spin_unlock_irqrestore(&ccci->ccif_lock, flags);
+	return ret;
+}
+
+/* HS1 as the modem left it in the SRAM */
+void mtk_ccci_ccif_read_hs(struct mtk_ccci *ccci,
+			   struct mtk_ccci_header *hdr,
+			   struct mtk_ccci_md_feature_query *query)
+{
+	void __iomem *sram = ccci->ccif_ap + CCIF_CHDATA;
+	__le32 *p;
+	unsigned int i;
+
+	p = (__le32 *)hdr;
+	for (i = 0; i < sizeof(*hdr) / 4; i++)
+		p[i] = cpu_to_le32(readl(sram + i * 4));
+	sram += sizeof(*hdr);
+	p = (__le32 *)query;
+	for (i = 0; i < sizeof(*query) / 4; i++)
+		p[i] = cpu_to_le32(readl(sram + i * 4));
+}
+
+/**
+ * mtk_ccci_ccif_write_rt() - put the answer to HS1 into the SRAM
+ * @ccci: driver state
+ * @ap_feature: the AP feature block
+ * @size: its size
+ *
+ * After the modem's query: a control header (data[1] = the packet length,
+ * channel CONTROL_TX without a sequence number, reserved = the HS1 check
+ * id, as the MediaTek downstream driver writes it), then the AP feature
+ * block. The caller notifies the SRAM channel.
+ */
+void mtk_ccci_ccif_write_rt(struct mtk_ccci *ccci, const void *ap_feature,
+			    u32 size)
+{
+	void __iomem *sram = ccci->ccif_ap + CCIF_CHDATA;
+	void __iomem *ul = sram + MTK_CCIF_SRAM_AP_FEATURE -
+			   sizeof(struct mtk_ccci_header);
+	const __le32 *p = ap_feature;
+	u32 i;
+
+	writel(0, ul);
+	writel(sizeof(struct mtk_ccci_header) + size, ul + 4);
+	writel(MTK_CCCI_CH_CONTROL_TX, ul + 8);
+	writel(MTK_CCCI_CTL_MD_INIT_CHK_ID, ul + 12);
+	for (i = 0; i < size / 4; i++)
+		writel(le32_to_cpu(p[i]), sram + MTK_CCIF_SRAM_AP_FEATURE + i * 4);
+}
+
+static void mtk_ccci_ccif_sram_clear(void __iomem *base, u32 size)
+{
+	u32 off;
+
+	for (off = 0; off < size; off += 4)
+		writel(0, base + CCIF_CHDATA + off);
+}
+
+/*
+ * Clear pending/busy channels on both sides (the reset leaves the SRAM
+ * alone), clear both SRAM views and tell the modem where its debug area
+ * is: the last 12 bytes of the SRAM carry a magic, the modem view of the
+ * MDSS_DBG region and its size.
+ */
+static void mtk_ccci_ccif_reset(struct mtk_ccci *ccci)
+{
+	const struct mtk_ccci_smem_region *dbg;
+	void __iomem *tail;
+
+	if (ccci->infra && ccci->ccif_rst_bit != U32_MAX) {
+		writel(BIT(ccci->ccif_rst_bit), ccci->infra + INFRA_RST_SET);
+		writel(BIT(ccci->ccif_rst_bit), ccci->infra + INFRA_RST_CLR);
+	} else {
+		dev_warn(ccci->dev, "no CCIF reset described, only clearing\n");
+		writel(readl(ccci->ccif_ap + CCIF_RCHNUM),
+		       ccci->ccif_ap + CCIF_ACK);
+	}
+
+	mtk_ccci_ccif_sram_clear(ccci->ccif_ap, ccci->ccif_sram_size);
+	mtk_ccci_ccif_sram_clear(ccci->ccif_md, ccci->ccif_sram_size);
+
+	dbg = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_MDSS_DBG);
+	if (!dbg)
+		return;
+	tail = ccci->ccif_ap + CCIF_CHDATA + ccci->ccif_sram_size - 12;
+	writel(MTK_CCIF_SRAM_DBG_MAGIC, tail);
+	writel(mtk_ccci_lk_smem_md_addr(dbg), tail + 4);
+	writel(le32_to_cpu(dbg->size), tail + 8);
+}
+
+/* map a shared memory region LK described (inside a no-map carveout) */
+static void __iomem *mtk_ccci_smem_map(struct mtk_ccci *ccci,
+				       enum mtk_ccci_smem_id id, u32 *size)
+{
+	const struct mtk_ccci_smem_region *r = mtk_ccci_lk_smem(ccci, id);
+	void __iomem *p;
+
+	if (!r) {
+		dev_err(ccci->dev, "no shared memory region %d from LK\n", id);
+		return NULL;
+	}
+	*size = le32_to_cpu(r->size);
+	p = ioremap_wc(le64_to_cpu(r->ap_phys), *size);
+	if (!p)
+		dev_err(ccci->dev, "cannot map shared memory region %d\n", id);
+	return p;
+}
+
+/**
+ * mtk_ccci_ccif_start() - take CCIF over for a modem (re)start
+ * @ccci: driver state
+ *
+ * The stock order: CCIF clocks, ring buffers laid out in the CCISM shared
+ * memory (normal and exception queues), CCIF reset with both SRAM views
+ * cleared. The runtime data region is mapped for the answer to HS1.
+ *
+ * Return: 0 or a negative error.
+ */
+int mtk_ccci_ccif_start(struct mtk_ccci *ccci)
+{
+	u32 size;
+	int ret;
+
+	if (!ccci->clks_on) {
+		ret = clk_bulk_prepare_enable(ccci->num_clks, ccci->clks);
+		if (ret)
+			return ret;
+		ccci->clks_on = true;
+	}
+
+	ret = -ENOMEM;
+	ccci->ccism = mtk_ccci_smem_map(ccci, MTK_CCCI_SMEM_CCISM_MCU, &size);
+	if (!ccci->ccism)
+		goto err;
+	ret = mtk_ccci_rings_init(ccci, ccci->ccism, size);
+	if (ret)
+		goto err;
+
+	ret = -ENOMEM;
+	ccci->ccism_exp = mtk_ccci_smem_map(ccci, MTK_CCCI_SMEM_CCISM_MCU_EXP,
+					    &size);
+	if (!ccci->ccism_exp)
+		goto err;
+	ret = mtk_ccci_rings_exp_init(ccci, ccci->ccism_exp, size);
+	if (ret)
+		goto err;
+
+	ret = -ENOMEM;
+	ccci->rt_data = mtk_ccci_smem_map(ccci, MTK_CCCI_SMEM_RUNTIME_DATA,
+					  &ccci->rt_data_size);
+	if (!ccci->rt_data)
+		goto err;
+
+	mtk_ccci_ccif_reset(ccci);
+	return 0;
+
+err:
+	mtk_ccci_ccif_stop(ccci);
+	return ret;
+}
+
+/**
+ * mtk_ccci_ccif_stop() - back to quiet after the modem is off
+ * @ccci: driver state
+ *
+ * Unmaps the shared memory and resets CCIF, as the MediaTek downstream driver does
+ * once the modem is gated. The CCIF clocks stay on: the stock way to
+ * gate CCIF4/5 needs registers this driver does not map, and the
+ * clocks were on before the driver started anyway.
+ */
+void mtk_ccci_ccif_stop(struct mtk_ccci *ccci)
+{
+	if (ccci->clks_on && ccci->ccism)
+		mtk_ccci_ccif_reset(ccci);
+
+	if (ccci->rt_data) {
+		iounmap(ccci->rt_data);
+		ccci->rt_data = NULL;
+	}
+	if (ccci->ccism_exp) {
+		iounmap(ccci->ccism_exp);
+		ccci->ccism_exp = NULL;
+		memset(ccci->ring_exp, 0, sizeof(ccci->ring_exp));
+	}
+	if (ccci->ccism) {
+		iounmap(ccci->ccism);
+		ccci->ccism = NULL;
+		memset(ccci->ring, 0, sizeof(ccci->ring));
+	}
+}
+
+/*
+ * Both CCIF0 lines report the channels the modem raised (the MediaTek downstream
+ * driver splits them: data queues on the first, SRAM and exceptions on
+ * the second). Take whatever is pending, acknowledge it so the level
+ * interrupt drops, and leave the work to the RX worker.
+ */
+static irqreturn_t mtk_ccci_ccif_isr(int irq, void *data)
+{
+	struct mtk_ccci *ccci = data;
+	u32 rch;
+
+	rch = readl(ccci->ccif_ap + CCIF_RCHNUM);
+	if (!rch)
+		return IRQ_NONE;
+	writel(rch, ccci->ccif_ap + CCIF_ACK);
+	atomic_or(rch, &ccci->ccif_pending);
+	ccci->stats.irqs++;
+	mtk_ccci_hif_kick(ccci);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t mtk_ccci_wdt_isr(int irq, void *data)
+{
+	struct mtk_ccci *ccci = data;
+
+	/* one shot: re-armed on the next start */
+	disable_irq_nosync(irq);
+	ccci->wdt_fired = true;
+	dev_err(ccci->dev, "modem watchdog fired\n");
+	mtk_ccci_fsm_exception(ccci, 0);
+	return IRQ_HANDLED;
+}
+
+/**
+ * mtk_ccci_ccif_irq_start() - take the CCIF interrupts
+ * @ccci: driver state
+ *
+ * Only while the driver runs the modem. Without interrupts in the DT the
+ * RX worker still polls.
+ *
+ * Return: 0 or a negative error.
+ */
+int mtk_ccci_ccif_irq_start(struct mtk_ccci *ccci)
+{
+	unsigned int i;
+	int ret;
+
+	if (ccci->irqs_on)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(ccci->irq_ccif); i++) {
+		if (ccci->irq_ccif[i] <= 0)
+			continue;
+		ret = request_irq(ccci->irq_ccif[i], mtk_ccci_ccif_isr, 0,
+				  i ? "ccci-ccif1" : "ccci-ccif0", ccci);
+		if (ret) {
+			dev_err(ccci->dev, "CCIF interrupt %u: %d\n", i, ret);
+			while (i--)
+				if (ccci->irq_ccif[i] > 0)
+					free_irq(ccci->irq_ccif[i], ccci);
+			return ret;
+		}
+	}
+	ccci->irqs_on = true;
+	return 0;
+}
+
+void mtk_ccci_ccif_irq_stop(struct mtk_ccci *ccci)
+{
+	unsigned int i;
+
+	if (!ccci->irqs_on)
+		return;
+	for (i = 0; i < ARRAY_SIZE(ccci->irq_ccif); i++)
+		if (ccci->irq_ccif[i] > 0)
+			free_irq(ccci->irq_ccif[i], ccci);
+	ccci->irqs_on = false;
+}
+
+/**
+ * mtk_ccci_wdt_irq_start() - watch the modem watchdog
+ * @ccci: driver state
+ *
+ * As the MediaTek downstream driver: from the release of the modem until it is
+ * stopped. One shot, logged and treated as a modem exception.
+ *
+ * Return: 0 or a negative error.
+ */
+int mtk_ccci_wdt_irq_start(struct mtk_ccci *ccci)
+{
+	int ret;
+
+	if (ccci->irq_wdt <= 0 || ccci->wdt_on)
+		return 0;
+	ccci->wdt_fired = false;
+	ret = request_irq(ccci->irq_wdt, mtk_ccci_wdt_isr, 0, "ccci-md-wdt",
+			  ccci);
+	if (ret)
+		return ret;
+	ccci->wdt_on = true;
+	return 0;
+}
+
+void mtk_ccci_wdt_irq_stop(struct mtk_ccci *ccci)
+{
+	if (!ccci->wdt_on)
+		return;
+	free_irq(ccci->irq_wdt, ccci);
+	/* as the stock stop: no stale watchdog for the next start */
+	irq_set_irqchip_state(ccci->irq_wdt, IRQCHIP_STATE_PENDING, false);
+	ccci->wdt_on = false;
+}
+
+/**
+ * mtk_ccci_irq_wake() - let the modem interrupts wake the system
+ * @ccci: driver state
+ * @on: arm (suspend_late) or disarm (resume_early)
+ *
+ * The CCIF0 lines (a channel raised by the modem: incoming call, SMS,
+ * downlink notification, CCB wakeup) and the modem watchdog stay enabled
+ * through system sleep as wakeup interrupts; one that fires in sleep
+ * aborts or ends it and is handled once interrupts are resumed (they are
+ * level interrupts: the line still stands). Only the interrupts in use
+ * are armed, and exactly those are disarmed again.
+ */
+void mtk_ccci_irq_wake(struct mtk_ccci *ccci, bool on)
+{
+	unsigned int i;
+
+	if (on) {
+		ccci->sleep.wake_irqs = 0;
+		for (i = 0; i < ARRAY_SIZE(ccci->irq_ccif); i++)
+			if (ccci->irqs_on && ccci->irq_ccif[i] > 0 &&
+			    !enable_irq_wake(ccci->irq_ccif[i]))
+				ccci->sleep.wake_irqs |= BIT(i);
+		if (ccci->wdt_on && !enable_irq_wake(ccci->irq_wdt))
+			ccci->sleep.wake_irqs |= BIT(2);
+		return;
+	}
+	for (i = 0; i < ARRAY_SIZE(ccci->irq_ccif); i++)
+		if (ccci->sleep.wake_irqs & BIT(i))
+			disable_irq_wake(ccci->irq_ccif[i]);
+	if (ccci->sleep.wake_irqs & BIT(2))
+		disable_irq_wake(ccci->irq_wdt);
+	ccci->sleep.wake_irqs = 0;
+}
+
+/* CCIF channel names for the log: "ringq5 ccb", at most @size bytes */
+static void mtk_ccci_ccif_ch_text(u32 mask, char *buf, size_t size)
+{
+	unsigned int ch;
+	size_t n = 0;
+
+	buf[0] = '\0';
+	for (ch = 0; ch < MTK_CCIF_CH_NUM && n < size; ch++) {
+		if (!(mask & BIT(ch)))
+			continue;
+		if (mtk_ccif_ch_names[ch])
+			n += scnprintf(buf + n, size - n, "%s%s", n ? " " : "",
+				       mtk_ccif_ch_names[ch]);
+		else
+			n += scnprintf(buf + n, size - n, "%sch%u", n ? " " : "",
+				       ch);
+	}
+	if (!n)
+		scnprintf(buf, size, "-");
+}
+
+/* bit i: CCIF0 line i stands at the interrupt controller */
+static u32 mtk_ccci_ccif_lines_pending(struct mtk_ccci *ccci)
+{
+	unsigned int i;
+	u32 lines = 0;
+	bool p;
+
+	for (i = 0; i < ARRAY_SIZE(ccci->irq_ccif); i++)
+		if (ccci->irq_ccif[i] > 0 &&
+		    !irq_get_irqchip_state(ccci->irq_ccif[i],
+					   IRQCHIP_STATE_PENDING, &p) && p)
+			lines |= BIT(i);
+	return lines;
+}
+
+/**
+ * mtk_ccci_ccif_suspend_noirq() - what is in flight when the AP goes to sleep
+ * @ccci: driver state
+ *
+ * Read only, for the log (one line, it survives in pstore): channels the
+ * modem raised and the AP has not taken (rch), channels the AP raised and
+ * the modem has not taken (busy), ring queues with data their reader has
+ * not read in either direction, whether TF-A sees the modem asleep, and
+ * the interrupt numbers armed as wakeup interrupts, to match
+ * "PM: Triggering wakeup from IRQ N". Anything the AP sent the modem
+ * last (tx) is answered in the sleep, waking it.
+ */
+void mtk_ccci_ccif_suspend_noirq(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_sleep *sl = &ccci->sleep;
+	u32 rch, busy, rx, tx;
+	char rch_txt[64];
+
+	if (!READ_ONCE(ccci->hif_on))
+		return;
+
+	rch = readl(ccci->ccif_ap + CCIF_RCHNUM);
+	busy = readl(ccci->ccif_ap + CCIF_BUSY);
+	mtk_ccci_rings_pending(ccci, &rx, &tx);
+	sl->md_asleep_at_suspend = mtk_ccci_md_sleep_mode(ccci);
+	mtk_ccci_ccif_ch_text(rch, rch_txt, sizeof(rch_txt));
+	dev_info(ccci->dev, "suspend: modem %s, CCIF from the modem %#x (%s), to the modem %#x, rings unread rx %#x tx %#x, wake irqs ccif0 %d ccif1 %d wdt %d\n",
+		 sl->md_asleep_at_suspend == 1 ? "asleep" :
+		 sl->md_asleep_at_suspend == 0 ? "awake" : "sleep unknown",
+		 rch, rch_txt, busy, rx, tx,
+		 sl->wake_irqs & BIT(0) ? ccci->irq_ccif[0] : -1,
+		 sl->wake_irqs & BIT(1) ? ccci->irq_ccif[1] : -1,
+		 sl->wake_irqs & BIT(2) ? ccci->irq_wdt : -1);
+}
+
+/**
+ * mtk_ccci_ccif_resume_noirq() - what woke the AP, as TF-A and CCIF see it
+ * @ccci: driver state
+ *
+ * As the downstream CCIF resume_noirq: ask TF-A whether CCIF0 woke the AP.
+ * On the Titan 2 TF-A answered 0 even for an SPM wake-up by
+ * CCIF0_EVENT_B (08.11), so the channels the modem raised and the state
+ * of the CCIF0 lines count as well: the interrupts are still suspended
+ * here, a channel raised in the sleep is still in RCHNUM and its line
+ * stands. The channels are only read, not acknowledged: the interrupt
+ * and the RX worker take them once interrupts are resumed; the first
+ * packet the worker finds is named in the log (or "no packet").
+ */
+void mtk_ccci_ccif_resume_noirq(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_sleep *sl = &ccci->sleep;
+	char rch_txt[64];
+	u32 rch, lines;
+	bool tfa;
+
+	if (!READ_ONCE(ccci->hif_on))
+		return;
+
+	rch = readl(ccci->ccif_ap + CCIF_RCHNUM);
+	lines = mtk_ccci_ccif_lines_pending(ccci);
+	sl->last_rch = rch;
+	tfa = mtk_ccci_wake_src_query(ccci, MTK_CCCI_WAKE_SRC_CCIF0,
+				      sl->wake_query);
+	if (!tfa && !rch)
+		return;
+	if (tfa)
+		sl->ccif_wakeups++;
+	else
+		sl->ccif_raised++;
+	sl->last_wake_ch = rch;
+	/* the RX worker names the first packet that follows */
+	sl->wake_rx_ch = MTK_CCCI_CH_NUM;
+	sl->wake_rx_what[0] = '\0';
+	WRITE_ONCE(sl->wake_pending, true);
+	WRITE_ONCE(sl->wake_check, true);
+	/* a wakeup event of this device: visible in /sys/class/wakeup */
+	pm_wakeup_event(ccci->dev, 0);
+	mtk_ccci_ccif_ch_text(rch, rch_txt, sizeof(rch_txt));
+	dev_info(ccci->dev, "%s CCIF0 (%lu): channels %#x (%s), lines pending %#x\n",
+		 tfa ? "woken by" : "in sleep the modem raised",
+		 tfa ? sl->ccif_wakeups : sl->ccif_raised, rch, rch_txt,
+		 lines);
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_cdev.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_cdev.c
new file mode 100644
index 000000000..8d40f1a6f
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_cdev.c
@@ -0,0 +1,346 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: character device ports with a user supplied header.
+ *
+ * The MediaTek downstream driver hands the modem's file server requests (channel
+ * FS_RX, queue 4) to userspace through /dev/ccci_fs, and the RPC requests
+ * it does not answer itself (channel RPC_RX, queue 1) through
+ * /dev/ccci_rpc, with the CCCI header left in (PORT_F_USER_HEADER). The
+ * same minimal ABI here, for open servers in userspace:
+ *
+ *  - read(): one modem packet, 16-byte CCCI header included; a short
+ *    buffer gets the start of it and the rest on the next read (as the
+ *    MediaTek downstream driver does). Blocks unless O_NONBLOCK.
+ *  - write(): one packet, header included. The driver sets data[1] to
+ *    the length (or data[0] to the magic for a header-only packet), the
+ *    TX channel, sequence number and check bit; data[0] and the
+ *    reserved word (the request slot) are the caller's.
+ *  - poll(): EPOLLIN with a packet queued, EPOLLOUT while writes are
+ *    accepted (from HS1 on, as in the MediaTek downstream driver for FS and RPC).
+ *  - mmap() on /dev/ccci_rpc only: the DRDI shared memory region (from
+ *    offset 0, at most its page-rounded size), into which the RPC server
+ *    copies the modem's RF calibration sets on request. Write-combined,
+ *    not cached: the modem reads it without snooping.
+ *  - one opener at a time; no ioctls.
+ *
+ * Packets are kept while nobody has the device open (stock
+ * PORT_F_CLOSE_NO_DROP_PKT): the modem asks for its NVRAM right after
+ * the start, maybe before the server is up. Past a limit they stay in
+ * the ring, which fills up and holds the modem back.
+ *
+ * The kernel only passes the packets: it never opens or writes a
+ * partition or a file for the modem.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/poll.h>
+#include <linux/sched/signal.h>
+#include <linux/seq_file.h>
+#include <linux/skbuff.h>
+#include <linux/uaccess.h>
+
+#include "mtk_ccci.h"
+
+/* packets kept per port before the ring is left to fill (stock 16) */
+#define MTK_CCCI_CDEV_RX_MAX	16
+
+static bool mtk_ccci_cdev_tx_allowed(struct mtk_ccci *ccci)
+{
+	switch (READ_ONCE(ccci->state)) {
+	case MTK_CCCI_FSM_WAIT_HS1:
+	case MTK_CCCI_FSM_HS1:
+	case MTK_CCCI_FSM_WAIT_HS2:
+	case MTK_CCCI_FSM_READY:
+		return READ_ONCE(ccci->hif_on);
+	default:
+		return false;
+	}
+}
+
+/**
+ * mtk_ccci_cdev_recv() - queue a modem packet for the reader
+ * @cd: port
+ * @skb: packet with its CCCI header; always taken
+ *
+ * Return: 0, or -EBUSY when the port is full: the packet is freed and
+ * stays in the ring, to be read again once the reader caught up.
+ */
+int mtk_ccci_cdev_recv(struct mtk_ccci_cdev *cd, struct sk_buff *skb)
+{
+	if (skb_queue_len(&cd->rx) >= MTK_CCCI_CDEV_RX_MAX) {
+		cd->rx_full++;
+		kfree_skb(skb);
+		return -EBUSY;
+	}
+	skb_queue_tail(&cd->rx, skb);
+	cd->rx_pkts++;
+	wake_up_interruptible(&cd->wq);
+	return 0;
+}
+
+static struct mtk_ccci_cdev *mtk_ccci_cdev_of(struct file *file)
+{
+	return container_of(file->private_data, struct mtk_ccci_cdev, misc);
+}
+
+static int mtk_ccci_cdev_open(struct inode *inode, struct file *file)
+{
+	struct mtk_ccci_cdev *cd = mtk_ccci_cdev_of(file);
+
+	if (atomic_cmpxchg(&cd->open, 0, 1))
+		return -EBUSY;
+	return stream_open(inode, file);
+}
+
+static int mtk_ccci_cdev_release(struct inode *inode, struct file *file)
+{
+	struct mtk_ccci_cdev *cd = mtk_ccci_cdev_of(file);
+
+	atomic_set(&cd->open, 0);
+	return 0;
+}
+
+static ssize_t mtk_ccci_cdev_read(struct file *file, char __user *buf,
+				  size_t count, loff_t *ppos)
+{
+	struct mtk_ccci_cdev *cd = mtk_ccci_cdev_of(file);
+	struct sk_buff *skb;
+	size_t len;
+	int ret;
+
+	for (;;) {
+		skb = skb_dequeue(&cd->rx);
+		if (skb)
+			break;
+		if (file->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+		ret = wait_event_interruptible(cd->wq,
+					       !skb_queue_empty(&cd->rx));
+		if (ret)
+			return ret;
+	}
+
+	len = min_t(size_t, count, skb->len);
+	if (copy_to_user(buf, skb->data, len)) {
+		skb_queue_head(&cd->rx, skb);
+		return -EFAULT;
+	}
+	if (len < skb->len) {
+		/* the rest on the next read */
+		skb_pull(skb, len);
+		skb_queue_head(&cd->rx, skb);
+	} else {
+		consume_skb(skb);
+		/* packets may wait in the ring for room here */
+		mtk_ccci_hif_kick(cd->ccci);
+	}
+	return len;
+}
+
+static ssize_t mtk_ccci_cdev_write(struct file *file, const char __user *buf,
+				   size_t count, loff_t *ppos)
+{
+	struct mtk_ccci_cdev *cd = mtk_ccci_cdev_of(file);
+	struct mtk_ccci *ccci = cd->ccci;
+	struct mtk_ccci_header *hdr;
+	struct sk_buff *skb;
+	int ret;
+
+	/* a shared memory node: nothing to send on */
+	if (cd->tx_ch == MTK_CCCI_CDEV_NO_TX)
+		return -EOPNOTSUPP;
+	if (count < sizeof(*hdr))
+		return -EINVAL;
+	/* the stock limit for a port with a user header (+4 on FS) */
+	if (count > MTK_CCCI_MTU + sizeof(*hdr) + 4)
+		return -EMSGSIZE;
+	if (!mtk_ccci_cdev_tx_allowed(ccci))
+		return -ENODEV;
+
+	skb = mtk_ccci_alloc_skb(count, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+	if (copy_from_user(skb_put(skb, count), buf, count)) {
+		kfree_skb(skb);
+		return -EFAULT;
+	}
+	hdr = (void *)skb->data;
+	if (count == sizeof(*hdr))
+		hdr->data[0] = cpu_to_le32(MTK_CCCI_MAGIC);
+	else
+		hdr->data[1] = cpu_to_le32(count);
+	hdr->status = cpu_to_le32(cd->tx_ch);
+
+	for (;;) {
+		ret = mtk_ccci_send_skb(ccci, cd->txq, skb);
+		if (ret != -EAGAIN || (file->f_flags & O_NONBLOCK))
+			break;
+		/* the ring is full: the modem drains it */
+		if (signal_pending(current)) {
+			ret = -ERESTARTSYS;
+			break;
+		}
+		usleep_range(1000, 2000);
+		if (!mtk_ccci_cdev_tx_allowed(ccci)) {
+			ret = -ENODEV;
+			break;
+		}
+	}
+	if (ret) {
+		kfree_skb(skb);
+		return ret;
+	}
+	cd->tx_pkts++;
+	return count;
+}
+
+static __poll_t mtk_ccci_cdev_poll(struct file *file, poll_table *wait)
+{
+	struct mtk_ccci_cdev *cd = mtk_ccci_cdev_of(file);
+	__poll_t mask = 0;
+
+	poll_wait(file, &cd->wq, wait);
+	if (!skb_queue_empty(&cd->rx))
+		mask |= EPOLLIN | EPOLLRDNORM;
+	if (mtk_ccci_cdev_tx_allowed(cd->ccci))
+		mask |= EPOLLOUT | EPOLLWRNORM;
+	return mask;
+}
+
+static int mtk_ccci_cdev_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct mtk_ccci_cdev *cd = mtk_ccci_cdev_of(file);
+	const struct mtk_ccci_smem_region *r;
+	unsigned long size;
+
+	if (cd->mmap_smem == MTK_CCCI_SMEM_DBM)
+		return -ENODEV;
+	r = mtk_ccci_lk_smem(cd->ccci, cd->mmap_smem);
+	if (!r)
+		return -ENODEV;
+	size = le32_to_cpu(r->size) & PAGE_MASK;
+	if (!size || !PAGE_ALIGNED(le64_to_cpu(r->ap_phys)))
+		return -ENODEV;
+	if (vma->vm_pgoff || vma->vm_end - vma->vm_start > size)
+		return -EINVAL;
+	size = vma->vm_end - vma->vm_start;
+
+	vm_flags_set(vma, VM_IO | VM_DONTEXPAND | VM_DONTDUMP);
+	vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);
+	return remap_pfn_range(vma, vma->vm_start,
+			       PHYS_PFN(le64_to_cpu(r->ap_phys)), size,
+			       vma->vm_page_prot);
+}
+
+static const struct file_operations mtk_ccci_cdev_fops = {
+	.owner = THIS_MODULE,
+	.open = mtk_ccci_cdev_open,
+	.release = mtk_ccci_cdev_release,
+	.read = mtk_ccci_cdev_read,
+	.write = mtk_ccci_cdev_write,
+	.poll = mtk_ccci_cdev_poll,
+	.mmap = mtk_ccci_cdev_mmap,
+	.llseek = noop_llseek,
+};
+
+/* the modem stopped: what it asked for is void */
+void mtk_ccci_cdev_reset(struct mtk_ccci *ccci)
+{
+	skb_queue_purge(&ccci->cdev_fs.rx);
+	wake_up_interruptible(&ccci->cdev_fs.wq);
+	skb_queue_purge(&ccci->cdev_rpc.rx);
+	wake_up_interruptible(&ccci->cdev_rpc.wq);
+	skb_queue_purge(&ccci->cdev_aud.rx);
+	wake_up_interruptible(&ccci->cdev_aud.wq);
+	skb_queue_purge(&ccci->cdev_dirc.rx);
+	wake_up_interruptible(&ccci->cdev_dirc.wq);
+}
+
+static void mtk_ccci_cdev_show(const struct mtk_ccci_cdev *cd,
+			       struct seq_file *s)
+{
+	seq_printf(s, "/dev/%s: %s, rx %lu (queued %u, full %lu) tx %lu\n",
+		   cd->misc.name, atomic_read(&cd->open) ? "open" : "closed",
+		   cd->rx_pkts, skb_queue_len(&cd->rx), cd->rx_full,
+		   cd->tx_pkts);
+}
+
+void mtk_ccci_cdev_debugfs(struct mtk_ccci *ccci, struct seq_file *s)
+{
+	mtk_ccci_cdev_show(&ccci->cdev_fs, s);
+	mtk_ccci_cdev_show(&ccci->cdev_rpc, s);
+	mtk_ccci_cdev_show(&ccci->cdev_aud, s);
+	mtk_ccci_cdev_show(&ccci->cdev_dirc, s);
+}
+
+static void mtk_ccci_cdev_cleanup(void *data)
+{
+	struct mtk_ccci_cdev *cd = data;
+
+	misc_deregister(&cd->misc);
+	skb_queue_purge(&cd->rx);
+}
+
+static int mtk_ccci_cdev_add(struct mtk_ccci *ccci, struct mtk_ccci_cdev *cd,
+			     const char *name, u16 tx_ch, u8 txq,
+			     enum mtk_ccci_smem_id mmap_smem)
+{
+	int ret;
+
+	cd->ccci = ccci;
+	cd->mmap_smem = mmap_smem;
+	cd->tx_ch = tx_ch;
+	cd->txq = txq;
+	skb_queue_head_init(&cd->rx);
+	init_waitqueue_head(&cd->wq);
+	atomic_set(&cd->open, 0);
+
+	cd->misc.minor = MISC_DYNAMIC_MINOR;
+	cd->misc.name = name;
+	cd->misc.fops = &mtk_ccci_cdev_fops;
+	cd->misc.parent = ccci->dev;
+	cd->misc.mode = 0600;
+	ret = misc_register(&cd->misc);
+	if (ret)
+		return dev_err_probe(ccci->dev, ret, "/dev/%s\n", name);
+	return devm_add_action_or_reset(ccci->dev, mtk_ccci_cdev_cleanup, cd);
+}
+
+int mtk_ccci_cdev_init(struct mtk_ccci *ccci)
+{
+	int ret;
+
+	ret = mtk_ccci_cdev_add(ccci, &ccci->cdev_fs, "ccci_fs",
+				MTK_CCCI_CH_FS_TX, MTK_CCCI_Q_FS,
+				MTK_CCCI_SMEM_DBM);
+	if (ret)
+		return ret;
+	ret = mtk_ccci_cdev_add(ccci, &ccci->cdev_rpc, "ccci_rpc",
+				MTK_CCCI_CH_RPC_TX, MTK_CCCI_Q_RPC,
+				MTK_CCCI_SMEM_DRDI);
+	if (ret)
+		return ret;
+	/* the speech control of the audio HAL, as the downstream ccci_aud port */
+	ret = mtk_ccci_cdev_add(ccci, &ccci->cdev_aud, "ccci_aud",
+				MTK_CCCI_CH_PCM_TX, MTK_CCCI_Q_CTRL,
+				MTK_CCCI_SMEM_DBM);
+	if (ret)
+		return ret;
+	/* the MD direct path control (the downstream mddp answers it), queue 1 */
+	ret = mtk_ccci_cdev_add(ccci, &ccci->cdev_dirc, "ccci_0_200",
+				MTK_CCCI_CH_MD_DIRC_TX, MTK_CCCI_Q_RPC,
+				MTK_CCCI_SMEM_DBM);
+	if (ret)
+		return ret;
+	/* the speech data rings in RAW_AUDIO shared memory, mmap() only */
+	return mtk_ccci_cdev_add(ccci, &ccci->cdev_raw_audio, "ccci_raw_audio",
+				 MTK_CCCI_CDEV_NO_TX, MTK_CCCI_Q_CTRL,
+				 MTK_CCCI_SMEM_RAW_AUDIO);
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_ctl.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_ctl.c
new file mode 100644
index 000000000..d46522a97
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_ctl.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: the control, system and status channels.
+ *
+ * Control (channel 0): the second boot handshake (HS2) and the modem
+ * exception messages. System (channel 2): notifications both ways; only
+ * the echo test is answered, the rest is logged. Status (channel 67):
+ * the modem's answers to status polls, logged.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/bitfield.h>
+#include <linux/device.h>
+#include <linux/skbuff.h>
+#include <linux/wait.h>
+
+#include "mtk_ccci.h"
+
+/**
+ * mtk_ccci_fsm_exception() - the modem reported an exception
+ * @ccci: driver state
+ * @channels: exception CCIF channels raised, 0 for the watchdog
+ *
+ * The modem is marked; the handshake runs in mtk_ccci_ee.c, the FSM
+ * gives up waiting, collects the report and powers the modem off. May
+ * be called from interrupt context.
+ */
+void mtk_ccci_fsm_exception(struct mtk_ccci *ccci, u32 channels)
+{
+	if (!READ_ONCE(ccci->exception))
+		dev_err(ccci->dev, "modem exception (CCIF %#x%s)\n", channels,
+			ccci->wdt_fired ? ", watchdog" : "");
+	ccci->ex_channels |= channels;
+	WRITE_ONCE(ccci->exception, true);
+	wake_up_all(&ccci->hs_wq);
+}
+
+/* HS2: the modem took the runtime data and is ready (RX path) */
+void mtk_ccci_fsm_hs2(struct mtk_ccci *ccci)
+{
+	WRITE_ONCE(ccci->hs2_seen, true);
+	wake_up_all(&ccci->hs_wq);
+}
+
+static void mtk_ccci_hdr_words(const struct sk_buff *skb, u32 w[4])
+{
+	const struct mtk_ccci_header *hdr = (const void *)skb->data;
+
+	w[0] = le32_to_cpu(hdr->data[0]);
+	w[1] = le32_to_cpu(hdr->data[1]);
+	w[2] = le32_to_cpu(hdr->status);
+	w[3] = le32_to_cpu(hdr->reserved);
+}
+
+void mtk_ccci_ctl_recv(struct mtk_ccci *ccci, struct sk_buff *skb)
+{
+	u32 w[4];
+
+	mtk_ccci_hdr_words(skb, w);
+	dev_info(ccci->dev, "control message %#x %#x\n", w[1], w[3]);
+
+	switch (w[1]) {
+	case MTK_CCCI_CTL_MD_INIT_START_BOOT:
+		if (w[3] == MTK_CCCI_CTL_MD_INIT_CHK_ID)
+			dev_warn(ccci->dev, "HS1 on a ring queue, ignored\n");
+		else if (READ_ONCE(ccci->state) != MTK_CCCI_FSM_WAIT_HS2)
+			dev_warn(ccci->dev, "HS2 without runtime data, ignored\n");
+		else
+			mtk_ccci_fsm_hs2(ccci);
+		break;
+	case MTK_CCCI_CTL_MD_EX:
+	case MTK_CCCI_CTL_MD_EX_REC_OK:
+	case MTK_CCCI_CTL_MD_EX_PASS:
+		mtk_ccci_ee_ctl(ccci, w[1], w[3], skb);
+		break;
+	case MTK_CCCI_CTL_DRV_VER_ERROR:
+		dev_err(ccci->dev, "modem: AP/modem driver version mismatch\n");
+		mtk_ccci_fsm_exception(ccci, 0);
+		break;
+	default:
+		break;
+	}
+	consume_skb(skb);
+}
+
+void mtk_ccci_sys_recv(struct mtk_ccci *ccci, struct sk_buff *skb)
+{
+	u32 w[4];
+
+	mtk_ccci_hdr_words(skb, w);
+	dev_info(ccci->dev, "system message (%08x %x %lu %x)\n", w[0], w[1],
+		 FIELD_GET(MTK_CCCI_H_CHANNEL, w[2]), w[3]);
+
+	switch (w[1]) {
+	case MTK_CCCI_SYS_TEST_MD2AP:
+		mtk_ccci_send_msg(ccci, MTK_CCCI_Q_CTRL, MTK_CCCI_CH_SYSTEM_TX,
+				  MTK_CCCI_SYS_TEST_AP2MD, w[3]);
+		break;
+	case MTK_CCCI_SYS_TEST_L1CORE_MD2AP:
+		mtk_ccci_send_msg(ccci, MTK_CCCI_Q_CTRL, MTK_CCCI_CH_SYSTEM_TX,
+				  MTK_CCCI_SYS_TEST_L1CORE_AP2MD, w[3]);
+		break;
+	default:
+		break;
+	}
+	consume_skb(skb);
+}
+
+void mtk_ccci_status_recv(struct mtk_ccci *ccci, struct sk_buff *skb)
+{
+	u32 w[4];
+
+	mtk_ccci_hdr_words(skb, w);
+	dev_dbg(ccci->dev, "modem status %#x\n", w[2]);
+	consume_skb(skb);
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_dpmaif.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_dpmaif.c
new file mode 100644
index 000000000..263ea60b5
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_dpmaif.c
@@ -0,0 +1,1973 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: DPMAIF v3 data path, hardware setup.
+ *
+ * DPMAIF moves network packets between the AP and the modem with DMA
+ * descriptor rings in AP memory. It is the block the t7xx driver drives
+ * over PCIe (same registers, same descriptors); here it is on the SoC
+ * bus, set up the way the MediaTek downstream driver sets it up on
+ * MT6878 (ccci_dpmaif_drv_v3.c, capability 4: no receive offload):
+ *
+ *  - DL (modem -> AP), one RX queue: a BAT ring of buffers the AP lends
+ *    the hardware, a fragment BAT ring for the rest of large packets and
+ *    a PIT ring where the hardware reports what it put where (message
+ *    PIT: CCMNI channel, i.e. which network device, and checksum status;
+ *    normal PIT: buffer id and length);
+ *  - UL (AP -> modem), 4 TX queues: a DRB ring of a message DRB (channel,
+ *    length) followed by payload DRBs (address, length).
+ *
+ * The block is set up before the modem is released and reset after the
+ * modem is powered off, as the downstream driver does it.
+ *
+ * Receive follows t7xx (t7xx_hif_dpmaif_rx.c): NAPI on the one RX queue
+ * reads the PITs up to the hardware write index, checks their sequence
+ * numbers, puts a packet together from its skb buffer and fragment pages
+ * and hands it to the WWAN link of its CCMNI channel; the buffers handed
+ * back are lent again. A buffer slot is lent again only once its PIT has
+ * been read, so the hardware never writes into a buffer the AP owns, and
+ * all buffers are freed only after the block is reset.
+ *
+ * Transmit follows the downstream driver and t7xx_hif_dpmaif_tx.c: a
+ * packet is a message DRB (CCMNI channel, length) and one payload DRB
+ * (the links do not do scatter-gather), on TX queue 0, or on queue 1 for
+ * a TCP segment that only acknowledges, as the downstream CCMNI does. The
+ * hardware read index tells which packets it took; they are released
+ * from a BH work item on the TX done interrupt, and the links are woken
+ * when a full queue drains.
+ *
+ * Nothing here runs unless the module parameter data=1.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2021 Intel Corporation (t7xx DPMAIF)
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/pm_wakeup.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
+#include <linux/mfd/syscon.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/netdevice.h>
+#include <linux/rcupdate.h>
+#include <linux/regmap.h>
+#include <linux/seq_file.h>
+#include <linux/sizes.h>
+#include <linux/skbuff.h>
+#include <linux/tcp.h>
+#include <linux/workqueue.h>
+#include <net/ip.h>
+
+#include "mtk_ccci.h"
+
+static bool data = true;
+module_param(data, bool, 0444);
+MODULE_PARM_DESC(data,
+		 "set up DPMAIF with the modem: mobile data (default: no)");
+
+#define DPMAIF_TXQ_NUM		4
+#define DPMAIF_BAT_CNT		16384
+#define DPMAIF_FRG_CNT		16384
+#define DPMAIF_PIT_CNT		(DPMAIF_BAT_CNT * 2)
+#define DPMAIF_DRB_CNT		2048
+
+/* buffers lent to the hardware at a time (downstream: up to the ring size) */
+#define DPMAIF_BAT_LEND		2048
+#define DPMAIF_FRG_LEND		1024
+
+/* DL settings of the downstream driver */
+#define DPMAIF_BAT_BUF_SIZE	(128 * 13)	/* a BAT buffer */
+#define DPMAIF_FRG_BUF_SIZE	(128 * 15)	/* a fragment BAT buffer */
+#define DPMAIF_BAT_REMAIN	64	/* less left in a buffer: next one */
+#define DPMAIF_PKT_BIDCNT	1	/* packets in one buffer */
+#define DPMAIF_HW_MTU		(3 * 1024 + 8)
+#define DPMAIF_CHK_BAT_NUM	62	/* fewer free BATs: length error */
+#define DPMAIF_CHK_FRG_NUM	62
+#define DPMAIF_CHK_PIT_NUM	(DPMAIF_CHK_BAT_NUM * 2)
+#define DPMAIF_CHK_RB_PIT_NUM	64
+
+/* UL: TCP ACKs on their own queue, as the downstream CCMNI does */
+#define DPMAIF_TXQ_DATA		0
+#define DPMAIF_TXQ_ACK		1
+#define DPMAIF_TX_DRBS		2	/* message + payload */
+
+/* register poll limits; the downstream driver spins forever */
+#define DPMAIF_UL_POLL_US	1000
+#define DPMAIF_POLL_US		10000
+#define DPMAIF_IDLE_POLL_US	100000
+
+/*
+ * "pd" window (0x1022d000): UL +0x000, DL +0x100, AP misc +0x400 and the
+ * SRAM copies of the AO settings: DL +0xc00, UL +0xd00, misc +0xe00.
+ */
+#define PD_UL_DBG_STA2		0x088
+#define PD_UL_ADD_DESC_CH(q)	(0x0b0 + 4 * (q))	/* DRB words added */
+#define  UL_ADD_UPDATE		BIT(31)	/* reads 1 while the update runs */
+#define  UL_DBG_IDLE		BIT(11)
+#define PD_DL_BAT_INIT		0x100
+#define PD_DL_BAT_ADD		0x104	/* buffers lent, BIT(16): fragment */
+#define PD_DL_BAT_INIT_CON0	0x108	/* BAT base 31:0 */
+#define PD_DL_BAT_INIT_CON1	0x10c
+#define  BAT_CON1_CNT		GENMASK(15, 0)
+#define  BAT_CON1_EN		BIT(16)
+#define  BAT_CON1_CACHE_PRI	BIT(22)
+#define  BAT_CON1_ADDR_HI	GENMASK(31, 24)
+#define PD_DL_PIT_INIT		0x120
+#define PD_DL_PIT_ADD		0x124	/* PITs read */
+#define PD_DL_PIT_INIT_CON0	0x128	/* PIT base 31:0 */
+#define PD_DL_PIT_INIT_CON1	0x12c
+#define  PIT_CON1_CNT		GENMASK(17, 0)
+#define  PIT_CON1_ADDR_HI	GENMASK(31, 24)
+#define PD_DL_PIT_INIT_CON3	0x134
+#define  PIT_CON3_EN		BIT(0)
+#define PD_DL_RESERVE_RW	0x1a8	/* 0 after the PD domain lost power */
+#define PD_DL_DBG_STA1		0x1b4
+#define  DL_DBG_IDLE		BIT(23)
+/* BAT_INIT, PIT_INIT */
+#define  DL_INIT_ALLSET		BIT(0)
+#define  DL_INIT_FRG		BIT(16)
+#define  DL_INIT_EN		BIT(31)	/* reads 1 while the update runs */
+/* BAT_ADD, PIT_ADD */
+#define  DL_ADD_FRG		BIT(16)
+#define  DL_ADD_UPDATE		BIT(31)	/* reads 1 while the update runs */
+
+#define PD_AP_UL_L2TISAR0	0x400	/* UL interrupt status, write 1 to clear */
+#define PD_AP_L1TISAR0		0x410
+#define PD_AP_DMA_ERR_STA	0x440
+#define PD_AP_DL_L2TISAR0	0x450	/* DL interrupt status */
+#define PD_AP_IP_BUSY		0x460
+#define PD_AP_CG_EN		0x468
+#define PD_AP_CODA_VER		0x46c
+#define PD_AP_OVERWRITE_CFG	0x490	/* bit 0: sync the settings to SRAM */
+#define PD_AP_MEM_CLR		0x494	/* bit 0: clear the SRAM */
+
+#define PD_DL_PKTINFO_CON0	0xc00
+#define  PKT0_CHK_RB_PIT	GENMASK(7, 0)
+#define  PKT0_REMAIN_MINSZ	GENMASK(15, 8)	/* in 16 bytes */
+#define  PKT0_BID_MAXCNT	GENMASK(31, 16)
+#define PD_DL_PKTINFO_CON1	0xc04	/* MTU */
+#define PD_DL_PKTINFO_CON2	0xc08
+#define  PKT2_BAT_RSV_LEN	GENMASK(7, 0)
+#define  PKT2_BAT_BUF_SZ	GENMASK(16, 8)	/* in 128 bytes */
+#define  PKT2_PIT_CHK_NUM	GENMASK(31, 24)
+#define PD_DL_RDY_CHK_THRES	0xc0c
+#define  RDY_PIT_BURST		BIT(13)
+#define  RDY_BAT_CHK_THRES	GENMASK(21, 16)
+#define  RDY_PKT_ALIGN		GENMASK(23, 22)	/* 23: on, 22: 128 bytes */
+#define  RDY_PKT_ALIGN_64	BIT(23)
+#define  RDY_CHKSUM		BIT(31)
+#define PD_DL_RDY_CHK_FRG_THRES	0xc10
+#define  FRG_CHK_THRES		GENMASK(7, 0)
+#define  FRG_BUF_SZ		GENMASK(15, 8)	/* in 128 bytes */
+#define  FRG_FEATURE_EN		BIT(28)
+#define PD_DL_PIT_WR_IDX	0xc60
+#define  DL_PIT_IDX		GENMASK(17, 0)
+#define PD_DL_FRG_RD_IDX	0xc78
+#define PD_DL_BAT_RD_IDX	0xcd8
+#define PD_DL_BAT_WR_IDX	0xcdc
+#define PD_DL_PIT_RD_IDX	0xcec
+#define PD_UL_CHNL_CON0(q)	(0xd10 + 0x10 * (q))	/* DRB base 31:0 */
+#define PD_UL_CHNL_CON1(q)	(0xd14 + 0x10 * (q))
+#define  DRB_CON1_SIZE		GENMASK(15, 0)	/* in 32-bit words */
+#define  DRB_CON1_ADDR_HI	GENMASK(31, 24)
+#define PD_UL_CH_STA(q)		(0xde0 + 4 * (q))
+#define  UL_STA_RD_IDX		GENMASK(31, 16)	/* in 32-bit words */
+#define PD_MISC_REMAP(i)	(0xe0c + 4 * (i))	/* 8 registers, 3 windows each */
+
+/* "ao" window (0x10014000): AO UL +0x000, AO DL +0x400 */
+#define AO_UL_INIT_SET		0x000
+#define AO_UL_CHNL_ARB0		0x01c
+#define  ARB0_RDY(q)		BIT(q)
+#define  ARB0_ARB(q)		BIT((q) + 8)
+#define  ARB0_ARB_ALL		GENMASK(11, 8)
+#define AO_UL_AP_L2TIMR0	0x080	/* UL interrupt mask, 1 = masked */
+#define AO_UL_AP_L2TIMCR0	0x084	/* write 1: unmask */
+#define AO_UL_AP_L2TIMSR0	0x088	/* write 1: mask */
+#define AO_UL_AP_L1TIMR0	0x08c
+#define AO_UL_APDL_L2TIMR0	0x090	/* DL interrupt mask */
+#define AO_UL_APDL_L2TIMCR0	0x094
+#define AO_UL_APDL_L2TIMSR0	0x098
+#define AO_UL_IP_BUSY_MASK	0x09c
+#define AO_DL_INIT_SET		0x400
+
+/* UL interrupts */
+#define UL_INT_QDONE		GENMASK(3, 0)	/* per TX queue */
+#define UL_INT_MD_NOTRDY	GENMASK(14, 10)	/* the modem side of the queue is not up */
+#define UL_INT_PWR_NOTRDY	GENMASK(19, 15)	/* the modem is asleep */
+#define UL_INT_LEN_ERR		GENMASK(24, 20)
+#define UL_INT_EN		(UL_INT_QDONE | UL_INT_PWR_NOTRDY | UL_INT_LEN_ERR)
+/* DL interrupts */
+#define DL_INT_QDONE		BIT(0)
+#define DL_INT_MTU_ERR		BIT(6)
+#define DL_INT_EN		(DL_INT_QDONE | DL_INT_MTU_ERR)
+/* L1 sources the downstream driver masks */
+#define L1_INT_MASK		(BIT(9) | BIT(10) | BIT(15) | BIT(16))
+
+/* infracfg_ao */
+#define INFRA_AO_DPMAIF_CTRL	0x208
+#define  INFRA_AO_DPMAIF_EN	BIT(15)	/* set before the setup, cleared before reset */
+#define INFRA_AO_DPMAIF_WAKE	0xc00
+#define  INFRA_AO_DPMAIF_IP_BUSY_MASK	BIT(12)
+#define  INFRA_AO_DPMAIF_MD_WAKE_MASK	BIT(13)	/* the modem-to-AP wakeup event */
+#define INFRA_AO_RST_SET	0x130
+#define INFRA_AO_RST_CLR	0x134
+#define  INFRA_AO_DPMAIF_RST	BIT(0)
+/* infracfg (the modem node's "infra" window), shared with the CCIF reset */
+#define INFRA_RST_SET		0xf50
+#define INFRA_RST_CLR		0xf54
+#define  INFRA_DPMAIF_PD_RST	BIT(22)
+
+/*
+ * Modem bank remap: the modem side of DPMAIF sees the modem memory (banks
+ * 0 and 1, 8 windows of 32 MiB each) at modem addresses, the remap gives
+ * the AP address of each window. A window field is bits 33:25 of its AP
+ * address, bit 0 of the field enables it.
+ */
+#define DPMAIF_REMAP_WIN	SZ_32M
+#define DPMAIF_REMAP_ON		16	/* banks 0 and 1; bank 4 stays off */
+#define DPMAIF_REMAP_FIELD	GENMASK_ULL(33, 25)
+
+/* normal PIT, v3 (16 bytes) */
+#define PIT0_PACKET_TYPE	BIT(0)		/* 0: data, 1: message */
+#define PIT0_CONT		BIT(1)		/* more PITs for this packet */
+#define PIT0_BUF_TYPE		BIT(2)		/* 1: fragment BAT */
+#define PIT0_BUF_ID		GENMASK(15, 3)
+#define PIT0_DATA_LEN		GENMASK(31, 16)
+/* word 1: buffer address low, word 2: high */
+#define PIT3_SEQ		GENMASK(7, 0)
+#define PIT3_H_BID		GENMASK(10, 8)	/* buffer id bits 15:13 */
+#define PIT3_ULQ_DONE		GENMASK(29, 24)
+#define PIT3_DLQ_DONE		GENMASK(31, 30)
+#define PIT_SEQ_MAX		0xfe		/* without receive offload */
+
+/* message PIT, v3 */
+#define MPIT0_CHECKSUM		GENMASK(3, 2)	/* 0: checked good */
+#define MPIT0_ERROR		BIT(4)
+#define MPIT0_SRC_QID		GENMASK(7, 5)
+#define MPIT0_CHANNEL_ID	GENMASK(23, 16)	/* CCMNI index */
+#define MPIT0_NETWORK_TYPE	GENMASK(26, 24)
+#define MPIT0_DROP		BIT(31)
+#define MPIT1_COUNT_L		GENMASK(15, 0)
+
+struct dpmaif_pit {
+	__le32 w[4];
+};
+
+/* BAT (8 bytes): buffer address low, high byte */
+struct dpmaif_bat {
+	__le32 addr_lo;
+	__le32 addr_hi;
+};
+
+/* what is lent in a BAT slot */
+struct dpmaif_bat_skb {
+	struct sk_buff *skb;
+	dma_addr_t dma;
+};
+
+struct dpmaif_bat_frg {
+	void *data;			/* page fragment */
+	dma_addr_t dma;
+};
+
+/* DRB (8 bytes) */
+#define DRB0_TYPE		GENMASK(1, 0)	/* 0: payload, 1: message */
+#define DRB0_CONT		BIT(2)
+#define DRB0_ADDR_EXT		GENMASK(15, 8)	/* payload: address bits 39:32 */
+#define DRB0_DATA_LEN		GENMASK(31, 16)	/* payload / message: length */
+#define DRB1_COUNT_L		GENMASK(15, 0)	/* message: priority count */
+#define DRB1_CHANNEL_ID		GENMASK(23, 16)	/* message: CCMNI index */
+#define DRB1_NETWORK_TYPE	GENMASK(26, 24)
+#define DRB1_IPV4_CSUM		BIT(28)
+#define DRB1_L4_CSUM		BIT(29)
+
+struct dpmaif_drb {
+	__le32 w[2];
+};
+
+/* the packet behind a payload DRB */
+struct dpmaif_drb_skb {
+	struct sk_buff *skb;
+	dma_addr_t dma;
+	u32 len;
+};
+
+struct dpmaif_txq {
+	spinlock_t lock;		/* the indexes, on, the DRB ring */
+	bool on;			/* takes packets */
+	struct dpmaif_drb_skb *skbs;	/* by DRB slot */
+	u32 wr;				/* next DRB to fill */
+	u32 rel;			/* next DRB to release */
+	unsigned long pkts;
+	unsigned long full;
+	unsigned long add_err;
+	unsigned long rd_err;
+};
+
+struct dpmaif_ring {
+	void *base;
+	dma_addr_t dma;
+	u32 cnt;
+};
+
+static const char * const dpmaif_clk_names[] = { "main", "blk", "26m" };
+
+struct mtk_ccci_dpmaif {
+	struct mtk_ccci *ccci;
+	struct device *dev;		/* the modem device, for DMA */
+	void __iomem *ao;
+	void __iomem *pd;
+	struct regmap *infracfg_ao;
+	struct clk_bulk_data clks[ARRAY_SIZE(dpmaif_clk_names)];
+	int irq;
+	u64 md_base;			/* AP address of modem bank 0 */
+
+	struct mutex lock;		/* started, clocks, register access */
+	bool started;			/* set up, clocks held */
+	struct dpmaif_ring bat;
+	struct dpmaif_ring frg;
+	struct dpmaif_ring pit;
+	struct dpmaif_ring drb[DPMAIF_TXQ_NUM];
+
+	/* DL, only touched by NAPI while started */
+	struct net_device *napi_dev;
+	struct napi_struct napi;
+	struct dpmaif_bat_skb *bat_skb;	/* by BAT slot */
+	struct dpmaif_bat_frg *frg_buf;	/* by fragment BAT slot */
+	u32 bat_wr;			/* next slot to lend */
+	u32 bat_lent;
+	u32 frg_wr;
+	u32 frg_lent;
+	u32 pit_rd;
+	u8 pit_seq;			/* the one expected next */
+	bool rx_retry;			/* a PIT not written yet, poll again */
+	/* the packet being put together */
+	struct sk_buff *rx_skb;
+	bool rx_msg;			/* its message PIT seen */
+	bool rx_drop;
+	bool rx_csum_ok;
+	u8 rx_ch;
+
+	/* UL */
+	struct dpmaif_txq txq[DPMAIF_TXQ_NUM];
+	struct work_struct tx_work;
+	atomic_t tx_pending;		/* TX queues with done interrupts */
+
+	/* DL counters: per CCMNI channel, and what was dropped */
+	unsigned long dl_pkts[MTK_CCCI_NET_LINKS];
+	unsigned long dl_nolink[MTK_CCCI_NET_LINKS];
+	unsigned long dl_bad_ch;
+	u8 dl_last_bad_ch;
+	unsigned long dl_dropped;	/* the modem said so */
+	unsigned long dl_err;		/* PIT or buffer inconsistent */
+	unsigned long pit_seq_err;
+	unsigned long bat_nomem;
+
+	/* interrupt counters */
+	unsigned long irqs;
+	unsigned long ul_done;
+	unsigned long ul_pwr_notrdy;
+	unsigned long ul_md_notrdy;
+	unsigned long ul_len_err;
+	unsigned long dl_done;
+	unsigned long dl_mtu_err;
+	u32 last_ul_sta;
+	u32 last_dl_sta;
+
+	/* system sleep */
+	bool suspended;			/* transmit held: suspend_late..resume */
+	bool wake_armed;		/* irq is a wakeup interrupt */
+	u32 sleep_dl_mask;		/* DL interrupt mask backed up at suspend */
+	unsigned long suspends;
+	unsigned long wakeups;		/* TF-A: the DPMAIF woke the AP */
+	unsigned long pd_lost;		/* resumes with the PD block powered down */
+	unsigned long wake_query[4];	/* the last TF-A answer */
+};
+
+static void dpmaif_rmem_release(void *dev)
+{
+	of_reserved_mem_device_release(dev);
+}
+
+static int dpmaif_ring_alloc(struct device *dev, struct dpmaif_ring *r,
+			     u32 cnt, size_t entry)
+{
+	r->cnt = cnt;
+	r->base = dmam_alloc_coherent(dev, cnt * entry, &r->dma, GFP_KERNEL);
+	return r->base ? 0 : -ENOMEM;
+}
+
+static void dpmaif_rmw(void __iomem *reg, u32 mask, u32 val)
+{
+	writel((readl(reg) & ~mask) | (val & mask), reg);
+}
+
+/* wait for a self-clearing bit */
+static int dpmaif_wait_clear(struct mtk_ccci_dpmaif *dp, void __iomem *reg,
+			     u32 bit, const char *what)
+{
+	u32 v;
+	int ret;
+
+	ret = readl_poll_timeout_atomic(reg, v, !(v & bit), 1, DPMAIF_POLL_US);
+	if (ret)
+		dev_err(dp->dev, "DPMAIF %s stuck: %#x\n", what, v);
+	return ret;
+}
+
+/* the DL "init" handshake: wait idle, write, wait for the update */
+static int dpmaif_dl_init_cmd(struct mtk_ccci_dpmaif *dp, u32 reg, u32 cmd,
+			      const char *what)
+{
+	int ret;
+
+	ret = dpmaif_wait_clear(dp, dp->pd + reg, DL_INIT_EN, what);
+	if (ret)
+		return ret;
+	writel(cmd, dp->pd + reg);
+	return dpmaif_wait_clear(dp, dp->pd + reg, DL_INIT_EN, what);
+}
+
+static void dpmaif_remap(struct mtk_ccci_dpmaif *dp)
+{
+	unsigned int i, j, w;
+	u32 v;
+
+	for (i = 0; i < 8; i++) {
+		v = 0;
+		for (j = 0; j < 3; j++) {
+			w = i * 3 + j;
+			v |= FIELD_GET(DPMAIF_REMAP_FIELD, dp->md_base +
+				       (u64)w * DPMAIF_REMAP_WIN) << (10 * j + 1);
+			if (w < DPMAIF_REMAP_ON)
+				v |= BIT(10 * j);
+		}
+		writel(v, dp->pd + PD_MISC_REMAP(i));
+	}
+}
+
+/* unmask the wanted interrupts, wait until the mask shows it */
+static int dpmaif_irq_setup(struct mtk_ccci_dpmaif *dp, u32 sta, u32 mask,
+			    u32 clr, u32 set, u32 en, const char *what)
+{
+	u32 v;
+	int ret;
+
+	writel(~0U, dp->pd + sta);
+	writel(en, dp->ao + clr);
+	writel(~en, dp->ao + set);
+	ret = readl_poll_timeout_atomic(dp->ao + mask, v, (v & en) != en, 1,
+					DPMAIF_POLL_US);
+	if (ret)
+		dev_err(dp->dev, "DPMAIF %s interrupts stay masked: %#x\n",
+			what, v);
+	return ret;
+}
+
+/* the common part: SRAM, clock gating, bank remap, interrupts */
+static int dpmaif_hw_common(struct mtk_ccci_dpmaif *dp)
+{
+	int ret;
+
+	writel(readl(dp->pd + PD_AP_MEM_CLR) | BIT(0), dp->pd + PD_AP_MEM_CLR);
+	ret = dpmaif_wait_clear(dp, dp->pd + PD_AP_MEM_CLR, BIT(0),
+				"SRAM clear");
+	if (ret)
+		return ret;
+
+	writel(0x7f, dp->pd + PD_AP_CG_EN);
+	dpmaif_remap(dp);
+	writel(L1_INT_MASK, dp->ao + AO_UL_AP_L1TIMR0);
+	/* reads 0 again once the PD domain lost its state */
+	writel(0xff, dp->pd + PD_DL_RESERVE_RW);
+
+	ret = dpmaif_irq_setup(dp, PD_AP_UL_L2TISAR0, AO_UL_AP_L2TIMR0,
+			       AO_UL_AP_L2TIMCR0, AO_UL_AP_L2TIMSR0, UL_INT_EN,
+			       "UL");
+	if (ret)
+		return ret;
+	ret = dpmaif_irq_setup(dp, PD_AP_DL_L2TISAR0, AO_UL_APDL_L2TIMR0,
+			       AO_UL_APDL_L2TIMCR0, AO_UL_APDL_L2TIMSR0,
+			       DL_INT_EN, "DL");
+	if (ret)
+		return ret;
+
+	writel(~0U, dp->pd + PD_AP_IP_BUSY);
+	writel(0, dp->ao + AO_UL_IP_BUSY_MASK);
+	return 0;
+}
+
+/* RX queue 0: packet parameters and the PIT ring */
+static int dpmaif_hw_rxq(struct mtk_ccci_dpmaif *dp)
+{
+	void __iomem *pd = dp->pd;
+
+	dpmaif_rmw(pd + PD_DL_PKTINFO_CON0,
+		   PKT0_REMAIN_MINSZ | PKT0_BID_MAXCNT | PKT0_CHK_RB_PIT,
+		   FIELD_PREP(PKT0_REMAIN_MINSZ, DPMAIF_BAT_REMAIN / 16) |
+		   FIELD_PREP(PKT0_BID_MAXCNT, DPMAIF_PKT_BIDCNT) |
+		   FIELD_PREP(PKT0_CHK_RB_PIT, DPMAIF_CHK_RB_PIT_NUM));
+	dpmaif_rmw(pd + PD_DL_RDY_CHK_THRES, RDY_PKT_ALIGN, RDY_PKT_ALIGN_64);
+	writel(DPMAIF_HW_MTU, pd + PD_DL_PKTINFO_CON1);
+	dpmaif_rmw(pd + PD_DL_PKTINFO_CON2, PKT2_PIT_CHK_NUM,
+		   FIELD_PREP(PKT2_PIT_CHK_NUM, DPMAIF_CHK_PIT_NUM));
+	/* BAT cache and PIT burst, "performance" in the downstream driver */
+	dpmaif_rmw(pd + PD_DL_BAT_INIT_CON1, BAT_CON1_CACHE_PRI,
+		   BAT_CON1_CACHE_PRI);
+	dpmaif_rmw(pd + PD_DL_RDY_CHK_THRES, RDY_PIT_BURST, RDY_PIT_BURST);
+
+	writel(lower_32_bits(dp->pit.dma), pd + PD_DL_PIT_INIT_CON0);
+	dpmaif_rmw(pd + PD_DL_PIT_INIT_CON1, PIT_CON1_ADDR_HI | PIT_CON1_CNT,
+		   FIELD_PREP(PIT_CON1_ADDR_HI, upper_32_bits(dp->pit.dma)) |
+		   FIELD_PREP(PIT_CON1_CNT, dp->pit.cnt));
+	dpmaif_rmw(pd + PD_DL_PIT_INIT_CON3, PIT_CON3_EN, PIT_CON3_EN);
+	return dpmaif_dl_init_cmd(dp, PD_DL_PIT_INIT,
+				  DL_INIT_EN | DL_INIT_ALLSET, "PIT init");
+}
+
+static int dpmaif_hw_bat(struct mtk_ccci_dpmaif *dp, struct dpmaif_ring *r,
+			 bool frg)
+{
+	void __iomem *pd = dp->pd;
+
+	writel(lower_32_bits(r->dma), pd + PD_DL_BAT_INIT_CON0);
+	dpmaif_rmw(pd + PD_DL_BAT_INIT_CON1,
+		   BAT_CON1_ADDR_HI | BAT_CON1_CNT | BAT_CON1_EN,
+		   FIELD_PREP(BAT_CON1_ADDR_HI, upper_32_bits(r->dma)) |
+		   FIELD_PREP(BAT_CON1_CNT, r->cnt));
+	return dpmaif_dl_init_cmd(dp, PD_DL_BAT_INIT,
+				  DL_INIT_EN | DL_INIT_ALLSET |
+				  (frg ? DL_INIT_FRG : 0),
+				  frg ? "frag BAT init" : "BAT init");
+}
+
+/* both BAT rings, queue left disabled: no buffer is lent yet */
+static int dpmaif_hw_bats(struct mtk_ccci_dpmaif *dp)
+{
+	void __iomem *pd = dp->pd;
+	int ret;
+
+	dpmaif_rmw(pd + PD_DL_PKTINFO_CON2, PKT2_BAT_BUF_SZ | PKT2_BAT_RSV_LEN,
+		   FIELD_PREP(PKT2_BAT_BUF_SZ, DPMAIF_BAT_BUF_SIZE / 128));
+	dpmaif_rmw(pd + PD_DL_RDY_CHK_THRES, RDY_BAT_CHK_THRES,
+		   FIELD_PREP(RDY_BAT_CHK_THRES, DPMAIF_CHK_BAT_NUM));
+	ret = dpmaif_hw_bat(dp, &dp->bat, false);
+	if (ret)
+		return ret;
+
+	dpmaif_rmw(pd + PD_DL_RDY_CHK_FRG_THRES,
+		   FRG_FEATURE_EN | FRG_BUF_SZ | FRG_CHK_THRES,
+		   FRG_FEATURE_EN |
+		   FIELD_PREP(FRG_BUF_SZ, DPMAIF_FRG_BUF_SIZE / 128) |
+		   FIELD_PREP(FRG_CHK_THRES, DPMAIF_CHK_FRG_NUM));
+	ret = dpmaif_hw_bat(dp, &dp->frg, true);
+	if (ret)
+		return ret;
+
+	/* the hardware checks the DL checksums */
+	dpmaif_rmw(pd + PD_DL_RDY_CHK_THRES, RDY_CHKSUM, RDY_CHKSUM);
+	return 0;
+}
+
+static void dpmaif_hw_txqs(struct mtk_ccci_dpmaif *dp)
+{
+	unsigned int q;
+
+	for (q = 0; q < DPMAIF_TXQ_NUM; q++) {
+		struct dpmaif_ring *r = &dp->drb[q];
+
+		dpmaif_rmw(dp->pd + PD_UL_CHNL_CON1(q),
+			   DRB_CON1_ADDR_HI | DRB_CON1_SIZE,
+			   FIELD_PREP(DRB_CON1_ADDR_HI, upper_32_bits(r->dma)) |
+			   FIELD_PREP(DRB_CON1_SIZE,
+				      r->cnt * sizeof(struct dpmaif_drb) / 4));
+		writel(lower_32_bits(r->dma), dp->pd + PD_UL_CHNL_CON0(q));
+		dpmaif_rmw(dp->ao + AO_UL_CHNL_ARB0, ARB0_RDY(q) | ARB0_ARB(q),
+			   ARB0_RDY(q) | ARB0_ARB(q));
+	}
+}
+
+/* copy the settings to the SRAM, then tell UL and DL the setup is done */
+static int dpmaif_hw_init_done(struct mtk_ccci_dpmaif *dp)
+{
+	int ret;
+
+	writel(readl(dp->pd + PD_AP_OVERWRITE_CFG) | BIT(0),
+	       dp->pd + PD_AP_OVERWRITE_CFG);
+	ret = dpmaif_wait_clear(dp, dp->pd + PD_AP_OVERWRITE_CFG, BIT(0),
+				"SRAM sync");
+	if (ret)
+		return ret;
+	writel(BIT(0), dp->ao + AO_UL_INIT_SET);
+	writel(BIT(0), dp->ao + AO_DL_INIT_SET);
+	return 0;
+}
+
+static void dpmaif_clear_ip_busy(struct mtk_ccci_dpmaif *dp)
+{
+	u32 v = readl(dp->pd + PD_AP_IP_BUSY);
+
+	if (v)
+		writel(v, dp->pd + PD_AP_IP_BUSY);
+}
+
+/* BAT_ADD or PIT_ADD: wait until the last update is taken, write */
+static int dpmaif_dl_add(struct mtk_ccci_dpmaif *dp, u32 reg, u32 val,
+			 bool wait_done)
+{
+	int ret;
+
+	ret = dpmaif_wait_clear(dp, dp->pd + reg, DL_ADD_UPDATE, "DL add");
+	if (ret)
+		return ret;
+	writel(val, dp->pd + reg);
+	return wait_done ? dpmaif_wait_clear(dp, dp->pd + reg, DL_ADD_UPDATE,
+					     "DL add") : 0;
+}
+
+/*
+ * Lend skb buffers in ring order, as long as the next slot came back (its
+ * PIT was read) and fewer than DPMAIF_BAT_LEND are out.
+ */
+static void dpmaif_bat_refill(struct mtk_ccci_dpmaif *dp, gfp_t gfp)
+{
+	struct dpmaif_bat *bat = dp->bat.base;
+	u32 n = 0;
+
+	while (dp->bat_lent < DPMAIF_BAT_LEND) {
+		struct dpmaif_bat_skb *b = &dp->bat_skb[dp->bat_wr];
+		struct sk_buff *skb;
+		dma_addr_t dma;
+
+		if (b->skb)
+			break;
+		skb = __dev_alloc_skb(DPMAIF_BAT_BUF_SIZE, gfp);
+		if (!skb) {
+			dp->bat_nomem++;
+			break;
+		}
+		dma = dma_map_single(dp->dev, skb->data, DPMAIF_BAT_BUF_SIZE,
+				     DMA_FROM_DEVICE);
+		if (dma_mapping_error(dp->dev, dma)) {
+			dev_kfree_skb_any(skb);
+			dp->bat_nomem++;
+			break;
+		}
+		b->skb = skb;
+		b->dma = dma;
+		bat[dp->bat_wr].addr_lo = cpu_to_le32(lower_32_bits(dma));
+		bat[dp->bat_wr].addr_hi = cpu_to_le32(upper_32_bits(dma) & 0xff);
+		dp->bat_wr = (dp->bat_wr + 1) % dp->bat.cnt;
+		dp->bat_lent++;
+		n++;
+	}
+	/* writel() orders the BAT writes before the register */
+	if (n)
+		dpmaif_dl_add(dp, PD_DL_BAT_ADD, DL_ADD_UPDATE | n, false);
+}
+
+/* the same with page fragments for the fragment BAT */
+static void dpmaif_frg_refill(struct mtk_ccci_dpmaif *dp)
+{
+	struct dpmaif_bat *bat = dp->frg.base;
+	u32 n = 0;
+
+	while (dp->frg_lent < DPMAIF_FRG_LEND) {
+		struct dpmaif_bat_frg *f = &dp->frg_buf[dp->frg_wr];
+		struct page *page;
+		dma_addr_t dma;
+		void *data;
+
+		if (f->data)
+			break;
+		data = netdev_alloc_frag(DPMAIF_FRG_BUF_SIZE);
+		if (!data) {
+			dp->bat_nomem++;
+			break;
+		}
+		page = virt_to_head_page(data);
+		dma = dma_map_page(dp->dev, page, data - page_address(page),
+				   DPMAIF_FRG_BUF_SIZE, DMA_FROM_DEVICE);
+		if (dma_mapping_error(dp->dev, dma)) {
+			skb_free_frag(data);
+			dp->bat_nomem++;
+			break;
+		}
+		f->data = data;
+		f->dma = dma;
+		bat[dp->frg_wr].addr_lo = cpu_to_le32(lower_32_bits(dma));
+		bat[dp->frg_wr].addr_hi = cpu_to_le32(upper_32_bits(dma) & 0xff);
+		dp->frg_wr = (dp->frg_wr + 1) % dp->frg.cnt;
+		dp->frg_lent++;
+		n++;
+	}
+	if (n)
+		dpmaif_dl_add(dp, PD_DL_BAT_ADD, DL_ADD_UPDATE | DL_ADD_FRG | n,
+			      false);
+}
+
+/* lend the first buffers, enable both BAT rings (downstream order) */
+static int dpmaif_dl_start(struct mtk_ccci_dpmaif *dp)
+{
+	int ret;
+
+	dpmaif_frg_refill(dp);
+	dpmaif_bat_refill(dp, GFP_KERNEL);
+	if (!dp->frg_lent || !dp->bat_lent)
+		return -ENOMEM;
+
+	dpmaif_rmw(dp->pd + PD_DL_BAT_INIT_CON1, BAT_CON1_EN, BAT_CON1_EN);
+	ret = dpmaif_dl_init_cmd(dp, PD_DL_BAT_INIT, DL_INIT_EN | DL_INIT_FRG,
+				 "frag BAT enable");
+	if (ret)
+		return ret;
+	dpmaif_rmw(dp->pd + PD_DL_BAT_INIT_CON1, BAT_CON1_EN, BAT_CON1_EN);
+	return dpmaif_dl_init_cmd(dp, PD_DL_BAT_INIT, DL_INIT_EN, "BAT enable");
+}
+
+/* only with the block reset: nothing is lent to the hardware any more */
+static void dpmaif_dl_free(struct mtk_ccci_dpmaif *dp)
+{
+	u32 i;
+
+	for (i = 0; i < dp->bat.cnt; i++) {
+		struct dpmaif_bat_skb *b = &dp->bat_skb[i];
+
+		if (!b->skb)
+			continue;
+		dma_unmap_single(dp->dev, b->dma, DPMAIF_BAT_BUF_SIZE,
+				 DMA_FROM_DEVICE);
+		dev_kfree_skb_any(b->skb);
+		b->skb = NULL;
+	}
+	for (i = 0; i < dp->frg.cnt; i++) {
+		struct dpmaif_bat_frg *f = &dp->frg_buf[i];
+
+		if (!f->data)
+			continue;
+		dma_unmap_page(dp->dev, f->dma, DPMAIF_FRG_BUF_SIZE,
+			       DMA_FROM_DEVICE);
+		skb_free_frag(f->data);
+		f->data = NULL;
+	}
+	dev_kfree_skb_any(dp->rx_skb);
+	dp->rx_skb = NULL;
+	dp->rx_msg = false;
+	dp->bat_wr = 0;
+	dp->bat_lent = 0;
+	dp->frg_wr = 0;
+	dp->frg_lent = 0;
+	dp->pit_rd = 0;
+	dp->pit_seq = 0;
+	memset(dp->bat.base, 0, dp->bat.cnt * sizeof(struct dpmaif_bat));
+	memset(dp->frg.base, 0, dp->frg.cnt * sizeof(struct dpmaif_bat));
+	memset(dp->pit.base, 0, dp->pit.cnt * sizeof(struct dpmaif_pit));
+}
+
+/* hand a finished packet to the link of its channel */
+static void dpmaif_rx_deliver(struct mtk_ccci_dpmaif *dp)
+{
+	struct sk_buff *skb = dp->rx_skb;
+	struct net_device *ndev;
+	u8 ch = dp->rx_ch;
+
+	dp->rx_skb = NULL;
+	dp->rx_msg = false;
+	if (dp->rx_drop) {
+		dp->dl_dropped++;
+		goto drop;
+	}
+	if (ch >= MTK_CCCI_NET_LINKS) {
+		dp->dl_bad_ch++;
+		dp->dl_last_bad_ch = ch;
+		goto drop;
+	}
+	dp->dl_pkts[ch]++;
+	ndev = rcu_dereference(dp->ccci->net_link[ch]);
+	if (!ndev || !netif_running(ndev)) {
+		dp->dl_nolink[ch]++;
+		goto drop;
+	}
+	if (!skb_headlen(skb))
+		goto drop_dev;
+	switch (skb->data[0] >> 4) {
+	case 4:
+		skb->protocol = htons(ETH_P_IP);
+		break;
+	case 6:
+		skb->protocol = htons(ETH_P_IPV6);
+		break;
+	default:
+		goto drop_dev;
+	}
+	skb->dev = ndev;
+	if (dp->rx_csum_ok && (ndev->features & NETIF_F_RXCSUM))
+		skb->ip_summed = CHECKSUM_UNNECESSARY;
+	dev_sw_netstats_rx_add(ndev, skb->len);
+	napi_gro_receive(&dp->napi, skb);
+	return;
+
+drop_dev:
+	dev_core_stats_rx_dropped_inc(ndev);
+drop:
+	dev_kfree_skb_any(skb);
+}
+
+/*
+ * One PIT. Return 1 when it ends a packet (handed on or dropped). A buffer
+ * named by a PIT is taken back from the hardware in any case.
+ */
+static int dpmaif_rx_pit(struct mtk_ccci_dpmaif *dp,
+			 const struct dpmaif_pit *pit, u32 w0, u32 w3)
+{
+	u32 len = FIELD_GET(PIT0_DATA_LEN, w0);
+	u32 bid = FIELD_GET(PIT0_BUF_ID, w0) | FIELD_GET(PIT3_H_BID, w3) << 13;
+	u64 addr = le32_to_cpu(pit->w[1]) |
+		   (u64)le32_to_cpu(pit->w[2]) << 32;
+
+	if (w0 & PIT0_PACKET_TYPE) {
+		if (dp->rx_msg || dp->rx_skb) {
+			dp->dl_err++;
+			dev_kfree_skb_any(dp->rx_skb);
+			dp->rx_skb = NULL;
+		}
+		dp->rx_msg = true;
+		dp->rx_ch = FIELD_GET(MPIT0_CHANNEL_ID, w0);
+		dp->rx_drop = w0 & (MPIT0_DROP | MPIT0_ERROR);
+		dp->rx_csum_ok = !FIELD_GET(MPIT0_CHECKSUM, w0);
+		return 0;
+	}
+
+	if (!(w0 & PIT0_BUF_TYPE)) {
+		struct dpmaif_bat_skb *b;
+		struct sk_buff *skb;
+
+		if (bid >= dp->bat.cnt || !dp->bat_skb[bid].skb)
+			goto bad;
+		b = &dp->bat_skb[bid];
+		skb = b->skb;
+		b->skb = NULL;
+		dp->bat_lent--;
+		dma_unmap_single(dp->dev, b->dma, DPMAIF_BAT_BUF_SIZE,
+				 DMA_FROM_DEVICE);
+		if (!dp->rx_msg || dp->rx_skb || addr < b->dma ||
+		    addr - b->dma + len > DPMAIF_BAT_BUF_SIZE) {
+			dev_kfree_skb_any(skb);
+			goto bad;
+		}
+		skb_reserve(skb, addr - b->dma);
+		skb_put(skb, len);
+		dp->rx_skb = skb;
+	} else {
+		struct dpmaif_bat_frg *f;
+		struct page *page;
+		void *data;
+
+		if (bid >= dp->frg.cnt || !dp->frg_buf[bid].data)
+			goto bad;
+		f = &dp->frg_buf[bid];
+		data = f->data;
+		f->data = NULL;
+		dp->frg_lent--;
+		dma_unmap_page(dp->dev, f->dma, DPMAIF_FRG_BUF_SIZE,
+			       DMA_FROM_DEVICE);
+		if (!dp->rx_skb || addr < f->dma ||
+		    addr - f->dma + len > DPMAIF_FRG_BUF_SIZE ||
+		    skb_shinfo(dp->rx_skb)->nr_frags >= MAX_SKB_FRAGS) {
+			skb_free_frag(data);
+			goto bad;
+		}
+		page = virt_to_head_page(data);
+		skb_add_rx_frag(dp->rx_skb, skb_shinfo(dp->rx_skb)->nr_frags,
+				page, data - page_address(page) + (addr - f->dma),
+				len, DPMAIF_FRG_BUF_SIZE);
+	}
+	if (w0 & PIT0_CONT)
+		return 0;
+	dpmaif_rx_deliver(dp);
+	return 1;
+
+bad:
+	dp->dl_err++;
+	dev_kfree_skb_any(dp->rx_skb);
+	dp->rx_skb = NULL;
+	if (w0 & PIT0_CONT)
+		return 0;
+	dp->rx_msg = false;
+	return 1;
+}
+
+/*
+ * The write index can run ahead of the PIT contents: give the hardware a
+ * little time for the sequence number (t7xx does the same).
+ */
+static bool dpmaif_pit_ready(struct mtk_ccci_dpmaif *dp,
+			     const struct dpmaif_pit *pit, u32 *w3)
+{
+	unsigned int i;
+
+	for (i = 0; i < 20; i++) {
+		*w3 = le32_to_cpu(READ_ONCE(pit->w[3]));
+		if (FIELD_GET(PIT3_SEQ, *w3) == dp->pit_seq)
+			return true;
+		udelay(5);
+	}
+	return false;
+}
+
+/* read the PITs up to the write index; finish a packet once started */
+static int dpmaif_rx(struct mtk_ccci_dpmaif *dp, int budget)
+{
+	struct dpmaif_pit *pits = dp->pit.base;
+	u32 hw_wr, done = 0;
+	int pkts = 0;
+
+	dp->rx_retry = false;
+	hw_wr = readl(dp->pd + PD_DL_PIT_WR_IDX) & DL_PIT_IDX;
+	if (hw_wr >= dp->pit.cnt) {
+		dp->dl_err++;
+		return 0;
+	}
+
+	rcu_read_lock();
+	while (dp->pit_rd != hw_wr && (pkts < budget || dp->rx_msg)) {
+		const struct dpmaif_pit *pit = &pits[dp->pit_rd];
+		u32 w0, w3;
+
+		if (!dpmaif_pit_ready(dp, pit, &w3)) {
+			dp->pit_seq_err++;
+			dp->rx_retry = true;
+			break;
+		}
+		dma_rmb();
+		w0 = le32_to_cpu(READ_ONCE(pit->w[0]));
+		pkts += dpmaif_rx_pit(dp, pit, w0, w3);
+		dp->pit_seq = dp->pit_seq == PIT_SEQ_MAX ? 0 : dp->pit_seq + 1;
+		dp->pit_rd = (dp->pit_rd + 1) % dp->pit.cnt;
+		done++;
+	}
+	rcu_read_unlock();
+
+	if (done)
+		dpmaif_dl_add(dp, PD_DL_PIT_ADD, DL_ADD_UPDATE | done, true);
+	return min(pkts, budget);
+}
+
+static int dpmaif_napi_poll(struct napi_struct *napi, int budget)
+{
+	struct mtk_ccci_dpmaif *dp = container_of(napi, struct mtk_ccci_dpmaif,
+						  napi);
+	int done;
+
+	done = dpmaif_rx(dp, budget);
+	dpmaif_frg_refill(dp);
+	dpmaif_bat_refill(dp, GFP_ATOMIC);
+	if (dp->rx_retry)
+		return budget;
+	if (done < budget && napi_complete_done(napi, done))
+		writel(DL_INT_QDONE, dp->ao + AO_UL_APDL_L2TIMCR0);
+	return done;
+}
+
+static u32 dpmaif_txq_used(struct mtk_ccci_dpmaif *dp, unsigned int q)
+{
+	u32 cnt = dp->drb[q].cnt;
+
+	return (dp->txq[q].wr + cnt - dp->txq[q].rel) % cnt;
+}
+
+static u32 dpmaif_txq_free(struct mtk_ccci_dpmaif *dp, unsigned int q)
+{
+	return dp->drb[q].cnt - 1 - dpmaif_txq_used(dp, q);
+}
+
+static void dpmaif_tx_enable(struct mtk_ccci_dpmaif *dp, bool on)
+{
+	unsigned int q;
+
+	for (q = 0; q < DPMAIF_TXQ_NUM; q++) {
+		spin_lock_bh(&dp->txq[q].lock);
+		dp->txq[q].on = on;
+		spin_unlock_bh(&dp->txq[q].lock);
+	}
+}
+
+/* wake the links once a queue has room again */
+static void dpmaif_tx_wake(struct mtk_ccci_dpmaif *dp)
+{
+	unsigned int i;
+
+	rcu_read_lock();
+	for (i = 0; i < MTK_CCCI_NET_LINKS; i++) {
+		struct net_device *ndev = rcu_dereference(dp->ccci->net_link[i]);
+
+		if (ndev && netif_running(ndev) && netif_queue_stopped(ndev))
+			netif_wake_queue(ndev);
+	}
+	rcu_read_unlock();
+}
+
+/* release what the hardware has read of TX queue @q */
+static bool dpmaif_tx_release(struct mtk_ccci_dpmaif *dp, unsigned int q)
+{
+	struct dpmaif_txq *txq = &dp->txq[q];
+	u32 cnt = dp->drb[q].cnt, hw_rd;
+	bool freed = false;
+
+	hw_rd = FIELD_GET(UL_STA_RD_IDX, readl(dp->pd + PD_UL_CH_STA(q))) /
+		(sizeof(struct dpmaif_drb) / 4);
+
+	spin_lock_bh(&txq->lock);
+	/* never past what was handed over */
+	if (hw_rd >= cnt ||
+	    (hw_rd + cnt - txq->rel) % cnt > dpmaif_txq_used(dp, q)) {
+		txq->rd_err++;
+		goto out;
+	}
+	while (txq->rel != hw_rd) {
+		struct dpmaif_drb_skb *e = &txq->skbs[txq->rel];
+
+		if (e->skb) {
+			dma_unmap_single(dp->dev, e->dma, e->len,
+					 DMA_TO_DEVICE);
+			dev_consume_skb_any(e->skb);
+			e->skb = NULL;
+			freed = true;
+		}
+		txq->rel = (txq->rel + 1) % cnt;
+	}
+out:
+	spin_unlock_bh(&txq->lock);
+	return freed;
+}
+
+static void dpmaif_tx_done_work(struct work_struct *work)
+{
+	struct mtk_ccci_dpmaif *dp = container_of(work, struct mtk_ccci_dpmaif,
+						  tx_work);
+	unsigned long pending = atomic_xchg(&dp->tx_pending, 0);
+	bool freed = false;
+	unsigned int q;
+
+	for_each_set_bit(q, &pending, DPMAIF_TXQ_NUM) {
+		freed |= dpmaif_tx_release(dp, q);
+		/* masked by the interrupt handler */
+		writel(BIT(q), dp->ao + AO_UL_AP_L2TIMCR0);
+	}
+	if (freed)
+		dpmaif_tx_wake(dp);
+}
+
+/* only with the block reset: the hardware reads no DRB any more */
+static void dpmaif_tx_free(struct mtk_ccci_dpmaif *dp)
+{
+	unsigned int q;
+	u32 i;
+
+	/* the modem maps its CCMNIs to the queues again after a restart */
+	memset(dp->ccci->net_txq, 0, sizeof(dp->ccci->net_txq));
+	for (q = 0; q < DPMAIF_TXQ_NUM; q++) {
+		struct dpmaif_txq *txq = &dp->txq[q];
+
+		spin_lock_bh(&txq->lock);
+		for (i = 0; i < dp->drb[q].cnt; i++) {
+			struct dpmaif_drb_skb *e = &txq->skbs[i];
+
+			if (!e->skb)
+				continue;
+			dma_unmap_single(dp->dev, e->dma, e->len,
+					 DMA_TO_DEVICE);
+			dev_kfree_skb_any(e->skb);
+			e->skb = NULL;
+		}
+		txq->wr = 0;
+		txq->rel = 0;
+		memset(dp->drb[q].base, 0,
+		       dp->drb[q].cnt * sizeof(struct dpmaif_drb));
+		spin_unlock_bh(&txq->lock);
+	}
+	atomic_set(&dp->tx_pending, 0);
+}
+
+/* stop UL arbitration and DL, wait for both to go idle */
+static void dpmaif_hw_quiesce(struct mtk_ccci_dpmaif *dp)
+{
+	u32 v;
+
+	dpmaif_rmw(dp->ao + AO_UL_CHNL_ARB0, ARB0_ARB_ALL, 0);
+	if (readl_poll_timeout_atomic(dp->pd + PD_UL_DBG_STA2, v,
+				      v & UL_DBG_IDLE, 1, DPMAIF_IDLE_POLL_US))
+		dev_err(dp->dev, "DPMAIF UL not idle: %#x\n", v);
+
+	dpmaif_rmw(dp->pd + PD_DL_BAT_INIT_CON1, BAT_CON1_EN, 0);
+	if (dpmaif_dl_init_cmd(dp, PD_DL_BAT_INIT, DL_INIT_EN, "DL disable"))
+		return;
+	if (readl_poll_timeout_atomic(dp->pd + PD_DL_DBG_STA1, v,
+				      v & DL_DBG_IDLE, 1, DPMAIF_IDLE_POLL_US))
+		dev_err(dp->dev, "DPMAIF DL not idle: %#x\n", v);
+}
+
+/*
+ * The downstream reset ("hw-reset-ver" 1 on MT6878): take the bus enable
+ * away, reset the PD then the AO part, release AO then PD. Register
+ * writes only, the DPMAIF clocks may be off. Sleeps.
+ */
+static void dpmaif_hw_reset(struct mtk_ccci_dpmaif *dp)
+{
+	void __iomem *infra = dp->ccci->infra;
+
+	regmap_clear_bits(dp->infracfg_ao, INFRA_AO_DPMAIF_CTRL,
+			  INFRA_AO_DPMAIF_EN);
+	usleep_range(500, 600);
+	writel(INFRA_DPMAIF_PD_RST, infra + INFRA_RST_SET);
+	usleep_range(500, 600);
+	regmap_write(dp->infracfg_ao, INFRA_AO_RST_SET, INFRA_AO_DPMAIF_RST);
+	usleep_range(500, 600);
+	regmap_write(dp->infracfg_ao, INFRA_AO_RST_CLR, INFRA_AO_DPMAIF_RST);
+	usleep_range(500, 600);
+	writel(INFRA_DPMAIF_PD_RST, infra + INFRA_RST_CLR);
+}
+
+/*
+ * L2 DL mask bits 8..12 sit at 13, 14, 8, 9, 10 in the status register
+ * (downstream mapping_rx_reg_from_mask_to_sts()).
+ */
+static u32 dpmaif_dl_mask_to_sta(u32 mask)
+{
+	return (mask & GENMASK(7, 0)) |
+	       FIELD_PREP(BIT(13), FIELD_GET(BIT(8), mask)) |
+	       FIELD_PREP(BIT(14), FIELD_GET(BIT(9), mask)) |
+	       FIELD_PREP(GENMASK(10, 8), FIELD_GET(GENMASK(12, 10), mask));
+}
+
+/*
+ * One line for TX done, RX queue 0 and the errors: acknowledge, mask the
+ * queue that has work and schedule it; errors are counted.
+ */
+static irqreturn_t dpmaif_irq(int irq, void *data)
+{
+	struct mtk_ccci_dpmaif *dp = data;
+	u32 ul, ul_raw, ul_mask, dl, mask;
+
+	ul_mask = readl(dp->ao + AO_UL_AP_L2TIMR0);
+	ul_raw = readl(dp->pd + PD_AP_UL_L2TISAR0);
+	ul = ul_raw & ~ul_mask;
+	/*
+	 * MD_NOTRDY is never enabled (as downstream), so nothing would ever
+	 * acknowledge it and the status would keep showing it: acknowledged
+	 * and counted whenever the line is handled for something else.
+	 */
+	if (ul_raw & UL_INT_MD_NOTRDY) {
+		writel(ul_raw & UL_INT_MD_NOTRDY, dp->pd + PD_AP_UL_L2TISAR0);
+		dp->ul_md_notrdy++;
+	}
+	dl = readl(dp->pd + PD_AP_DL_L2TISAR0) &
+	     ~dpmaif_dl_mask_to_sta(readl(dp->ao + AO_UL_APDL_L2TIMR0));
+	dpmaif_clear_ip_busy(dp);
+	if (!ul && !dl)
+		return IRQ_NONE;
+
+	dp->irqs++;
+	if (ul) {
+		dp->last_ul_sta = ul;
+		writel(ul, dp->pd + PD_AP_UL_L2TISAR0);
+		if (ul & UL_INT_LEN_ERR)
+			dp->ul_len_err++;
+		if (ul & UL_INT_PWR_NOTRDY)
+			dp->ul_pwr_notrdy++;
+		if (ul & UL_INT_QDONE) {
+			dp->ul_done++;
+			/*
+			 * Masked before the work is queued: the work unmasks
+			 * it again and may run at once on another CPU.
+			 */
+			mask = ul & UL_INT_QDONE;
+			writel(mask, dp->ao + AO_UL_AP_L2TIMSR0);
+			atomic_or(mask, &dp->tx_pending);
+			queue_work(system_bh_wq, &dp->tx_work);
+			/* the modem is awake again (downstream does this too) */
+			if (ul_mask & UL_INT_PWR_NOTRDY)
+				writel(UL_INT_PWR_NOTRDY,
+				       dp->ao + AO_UL_AP_L2TIMCR0);
+		} else if (ul & UL_INT_PWR_NOTRDY) {
+			/* the modem sleeps: masked until the next TX done */
+			writel(UL_INT_PWR_NOTRDY, dp->ao + AO_UL_AP_L2TIMSR0);
+		}
+	}
+	if (dl) {
+		dp->last_dl_sta = dl;
+		writel(dl, dp->pd + PD_AP_DL_L2TISAR0);
+		if (dl & DL_INT_MTU_ERR)
+			dp->dl_mtu_err++;
+		if (dl & DL_INT_QDONE) {
+			dp->dl_done++;
+			/* unmasked again when NAPI is done */
+			writel(DL_INT_QDONE, dp->ao + AO_UL_APDL_L2TIMSR0);
+			napi_schedule(&dp->napi);
+		}
+	}
+	return IRQ_HANDLED;
+}
+
+/**
+ * mtk_ccci_dpmaif_start() - set DPMAIF up, before the modem is released
+ * @ccci: driver state
+ *
+ * The downstream order: clocks, bus enable, SRAM clear, bank remap,
+ * interrupts, RX queue (PIT), BAT rings, the first buffers lent and DL
+ * enabled, TX queues (DRB), SRAM sync and "init done". On a failure the
+ * block is reset and left off; the modem starts without a data path.
+ *
+ * Return: 0 (also without DPMAIF) or a negative error.
+ */
+int mtk_ccci_dpmaif_start(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+	int ret;
+
+	if (!dp)
+		return 0;
+
+	mutex_lock(&dp->lock);
+	if (dp->started) {
+		ret = 0;
+		goto out;
+	}
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(dp->clks), dp->clks);
+	if (ret)
+		goto out;
+	ret = regmap_set_bits(dp->infracfg_ao, INFRA_AO_DPMAIF_CTRL,
+			      INFRA_AO_DPMAIF_EN);
+	if (!ret)
+		/* as the downstream driver: 0x1000 there, 0x3000 out of LK */
+		ret = regmap_update_bits(dp->infracfg_ao, INFRA_AO_DPMAIF_WAKE,
+					 INFRA_AO_DPMAIF_IP_BUSY_MASK |
+					 INFRA_AO_DPMAIF_MD_WAKE_MASK,
+					 INFRA_AO_DPMAIF_IP_BUSY_MASK);
+	if (ret)
+		goto clk_off;
+
+	ret = dpmaif_hw_common(dp);
+	if (!ret)
+		ret = dpmaif_hw_rxq(dp);
+	if (!ret)
+		ret = dpmaif_hw_bats(dp);
+	if (!ret)
+		ret = dpmaif_dl_start(dp);
+	if (!ret) {
+		dpmaif_hw_txqs(dp);
+		ret = dpmaif_hw_init_done(dp);
+	}
+	if (ret)
+		goto reset;
+
+	dpmaif_clear_ip_busy(dp);
+	napi_enable(&dp->napi);
+	enable_irq(dp->irq);
+	dpmaif_tx_enable(dp, true);
+	dp->started = true;
+	dev_info(ccci->dev, "DPMAIF up (coda %#x), %u+%u buffers lent\n",
+		 readl(dp->pd + PD_AP_CODA_VER), dp->bat_lent, dp->frg_lent);
+	goto out;
+
+reset:
+	dpmaif_hw_reset(dp);
+	dpmaif_dl_free(dp);
+clk_off:
+	clk_bulk_disable_unprepare(ARRAY_SIZE(dp->clks), dp->clks);
+out:
+	mutex_unlock(&dp->lock);
+	return ret;
+}
+
+/**
+ * mtk_ccci_dpmaif_pre_stop() - stop the queues, before the modem goes down
+ * @ccci: driver state
+ */
+void mtk_ccci_dpmaif_pre_stop(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+
+	if (!dp)
+		return;
+	mutex_lock(&dp->lock);
+	if (dp->started) {
+		dpmaif_tx_enable(dp, false);
+		dpmaif_hw_quiesce(dp);
+	}
+	mutex_unlock(&dp->lock);
+}
+
+/**
+ * mtk_ccci_dpmaif_stop() - reset DPMAIF, once the modem is off
+ * @ccci: driver state
+ */
+void mtk_ccci_dpmaif_stop(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+
+	if (!dp)
+		return;
+	mutex_lock(&dp->lock);
+	if (dp->started) {
+		dpmaif_tx_enable(dp, false);
+		disable_irq(dp->irq);
+		napi_disable(&dp->napi);
+		cancel_work_sync(&dp->tx_work);
+		dpmaif_hw_quiesce(dp);
+		clk_bulk_disable_unprepare(ARRAY_SIZE(dp->clks), dp->clks);
+		dpmaif_hw_reset(dp);
+		/* the block is reset: the buffers are the AP's again */
+		dpmaif_dl_free(dp);
+		dpmaif_tx_free(dp);
+		dp->started = false;
+		dev_info(ccci->dev, "DPMAIF down\n");
+	}
+	mutex_unlock(&dp->lock);
+}
+
+/*
+ * Did the PD block lose power? The marker written at the setup reads 0
+ * then (the AO block, with the settings and their SRAM copy, keeps its
+ * state). Written again either way, as the downstream check does.
+ */
+static bool dpmaif_pd_lost(struct mtk_ccci_dpmaif *dp)
+{
+	if (readl(dp->pd + PD_DL_RESERVE_RW))
+		return false;
+	writel(0xff, dp->pd + PD_DL_RESERVE_RW);
+	return true;
+}
+
+/*
+ * The downstream v3 resume after a power-down of the PD block: the interrupts
+ * that are not wanted are masked again and their status bits dropped, the
+ * rings and queues are left alone (their settings live in the AO block).
+ * The indices are logged so that a block that forgot them would show.
+ */
+static void dpmaif_hw_resume(struct mtk_ccci_dpmaif *dp)
+{
+	u32 pit_wr, pit_rd, bat_rd, bat_wr;
+
+	writel(~(u32)UL_INT_EN, dp->ao + AO_UL_AP_L2TIMSR0);
+	writel(~(u32)UL_INT_EN, dp->pd + PD_AP_UL_L2TISAR0);
+	writel(~(u32)DL_INT_EN, dp->ao + AO_UL_APDL_L2TIMSR0);
+	writel(~(u32)DL_INT_EN, dp->pd + PD_AP_DL_L2TISAR0);
+
+	pit_wr = readl(dp->pd + PD_DL_PIT_WR_IDX) & DL_PIT_IDX;
+	pit_rd = readl(dp->pd + PD_DL_PIT_RD_IDX) & DL_PIT_IDX;
+	bat_rd = readl(dp->pd + PD_DL_BAT_RD_IDX);
+	bat_wr = readl(dp->pd + PD_DL_BAT_WR_IDX);
+	dev_info(dp->dev, "DPMAIF PD block was down in sleep (%lu); masks ul %#x dl %#x (was %#x); pit wr/rd %u/%u (driver rd %u), bat rd/wr %u/%u (driver wr %u)\n",
+		 dp->pd_lost, readl(dp->ao + AO_UL_AP_L2TIMR0),
+		 readl(dp->ao + AO_UL_APDL_L2TIMR0), dp->sleep_dl_mask, pit_wr,
+		 pit_rd, dp->pit_rd, bat_rd, bat_wr, dp->bat_wr);
+	if (!pit_wr && !pit_rd && !bat_rd && dp->pit_rd)
+		dev_warn(dp->dev, "DPMAIF indices read 0 after sleep: the block may have lost its rings\n");
+}
+
+/**
+ * mtk_ccci_dpmaif_suspend_late() - hold transmit, arm the wakeup interrupt
+ * @ccci: driver state
+ *
+ * The downstream driver makes a transmit wait while the block is suspended;
+ * here the links are told the queue is busy and woken again at resume.
+ * Downlink data arriving in sleep raises the DPMAIF interrupt, which wakes
+ * the AP.
+ */
+void mtk_ccci_dpmaif_suspend_late(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+
+	if (!dp)
+		return;
+	mutex_lock(&dp->lock);
+	if (dp->started) {
+		WRITE_ONCE(dp->suspended, true);
+		dp->wake_armed = !enable_irq_wake(dp->irq);
+	}
+	mutex_unlock(&dp->lock);
+}
+
+/**
+ * mtk_ccci_dpmaif_suspend_noirq() - as the downstream suspend_noirq
+ * @ccci: driver state
+ *
+ * Backs up the DL interrupt mask (the downstream driver does, and shows it) and
+ * checks the power-down marker, re-arming it.
+ */
+void mtk_ccci_dpmaif_suspend_noirq(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+
+	if (!dp)
+		return;
+	mutex_lock(&dp->lock);
+	if (dp->started) {
+		dp->suspends++;
+		dp->sleep_dl_mask = readl(dp->ao + AO_UL_APDL_L2TIMR0);
+		if (dpmaif_pd_lost(dp))
+			dev_info(dp->dev, "DPMAIF PD block was down before suspend\n");
+	}
+	mutex_unlock(&dp->lock);
+}
+
+/**
+ * mtk_ccci_dpmaif_resume_noirq() - as the downstream resume_noirq
+ * @ccci: driver state
+ *
+ * Asks TF-A whether the DPMAIF woke the AP, then restores the interrupt
+ * masks if the PD block lost power meanwhile; otherwise nothing is
+ * touched. A downlink interrupt that stands is handled once interrupts
+ * are resumed.
+ */
+void mtk_ccci_dpmaif_resume_noirq(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+
+	if (!dp)
+		return;
+	mutex_lock(&dp->lock);
+	if (!dp->started)
+		goto out;
+	if (mtk_ccci_wake_src_query(ccci, MTK_CCCI_WAKE_SRC_DPMAIF,
+				    dp->wake_query)) {
+		dp->wakeups++;
+		pm_wakeup_event(ccci->dev, 0);
+		dev_info(dp->dev, "woken by the DPMAIF (%lu): dl status %#x\n",
+			 dp->wakeups, readl(dp->pd + PD_AP_DL_L2TISAR0));
+	}
+	if (dpmaif_pd_lost(dp)) {
+		dp->pd_lost++;
+		dpmaif_hw_resume(dp);
+	}
+out:
+	mutex_unlock(&dp->lock);
+}
+
+void mtk_ccci_dpmaif_resume_early(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+
+	if (!dp)
+		return;
+	mutex_lock(&dp->lock);
+	if (dp->wake_armed) {
+		disable_irq_wake(dp->irq);
+		dp->wake_armed = false;
+	}
+	mutex_unlock(&dp->lock);
+}
+
+/* transmit again: the links held in suspend_late are woken */
+void mtk_ccci_dpmaif_resume(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+
+	if (!dp)
+		return;
+	mutex_lock(&dp->lock);
+	WRITE_ONCE(dp->suspended, false);
+	if (dp->started)
+		dpmaif_tx_wake(dp);
+	mutex_unlock(&dp->lock);
+}
+
+/* the base of modem bank 0 as LK reports it, checked against the carveouts */
+static int dpmaif_md_base(struct mtk_ccci_dpmaif *dp)
+{
+	struct mtk_ccci *ccci = dp->ccci;
+	const __le64 *hdr;
+	unsigned int i;
+	u32 size;
+
+	hdr = mtk_ccci_lk_find(ccci, "hdr_tbl_inf", &size);
+	if (!hdr || size < sizeof(*hdr))
+		return -ENODEV;
+	dp->md_base = le64_to_cpu(*hdr);
+
+	if (!dp->md_base || !IS_ALIGNED(dp->md_base, DPMAIF_REMAP_WIN) ||
+	    dp->md_base + 24ULL * DPMAIF_REMAP_WIN > BIT_ULL(34))
+		return -EINVAL;
+	for (i = 0; i < ccci->md_mem_num; i++)
+		if (ccci->md_mem[i].start == dp->md_base)
+			return 0;
+	return -EINVAL;
+}
+
+static void dpmaif_napi_cleanup(void *data)
+{
+	struct mtk_ccci_dpmaif *dp = data;
+
+	netif_napi_del(&dp->napi);
+	free_netdev(dp->napi_dev);
+}
+
+/* NAPI needs a device; the links come and go, as in t7xx use a dummy one */
+static int dpmaif_napi_init(struct mtk_ccci_dpmaif *dp)
+{
+	dp->napi_dev = alloc_netdev_dummy(0);
+	if (!dp->napi_dev)
+		return -ENOMEM;
+	netif_napi_add(dp->napi_dev, &dp->napi, dpmaif_napi_poll);
+	return devm_add_action_or_reset(dp->dev, dpmaif_napi_cleanup, dp);
+}
+
+static void __iomem *dpmaif_map(struct device *dev, struct device_node *np,
+				const char *name)
+{
+	int i = of_property_match_string(np, "reg-names", name);
+
+	if (i < 0)
+		return IOMEM_ERR_PTR(i);
+	return devm_of_iomap(dev, np, i, NULL);
+}
+
+/* the DPMAIF node: windows, clocks, interrupt, infracfg_ao */
+static int dpmaif_get_resources(struct mtk_ccci_dpmaif *dp,
+				struct device_node *np)
+{
+	struct device *dev = dp->dev;
+	unsigned int i;
+
+	dp->ao = dpmaif_map(dev, np, "ao");
+	if (IS_ERR(dp->ao))
+		return PTR_ERR(dp->ao);
+	dp->pd = dpmaif_map(dev, np, "pd");
+	if (IS_ERR(dp->pd))
+		return PTR_ERR(dp->pd);
+
+	for (i = 0; i < ARRAY_SIZE(dpmaif_clk_names); i++) {
+		dp->clks[i].id = dpmaif_clk_names[i];
+		dp->clks[i].clk =
+			devm_get_clk_from_child(dev, np, dpmaif_clk_names[i]);
+		if (IS_ERR(dp->clks[i].clk))
+			return dev_err_probe(dev, PTR_ERR(dp->clks[i].clk),
+					     "DPMAIF clock %s\n",
+					     dpmaif_clk_names[i]);
+	}
+
+	dp->infracfg_ao = syscon_regmap_lookup_by_phandle(np,
+							  "mediatek,infracfg-ao");
+	if (IS_ERR(dp->infracfg_ao))
+		return PTR_ERR(dp->infracfg_ao);
+
+	dp->irq = of_irq_get(np, 0);
+	if (dp->irq <= 0)
+		return dp->irq ? dp->irq : -ENXIO;
+	return devm_request_irq(dev, dp->irq, dpmaif_irq, IRQF_NO_AUTOEN,
+				"mtk-ccci-dpmaif", dp);
+}
+
+/**
+ * mtk_ccci_dpmaif_init() - find DPMAIF and allocate its rings
+ * @ccci: driver state
+ *
+ * Only with data=1 and the DPMAIF node linked by "mediatek,dpmaif". Touches
+ * no register: the block is set up by mtk_ccci_dpmaif_start(). A DPMAIF
+ * that cannot be used leaves the modem without a data path, it does not
+ * fail the probe.
+ *
+ * Return: 0 (also when skipped), -EPROBE_DEFER, -ENOMEM or an error of
+ * the WWAN registration.
+ */
+int mtk_ccci_dpmaif_init(struct mtk_ccci *ccci)
+{
+	struct device *dev = ccci->dev;
+	struct mtk_ccci_dpmaif *dp;
+	struct device_node *np;
+	unsigned int i;
+	int ret;
+
+	BUILD_BUG_ON(sizeof(struct dpmaif_pit) != 16);
+	BUILD_BUG_ON(sizeof(struct dpmaif_bat) != 8);
+	BUILD_BUG_ON(sizeof(struct dpmaif_drb) != 8);
+
+	if (!data)
+		return 0;
+	np = of_parse_phandle(dev->of_node, "mediatek,dpmaif", 0);
+	if (!np) {
+		dev_info(dev, "no DPMAIF in the DT, no data path\n");
+		return 0;
+	}
+	if (!ccci->infra) {
+		of_node_put(np);
+		dev_info(dev, "no infracfg window to reset DPMAIF, no data path\n");
+		return 0;
+	}
+
+	dp = devm_kzalloc(dev, sizeof(*dp), GFP_KERNEL);
+	if (!dp) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	dp->ccci = ccci;
+	dp->dev = dev;
+	mutex_init(&dp->lock);
+
+	ret = dpmaif_md_base(dp);
+	if (ret) {
+		dev_warn(dev, "no usable modem bank base for DPMAIF\n");
+		goto out;
+	}
+
+	ret = dpmaif_get_resources(dp, np);
+	if (ret)
+		goto out;
+
+	/* BAT and DRB addresses have 40 bits */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(40));
+	if (ret)
+		goto out;
+	/* the rings from the DT pool if there is one, as downstream */
+	ret = of_reserved_mem_device_init(dev);
+	if (!ret)
+		ret = devm_add_action_or_reset(dev, dpmaif_rmem_release, dev);
+	else if (ret == -ENODEV)
+		ret = 0;
+	if (ret)
+		goto out;
+	ret = dpmaif_ring_alloc(dev, &dp->bat, DPMAIF_BAT_CNT,
+				sizeof(struct dpmaif_bat));
+	if (!ret)
+		ret = dpmaif_ring_alloc(dev, &dp->frg, DPMAIF_FRG_CNT,
+					sizeof(struct dpmaif_bat));
+	if (!ret)
+		ret = dpmaif_ring_alloc(dev, &dp->pit, DPMAIF_PIT_CNT,
+					sizeof(struct dpmaif_pit));
+	for (i = 0; !ret && i < DPMAIF_TXQ_NUM; i++)
+		ret = dpmaif_ring_alloc(dev, &dp->drb[i], DPMAIF_DRB_CNT,
+					sizeof(struct dpmaif_drb));
+	if (ret)
+		goto out;
+	dp->bat_skb = devm_kcalloc(dev, DPMAIF_BAT_CNT, sizeof(*dp->bat_skb),
+				   GFP_KERNEL);
+	dp->frg_buf = devm_kcalloc(dev, DPMAIF_FRG_CNT, sizeof(*dp->frg_buf),
+				   GFP_KERNEL);
+	if (!dp->bat_skb || !dp->frg_buf) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	for (i = 0; i < DPMAIF_TXQ_NUM; i++) {
+		spin_lock_init(&dp->txq[i].lock);
+		dp->txq[i].skbs = devm_kcalloc(dev, DPMAIF_DRB_CNT,
+					       sizeof(*dp->txq[i].skbs),
+					       GFP_KERNEL);
+		if (!dp->txq[i].skbs) {
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+	INIT_WORK(&dp->tx_work, dpmaif_tx_done_work);
+	ret = dpmaif_napi_init(dp);
+	if (ret)
+		goto out;
+
+	ccci->dpmaif = dp;
+	dev_info(dev, "DPMAIF: rings allocated, modem bank 0 at %#llx, set up with the modem\n",
+		 dp->md_base);
+	of_node_put(np);
+	return mtk_ccci_net_init(ccci);
+
+out:
+	of_node_put(np);
+	if (ret == -EPROBE_DEFER || ret == -ENOMEM)
+		return ret;
+	/* the modem works without a data path */
+	dev_warn(dev, "DPMAIF unusable (%d), no data path\n", ret);
+	return 0;
+}
+
+static void dpmaif_show_regs(struct seq_file *s, struct mtk_ccci_dpmaif *dp)
+{
+	static const struct {
+		const char *name;
+		bool ao;
+		u16 off;
+	} regs[] = {
+		{ "coda_ver", false, PD_AP_CODA_VER },
+		{ "dl_reserve_rw", false, PD_DL_RESERVE_RW },
+		{ "ul_init_set", true, AO_UL_INIT_SET },
+		{ "dl_init_set", true, AO_DL_INIT_SET },
+		{ "ul_chnl_arb0", true, AO_UL_CHNL_ARB0 },
+		{ "ul_l2 sta", false, PD_AP_UL_L2TISAR0 },
+		{ "ul_l2 mask", true, AO_UL_AP_L2TIMR0 },
+		{ "dl_l2 sta", false, PD_AP_DL_L2TISAR0 },
+		{ "dl_l2 mask", true, AO_UL_APDL_L2TIMR0 },
+		{ "l1 sta", false, PD_AP_L1TISAR0 },
+		{ "l1 mask", true, AO_UL_AP_L1TIMR0 },
+		{ "ip_busy", false, PD_AP_IP_BUSY },
+		{ "dma_err_sta", false, PD_AP_DMA_ERR_STA },
+		{ "pit_con0", false, PD_DL_PIT_INIT_CON0 },
+		{ "pit_con1", false, PD_DL_PIT_INIT_CON1 },
+		{ "pit_con3", false, PD_DL_PIT_INIT_CON3 },
+		{ "bat_con0", false, PD_DL_BAT_INIT_CON0 },
+		{ "bat_con1", false, PD_DL_BAT_INIT_CON1 },
+		{ "pktinfo_con0", false, PD_DL_PKTINFO_CON0 },
+		{ "pktinfo_con1", false, PD_DL_PKTINFO_CON1 },
+		{ "pktinfo_con2", false, PD_DL_PKTINFO_CON2 },
+		{ "rdy_chk_thres", false, PD_DL_RDY_CHK_THRES },
+		{ "rdy_chk_frg", false, PD_DL_RDY_CHK_FRG_THRES },
+		{ "pit wr/rd", false, PD_DL_PIT_WR_IDX },
+		{ "", false, PD_DL_PIT_RD_IDX },
+		{ "bat rd/wr", false, PD_DL_BAT_RD_IDX },
+		{ "", false, PD_DL_BAT_WR_IDX },
+		{ "frg rd", false, PD_DL_FRG_RD_IDX },
+		{ "dl_dbg_sta1", false, PD_DL_DBG_STA1 },
+		{ "ul_dbg_sta2", false, PD_UL_DBG_STA2 },
+	};
+	unsigned int i;
+
+	/* an unnamed register goes on the line of the one before */
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		u32 v = readl((regs[i].ao ? dp->ao : dp->pd) + regs[i].off);
+
+		if (!regs[i].name[0])
+			seq_printf(s, " %#010x", v);
+		else
+			seq_printf(s, "%s%-14s %#010x", i ? "\n" : "",
+				   regs[i].name, v);
+	}
+	seq_puts(s, "\n");
+	for (i = 0; i < DPMAIF_TXQ_NUM; i++)
+		seq_printf(s, "txq%u con0 %#010x con1 %#010x sta %#010x\n", i,
+			   readl(dp->pd + PD_UL_CHNL_CON0(i)),
+			   readl(dp->pd + PD_UL_CHNL_CON1(i)),
+			   readl(dp->pd + PD_UL_CH_STA(i)));
+	seq_puts(s, "remap");
+	for (i = 0; i < 8; i++)
+		seq_printf(s, " %#010x", readl(dp->pd + PD_MISC_REMAP(i)));
+	seq_puts(s, "\n");
+}
+
+/*
+ * The registers are read only with the clocks on and the bus enable set:
+ * while started, or (before the first start) when LK left the enable set,
+ * with the clocks held for the read.
+ */
+static int mtk_ccci_dpmaif_show(struct seq_file *s, void *unused)
+{
+	struct mtk_ccci_dpmaif *dp = s->private;
+	unsigned int i;
+	u32 ctrl = 0;
+	int ret;
+
+	mutex_lock(&dp->lock);
+	ret = regmap_read(dp->infracfg_ao, INFRA_AO_DPMAIF_CTRL, &ctrl);
+	seq_printf(s, "state: %s, infracfg_ao+0x208 %#010x (%d), modem bank 0 at %#llx\n",
+		   dp->started ? "up" : "down", ctrl, ret, dp->md_base);
+	seq_printf(s, "rings: bat %pad+%u frg %pad+%u pit %pad+%u\n",
+		   &dp->bat.dma, dp->bat.cnt, &dp->frg.dma, dp->frg.cnt,
+		   &dp->pit.dma, dp->pit.cnt);
+	for (i = 0; i < DPMAIF_TXQ_NUM; i++)
+		seq_printf(s, "       drb%u %pad+%u\n", i, &dp->drb[i].dma,
+			   dp->drb[i].cnt);
+	seq_printf(s, "irq %d: %lu; ul done %lu pwr-notrdy %lu md-notrdy %lu len-err %lu, dl done %lu mtu-err %lu; last ul %#x dl %#x\n",
+		   dp->irq, dp->irqs, dp->ul_done, dp->ul_pwr_notrdy,
+		   dp->ul_md_notrdy, dp->ul_len_err, dp->dl_done, dp->dl_mtu_err,
+		   dp->last_ul_sta, dp->last_dl_sta);
+	seq_printf(s, "sleep: %lu suspends, %lu woken by the DPMAIF, %lu with the PD block down, dl mask at suspend %#x, last TF-A answer %#lx %#lx %#lx %#lx\n",
+		   dp->suspends, dp->wakeups, dp->pd_lost, dp->sleep_dl_mask,
+		   dp->wake_query[0], dp->wake_query[1], dp->wake_query[2],
+		   dp->wake_query[3]);
+	seq_printf(s, "dl: pit rd %u seq %u, bat wr %u lent %u, frg wr %u lent %u; dropped %lu err %lu seq-err %lu nomem %lu bad-ch %lu (last %u)\n",
+		   dp->pit_rd, dp->pit_seq, dp->bat_wr, dp->bat_lent,
+		   dp->frg_wr, dp->frg_lent, dp->dl_dropped, dp->dl_err,
+		   dp->pit_seq_err, dp->bat_nomem, dp->dl_bad_ch,
+		   dp->dl_last_bad_ch);
+	for (i = 0; i < DPMAIF_TXQ_NUM; i++)
+		seq_printf(s, "ul q%u: wr %u rel %u, %lu packets, full %lu, add-err %lu rd-err %lu\n",
+			   i, dp->txq[i].wr, dp->txq[i].rel, dp->txq[i].pkts,
+			   dp->txq[i].full, dp->txq[i].add_err,
+			   dp->txq[i].rd_err);
+	/* the channel a PDN uses shows here, link or not */
+	for (i = 0; i < MTK_CCCI_NET_LINKS; i++)
+		if (dp->dl_pkts[i])
+			seq_printf(s, "dl ch %2u: %lu packets, %lu without a link\n",
+				   i, dp->dl_pkts[i], dp->dl_nolink[i]);
+
+	if (dp->started) {
+		dpmaif_show_regs(s, dp);
+	} else if (!ret && (ctrl & INFRA_AO_DPMAIF_EN) &&
+		   !clk_bulk_prepare_enable(ARRAY_SIZE(dp->clks), dp->clks)) {
+		dpmaif_show_regs(s, dp);
+		clk_bulk_disable_unprepare(ARRAY_SIZE(dp->clks), dp->clks);
+	} else {
+		seq_puts(s, "registers: not read (bus enable off)\n");
+	}
+	mutex_unlock(&dp->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_dpmaif);
+
+void mtk_ccci_dpmaif_debugfs_init(struct mtk_ccci *ccci)
+{
+	if (ccci->dpmaif)
+		debugfs_create_file("dpmaif", 0400, ccci->debugfs,
+				    ccci->dpmaif, &mtk_ccci_dpmaif_fops);
+}
+
+/* a TCP segment that only acknowledges: downstream sends those on queue 1 */
+static bool dpmaif_tx_is_ack(const struct sk_buff *skb)
+{
+	const struct tcphdr *th;
+	unsigned int l3, total;
+
+	switch (skb->data[0] >> 4) {
+	case 4: {
+		const struct iphdr *iph = (const struct iphdr *)skb->data;
+
+		if (skb->len < sizeof(*iph) || iph->ihl < 5 ||
+		    iph->protocol != IPPROTO_TCP ||
+		    (iph->frag_off & htons(IP_MF | IP_OFFSET)))
+			return false;
+		l3 = iph->ihl * 4;
+		total = ntohs(iph->tot_len);
+		break;
+	}
+	case 6: {
+		const struct ipv6hdr *ip6h = (const struct ipv6hdr *)skb->data;
+
+		if (skb->len < sizeof(*ip6h) || ip6h->nexthdr != IPPROTO_TCP)
+			return false;
+		l3 = sizeof(*ip6h);
+		total = l3 + ntohs(ip6h->payload_len);
+		break;
+	}
+	default:
+		return false;
+	}
+	if (skb->len < l3 + sizeof(*th))
+		return false;
+	th = (const struct tcphdr *)(skb->data + l3);
+	return th->ack && !th->syn && !th->fin && !th->rst &&
+	       total == l3 + th->doff * 4;
+}
+
+/* tell the hardware about @words more DRB words of TX queue @q */
+static int dpmaif_ul_add(struct mtk_ccci_dpmaif *dp, unsigned int q,
+			 u32 words)
+{
+	void __iomem *reg = dp->pd + PD_UL_ADD_DESC_CH(q);
+	u32 v;
+
+	if (readl_poll_timeout_atomic(reg, v, !(v & UL_ADD_UPDATE), 1,
+				      DPMAIF_UL_POLL_US))
+		return -ETIMEDOUT;
+	writel(UL_ADD_UPDATE | words, reg);
+	/* taken or not, the DRBs are the hardware's now */
+	if (readl_poll_timeout_atomic(reg, v, !(v & UL_ADD_UPDATE), 1,
+				      DPMAIF_UL_POLL_US))
+		dev_err_ratelimited(dp->dev, "DPMAIF UL q%u add slow\n", q);
+	return 0;
+}
+
+/**
+ * mtk_ccci_dpmaif_xmit() - send an IP packet to the modem
+ * @ccci: driver state
+ * @dev: the WWAN link it comes from
+ * @skb: the packet, raw IP
+ * @ch: CCMNI index of the link
+ *
+ * Return: NETDEV_TX_OK, or NETDEV_TX_BUSY with @dev stopped when the TX
+ * queue is full.
+ */
+netdev_tx_t mtk_ccci_dpmaif_xmit(struct mtk_ccci *ccci, struct net_device *dev,
+				 struct sk_buff *skb, unsigned int ch)
+{
+	struct mtk_ccci_dpmaif *dp = ccci->dpmaif;
+	struct dpmaif_drb_skb *e;
+	struct dpmaif_txq *txq;
+	struct dpmaif_drb *drb;
+	unsigned int q, len;
+	dma_addr_t dma;
+	u32 i, j, cnt;
+
+	if (!dp || skb_linearize(skb) || skb->len > FIELD_MAX(DRB0_DATA_LEN))
+		goto drop;
+	len = skb->len;
+	/* the queue the modem mapped the CCMNI to (RPC), ACKs apart from data */
+	q = READ_ONCE(ccci->net_txq[ch]);
+	if (q == DPMAIF_TXQ_DATA && dpmaif_tx_is_ack(skb))
+		q = DPMAIF_TXQ_ACK;
+	txq = &dp->txq[q];
+	drb = dp->drb[q].base;
+	cnt = dp->drb[q].cnt;
+
+	if (READ_ONCE(dp->suspended)) {
+		/* the system is going to sleep: kept, the resume wakes the link */
+		netif_stop_queue(dev);
+		return NETDEV_TX_BUSY;
+	}
+
+	spin_lock_bh(&txq->lock);
+	if (!txq->on) {
+		spin_unlock_bh(&txq->lock);
+		goto drop;
+	}
+	if (dpmaif_txq_free(dp, q) < DPMAIF_TX_DRBS) {
+		/* woken by the TX done work; a full queue has packets out */
+		netif_stop_queue(dev);
+		txq->full++;
+		spin_unlock_bh(&txq->lock);
+		return NETDEV_TX_BUSY;
+	}
+	dma = dma_map_single(dp->dev, skb->data, len, DMA_TO_DEVICE);
+	if (dma_mapping_error(dp->dev, dma)) {
+		spin_unlock_bh(&txq->lock);
+		goto drop;
+	}
+
+	i = txq->wr;
+	j = (i + 1) % cnt;
+	drb[i].w[0] = cpu_to_le32(FIELD_PREP(DRB0_TYPE, 1) | DRB0_CONT |
+				  FIELD_PREP(DRB0_DATA_LEN, len));
+	drb[i].w[1] = cpu_to_le32(FIELD_PREP(DRB1_CHANNEL_ID, ch));
+	drb[j].w[0] = cpu_to_le32(FIELD_PREP(DRB0_TYPE, 0) |
+				  FIELD_PREP(DRB0_ADDR_EXT,
+					     upper_32_bits(dma) & 0xff) |
+				  FIELD_PREP(DRB0_DATA_LEN, len));
+	drb[j].w[1] = cpu_to_le32(lower_32_bits(dma));
+	e = &txq->skbs[j];
+	e->skb = skb;
+	e->dma = dma;
+	e->len = len;
+
+	/* writel() orders the DRB writes before the register */
+	if (dpmaif_ul_add(dp, q, DPMAIF_TX_DRBS *
+			  sizeof(struct dpmaif_drb) / 4)) {
+		e->skb = NULL;
+		dma_unmap_single(dp->dev, dma, len, DMA_TO_DEVICE);
+		txq->add_err++;
+		spin_unlock_bh(&txq->lock);
+		goto drop;
+	}
+	txq->wr = (j + 1) % cnt;
+	txq->pkts++;
+	if (dpmaif_txq_free(dp, q) < DPMAIF_TX_DRBS) {
+		netif_stop_queue(dev);
+		txq->full++;
+	}
+	spin_unlock_bh(&txq->lock);
+	dev_sw_netstats_tx_add(dev, 1, len);
+	return NETDEV_TX_OK;
+
+drop:
+	dev_core_stats_tx_dropped_inc(dev);
+	dev_kfree_skb_any(skb);
+	return NETDEV_TX_OK;
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_ee.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_ee.c
new file mode 100644
index 000000000..1ff327091
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_ee.c
@@ -0,0 +1,398 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: the modem exception handshake and its report.
+ *
+ * On an exception the modem raises CCIF channel 16 and then walks the
+ * AP through the MediaTek downstream sequence:
+ *
+ *	modem			AP
+ *	EX_INIT (16)	->
+ *			<-	EX_ACK (17)
+ *	EX_INIT_DONE (17)
+ *	EX_CLEARQ_DONE (18) ->	switch every queue to its exception ring
+ *				(CCISM_MCU_EXP), emptied
+ *			<-	EX_CLEARQ_ACK (18)
+ *	EX_ALLQ_RESET (19)
+ *	MD_EX on CONTROL ->
+ *			<-	MD_EX
+ *	MD_EX_REC_OK	->	(carries the exception overview)
+ *	MD_EX_PASS	->
+ *
+ * The overview (format version 6) says which core failed, the exception
+ * type and either the assert file, line and parameters or the fatal
+ * error codes. Before HS2 the modem leaves it in the MDSS_DBG shared
+ * memory; the copy in MD_EX_REC_OK is preferred when it is valid.
+ *
+ * Nothing here dumps modem memory or restarts the modem: the report is
+ * logged and kept for debugfs ("ee"), then the FSM powers the modem off.
+ *
+ * Copyright (C) 2019 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/debugfs.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/seq_file.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/wait.h>
+
+#include "mtk_ccci.h"
+
+#define EE_MD_EX_CHK_ID		0x45584350	/* "EXCP" */
+#define EE_MD_EX_REC_OK_CHK_ID	0x45524543	/* "EREC" */
+
+/* how long the modem gets for the handshake and its report */
+#define EE_REPORT_TIMEOUT_MS	10000
+
+/* exception overview, format 6 */
+#define EE_OVERVIEW_VER_MASK	0xffff0000
+#define EE_OVERVIEW_VER		0xab000006
+#define EE_CORES		5
+#define EE_CORE_NAME_LEN	11
+#define EE_VPE_NUM		15
+
+enum {
+	EE_CLASS_ASSERT,
+	EE_CLASS_FATAL,
+	EE_CLASS_CUSTOM,
+};
+
+struct mtk_ccci_ee_assert {
+	char file[256];
+	__le32 line;
+	__le32 param[3];
+	__le32 lr;
+} __packed;
+
+struct mtk_ccci_ee_fatal {
+	__le32 code[3];
+	char offender[8];
+	u8 cadefa;
+	u8 has_file;
+	u8 section;
+	u8 dispatch_valid;
+	u8 pad[4];
+	__le32 status;
+	__le32 sp;
+	__le32 pc;
+	__le32 lr;
+	__le32 addr;
+	__le32 cause;
+	char file[];	/* when has_file, to the end of the union */
+} __packed;
+
+struct mtk_ccci_ee_overview {
+	__le32 version;
+	__le32 cores;
+	struct {
+		char name[EE_CORE_NAME_LEN];
+		u8 offender;
+	} __packed core[EE_CORES];
+	/* the main record */
+	__le16 type;
+	u8 type_format;
+	u8 class;
+	u8 elm_status;
+	u8 vpe;
+	u8 tc;
+	u8 pad0;
+	union {
+		struct mtk_ccci_ee_assert assert;
+		struct mtk_ccci_ee_fatal fatal;
+	} __packed info;
+	__le32 vpes;
+	struct {
+		__le32 step;
+		__le32 time;
+	} __packed steps[EE_VPE_NUM];
+	u8 rest[116];
+} __packed;
+static_assert(sizeof(struct mtk_ccci_ee_overview) == 592);
+
+/* a few exception types worth a name; the rest is printed as a number */
+static const char *mtk_ccci_ee_type_name(u16 type)
+{
+	switch (type) {
+	case 0x50: return "assert";
+	case 0x51: return "assert (extended record)";
+	case 0x52: return "assert (native)";
+	case 0x53 ... 0x55: return "assert (custom)";
+	case 0x30: return "stack access";
+	case 0x31: return "fatal error (task)";
+	case 0x32: return "fatal error (buffer)";
+	case 0x60 ... 0x67: return "cross core";
+	case 0x70: return "EMI MPU violation";
+	case 0x00 ... 0x2f: return "CPU exception";
+	default: return "unknown";
+	}
+}
+
+/* format the overview into ccci->ee_report; false if it is not one */
+static bool mtk_ccci_ee_parse(struct mtk_ccci *ccci, const void *buf,
+			      size_t len, const char *from)
+{
+	const struct mtk_ccci_ee_overview *ov = buf;
+	char *p = ccci->ee_report, *end = p + sizeof(ccci->ee_report);
+	u32 ver, cores, i;
+	u16 type;
+
+	if (len < sizeof(*ov))
+		return false;
+	ver = le32_to_cpu(ov->version);
+	cores = le32_to_cpu(ov->cores);
+	if (ver != EE_OVERVIEW_VER || cores > EE_CORES)
+		return false;
+
+	type = le16_to_cpu(ov->type);
+	p += scnprintf(p, end - p, "from %s: type %#x (%s), class %u", from,
+		       type, mtk_ccci_ee_type_name(type), ov->class);
+	for (i = 0; i < cores; i++)
+		if (ov->core[i].offender) {
+			p += scnprintf(p, end - p, ", core %.*s",
+				       EE_CORE_NAME_LEN, ov->core[i].name);
+			break;
+		}
+	p += scnprintf(p, end - p, " (vpe %u tc %u)\n", ov->vpe, ov->tc);
+
+	switch (ov->class) {
+	case EE_CLASS_ASSERT: {
+		const struct mtk_ccci_ee_assert *a = &ov->info.assert;
+
+		p += scnprintf(p, end - p,
+			       "assert %.*s:%u params %#x %#x %#x lr %#x\n",
+			       (int)sizeof(a->file), a->file,
+			       le32_to_cpu(a->line), le32_to_cpu(a->param[0]),
+			       le32_to_cpu(a->param[1]),
+			       le32_to_cpu(a->param[2]), le32_to_cpu(a->lr));
+		break;
+	}
+	case EE_CLASS_FATAL:
+	case EE_CLASS_CUSTOM: {
+		const struct mtk_ccci_ee_fatal *f = &ov->info.fatal;
+		size_t flen = sizeof(ov->info) - sizeof(*f);
+
+		p += scnprintf(p, end - p,
+			       "fatal %#x %#x %#x offender %.*s section %u pc %#x lr %#x addr %#x cause %#x\n",
+			       le32_to_cpu(f->code[0]), le32_to_cpu(f->code[1]),
+			       le32_to_cpu(f->code[2]),
+			       f->offender[0] == (char)0xcc ? 0 :
+			       (int)sizeof(f->offender), f->offender,
+			       f->section, le32_to_cpu(f->pc),
+			       le32_to_cpu(f->lr), le32_to_cpu(f->addr),
+			       le32_to_cpu(f->cause));
+		if (f->has_file == 1)
+			p += scnprintf(p, end - p, "file %.*s\n", (int)flen,
+				       f->file);
+		break;
+	}
+	default:
+		break;
+	}
+	return true;
+}
+
+/* the overview the modem left in MDSS_DBG */
+static bool mtk_ccci_ee_parse_smem(struct mtk_ccci *ccci)
+{
+	const struct mtk_ccci_smem_region *r;
+	void __iomem *map;
+	void *buf;
+	size_t len;
+	bool ok;
+
+	r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_MDSS_DBG);
+	if (!r)
+		return false;
+	len = min_t(size_t, le32_to_cpu(r->size), MTK_CCCI_EE_PKT_MAX);
+	if (len < sizeof(struct mtk_ccci_ee_overview))
+		return false;
+	buf = kmalloc(len, GFP_KERNEL);
+	map = ioremap_wc(le64_to_cpu(r->ap_phys), len);
+	ok = buf && map;
+	if (ok) {
+		memcpy_fromio(buf, map, len);
+		ok = mtk_ccci_ee_parse(ccci, buf, len, "MDSS_DBG");
+		if (!ok)
+			print_hex_dump(KERN_INFO, "MDSS_DBG: ",
+				       DUMP_PREFIX_OFFSET, 16, 4, buf, 128,
+				       false);
+	}
+	if (map)
+		iounmap(map);
+	kfree(buf);
+	return ok;
+}
+
+/* the queues the modem uses from EX_CLEARQ_DONE on */
+static void mtk_ccci_ee_switch_rings(struct mtk_ccci *ccci)
+{
+	unsigned long flags[MTK_CCCI_RINGQ_NUM];
+	unsigned int i;
+
+	for (i = 0; i < MTK_CCCI_RINGQ_NUM; i++)
+		spin_lock_irqsave(&ccci->tx_lock[i], flags[i]);
+	for (i = 0; i < MTK_CCCI_RINGQ_NUM; i++) {
+		struct mtk_ccci_ring *r = &ccci->ring[i];
+
+		*r = ccci->ring_exp[i];
+		if (!r->ctl)
+			continue;
+		/* empty both ways, as the downstream queue reset */
+		writel(0, r->ctl + 0x00);
+		writel(0, r->ctl + 0x04);
+		writel(0, r->ctl + 0x0c);
+		writel(0, r->ctl + 0x10);
+	}
+	memset(ccci->tx_seq, 0, sizeof(ccci->tx_seq));
+	memset(ccci->rx_seq, 0, sizeof(ccci->rx_seq));
+	for (i = MTK_CCCI_RINGQ_NUM; i-- > 0;)
+		spin_unlock_irqrestore(&ccci->tx_lock[i], flags[i]);
+}
+
+/**
+ * mtk_ccci_ee_ccif() - the exception channels the modem raised
+ * @ccci: driver state
+ * @channels: CCIF channels, MTK_CCIF_EX_MASK bits only
+ *
+ * Called from the RX worker, in the modem's order when several came at
+ * once.
+ */
+void mtk_ccci_ee_ccif(struct mtk_ccci *ccci, u32 channels)
+{
+	if (channels & BIT(MTK_CCIF_CH_EX_INIT)) {
+		ccci->ee_stage |= BIT(MTK_CCIF_CH_EX_INIT);
+		mtk_ccci_ccif_notify(ccci, MTK_CCIF_CH_EX_ACK);
+	}
+	if (channels & BIT(MTK_CCIF_CH_EX_INIT_DONE))
+		ccci->ee_stage |= BIT(MTK_CCIF_CH_EX_INIT_DONE);
+	if (channels & BIT(MTK_CCIF_CH_EX_CLEARQ_DONE)) {
+		ccci->ee_stage |= BIT(MTK_CCIF_CH_EX_CLEARQ_DONE);
+		mtk_ccci_ee_switch_rings(ccci);
+		mtk_ccci_ccif_notify(ccci, MTK_CCIF_CH_EX_CLEARQ_ACK);
+	}
+	if (channels & BIT(MTK_CCIF_CH_EX_ALLQ_RESET))
+		ccci->ee_stage |= BIT(MTK_CCIF_CH_EX_ALLQ_RESET);
+	dev_info(ccci->dev, "exception handshake: CCIF %#x, seen %#x\n",
+		 channels, ccci->ee_stage);
+	mtk_ccci_fsm_exception(ccci, channels);
+}
+
+/**
+ * mtk_ccci_ee_ctl() - an exception message on the control channel
+ * @ccci: driver state
+ * @msg: data[1] of the message
+ * @id: its reserved word
+ * @skb: the message, header included; not taken
+ */
+void mtk_ccci_ee_ctl(struct mtk_ccci *ccci, u32 msg, u32 id,
+		     const struct sk_buff *skb)
+{
+	u32 len;
+
+	switch (msg) {
+	case MTK_CCCI_CTL_MD_EX:
+		if (id != EE_MD_EX_CHK_ID)
+			break;
+		mtk_ccci_send_msg(ccci, MTK_CCCI_Q_CTRL,
+				  MTK_CCCI_CH_CONTROL_TX, MTK_CCCI_CTL_MD_EX,
+				  EE_MD_EX_CHK_ID);
+		break;
+	case MTK_CCCI_CTL_MD_EX_REC_OK:
+		if (id != EE_MD_EX_REC_OK_CHK_ID)
+			break;
+		len = skb->len - sizeof(struct mtk_ccci_header);
+		len = min_t(u32, len, MTK_CCCI_EE_PKT_MAX);
+		memcpy(ccci->ee_pkt, skb->data + sizeof(struct mtk_ccci_header),
+		       len);
+		ccci->ee_pkt_len = len;
+		WRITE_ONCE(ccci->ee_rec_ok, true);
+		wake_up_all(&ccci->hs_wq);
+		break;
+	case MTK_CCCI_CTL_MD_EX_PASS:
+		WRITE_ONCE(ccci->ee_pass, true);
+		wake_up_all(&ccci->hs_wq);
+		break;
+	default:
+		break;
+	}
+	dev_info(ccci->dev, "exception message %#x %#x\n", msg, id);
+	mtk_ccci_fsm_exception(ccci, 0);
+}
+
+/* a new start: forget the last report */
+void mtk_ccci_ee_reset(struct mtk_ccci *ccci)
+{
+	ccci->ee_stage = 0;
+	ccci->ee_pkt_len = 0;
+	ccci->ee_rec_ok = false;
+	ccci->ee_pass = false;
+	ccci->ee_report[0] = '\0';
+}
+
+/**
+ * mtk_ccci_ee_report() - let the modem finish its exception and log it
+ * @ccci: driver state, the modem marked as in exception
+ *
+ * Waits for MD_EX_PASS (or the timeout), then logs the overview. The
+ * modem stays powered: the caller switches it off.
+ */
+void mtk_ccci_ee_report(struct mtk_ccci *ccci)
+{
+	const char *line, *next;
+
+	wait_event_timeout(ccci->hs_wq, READ_ONCE(ccci->ee_pass),
+			   msecs_to_jiffies(EE_REPORT_TIMEOUT_MS));
+	dev_err(ccci->dev, "exception handshake %#x, MD_EX_REC_OK %s (%u bytes), MD_EX_PASS %s\n",
+		ccci->ee_stage, ccci->ee_rec_ok ? "seen" : "missing",
+		ccci->ee_pkt_len, ccci->ee_pass ? "seen" : "missing");
+
+	if (!(ccci->ee_rec_ok &&
+	      mtk_ccci_ee_parse(ccci, ccci->ee_pkt, ccci->ee_pkt_len,
+				"MD_EX_REC_OK")) &&
+	    !mtk_ccci_ee_parse_smem(ccci)) {
+		strscpy(ccci->ee_report, "no valid exception overview\n");
+		if (ccci->ee_pkt_len)
+			print_hex_dump(KERN_INFO, "MD_EX_REC_OK: ",
+				       DUMP_PREFIX_OFFSET, 16, 4, ccci->ee_pkt,
+				       min_t(u32, ccci->ee_pkt_len, 128),
+				       false);
+	}
+	for (line = ccci->ee_report; *line; line = next) {
+		next = strchrnul(line, '\n');
+		dev_err(ccci->dev, "modem exception: %.*s\n",
+			(int)(next - line), line);
+		if (*next)
+			next++;
+	}
+}
+
+static int mtk_ccci_ee_show(struct seq_file *s, void *unused)
+{
+	struct mtk_ccci *ccci = s->private;
+
+	seq_printf(s, "handshake %#x, MD_EX_REC_OK %s (%u bytes), MD_EX_PASS %s\n",
+		   ccci->ee_stage, ccci->ee_rec_ok ? "seen" : "missing",
+		   ccci->ee_pkt_len, ccci->ee_pass ? "seen" : "missing");
+	seq_puts(s, ccci->ee_report);
+	if (ccci->ee_pkt_len)
+		seq_hex_dump(s, "pkt ", DUMP_PREFIX_OFFSET, 16, 4,
+			     ccci->ee_pkt, ccci->ee_pkt_len, true);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_ee);
+
+void mtk_ccci_ee_debugfs_init(struct mtk_ccci *ccci)
+{
+	debugfs_create_file("ee", 0400, ccci->debugfs, ccci,
+			    &mtk_ccci_ee_fops);
+}
+
+int mtk_ccci_ee_init(struct mtk_ccci *ccci)
+{
+	ccci->ee_pkt = devm_kzalloc(ccci->dev, MTK_CCCI_EE_PKT_MAX,
+				    GFP_KERNEL);
+	return ccci->ee_pkt ? 0 : -ENOMEM;
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_fsm.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_fsm.c
new file mode 100644
index 000000000..ca70ca245
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_fsm.c
@@ -0,0 +1,1059 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: modem power sequence and boot state machine.
+ *
+ * LK powers the modem up and lets it run on every boot. The stock kernel
+ * does not pick that modem up: on its first start it waits for the modem
+ * boot ROM to finish (TF-A "check done"), powers the modem off and then
+ * on again its own way:
+ *
+ *   power off: MD power domain off, 4 ms, flight mode on (TF-A),
+ *              modem clocks gated in topckgen
+ *   power on:  supplies at their voltages, modem clocks ungated, flight
+ *              mode off (TF-A), MD power domain on, "kernel boot up"
+ *              (TF-A applies the boot vector and releases the modem)
+ *
+ * after which the modem raises HS1 through the CCIF SRAM. This file has
+ * that sequence, but runs nothing on its own: every step is behind the
+ * power_ctrl module parameter AND an explicit command written to the
+ * debugfs file "fsm". Probing never powers, clocks or calls TF-A.
+ *
+ * With runtime_data=1 the FSM answers HS1 (mtk_ccci_rt.c) and waits for
+ * HS2: the modem is then READY and keeps running until "stop". Without
+ * it, the FSM reads HS1, records what the modem asked for and powers the
+ * modem off again the downstream way. Any failure on the way also ends with
+ * the modem powered off.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/bitfield.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/pm_wakeup.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/seq_file.h>
+#include <linux/soc/mediatek/mtk_sip_svc.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+
+#include "mtk_ccci.h"
+
+static bool power_ctrl = true;
+module_param(power_ctrl, bool, 0444);
+MODULE_PARM_DESC(power_ctrl,
+		 "allow the debugfs FSM commands to call TF-A and switch the modem (default: no)");
+
+/*
+ * The factory firmware start takes TF-A's CCIF clock request for the boot only: it
+ * is released as soon as the modem is READY (factory firmware boot log:
+ * "fsm_routine_start [CCIF_CLK_RELEASE]" 6 ms after md_state 3 -> 4), and
+ * on every failed start. The CCIF clock gates stay on through the clock
+ * framework either way. 1: hold it until the stop, as before.
+ */
+static bool ccif_clk_hold;
+module_param(ccif_clk_hold, bool, 0644);
+MODULE_PARM_DESC(ccif_clk_hold,
+		 "keep TF-A's CCIF clock request after the modem is ready (default: release it, as the downstream driver does)");
+
+/* TF-A SiP service of the CCCI driver */
+#define MTK_SIP_KERNEL_CCCI_CONTROL	MTK_SIP_SMC_CMD(0x505)
+
+enum {
+	CCCI_SIP_MD_CLOCK_REQUEST = 5,
+	CCCI_SIP_MD_POWER_CONFIG = 6,
+	CCCI_SIP_MD_FLIGHT_MODE_SET = 7,
+	CCCI_SIP_CCIF_CLK_REQUEST = 14,
+	CCCI_SIP_CCIF_CLK_RELEASE = 15,
+};
+
+/* sub-commands of CCCI_SIP_MD_CLOCK_REQUEST */
+enum {
+	CCCI_SIP_CLK_WAKEUP_AP_SRC = 3,
+	CCCI_SIP_CLK_GET_SLEEP_MODE = 4,
+};
+
+/* the downstream driver waits this long for the modem to sleep before a power off */
+#define MTK_CCCI_MD_SLEEP_TIMEOUT_MS	4000
+
+/* sub-commands of CCCI_SIP_MD_POWER_CONFIG */
+enum {
+	CCCI_SIP_PWR_KERNEL_BOOT_UP = 0,
+	CCCI_SIP_PWR_CHECK_FLAG = 2,
+	CCCI_SIP_PWR_CHECK_DONE = 3,
+	CCCI_SIP_PWR_BOOT_STATUS = 4,
+};
+
+/* expected boot status of MT6878 and later ("boot-status-config" 1) */
+#define MTK_CCCI_BOOT_STATUS_OK		0x544300f1
+
+#define SPM_MD_PWR_CON		0xe00
+#define SPM_MD_PWR_ACK		BIT(30)
+
+#define TOPCKGEN_MD1_CLK_MOD	0x0
+#define TOPCKGEN_MD1_CLK_MASK	(BIT(8) | BIT(9))
+
+#define MTK_CCCI_POLL_MS		20
+#define MTK_CCCI_BROM_TIMEOUT_MS	2000
+#define MTK_CCCI_HS1_TIMEOUT_MS		30000
+/* as downstream: restarted while the modem asks for files or board data */
+#define MTK_CCCI_HS2_TIMEOUT_MS		30000
+
+static const char * const mtk_ccci_supply_names[MTK_CCCI_SUPPLY_NUM] = {
+	[MTK_CCCI_SUPPLY_VMODEM] = "md-vmodem",
+	[MTK_CCCI_SUPPLY_VSRAM] = "md-vsram",
+	[MTK_CCCI_SUPPLY_VDIGRF] = "md-vdigrf",
+};
+
+/*
+ * The MediaTek downstream driver sets these voltages before the modem
+ * domain goes on (vmodem and the modem SRAM at 0.8 V, digital RF at
+ * 0.7 V on Titan 2) and never switches the supplies: they are always on.
+ * The running modem lowers vmodem and the digital RF rail itself through
+ * the PMIC, and they stay there once it is off, so the voltages have to
+ * be set again at every start, not only checked.
+ */
+static const int mtk_ccci_supply_uv[MTK_CCCI_SUPPLY_NUM] = {
+	[MTK_CCCI_SUPPLY_VMODEM] = 800000,
+	[MTK_CCCI_SUPPLY_VSRAM] = 800000,
+	[MTK_CCCI_SUPPLY_VDIGRF] = 700000,
+};
+
+static const char * const mtk_ccci_fsm_names[] = {
+	[MTK_CCCI_FSM_LK_OWNED] = "lk-owned",
+	[MTK_CCCI_FSM_STARTING] = "starting",
+	[MTK_CCCI_FSM_WAIT_HS1] = "wait-hs1",
+	[MTK_CCCI_FSM_HS1] = "hs1",
+	[MTK_CCCI_FSM_WAIT_HS2] = "wait-hs2",
+	[MTK_CCCI_FSM_EXCEPTION] = "exception",
+	[MTK_CCCI_FSM_READY] = "ready",
+	[MTK_CCCI_FSM_STOPPED] = "stopped",
+	[MTK_CCCI_FSM_FAILED] = "failed",
+};
+
+const char *mtk_ccci_fsm_state_name(enum mtk_ccci_fsm_state state)
+{
+	if (state >= ARRAY_SIZE(mtk_ccci_fsm_names))
+		return "?";
+	return mtk_ccci_fsm_names[state];
+}
+
+static void mtk_ccci_sip(struct mtk_ccci *ccci, unsigned long cmd,
+			 unsigned long a1, unsigned long a2,
+			 struct arm_smccc_res *res)
+{
+	arm_smccc_smc(MTK_SIP_KERNEL_CCCI_CONTROL, cmd, a1, a2, 0, 0, 0, 0,
+		      res);
+	dev_dbg(ccci->dev, "sip %lu/%lu/%lu: %#lx %#lx %#lx %#lx\n", cmd, a1,
+		a2, res->a0, res->a1, res->a2, res->a3);
+}
+
+/**
+ * mtk_ccci_wake_src_query() - did this modem interface wake the AP?
+ * @ccci: driver state
+ * @src: the interface asked about
+ * @res: the raw TF-A answer (a0..a3), kept for debugfs
+ *
+ * As the downstream resume_noirq of CCIF and DPMAIF: TF-A answers 0 in a0 and
+ * the interface in a1 when the AP was woken by it. Only called while the
+ * driver runs the modem (power_ctrl=1 was needed to start it); without
+ * power_ctrl TF-A is not called.
+ *
+ * Return: true if @src woke the AP.
+ */
+bool mtk_ccci_wake_src_query(struct mtk_ccci *ccci, enum mtk_ccci_wake_src src,
+			     unsigned long res[4])
+{
+	struct arm_smccc_res r;
+
+	if (!power_ctrl)
+		return false;
+	mtk_ccci_sip(ccci, CCCI_SIP_MD_CLOCK_REQUEST, CCCI_SIP_CLK_WAKEUP_AP_SRC,
+		     src, &r);
+	res[0] = r.a0;
+	res[1] = r.a1;
+	res[2] = r.a2;
+	res[3] = r.a3;
+	dev_info(ccci->dev, "TF-A wake source for %u: %#lx %#lx %#lx %#lx\n",
+		 src, r.a0, r.a1, r.a2, r.a3);
+	return !r.a0 && r.a1 == src;
+}
+
+static void mtk_ccci_query_boot_status(struct mtk_ccci *ccci)
+{
+	struct arm_smccc_res res;
+
+	mtk_ccci_sip(ccci, CCCI_SIP_MD_POWER_CONFIG, CCCI_SIP_PWR_BOOT_STATUS,
+		     0, &res);
+	ccci->boot_status[0] = res.a1;
+	ccci->boot_status[1] = res.a2;
+	dev_info(ccci->dev, "boot status %#lx: %#lx %#lx (expect %#x)\n",
+		 res.a0, res.a1, res.a2, MTK_CCCI_BOOT_STATUS_OK);
+}
+
+/* what has to be in place before anything is switched, as text */
+struct mtk_ccci_check {
+	char *buf;
+	size_t len, size;
+	bool ok;
+};
+
+static __printf(3, 4) void mtk_ccci_check_add(struct mtk_ccci_check *c,
+					      bool ok, const char *fmt, ...)
+{
+	va_list args;
+
+	if (!ok)
+		c->ok = false;
+	if (c->len >= c->size)
+		return;
+	c->len += scnprintf(c->buf + c->len, c->size - c->len, "%s ",
+			    ok ? "[ok]  " : "[MISS]");
+	va_start(args, fmt);
+	c->len += vscnprintf(c->buf + c->len, c->size - c->len, fmt, args);
+	va_end(args);
+	c->len += scnprintf(c->buf + c->len, c->size - c->len, "\n");
+}
+
+static void mtk_ccci_fsm_check(struct mtk_ccci *ccci,
+			       struct mtk_ccci_check *c)
+{
+	unsigned int i;
+
+	c->ok = true;
+	mtk_ccci_check_add(c, power_ctrl, "module parameter power_ctrl=1");
+	mtk_ccci_check_add(c, ccci->md_domain,
+			   "MD power domain attached (mediatek,modem-power-domain in DT)");
+	mtk_ccci_check_add(c, ccci->topckgen,
+			   "topckgen regmap (mediatek,topckgen)");
+	mtk_ccci_check_add(c, ccci->infra && ccci->ccif_rst_bit != U32_MAX,
+			   "CCIF reset (reg \"infra\", mediatek,ccif-reset-bit)");
+	mtk_ccci_check_add(c, mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_CCISM_MCU),
+			   "CCISM_MCU shared memory from LK");
+	for (i = 0; i < MTK_CCCI_SUPPLY_NUM; i++) {
+		int uv = ccci->supply[i] ?
+			 regulator_get_voltage(ccci->supply[i]) : -ENODEV;
+
+		mtk_ccci_check_add(c, ccci->supply[i],
+				   "%s-supply (now %d uV, %d uV at start)",
+				   mtk_ccci_supply_names[i], uv,
+				   mtk_ccci_supply_uv[i]);
+	}
+}
+
+/*
+ * The rails as the downstream power-on sets them: vmodem and digital RF
+ * first, the modem SRAM 2 ms later (the downstream driver's order). The
+ * supplies stay enabled throughout; only the voltages are written. A
+ * rail that cannot be set is reported and left as it is, as downstream
+ * does: at the first start LK has already set these voltages.
+ */
+static void mtk_ccci_supplies_set(struct mtk_ccci *ccci)
+{
+	static const unsigned int order[MTK_CCCI_SUPPLY_NUM] = {
+		MTK_CCCI_SUPPLY_VMODEM, MTK_CCCI_SUPPLY_VDIGRF,
+		MTK_CCCI_SUPPLY_VSRAM,
+	};
+	unsigned int i, s;
+	int ret, uv;
+
+	for (i = 0; i < ARRAY_SIZE(order); i++) {
+		s = order[i];
+		if (!ccci->supply[s])
+			continue;
+		if (s == MTK_CCCI_SUPPLY_VSRAM)
+			usleep_range(2000, 3000);
+		uv = regulator_get_voltage(ccci->supply[s]);
+		ret = regulator_set_voltage(ccci->supply[s],
+					    mtk_ccci_supply_uv[s],
+					    mtk_ccci_supply_uv[s]);
+		/*
+		 * The same request as last time is not written again by the
+		 * regulator core, but the modem changed the rail behind its
+		 * back: write it anyway.
+		 */
+		if (!ret)
+			ret = regulator_sync_voltage(ccci->supply[s]);
+		if (ret)
+			dev_warn(ccci->dev, "%s-supply: %d uV, setting %d uV failed: %d\n",
+				 mtk_ccci_supply_names[s], uv,
+				 mtk_ccci_supply_uv[s], ret);
+		else if (uv != mtk_ccci_supply_uv[s])
+			dev_info(ccci->dev, "%s-supply: %d -> %d uV\n",
+				 mtk_ccci_supply_names[s], uv,
+				 mtk_ccci_supply_uv[s]);
+	}
+}
+
+/* SPM PWR_CON of the modem: 1 = powered, 0 = off, < 0 unknown */
+static int mtk_ccci_md_pwr_ack(struct mtk_ccci *ccci)
+{
+	unsigned int val;
+
+	if (!ccci->scpsys || regmap_read(ccci->scpsys, SPM_MD_PWR_CON, &val))
+		return -ENODEV;
+	return !!(val & SPM_MD_PWR_ACK);
+}
+
+static int mtk_ccci_topckgen_md_clk(struct mtk_ccci *ccci, bool on)
+{
+	return regmap_update_bits(ccci->topckgen, TOPCKGEN_MD1_CLK_MOD,
+				  TOPCKGEN_MD1_CLK_MASK,
+				  on ? 0 : TOPCKGEN_MD1_CLK_MASK);
+}
+
+/* wait for the modem boot ROM, as the stock first start does */
+static int mtk_ccci_wait_brom(struct mtk_ccci *ccci)
+{
+	struct arm_smccc_res res;
+	unsigned int waited;
+
+	for (waited = 0; waited < MTK_CCCI_BROM_TIMEOUT_MS;
+	     waited += MTK_CCCI_POLL_MS) {
+		mtk_ccci_sip(ccci, CCCI_SIP_MD_POWER_CONFIG,
+			     CCCI_SIP_PWR_CHECK_DONE, 0, &res);
+		if (!res.a0)
+			break;
+		msleep(MTK_CCCI_POLL_MS);
+	}
+
+	mtk_ccci_sip(ccci, CCCI_SIP_MD_POWER_CONFIG, CCCI_SIP_PWR_CHECK_FLAG,
+		     0, &res);
+	dev_info(ccci->dev, "modem BROM %s after %u ms, flags %#lx %#lx %#lx %#lx\n",
+		 waited < MTK_CCCI_BROM_TIMEOUT_MS ? "done" : "NOT done",
+		 waited, res.a0, res.a1, res.a2, res.a3);
+	mtk_ccci_query_boot_status(ccci);
+
+	return waited < MTK_CCCI_BROM_TIMEOUT_MS ? 0 : -ETIMEDOUT;
+}
+
+/*
+ * Is the modem asleep? TF-A answers a0 = 0 and a1 = 1 (asleep) or 0;
+ * another a0 means the query is not supported. The downstream driver
+ * polls this after userspace sent AT+EPOF, for up to 4 s, and powers the
+ * modem off only then (or after a dump on timeout).
+ */
+int mtk_ccci_md_sleep_mode(struct mtk_ccci *ccci)
+{
+	struct arm_smccc_res res;
+
+	if (!power_ctrl)
+		return -EPERM;
+	mtk_ccci_sip(ccci, CCCI_SIP_MD_CLOCK_REQUEST,
+		     CCCI_SIP_CLK_GET_SLEEP_MODE, 0, &res);
+	ccci->sleep.md_sleep[0] = res.a0;
+	ccci->sleep.md_sleep[1] = res.a1;
+	ccci->sleep.md_sleep[2] = res.a2;
+	ccci->sleep.md_sleep[3] = res.a3;
+	if (res.a0)
+		return -EOPNOTSUPP;
+	return res.a1 ? 1 : 0;
+}
+
+/* as downstream before a power off: wait for the modem to be asleep */
+static void mtk_ccci_wait_md_sleep(struct mtk_ccci *ccci)
+{
+	unsigned int waited;
+	int asleep = 0;
+
+	for (waited = 0; waited < MTK_CCCI_MD_SLEEP_TIMEOUT_MS;
+	     waited += 100) {
+		asleep = mtk_ccci_md_sleep_mode(ccci);
+		if (asleep)
+			break;
+		msleep(100);
+	}
+	ccci->sleep.md_sleep_ms = waited;
+	if (asleep == 1)
+		dev_info(ccci->dev, "modem asleep after %u ms\n", waited);
+	else if (asleep < 0)
+		dev_info(ccci->dev, "modem sleep state not reported by TF-A (%#lx %#lx)\n",
+			 ccci->sleep.md_sleep[0], ccci->sleep.md_sleep[1]);
+	else
+		dev_warn(ccci->dev, "modem not asleep after %u ms, powering off anyway (%#lx %#lx %#lx %#lx)\n",
+			 waited, ccci->sleep.md_sleep[0], ccci->sleep.md_sleep[1],
+			 ccci->sleep.md_sleep[2], ccci->sleep.md_sleep[3]);
+}
+
+/* Keep the stock path for DTs using the standard power domain. */
+extern int cmf_md_runtime_switch(struct device *dev, bool on);
+
+static bool mtk_ccci_cmf_domain(struct device *dev)
+{
+	struct device_node *np __free(device_node) =
+		of_parse_phandle(dev->of_node, "mediatek,modem-power-domain", 0);
+
+	return of_device_is_compatible(np, "cmf,mt6878-switchable-modem-resources");
+}
+
+static int mtk_ccci_runtime_switch(struct device *dev, bool on)
+{
+	typeof(&cmf_md_runtime_switch) transition;
+	int ret;
+
+	if (!mtk_ccci_cmf_domain(dev))
+		return on ? pm_runtime_resume_and_get(dev) : pm_runtime_put_sync(dev);
+	transition = symbol_get(cmf_md_runtime_switch);
+	if (!transition)
+		return -ENODEV;
+	ret = transition(dev, on);
+	symbol_put(cmf_md_runtime_switch);
+	return ret;
+}
+
+static int mtk_ccci_power_off(struct mtk_ccci *ccci)
+{
+	struct arm_smccc_res res;
+	int ret;
+
+	/*
+	 * The modem LK started: genpd sees the domain off. Take it over
+	 * first (on a running domain this only sets bits that are set).
+	 */
+	if (!ccci->md_domain_held) {
+		ret = pm_runtime_resume_and_get(ccci->dev);
+		if (ret) {
+			dev_err(ccci->dev, "MD power domain take-over: %d\n",
+				ret);
+			return ret;
+		}
+		ccci->md_domain_held = true;
+	}
+
+	/*
+	 * The MediaTek downstream driver also blocks UFS I/O around the domain switch
+	 * (ufs_mtk_cali_hold); the mainline UFS driver has no such hook.
+	 */
+	mtk_ccci_wdt_irq_stop(ccci);
+	ret = mtk_ccci_runtime_switch(ccci->dev, false);
+	if (ret < 0)
+		dev_warn(ccci->dev, "MD power domain off: %d\n", ret);
+	ccci->md_domain_held = false;
+	/* genpd does not report a failed power off: ask SPM */
+	if (mtk_ccci_cmf_domain(ccci->dev)) {
+		if (ret < 0)
+			return ret;
+		ret = mtk_ccci_md_pwr_ack(ccci);
+		if (ret)
+			return ret < 0 ? ret : -EIO;
+	} else if (ret >= 0 && mtk_ccci_md_pwr_ack(ccci) > 0) {
+		dev_err(ccci->dev, "MD power domain still on\n");
+		ret = -EIO;
+	}
+	/* required by modem generation 6299 after the domain is off */
+	mdelay(4);
+
+	mtk_ccci_sip(ccci, CCCI_SIP_MD_FLIGHT_MODE_SET, 1, 0, &res);
+	mtk_ccci_topckgen_md_clk(ccci, false);
+	if (ret >= 0)
+		ccci->lk_modem_gone = true;
+	dev_info(ccci->dev, "modem powered off\n");
+
+	return ret < 0 ? ret : 0;
+}
+
+static int mtk_ccci_power_on(struct mtk_ccci *ccci)
+{
+	struct arm_smccc_res res;
+	int ret;
+
+	mtk_ccci_supplies_set(ccci);
+	if (mtk_ccci_cmf_domain(ccci->dev)) {
+		unsigned int i;
+
+		for (i = 0; i < MTK_CCCI_SUPPLY_NUM; i++) {
+			int uv = regulator_get_voltage(ccci->supply[i]);
+
+			if (uv != mtk_ccci_supply_uv[i])
+				return uv < 0 ? uv : -ERANGE;
+		}
+	}
+	ret = mtk_ccci_topckgen_md_clk(ccci, true);
+	if (ret)
+		return ret;
+
+	mtk_ccci_sip(ccci, CCCI_SIP_MD_FLIGHT_MODE_SET, 0, 0, &res);
+
+	ret = mtk_ccci_runtime_switch(ccci->dev, true);
+	if (ret) {
+		dev_err(ccci->dev, "MD power domain on: %d\n", ret);
+		return ret;
+	}
+	ccci->md_domain_held = true;
+
+	/*
+	 * The boot ROM runs from the power on; the first start waited for it
+	 * on the modem LK had started. Wait here too, before the release: a
+	 * restart that released at once left the modem booted but silent.
+	 */
+	if (mtk_ccci_wait_brom(ccci))
+		dev_warn(ccci->dev, "boot ROM not done, releasing anyway\n");
+
+	/* make the boot vector take effect: the modem starts */
+	mtk_ccci_sip(ccci, CCCI_SIP_MD_POWER_CONFIG,
+		     CCCI_SIP_PWR_KERNEL_BOOT_UP, 0, &res);
+	dev_info(ccci->dev, "modem released: %#lx %#lx %#lx %#lx\n", res.a0,
+		 res.a1, res.a2, res.a3);
+
+	/* as the MediaTek downstream driver: the watchdog is watched from here on */
+	ret = mtk_ccci_wdt_irq_start(ccci);
+	if (ret)
+		dev_warn(ccci->dev, "modem watchdog interrupt: %d\n", ret);
+	return 0;
+}
+
+/* wait for HS1: the RX worker sees the SRAM channel (interrupt or poll) */
+static int mtk_ccci_wait_hs1(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_header hdr;
+	unsigned long t0 = jiffies;
+	long left;
+	u32 status;
+
+	left = wait_event_timeout(ccci->hs_wq,
+				  READ_ONCE(ccci->hs1_pending) ||
+				  READ_ONCE(ccci->exception),
+				  msecs_to_jiffies(MTK_CCCI_HS1_TIMEOUT_MS));
+	if (READ_ONCE(ccci->exception)) {
+		dev_err(ccci->dev, "modem exception before HS1\n");
+		return -EIO;
+	}
+	if (!left) {
+		struct mtk_ccci_ccif_snap *snap;
+
+		dev_err(ccci->dev, "no HS1 in %u ms\n", MTK_CCCI_HS1_TIMEOUT_MS);
+		/* what the modem left in CCIF0, if anything */
+		snap = kzalloc(sizeof(*snap), GFP_KERNEL);
+		if (snap && !mtk_ccci_ccif_snapshot(ccci, snap))
+			dev_err(ccci->dev, "CCIF0 at the timeout: ap busy %#x tchnum %#x rchnum %#x, md busy %#x tchnum %#x rchnum %#x, sram %08x %08x %08x %08x\n",
+				snap->ap.busy, snap->ap.tchnum, snap->ap.rchnum,
+				snap->md.busy, snap->md.tchnum, snap->md.rchnum,
+				snap->sram[0], snap->sram[1], snap->sram[2],
+				snap->sram[3]);
+		kfree(snap);
+		return -ETIMEDOUT;
+	}
+
+	mtk_ccci_ccif_read_hs(ccci, &hdr, &ccci->hs1_query);
+	status = le32_to_cpu(hdr.status);
+	if (FIELD_GET(MTK_CCCI_H_CHANNEL, status) != MTK_CCCI_CH_CONTROL_RX ||
+	    le32_to_cpu(hdr.data[1]) != MTK_CCCI_CTL_MD_INIT_START_BOOT ||
+	    le32_to_cpu(hdr.reserved) != MTK_CCCI_CTL_MD_INIT_CHK_ID) {
+		dev_err(ccci->dev, "unexpected SRAM message %*ph\n",
+			(int)sizeof(hdr), &hdr);
+		return -EPROTO;
+	}
+
+	ccci->hs1_valid = le32_to_cpu(ccci->hs1_query.head_pattern) ==
+			  MTK_CCCI_MD_FEATURE_PATTERN &&
+			  le32_to_cpu(ccci->hs1_query.tail_pattern) ==
+			  MTK_CCCI_MD_FEATURE_PATTERN;
+	dev_info(ccci->dev, "HS1 after %u ms, feature query %s\n",
+		 jiffies_to_msecs(jiffies - t0),
+		 ccci->hs1_valid ? "valid" : "INVALID");
+	return 0;
+}
+
+/*
+ * Answer HS1 and wait for HS2. The modem asks for files (FS, served from
+ * userspace through /dev/ccci_fs) and board data (RPC) before HS2; as the
+ * downstream driver, the timeout starts again while it does.
+ */
+static int mtk_ccci_boot_to_ready(struct mtk_ccci *ccci)
+{
+	unsigned long t0 = jiffies, deadline;
+	unsigned long fs_rpc;
+	int ret;
+
+	WRITE_ONCE(ccci->hs2_seen, false);
+	WRITE_ONCE(ccci->state, MTK_CCCI_FSM_WAIT_HS2);
+	ret = mtk_ccci_rt_send(ccci);
+	if (ret) {
+		dev_err(ccci->dev, "runtime data: %d\n", ret);
+		return ret;
+	}
+
+	fs_rpc = READ_ONCE(ccci->stats.fs_rpc);
+	deadline = jiffies + msecs_to_jiffies(MTK_CCCI_HS2_TIMEOUT_MS);
+	for (;;) {
+		wait_event_timeout(ccci->hs_wq,
+				   READ_ONCE(ccci->hs2_seen) ||
+				   READ_ONCE(ccci->exception),
+				   msecs_to_jiffies(MTK_CCCI_POLL_MS * 10));
+		if (READ_ONCE(ccci->exception)) {
+			dev_err(ccci->dev, "modem exception before HS2\n");
+			return -EIO;
+		}
+		if (READ_ONCE(ccci->hs2_seen))
+			break;
+		if (READ_ONCE(ccci->stats.fs_rpc) != fs_rpc) {
+			fs_rpc = READ_ONCE(ccci->stats.fs_rpc);
+			deadline = jiffies +
+				   msecs_to_jiffies(MTK_CCCI_HS2_TIMEOUT_MS);
+		} else if (time_after(jiffies, deadline)) {
+			dev_err(ccci->dev, "no HS2 in %u ms (%lu FS/RPC packets)\n",
+				MTK_CCCI_HS2_TIMEOUT_MS, fs_rpc);
+			return -ETIMEDOUT;
+		}
+	}
+
+	WRITE_ONCE(ccci->state, MTK_CCCI_FSM_READY);
+	dev_info(ccci->dev, "modem ready, HS2 %u ms after the runtime data (%lu FS/RPC packets)\n",
+		 jiffies_to_msecs(jiffies - t0), fs_rpc);
+	mtk_ccci_query_boot_status(ccci);
+	mtk_ccci_port_register(ccci);
+	return 0;
+}
+
+/* TF-A's CCIF clock request, taken at the start: released once */
+static void mtk_ccci_ccif_clk_release(struct mtk_ccci *ccci)
+{
+	struct arm_smccc_res res;
+
+	if (!ccci->ccif_clk_req)
+		return;
+	mtk_ccci_sip(ccci, CCCI_SIP_CCIF_CLK_RELEASE, 0, 0, &res);
+	ccci->ccif_clk_req = false;
+	dev_info(ccci->dev, "CCIF clock request released (%#lx)\n", res.a0);
+}
+
+/* stop talking to the modem; it must be off (or never touched) */
+static void mtk_ccci_hif_down(struct mtk_ccci *ccci)
+{
+	mtk_ccci_dpmaif_stop(ccci);
+	mtk_ccci_ccif_irq_stop(ccci);
+	mtk_ccci_hif_stop(ccci);
+	mtk_ccci_ccif_stop(ccci);
+	mtk_ccci_ccif_clk_release(ccci);
+}
+
+/*
+ * The stock first start, in the stock order: CCIF taken over (while the
+ * LK modem still runs), boot ROM wait, power off, power on, HS1, runtime
+ * data, HS2. Without runtime_data=1 the modem is powered off again at HS1:
+ * the start reports -EOPNOTSUPP with the HS1 details kept.
+ */
+static int mtk_ccci_fsm_start(struct mtk_ccci *ccci)
+{
+	struct arm_smccc_res res;
+	/* until the LK modem is powered off once, start the stock first way */
+	bool first = !ccci->lk_modem_gone;
+	int ret;
+
+	if (ccci->state != MTK_CCCI_FSM_LK_OWNED &&
+	    ccci->state != MTK_CCCI_FSM_STOPPED &&
+	    !(ccci->state == MTK_CCCI_FSM_FAILED && !ccci->md_domain_held))
+		return -EBUSY;
+
+	WRITE_ONCE(ccci->state, MTK_CCCI_FSM_STARTING);
+	ccci->hs1_valid = false;
+	ccci->rt_len = 0;
+	memset(ccci->rt_answer, 0, sizeof(ccci->rt_answer));
+	WRITE_ONCE(ccci->exception, false);
+	ccci->ex_channels = 0;
+	mtk_ccci_ee_reset(ccci);
+
+	mtk_ccci_sip(ccci, CCCI_SIP_CCIF_CLK_REQUEST, 0, 0, &res);
+	ccci->ccif_clk_req = true;
+
+	ret = mtk_ccci_ccif_start(ccci);
+	if (ret) {
+		dev_err(ccci->dev, "CCIF start: %d\n", ret);
+		goto fail;
+	}
+	mtk_ccci_hif_start(ccci);
+	ret = mtk_ccci_ccif_irq_start(ccci);
+	if (ret)
+		dev_warn(ccci->dev, "no CCIF interrupts (%d), polling\n", ret);
+
+	if (first) {
+		ret = mtk_ccci_wait_brom(ccci);
+		if (ret)
+			goto fail;
+		ret = mtk_ccci_power_off(ccci);
+		if (ret)
+			goto fail;
+	}
+
+	/*
+	 * The CCB ring headers the modem expects to find when it starts;
+	 * the start goes on without them.
+	 */
+	ret = mtk_ccci_ccb_init(ccci);
+	if (ret)
+		dev_warn(ccci->dev, "CCB ring headers not written: %d\n", ret);
+
+	/*
+	 * The data path, set up before the modem runs as downstream does
+	 * (only with data=1); the modem boots without it if that fails.
+	 */
+	ret = mtk_ccci_dpmaif_start(ccci);
+	if (ret)
+		dev_warn(ccci->dev, "no data path, DPMAIF setup: %d\n", ret);
+
+	ret = mtk_ccci_power_on(ccci);
+	if (ret)
+		goto fail;
+
+	WRITE_ONCE(ccci->state, MTK_CCCI_FSM_WAIT_HS1);
+	ret = mtk_ccci_wait_hs1(ccci);
+	if (ret)
+		goto fail;
+	WRITE_ONCE(ccci->state, MTK_CCCI_FSM_HS1);
+	mtk_ccci_query_boot_status(ccci);
+
+	if (mtk_ccci_rt_enabled()) {
+		ret = mtk_ccci_boot_to_ready(ccci);
+		if (ret)
+			goto fail;
+		/* as the downstream start: the request is for the boot only */
+		if (!READ_ONCE(ccif_clk_hold))
+			mtk_ccci_ccif_clk_release(ccci);
+		return 0;
+	}
+
+	/*
+	 * Without the answer the modem would time out waiting and assert;
+	 * power it off now instead.
+	 */
+	dev_warn(ccci->dev, "runtime_data=0: stopping the modem at HS1\n");
+	ret = -EOPNOTSUPP;
+
+fail:
+	if (READ_ONCE(ccci->exception)) {
+		WRITE_ONCE(ccci->state, MTK_CCCI_FSM_EXCEPTION);
+		mtk_ccci_ee_report(ccci);
+	}
+	if (ret != -EOPNOTSUPP)
+		mtk_ccci_query_boot_status(ccci);
+	mtk_ccci_dpmaif_pre_stop(ccci);
+	if (ccci->md_domain_held)
+		mtk_ccci_power_off(ccci);
+	mtk_ccci_hif_down(ccci);
+	/* FAILED with the domain held: "stop" retries the power off */
+	WRITE_ONCE(ccci->state, ret == -EOPNOTSUPP && !ccci->md_domain_held ?
+			 MTK_CCCI_FSM_STOPPED : MTK_CCCI_FSM_FAILED);
+	return ret;
+}
+
+static int mtk_ccci_fsm_stop(struct mtk_ccci *ccci)
+{
+	int ret;
+
+	switch (ccci->state) {
+	case MTK_CCCI_FSM_WAIT_HS1:
+	case MTK_CCCI_FSM_HS1:
+	case MTK_CCCI_FSM_WAIT_HS2:
+	case MTK_CCCI_FSM_READY:
+	case MTK_CCCI_FSM_EXCEPTION:
+	case MTK_CCCI_FSM_FAILED:
+		break;
+	default:
+		return -EINVAL;
+	}
+	/* FAILED before the power on: nothing is held */
+	if (!ccci->md_domain_held)
+		return -EINVAL;
+
+	mtk_ccci_port_unregister(ccci);
+	mtk_ccci_dpmaif_pre_stop(ccci);
+	/* as downstream: a running modem is powered off asleep (userspace sent AT+EPOF) */
+	if (ccci->state == MTK_CCCI_FSM_READY)
+		mtk_ccci_wait_md_sleep(ccci);
+	ret = mtk_ccci_power_off(ccci);
+	mtk_ccci_hif_down(ccci);
+	WRITE_ONCE(ccci->state, ret ? MTK_CCCI_FSM_FAILED :
+			 MTK_CCCI_FSM_STOPPED);
+	return ret;
+}
+
+static int mtk_ccci_fsm_show(struct seq_file *s, void *unused)
+{
+	struct mtk_ccci *ccci = s->private;
+	struct mtk_ccci_check c = { };
+	unsigned int i;
+
+	c.size = PAGE_SIZE;
+	c.buf = kzalloc(c.size, GFP_KERNEL);
+	if (!c.buf)
+		return -ENOMEM;
+
+	if (!mutex_trylock(&ccci->fsm_lock)) {
+		/*
+		 * Another reader, or a start/stop, holds the lock: say so on
+		 * a line of its own. The first line keeps its exact form, the
+		 * userspace daemons read it to see whether the modem is ready.
+		 */
+		seq_printf(s, "state: %s\n",
+			   mtk_ccci_fsm_state_name(READ_ONCE(ccci->state)));
+		seq_printf(s, "boot status: %#x %#x\n",
+			   READ_ONCE(ccci->boot_status[0]),
+			   READ_ONCE(ccci->boot_status[1]));
+		seq_puts(s, "busy: a command or another reader holds the lock, details skipped\n");
+		kfree(c.buf);
+		return 0;
+	}
+	seq_printf(s, "state: %s\n", mtk_ccci_fsm_state_name(ccci->state));
+	seq_printf(s, "boot status: %#x %#x\n", ccci->boot_status[0],
+		   ccci->boot_status[1]);
+	if (ccci->hs1_valid) {
+		seq_puts(s, "hs1 features:");
+		for (i = 0; i < MTK_CCCI_FEATURE_COUNT; i++)
+			if (ccci->hs1_query.feature[i])
+				seq_printf(s, " %u:%#x", i,
+					   ccci->hs1_query.feature[i]);
+		seq_puts(s, "\n");
+	}
+	mtk_ccci_rt_show(ccci, s);
+	seq_printf(s, "sleep: %lu suspends with the modem up, %lu woken by CCIF0 (channels %#x), last resume channels %#x, last TF-A answer %#lx %#lx %#lx %#lx, wakeup %s\n",
+		   ccci->sleep.suspends, ccci->sleep.ccif_wakeups,
+		   ccci->sleep.last_wake_ch, ccci->sleep.last_rch,
+		   ccci->sleep.wake_query[0], ccci->sleep.wake_query[1],
+		   ccci->sleep.wake_query[2], ccci->sleep.wake_query[3],
+		   device_may_wakeup(ccci->dev) ? "enabled" : "DISABLED (suspend refused)");
+	seq_printf(s, "sleep: %lu CCIF0 raised at resume without TF-A naming it; modem at the last suspend: %s; slept in the last AP sleep: %s (%llu ms); CCIF clock request %s\n",
+		   ccci->sleep.ccif_raised,
+		   ccci->sleep.md_asleep_at_suspend == 1 ? "asleep" :
+		   ccci->sleep.md_asleep_at_suspend == 0 ? "awake" : "unknown",
+		   ccci->sleep.md_lp_state == 1 ? "yes" :
+		   ccci->sleep.md_lp_state == 0 ? "no" : "unknown",
+		   ccci->sleep.md_lp_slept_ms,
+		   ccci->ccif_clk_req ? "held" : "released");
+	if (ccci->sleep.ccif_wakeups || ccci->sleep.ccif_raised)
+		seq_printf(s, "last wake-up packet: channel %u queue %u %s\n",
+			   ccci->sleep.wake_rx_ch, ccci->sleep.wake_rx_q,
+			   ccci->sleep.wake_rx_what);
+	seq_printf(s, "md sleep: last answer %#lx %#lx %#lx %#lx, last stop waited %u ms\n",
+		   ccci->sleep.md_sleep[0], ccci->sleep.md_sleep[1],
+		   ccci->sleep.md_sleep[2], ccci->sleep.md_sleep[3],
+		   ccci->sleep.md_sleep_ms);
+	mtk_ccci_fsm_check(ccci, &c);
+	mutex_unlock(&ccci->fsm_lock);
+
+	seq_printf(s, "start needs:\n%s", c.buf);
+	seq_puts(s, "commands: dry-run | query | sleep | start | stop\n");
+	kfree(c.buf);
+	return 0;
+}
+
+static void mtk_ccci_fsm_dry_run(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_check c = { };
+	char *line, *p;
+
+	c.size = PAGE_SIZE;
+	c.buf = kzalloc(c.size, GFP_KERNEL);
+	if (!c.buf)
+		return;
+	mtk_ccci_fsm_check(ccci, &c);
+
+	dev_info(ccci->dev, "dry run, state %s, nothing is switched:\n",
+		 mtk_ccci_fsm_state_name(ccci->state));
+	for (p = c.buf; (line = strsep(&p, "\n")) && *line;)
+		dev_info(ccci->dev, "  %s\n", line);
+	dev_info(ccci->dev,
+		 "  would: SIP CCIF_CLK_REQUEST; CCIF clocks on, rings in CCISM, CCIF reset, CCIF interrupts%s%s; topckgen md1 clocks on; SIP FLIGHT_MODE 0; MD domain on; SIP KERNEL_BOOT_UP; wait for HS1 up to %u ms; then %s\n",
+		 !ccci->lk_modem_gone ?
+		 "; SIP CHECK_DONE poll; take the MD domain over, off, 4 ms, SIP FLIGHT_MODE 1, topckgen md1 clocks off" : "",
+		 !ccci->ccb_ctrl_init ? "; CCB ring headers into CCB_CTRL" : "",
+		 MTK_CCCI_HS1_TIMEOUT_MS,
+		 mtk_ccci_rt_enabled() ?
+		 "runtime data into RUNTIME_DATA and the CCIF SRAM, CCIF channel 15, wait for HS2 (FS/RPC served meanwhile), READY" :
+		 "(runtime_data=0) MD domain off, 4 ms, SIP FLIGHT_MODE 1, topckgen md1 clocks off");
+	kfree(c.buf);
+}
+
+static ssize_t mtk_ccci_fsm_write(struct file *file, const char __user *ubuf,
+				  size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct mtk_ccci *ccci = s->private;
+	struct mtk_ccci_check c = { };
+	char cmd[16];
+	int ret = 0;
+
+	if (count >= sizeof(cmd))
+		return -EINVAL;
+	if (copy_from_user(cmd, ubuf, count))
+		return -EFAULT;
+	cmd[count] = '\0';
+	strim(cmd);
+
+	mutex_lock(&ccci->fsm_lock);
+	if (!strcmp(cmd, "dry-run")) {
+		mtk_ccci_fsm_dry_run(ccci);
+	} else if (!strcmp(cmd, "query")) {
+		/* TF-A reads only, but still TF-A: behind power_ctrl */
+		if (power_ctrl)
+			mtk_ccci_query_boot_status(ccci);
+		else
+			ret = -EPERM;
+	} else if (!strcmp(cmd, "sleep")) {
+		/* ask TF-A whether the modem sleeps; the answer is in the file */
+		if (power_ctrl) {
+			ret = mtk_ccci_md_sleep_mode(ccci);
+			dev_info(ccci->dev, "modem sleep mode: %d (%#lx %#lx %#lx %#lx)\n",
+				 ret, ccci->sleep.md_sleep[0],
+				 ccci->sleep.md_sleep[1], ccci->sleep.md_sleep[2],
+				 ccci->sleep.md_sleep[3]);
+			ret = ret < 0 ? ret : 0;
+		} else {
+			ret = -EPERM;
+		}
+	} else if (!strcmp(cmd, "start")) {
+		c.size = PAGE_SIZE;
+		c.buf = kzalloc(c.size, GFP_KERNEL);
+		if (!c.buf) {
+			ret = -ENOMEM;
+		} else {
+			mtk_ccci_fsm_check(ccci, &c);
+			if (c.ok) {
+				ret = mtk_ccci_fsm_start(ccci);
+			} else {
+				char *line, *p = c.buf;
+
+				/* say why, not only -EPERM to the writer */
+				while ((line = strsep(&p, "\n")))
+					if (strstarts(line, "[MISS]"))
+						dev_err(ccci->dev, "start: %s\n",
+							line + 7);
+				ret = -EPERM;
+			}
+			kfree(c.buf);
+		}
+	} else if (!strcmp(cmd, "stop")) {
+		ret = power_ctrl ? mtk_ccci_fsm_stop(ccci) : -EPERM;
+	} else {
+		ret = -EINVAL;
+	}
+	mutex_unlock(&ccci->fsm_lock);
+
+	return ret ?: count;
+}
+
+static int mtk_ccci_fsm_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, mtk_ccci_fsm_show, inode->i_private);
+}
+
+static const struct file_operations mtk_ccci_fsm_fops = {
+	.owner = THIS_MODULE,
+	.open = mtk_ccci_fsm_open,
+	.read = seq_read,
+	.write = mtk_ccci_fsm_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+void mtk_ccci_fsm_debugfs_init(struct mtk_ccci *ccci)
+{
+	debugfs_create_file("fsm", 0600, ccci->debugfs, ccci,
+			    &mtk_ccci_fsm_fops);
+}
+
+static void mtk_ccci_md_domain_detach(void *data)
+{
+	struct device *dev = data;
+
+	/* never switches the domain: genpd keeps whatever state it had */
+	pm_runtime_disable(dev);
+	pm_genpd_remove_device(dev);
+}
+
+/*
+ * The MD power domain, from "mediatek,modem-power-domain" and not from
+ * "power-domains" on purpose: the bus code powers a "power-domains"
+ * domain on at bind and off at unbind or when probe fails, which would
+ * stop the modem LK started. Here the device is only added to the
+ * domain, which the power controller registers default-off (genpd sees
+ * it off while LK's modem runs). The domain is switched by the FSM
+ * alone, through runtime PM: on in the power on step, off in the power
+ * off step; the first power off adopts LK's modem (a power on of the
+ * running domain, which only sets bits that are set already) and then
+ * really switches it off. The module is pinned: with the domain held,
+ * nothing may tear the device down.
+ */
+static int mtk_ccci_md_domain_attach(struct mtk_ccci *ccci)
+{
+	struct device *dev = ccci->dev;
+	struct of_phandle_args args;
+	int ret;
+
+	ret = of_parse_phandle_with_args(dev->of_node,
+					 "mediatek,modem-power-domain",
+					 "#power-domain-cells", 0, &args);
+	if (ret == -ENOENT)
+		return 0;
+	if (ret)
+		return dev_err_probe(dev, ret, "modem power domain\n");
+	if (dev->pm_domain) {
+		of_node_put(args.np);
+		return dev_err_probe(dev, -EINVAL,
+				     "use mediatek,modem-power-domain, not power-domains\n");
+	}
+
+	ret = of_genpd_add_device(&args, dev);
+	of_node_put(args.np);
+	if (ret == -ENOENT)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "modem power domain not registered\n");
+	if (ret)
+		return dev_err_probe(dev, ret, "modem power domain\n");
+
+	pm_runtime_enable(dev);
+	ret = devm_add_action_or_reset(dev, mtk_ccci_md_domain_detach, dev);
+	if (ret)
+		return ret;
+
+	ccci->md_domain = true;
+	__module_get(THIS_MODULE);
+	return 0;
+}
+
+/**
+ * mtk_ccci_fsm_init() - get the power resources, switch nothing
+ * @ccci: driver state
+ *
+ * Return: 0 or a negative error.
+ */
+int mtk_ccci_fsm_init(struct mtk_ccci *ccci)
+{
+	struct device *dev = ccci->dev;
+	unsigned int i;
+	int ret;
+
+	mutex_init(&ccci->fsm_lock);
+	ccci->state = MTK_CCCI_FSM_LK_OWNED;
+
+	/* getting a supply does not switch it; it is never enabled here */
+	for (i = 0; i < MTK_CCCI_SUPPLY_NUM; i++) {
+		struct regulator *reg;
+
+		reg = devm_regulator_get_optional(dev,
+						  mtk_ccci_supply_names[i]);
+		if (IS_ERR(reg)) {
+			if (PTR_ERR(reg) != -ENODEV)
+				return dev_err_probe(dev, PTR_ERR(reg),
+						     "%s supply\n",
+						     mtk_ccci_supply_names[i]);
+			reg = NULL;
+		}
+		ccci->supply[i] = reg;
+	}
+
+	ret = mtk_ccci_md_domain_attach(ccci);
+	if (ret)
+		return ret;
+
+	return 0;
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_hif.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_hif.c
new file mode 100644
index 000000000..0c35d9b69
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_hif.c
@@ -0,0 +1,568 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: packet queues on top of CCIF and the CCISM ring buffers.
+ *
+ * TX: the CCCI header gets the per-channel sequence number and the
+ * "check the sequence" bit (cleared for the FS and RPC channels outside
+ * the HS1..HS2 window, as the MediaTek downstream driver does), the packet goes into
+ * the queue's TX ring and the queue's CCIF channel is raised.
+ *
+ * RX: one ordered worker drains every RX ring, triggered by the CCIF
+ * interrupt and, as a safety net and for boards without the interrupt,
+ * by a poll timer. A packet is copied out and handed to its channel's
+ * consumer; only once the consumer took it is it dropped from the ring.
+ * A consumer that is full (a character device nobody reads) leaves the
+ * packet in the ring: the modem sees the queue fill up, as with the
+ * MediaTek downstream driver.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/bitfield.h>
+#include <linux/ctype.h>
+#include <linux/debugfs.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/pm_wakeup.h>
+#include <linux/seq_file.h>
+#include <linux/skbuff.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#include "mtk_ccci.h"
+
+#define MTK_CCCI_RX_BUDGET		64
+#define MTK_CCCI_POLL_BOOT_MS		20
+#define MTK_CCCI_POLL_READY_MS		200
+
+/*
+ * As the downstream port layer (a wakeup source per port, held HZ/2 for
+ * every packet): a packet from the modem keeps the system awake long
+ * enough for its reader to take it, also when it arrives while user space
+ * is deciding to suspend. 0: no wakeup event per packet (the old way:
+ * only the CCIF0 wake-up itself counts).
+ */
+static unsigned int rx_wake_ms = 500;
+module_param(rx_wake_ms, uint, 0644);
+MODULE_PARM_DESC(rx_wake_ms, "Wakeup event per received packet, ms (default 500, 0 = none)");
+
+static const char * const mtk_ccci_rx_ws_names[MTK_CCCI_WS_NUM] = {
+	[MTK_CCCI_WS_AT] = "ccci-at",
+	[MTK_CCCI_WS_MIPC] = "ccci-mipc",
+	[MTK_CCCI_WS_FS] = "ccci-fs",
+	[MTK_CCCI_WS_RPC] = "ccci-rpc",
+	[MTK_CCCI_WS_CTL] = "ccci-ctl",
+};
+
+static enum mtk_ccci_rx_ws mtk_ccci_rx_ws_of(u32 ch)
+{
+	if (ch == MTK_CCCI_CH_UART2_RX)
+		return MTK_CCCI_WS_AT;
+	if (ch >= MTK_CCCI_CH_MIPC0_RX && ch < MTK_CCCI_CH_MIPC0_RX + 20 &&
+	    !((ch - MTK_CCCI_CH_MIPC0_RX) & 1))
+		return MTK_CCCI_WS_MIPC;
+	if (ch == MTK_CCCI_CH_FS_RX)
+		return MTK_CCCI_WS_FS;
+	if (ch == MTK_CCCI_CH_RPC_RX)
+		return MTK_CCCI_WS_RPC;
+	return MTK_CCCI_WS_CTL;
+}
+
+/* MIPC: the message id is at byte 10 of the MIPC header (magic, ...) */
+#define MTK_CCCI_MIPC_MSG_ID_OFF	10
+
+/*
+ * The first packet after a CCIF0 wake-up says what the modem wanted, as the
+ * downstream CCIF driver logs it ("CCIF_MD wakeup source"): its channel
+ * and, for MIPC, the message id, for AT the result code prefix ("+CEREG"),
+ * never the parameters (numbers, cell ids).
+ */
+static void mtk_ccci_rx_wake_note(struct mtk_ccci *ccci, unsigned int qno,
+				  u32 ch, const struct sk_buff *skb)
+{
+	struct mtk_ccci_sleep *sl = &ccci->sleep;
+	const u8 *p = skb->data + sizeof(struct mtk_ccci_header);
+	unsigned int len = skb->len - sizeof(struct mtk_ccci_header);
+	unsigned int i, n = 0;
+
+	sl->wake_rx_ch = ch;
+	sl->wake_rx_q = qno;
+	switch (mtk_ccci_rx_ws_of(ch)) {
+	case MTK_CCCI_WS_MIPC:
+		if (len >= MTK_CCCI_MIPC_MSG_ID_OFF + 2)
+			snprintf(sl->wake_rx_what, sizeof(sl->wake_rx_what),
+				 "mipc msg %#06x",
+				 get_unaligned_le16(p + MTK_CCCI_MIPC_MSG_ID_OFF));
+		break;
+	case MTK_CCCI_WS_AT:
+		for (i = 0; i < len && (p[i] == '\r' || p[i] == '\n'); i++)
+			;
+		for (; i < len && n < sizeof(sl->wake_rx_what) - 1; i++) {
+			if (p[i] == ':' || p[i] == '\r' || p[i] == '\n' ||
+			    p[i] == ' ' || !isprint(p[i]))
+				break;
+			sl->wake_rx_what[n++] = p[i];
+		}
+		sl->wake_rx_what[n] = '\0';
+		break;
+	default:
+		snprintf(sl->wake_rx_what, sizeof(sl->wake_rx_what), "%s",
+			 mtk_ccci_rx_ws_names[mtk_ccci_rx_ws_of(ch)]);
+		break;
+	}
+	dev_info(ccci->dev, "woken by the modem: queue %u channel %u (%s) %s\n",
+		 qno, ch, mtk_ccci_rx_ws_names[mtk_ccci_rx_ws_of(ch)],
+		 sl->wake_rx_what);
+}
+
+static void mtk_ccci_rx_wake(struct mtk_ccci *ccci, unsigned int qno,
+			     const struct sk_buff *skb)
+{
+	const struct mtk_ccci_header *hdr = (const void *)skb->data;
+	unsigned int ms = READ_ONCE(rx_wake_ms);
+	u32 ch;
+
+	if (skb->len < sizeof(*hdr))
+		return;
+	ch = FIELD_GET(MTK_CCCI_H_CHANNEL, le32_to_cpu(hdr->status));
+	if (READ_ONCE(ccci->sleep.wake_pending)) {
+		WRITE_ONCE(ccci->sleep.wake_pending, false);
+		mtk_ccci_rx_wake_note(ccci, qno, ch, skb);
+	}
+	if (ms)
+		__pm_wakeup_event(ccci->rx_ws[mtk_ccci_rx_ws_of(ch)], ms);
+}
+
+struct sk_buff *mtk_ccci_alloc_skb(unsigned int len, gfp_t gfp)
+{
+	return alloc_skb(len, gfp);
+}
+
+/**
+ * mtk_ccci_send_skb() - queue a packet for the modem
+ * @ccci: driver state
+ * @qno: ring queue
+ * @skb: CCCI header (channel set) and payload; consumed on success only
+ *
+ * Return: 0, -EAGAIN if the queue is full, another negative error.
+ */
+int mtk_ccci_send_skb(struct mtk_ccci *ccci, unsigned int qno,
+		      struct sk_buff *skb)
+{
+	struct mtk_ccci_header *hdr = (void *)skb->data;
+	struct mtk_ccci_ring *ring;
+	unsigned long flags;
+	u32 status, ch;
+	bool assert = true;
+	int ret;
+
+	/* the MTU is payload: the header and the FS reserved word come on top */
+	if (qno >= MTK_CCCI_RINGQ_NUM || skb->len < sizeof(*hdr) ||
+	    skb->len > MTK_CCCI_MTU + sizeof(*hdr) + 4)
+		return -EINVAL;
+	if (!READ_ONCE(ccci->hif_on))
+		return -ENODEV;
+	ring = &ccci->ring[qno];
+	if (!ring->tx_len)
+		return -EINVAL;
+
+	ch = FIELD_GET(MTK_CCCI_H_CHANNEL, le32_to_cpu(hdr->status));
+	/* the RPC and FS servers are preemptible on the modem after HS2 */
+	if ((ch == MTK_CCCI_CH_RPC_TX || ch == MTK_CCCI_CH_FS_TX) &&
+	    READ_ONCE(ccci->state) != MTK_CCCI_FSM_WAIT_HS2)
+		assert = false;
+
+	spin_lock_irqsave(&ccci->tx_lock[qno], flags);
+	status = FIELD_PREP(MTK_CCCI_H_CHANNEL, ch);
+	if (ch < MTK_CCCI_CH_NUM) {
+		status |= FIELD_PREP(MTK_CCCI_H_SEQ, ccci->tx_seq[ch]);
+		if (assert)
+			status |= MTK_CCCI_H_ASSERT;
+	}
+	hdr->status = cpu_to_le32(status);
+
+	ret = mtk_ccci_ring_write(ring, skb->data, skb->len);
+	if (ret >= 0) {
+		if (ch < MTK_CCCI_CH_NUM)
+			ccci->tx_seq[ch] = (ccci->tx_seq[ch] + 1) &
+					   FIELD_MAX(MTK_CCCI_H_SEQ);
+		ccci->stats.tx[qno]++;
+	}
+	spin_unlock_irqrestore(&ccci->tx_lock[qno], flags);
+	if (ret < 0)
+		return ret == -ENOSPC ? -EAGAIN : ret;
+
+	/* busy: the modem has not taken the last one, it drains the ring */
+	mtk_ccci_ccif_notify(ccci, MTK_CCIF_CH_RINGQ(qno));
+	consume_skb(skb);
+	return 0;
+}
+
+/**
+ * mtk_ccci_send_msg() - send a header-only message
+ * @ccci: driver state
+ * @qno: ring queue
+ * @tx_ch: channel
+ * @msg: message id (data[1])
+ * @reserved: its argument
+ *
+ * The format of the vendor port_send_msg_to_md(): data[0] is the magic,
+ * data[1] the message, the reserved word its argument.
+ *
+ * Return: 0 or a negative error.
+ */
+int mtk_ccci_send_msg(struct mtk_ccci *ccci, unsigned int qno,
+		      unsigned int tx_ch, u32 msg, u32 reserved)
+{
+	struct mtk_ccci_header *hdr;
+	struct sk_buff *skb;
+	int ret;
+
+	skb = mtk_ccci_alloc_skb(sizeof(*hdr), GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+	hdr = skb_put(skb, sizeof(*hdr));
+	hdr->data[0] = cpu_to_le32(MTK_CCCI_MAGIC);
+	hdr->data[1] = cpu_to_le32(msg);
+	hdr->status = cpu_to_le32(tx_ch);
+	hdr->reserved = cpu_to_le32(reserved);
+
+	ret = mtk_ccci_send_skb(ccci, qno, skb);
+	if (ret)
+		kfree_skb(skb);
+	return ret;
+}
+
+/* the MediaTek downstream driver force-asserts the modem here; only count it */
+static void mtk_ccci_rx_check_seq(struct mtk_ccci *ccci,
+				  const struct mtk_ccci_header *hdr)
+{
+	u32 status = le32_to_cpu(hdr->status);
+	u32 ch = FIELD_GET(MTK_CCCI_H_CHANNEL, status);
+	u16 seq = FIELD_GET(MTK_CCCI_H_SEQ, status);
+
+	if (ch >= MTK_CCCI_CH_NUM)
+		return;
+	if ((status & MTK_CCCI_H_ASSERT) && ccci->rx_seq[ch] &&
+	    ((seq - ccci->rx_seq[ch]) & FIELD_MAX(MTK_CCCI_H_SEQ)) != 1) {
+		ccci->stats.seq_err++;
+		dev_warn_ratelimited(ccci->dev,
+				     "channel %u sequence %u after %u\n", ch,
+				     seq, ccci->rx_seq[ch]);
+	}
+	ccci->rx_seq[ch] = seq;
+}
+
+/*
+ * Hand a packet to its consumer.
+ * Return: 0 if taken (or dropped), -EBUSY to leave it in the ring. The
+ * skb belongs to the consumer either way.
+ */
+static int mtk_ccci_rx_dispatch(struct mtk_ccci *ccci, struct sk_buff *skb)
+{
+	const struct mtk_ccci_header *hdr = (const void *)skb->data;
+	u32 ch = FIELD_GET(MTK_CCCI_H_CHANNEL, le32_to_cpu(hdr->status));
+
+	switch (ch) {
+	case MTK_CCCI_CH_CONTROL_RX:
+		mtk_ccci_ctl_recv(ccci, skb);
+		return 0;
+	case MTK_CCCI_CH_SYSTEM_RX:
+		mtk_ccci_sys_recv(ccci, skb);
+		return 0;
+	case MTK_CCCI_CH_STATUS_RX:
+		mtk_ccci_status_recv(ccci, skb);
+		return 0;
+	case MTK_CCCI_CH_FS_RX:
+		ccci->stats.fs_rpc++;
+		return mtk_ccci_cdev_recv(&ccci->cdev_fs, skb);
+	case MTK_CCCI_CH_RPC_RX:
+		ccci->stats.fs_rpc++;
+		return mtk_ccci_rpc_recv(ccci, skb);
+	case MTK_CCCI_CH_PCM_RX:
+		return mtk_ccci_cdev_recv(&ccci->cdev_aud, skb);
+	case MTK_CCCI_CH_MD_DIRC_RX:
+		return mtk_ccci_cdev_recv(&ccci->cdev_dirc, skb);
+	}
+
+	if (!mtk_ccci_port_recv(ccci, skb))
+		return 0;
+
+	/* mtk_ccci_port_recv() consumed it */
+	ccci->stats.dropped++;
+	ccci->stats.last_drop_ch = ch;
+	dev_dbg_ratelimited(ccci->dev, "no consumer for channel %u\n", ch);
+	return 0;
+}
+
+/* drain one RX ring; true if there is more to do */
+static bool mtk_ccci_rx_queue(struct mtk_ccci *ccci, unsigned int qno)
+{
+	struct mtk_ccci_ring *ring = &ccci->ring[qno];
+	struct mtk_ccci_header hdr;
+	unsigned int budget = MTK_CCCI_RX_BUDGET;
+	struct sk_buff *skb;
+	int len, ret;
+
+	while (budget--) {
+		len = mtk_ccci_ring_readable(ring);
+		if (len == -EAGAIN)
+			return false;
+		if (len < 0) {
+			/* indices or magics the modem wrote make no sense */
+			ccci->stats.rx_err[qno]++;
+			dev_err_ratelimited(ccci->dev,
+					    "RX queue %u corrupted (%d)\n",
+					    qno, len);
+			return false;
+		}
+
+		skb = mtk_ccci_alloc_skb(len, GFP_KERNEL);
+		if (!skb)
+			return true;
+		ret = mtk_ccci_ring_peek(ring, skb_put(skb, len), len);
+		if (ret < 0) {
+			kfree_skb(skb);
+			ccci->stats.rx_err[qno]++;
+			return false;
+		}
+		memcpy(&hdr, skb->data, sizeof(hdr));
+		mtk_ccci_rx_wake(ccci, qno, skb);
+
+		ret = mtk_ccci_rx_dispatch(ccci, skb);
+		if (ret == -EBUSY) {
+			/* the consumer did not take it; retried on its read */
+			ccci->rxq_blocked |= BIT(qno);
+			return false;
+		}
+		mtk_ccci_rx_check_seq(ccci, &hdr);
+		mtk_ccci_ring_consume(ring, len);
+		ccci->stats.rx[qno]++;
+	}
+
+	return true;
+}
+
+static void mtk_ccci_rx_work(struct work_struct *work)
+{
+	struct mtk_ccci *ccci = container_of(work, struct mtk_ccci, rx_work);
+	bool again = false;
+	unsigned int qno;
+	u32 pending, rch;
+
+	if (!READ_ONCE(ccci->hif_on))
+		return;
+
+	pending = atomic_xchg(&ccci->ccif_pending, 0);
+	rch = mtk_ccci_ccif_pending(ccci);
+	if (rch) {
+		mtk_ccci_ccif_ack(ccci, rch);
+		pending |= rch;
+	}
+
+	if (pending & MTK_CCIF_EX_MASK)
+		mtk_ccci_ee_ccif(ccci, pending & MTK_CCIF_EX_MASK);
+
+	if (pending & BIT(MTK_CCIF_CH_SRAM)) {
+		/* the boot handshake: the FSM reads the SRAM itself */
+		WRITE_ONCE(ccci->hs1_pending, true);
+		wake_up_all(&ccci->hs_wq);
+	}
+
+	/* all queues: cheap, and nothing is lost to a missed interrupt */
+	ccci->rxq_blocked = 0;
+	for (qno = 0; qno < MTK_CCCI_RINGQ_NUM; qno++)
+		if (ccci->ring[qno].rx_len)
+			again |= mtk_ccci_rx_queue(ccci, qno);
+
+	/* a CCIF0 wake-up the modem sent no packet for: say so once */
+	if (READ_ONCE(ccci->sleep.wake_check)) {
+		WRITE_ONCE(ccci->sleep.wake_check, false);
+		if (READ_ONCE(ccci->sleep.wake_pending)) {
+			WRITE_ONCE(ccci->sleep.wake_pending, false);
+			dev_info(ccci->dev, "woken by the modem: no packet in the rings (CCIF channels %#x)\n",
+				 pending);
+		}
+	}
+
+	if (again)
+		queue_work(ccci->wq, &ccci->rx_work);
+}
+
+static void mtk_ccci_poll_work(struct work_struct *work)
+{
+	struct mtk_ccci *ccci = container_of(to_delayed_work(work),
+					     struct mtk_ccci, poll_work);
+	enum mtk_ccci_fsm_state state = READ_ONCE(ccci->state);
+	unsigned int ms;
+
+	if (!READ_ONCE(ccci->hif_on))
+		return;
+	ccci->stats.polls++;
+	queue_work(ccci->wq, &ccci->rx_work);
+
+	ms = state == MTK_CCCI_FSM_READY ? MTK_CCCI_POLL_READY_MS :
+					   MTK_CCCI_POLL_BOOT_MS;
+	queue_delayed_work(ccci->wq, &ccci->poll_work, msecs_to_jiffies(ms));
+}
+
+/* from interrupt context too */
+void mtk_ccci_hif_kick(struct mtk_ccci *ccci)
+{
+	if (READ_ONCE(ccci->hif_on))
+		queue_work(ccci->wq, &ccci->rx_work);
+}
+
+/**
+ * mtk_ccci_hif_start() - let packets flow, once the rings are laid out
+ * @ccci: driver state
+ */
+void mtk_ccci_hif_start(struct mtk_ccci *ccci)
+{
+	memset(ccci->tx_seq, 0, sizeof(ccci->tx_seq));
+	memset(ccci->rx_seq, 0, sizeof(ccci->rx_seq));
+	memset(&ccci->stats, 0, sizeof(ccci->stats));
+	atomic_set(&ccci->ccif_pending, 0);
+	ccci->rxq_blocked = 0;
+	WRITE_ONCE(ccci->hs1_pending, false);
+
+	WRITE_ONCE(ccci->hif_on, true);
+	queue_delayed_work(ccci->wq, &ccci->poll_work,
+			   msecs_to_jiffies(MTK_CCCI_POLL_BOOT_MS));
+}
+
+/**
+ * mtk_ccci_hif_stop() - stop the packet flow and drop what is queued
+ * @ccci: driver state
+ *
+ * Interrupts must be released already.
+ */
+void mtk_ccci_hif_stop(struct mtk_ccci *ccci)
+{
+	WRITE_ONCE(ccci->hif_on, false);
+	cancel_delayed_work_sync(&ccci->poll_work);
+	cancel_work_sync(&ccci->rx_work);
+	mtk_ccci_cdev_reset(ccci);
+}
+
+/**
+ * mtk_ccci_hif_suspend() - stop the poll timer for system sleep
+ * @ccci: driver state
+ *
+ * From suspend_noirq. The rings and CCIF stay as they are; the RX worker
+ * is not cancelled, a run in progress finishes before the CPUs go idle.
+ */
+void mtk_ccci_hif_suspend(struct mtk_ccci *ccci)
+{
+	if (!READ_ONCE(ccci->hif_on))
+		return;
+	cancel_delayed_work_sync(&ccci->poll_work);
+}
+
+/**
+ * mtk_ccci_hif_resume() - take what the modem sent while the AP slept
+ * @ccci: driver state
+ *
+ * From resume_noirq, after the wake source was read: the RX worker runs
+ * now (it acknowledges the pending CCIF channels itself, the interrupt
+ * that may still stand then finds nothing) and the poll timer is started
+ * again.
+ */
+void mtk_ccci_hif_resume(struct mtk_ccci *ccci)
+{
+	if (!READ_ONCE(ccci->hif_on))
+		return;
+	queue_work(ccci->wq, &ccci->rx_work);
+	queue_delayed_work(ccci->wq, &ccci->poll_work,
+			   msecs_to_jiffies(MTK_CCCI_POLL_BOOT_MS));
+}
+
+static int mtk_ccci_queues_show(struct seq_file *s, void *unused)
+{
+	struct mtk_ccci *ccci = s->private;
+	const struct mtk_ccci_stats *st = &ccci->stats;
+	unsigned int i;
+
+	seq_printf(s, "hif %s, irqs %lu, polls %lu, seq errors %lu, dropped %lu (last ch %u), fs+rpc %lu\n",
+		   ccci->hif_on ? "on" : "off", st->irqs, st->polls,
+		   st->seq_err, st->dropped, st->last_drop_ch, st->fs_rpc);
+	for (i = 0; i < MTK_CCCI_RINGQ_NUM; i++) {
+		const struct mtk_ccci_ring *r = &ccci->ring[i];
+
+		if (!r->rx_len && !r->tx_len)
+			continue;
+		seq_printf(s, "q%-2u rx %6lu (err %lu) tx %6lu", i, st->rx[i],
+			   st->rx_err[i], st->tx[i]);
+		if (ccci->hif_on)
+			seq_printf(s, "  rx r/w %#x/%#x tx r/w %#x/%#x",
+				   readl(r->ctl), readl(r->ctl + 4),
+				   readl(r->ctl + 12), readl(r->ctl + 16));
+		seq_puts(s, "\n");
+	}
+	mtk_ccci_cdev_debugfs(ccci, s);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_queues);
+
+void mtk_ccci_hif_debugfs_init(struct mtk_ccci *ccci)
+{
+	debugfs_create_file("queues", 0400, ccci->debugfs, ccci,
+			    &mtk_ccci_queues_fops);
+}
+
+static void mtk_ccci_hif_cleanup(void *data)
+{
+	struct mtk_ccci *ccci = data;
+
+	WRITE_ONCE(ccci->hif_on, false);
+	cancel_delayed_work_sync(&ccci->poll_work);
+	cancel_work_sync(&ccci->rx_work);
+	destroy_workqueue(ccci->wq);
+}
+
+static void mtk_ccci_rx_ws_cleanup(void *data)
+{
+	struct mtk_ccci *ccci = data;
+	unsigned int i;
+
+	for (i = 0; i < MTK_CCCI_WS_NUM; i++)
+		wakeup_source_unregister(ccci->rx_ws[i]);
+}
+
+int mtk_ccci_hif_init(struct mtk_ccci *ccci)
+{
+	unsigned int i;
+	int ret;
+
+	ccci->sleep.wake_rx_ch = MTK_CCCI_CH_NUM;
+	ccci->sleep.md_lp_state = -1;
+	ccci->sleep.md_asleep_at_suspend = -1;
+	for (i = 0; i < MTK_CCCI_WS_NUM; i++) {
+		ccci->rx_ws[i] = wakeup_source_register(ccci->dev,
+							mtk_ccci_rx_ws_names[i]);
+		if (!ccci->rx_ws[i]) {
+			while (i--)
+				wakeup_source_unregister(ccci->rx_ws[i]);
+			return -ENOMEM;
+		}
+	}
+	ret = devm_add_action_or_reset(ccci->dev, mtk_ccci_rx_ws_cleanup, ccci);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < MTK_CCCI_RINGQ_NUM; i++)
+		spin_lock_init(&ccci->tx_lock[i]);
+	spin_lock_init(&ccci->ccif_lock);
+	init_waitqueue_head(&ccci->hs_wq);
+	INIT_WORK(&ccci->rx_work, mtk_ccci_rx_work);
+	INIT_DELAYED_WORK(&ccci->poll_work, mtk_ccci_poll_work);
+
+	ccci->wq = alloc_ordered_workqueue("mtk_ccci",
+					   WQ_MEM_RECLAIM | WQ_HIGHPRI);
+	if (!ccci->wq)
+		return -ENOMEM;
+	return devm_add_action_or_reset(ccci->dev, mtk_ccci_hif_cleanup,
+					ccci);
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_lk.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_lk.c
new file mode 100644
index 000000000..52c4a4202
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_lk.c
@@ -0,0 +1,409 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: arguments the bootloader leaves for the modem driver.
+ *
+ * The stock LK loads and verifies the modem firmware, carves out the
+ * modem and shared memory, programs the EMI MPU and the modem address
+ * remapping, and describes all of it in a table of named "tags" in a
+ * reserved memory block. The location of that table is written into
+ * the "ccci,modem_info_v2" property of the modem node.
+ *
+ * Everything here only reads: the tag area is copied once and unmapped,
+ * nothing is written back (the MediaTek downstream driver clears the area for tag
+ * formats older than 3; LK on MT6878 uses format 3).
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/debugfs.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/overflow.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "mtk_ccci.h"
+
+static bool mtk_ccci_resv_contains(const struct resource *r, u64 base, u64 size)
+{
+	u64 end;
+
+	if (!r->end || check_add_overflow(base, size, &end))
+		return false;
+
+	return base >= r->start && end - 1 <= r->end;
+}
+
+static int mtk_ccci_lk_walk_tags(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_lk *lk = &ccci->lk;
+	u32 tag_num = le32_to_cpu(lk->info.tag_num);
+	u32 off = 0, i;
+
+	for (i = 0; i < tag_num; i++) {
+		const struct mtk_ccci_lk_tag *tag;
+		u32 data_off, data_size, next, end;
+
+		if (off > lk->tags_size - sizeof(*tag)) {
+			dev_err(ccci->dev, "LK tag %u out of bounds\n", i);
+			return -EINVAL;
+		}
+		tag = lk->tags + off;
+
+		if (!memchr(tag->name, '\0', sizeof(tag->name))) {
+			dev_err(ccci->dev, "LK tag %u has no name\n", i);
+			return -EINVAL;
+		}
+
+		data_off = le32_to_cpu(tag->data_offset);
+		data_size = le32_to_cpu(tag->data_size);
+		if (check_add_overflow(data_off, data_size, &end) ||
+		    end > lk->tags_size) {
+			dev_err(ccci->dev, "LK tag %s: data out of bounds\n",
+				tag->name);
+			return -EINVAL;
+		}
+
+		next = le32_to_cpu(tag->next_tag_offset);
+		if (i + 1 < tag_num && next <= off) {
+			dev_err(ccci->dev, "LK tag %s: bad next offset\n",
+				tag->name);
+			return -EINVAL;
+		}
+		off = next;
+	}
+
+	lk->tag_num = tag_num;
+	return 0;
+}
+
+/**
+ * mtk_ccci_lk_find() - look up an LK tag by name
+ * @ccci: driver state
+ * @name: tag name
+ * @size: returns the size of the tag data
+ *
+ * Return: the tag data (in the private copy of the tag area) or NULL.
+ */
+const void *mtk_ccci_lk_find(const struct mtk_ccci *ccci, const char *name,
+			     u32 *size)
+{
+	const struct mtk_ccci_lk *lk = &ccci->lk;
+	u32 off = 0, i;
+
+	for (i = 0; i < lk->tag_num; i++) {
+		const struct mtk_ccci_lk_tag *tag = lk->tags + off;
+
+		if (!strcmp(tag->name, name)) {
+			*size = le32_to_cpu(tag->data_size);
+			return lk->tags + le32_to_cpu(tag->data_offset);
+		}
+		off = le32_to_cpu(tag->next_tag_offset);
+	}
+
+	return NULL;
+}
+
+static int mtk_ccci_lk_find_u32(const struct mtk_ccci *ccci, const char *name,
+				u32 *val)
+{
+	const __le32 *p;
+	u32 size;
+
+	p = mtk_ccci_lk_find(ccci, name, &size);
+	if (!p || size < sizeof(*p))
+		return -ENOENT;
+
+	*val = le32_to_cpu(*p);
+	return 0;
+}
+
+static const struct mtk_ccci_smem_region *
+mtk_ccci_lk_smem_table(struct mtk_ccci *ccci, const char *name,
+		       const char *num_name, unsigned int *num)
+{
+	const struct mtk_ccci_smem_region *tbl;
+	u32 n, size;
+
+	*num = 0;
+	if (mtk_ccci_lk_find_u32(ccci, num_name, &n))
+		return NULL;
+
+	tbl = mtk_ccci_lk_find(ccci, name, &size);
+	if (!tbl || size < n * sizeof(*tbl)) {
+		dev_warn(ccci->dev, "LK tag %s: %u entries do not fit\n",
+			 name, n);
+		return NULL;
+	}
+
+	*num = n;
+	return tbl;
+}
+
+static bool mtk_ccci_lk_smem_is(const struct mtk_ccci_smem_region *r,
+				enum mtk_ccci_smem_id id)
+{
+	return le32_to_cpu(r->id) == id && le32_to_cpu(r->size) &&
+	       !(le32_to_cpu(r->flags) & MTK_CCCI_SMEM_F_PADDING);
+}
+
+/**
+ * mtk_ccci_lk_smem() - look up a shared memory region by SMEM user
+ * @ccci: driver state
+ * @id: SMEM user
+ *
+ * LK pads a region to its alignment with an entry carrying the same id and
+ * the padding flag (DRDI: 0x800 bytes before its 64 KiB); those are skipped.
+ *
+ * Return: the region from the non-cached or the cached table (both checked
+ * to lie inside their carveouts), or NULL if LK did not set it up.
+ */
+const struct mtk_ccci_smem_region *
+mtk_ccci_lk_smem(const struct mtk_ccci *ccci, enum mtk_ccci_smem_id id)
+{
+	const struct mtk_ccci_lk *lk = &ccci->lk;
+	unsigned int i;
+
+	for (i = 0; i < lk->nc_smem_num; i++)
+		if (mtk_ccci_lk_smem_is(&lk->nc_smem[i], id))
+			return &lk->nc_smem[i];
+	for (i = 0; i < lk->c_smem_num; i++)
+		if (mtk_ccci_lk_smem_is(&lk->c_smem[i], id))
+			return &lk->c_smem[i];
+
+	return NULL;
+}
+
+/* the address the modem sees a shared memory region at */
+u32 mtk_ccci_lk_smem_md_addr(const struct mtk_ccci_smem_region *r)
+{
+	return MTK_CCCI_SMEM_MD_VIEW_BASE + le32_to_cpu(r->md_offset);
+}
+
+/* every shared memory region LK describes must lie in its carveout */
+static int mtk_ccci_lk_check_smem(struct mtk_ccci *ccci, const char *what,
+				  const struct mtk_ccci_smem_region *tbl,
+				  unsigned int num, const struct resource *r)
+{
+	unsigned int i;
+
+	for (i = 0; i < num; i++) {
+		u64 base = le64_to_cpu(tbl[i].ap_phys);
+		u32 size = le32_to_cpu(tbl[i].size);
+
+		if (!size)
+			continue;
+		if (!mtk_ccci_resv_contains(r, base, size)) {
+			dev_err(ccci->dev,
+				"%s smem id %d [%#llx+%#x] outside %pR\n", what,
+				le32_to_cpu(tbl[i].id), base, size, r);
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+/**
+ * mtk_ccci_lk_parse() - read and check what LK passed for the modem
+ * @ccci: driver state, with the reserved memory regions filled in
+ *
+ * Return: 0 when LK loaded the modem and its description is consistent,
+ * -ENODEV when LK did not load a modem, another error otherwise.
+ */
+int mtk_ccci_lk_parse(struct mtk_ccci *ccci)
+{
+	const struct resource *tag_resv = &ccci->resv[MTK_CCCI_RESV_TAGS];
+	struct mtk_ccci_lk *lk = &ccci->lk;
+	struct device *dev = ccci->dev;
+	const void *prop;
+	void *map;
+	u64 base;
+	u32 size;
+	int len, ret;
+
+	prop = of_get_property(dev->of_node, "ccci,modem_info_v2", &len);
+	if (!prop || len < sizeof(lk->info)) {
+		dev_info(dev, "no modem arguments from the bootloader\n");
+		return -ENODEV;
+	}
+	memcpy(&lk->info, prop, sizeof(lk->info));
+
+	base = le64_to_cpu(lk->info.tags_base);
+	size = le32_to_cpu(lk->info.tags_size);
+	dev_info(dev,
+		 "LK: tags %#llx+%#x v%u n=%u ld_flag=%#x err=%d md_err=%d\n",
+		 base, size, le32_to_cpu(lk->info.version),
+		 le32_to_cpu(lk->info.tag_num), le32_to_cpu(lk->info.ld_flag),
+		 (s32)le32_to_cpu(lk->info.err_no),
+		 (s32)le32_to_cpu(lk->info.ld_md_errno));
+
+	if (!base || !(le32_to_cpu(lk->info.ld_flag) & MTK_CCCI_LK_LD_MD) ||
+	    lk->info.err_no || lk->info.ld_md_errno) {
+		dev_info(dev, "LK did not load the modem\n");
+		return -ENODEV;
+	}
+
+	if (le32_to_cpu(lk->info.version) < 2) {
+		dev_err(dev, "LK tag format %u not supported\n",
+			le32_to_cpu(lk->info.version));
+		return -EINVAL;
+	}
+
+	/* never map anything LK did not reserve for exactly this */
+	if (size < sizeof(struct mtk_ccci_lk_tag) ||
+	    size > MTK_CCCI_LK_TAGS_MAX_SIZE ||
+	    !mtk_ccci_resv_contains(tag_resv, base, size)) {
+		dev_err(dev, "LK tag area %#llx+%#x not in %pR\n", base, size,
+			tag_resv);
+		return -EINVAL;
+	}
+
+	/*
+	 * tags_size counts the bytes LK used; the MediaTek downstream driver maps the
+	 * whole 64 KiB window, so allow tag data anywhere in it as long as
+	 * it stays inside the carveout.
+	 */
+	size = min_t(u64, MTK_CCCI_LK_TAGS_MAX_SIZE, tag_resv->end - base + 1);
+
+	/* no-map carveout: memremap() falls back to ioremap_wc() */
+	map = memremap(base, size, MEMREMAP_WC);
+	if (!map)
+		return -ENOMEM;
+	lk->tags = devm_kmalloc(dev, size, GFP_KERNEL);
+	if (lk->tags)
+		memcpy(lk->tags, map, size);
+	memunmap(map);
+	if (!lk->tags)
+		return -ENOMEM;
+	lk->tags_size = size;
+
+	ret = mtk_ccci_lk_walk_tags(ccci);
+	if (ret)
+		return ret;
+
+	lk->md_mem = mtk_ccci_lk_find(ccci, "md_mem_layout", &size);
+	lk->md_mem_num = lk->md_mem ? size / sizeof(*lk->md_mem) : 0;
+
+	lk->nc_smem = mtk_ccci_lk_smem_table(ccci, "nc_smem_layout",
+					     "nc_smem_layout_num",
+					     &lk->nc_smem_num);
+	lk->c_smem = mtk_ccci_lk_smem_table(ccci, "c_smem_layout",
+					    "c_smem_layout_num",
+					    &lk->c_smem_num);
+	if (!lk->nc_smem || !lk->c_smem) {
+		dev_err(dev, "LK did not describe the shared memory\n");
+		return -EINVAL;
+	}
+
+	ret = mtk_ccci_lk_check_smem(ccci, "nc", lk->nc_smem, lk->nc_smem_num,
+				     &ccci->resv[MTK_CCCI_RESV_NC_SMEM]);
+	if (ret)
+		return ret;
+	ret = mtk_ccci_lk_check_smem(ccci, "c", lk->c_smem, lk->c_smem_num,
+				     &ccci->resv[MTK_CCCI_RESV_C_SMEM]);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "LK: %u tags, %u modem blocks, smem %u nc + %u c\n",
+		 lk->tag_num, lk->md_mem_num, lk->nc_smem_num, lk->c_smem_num);
+	return 0;
+}
+
+static int mtk_ccci_lk_tags_show(struct seq_file *s, void *unused)
+{
+	const struct mtk_ccci *ccci = s->private;
+	const struct mtk_ccci_lk *lk = &ccci->lk;
+	u32 off = 0, i;
+
+	for (i = 0; i < lk->tag_num; i++) {
+		const struct mtk_ccci_lk_tag *tag = lk->tags + off;
+		u32 size = le32_to_cpu(tag->data_size);
+		const u8 *data = lk->tags + le32_to_cpu(tag->data_offset);
+
+		seq_printf(s, "%-32s %5u %*ph\n", tag->name, size,
+			   (int)min(size, 16U), data);
+		off = le32_to_cpu(tag->next_tag_offset);
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_lk_tags);
+
+static void mtk_ccci_smem_show(struct seq_file *s, const char *what,
+			       const struct mtk_ccci_smem_region *tbl,
+			       unsigned int num)
+{
+	unsigned int i;
+
+	for (i = 0; i < num; i++)
+		seq_printf(s, "%-2s id %2d ap %#011llx md +%#09x size %#09x flags %#x\n",
+			   what, le32_to_cpu(tbl[i].id),
+			   le64_to_cpu(tbl[i].ap_phys),
+			   le32_to_cpu(tbl[i].md_offset),
+			   le32_to_cpu(tbl[i].size),
+			   le32_to_cpu(tbl[i].flags));
+}
+
+static int mtk_ccci_lk_layout_show(struct seq_file *s, void *unused)
+{
+	const struct mtk_ccci *ccci = s->private;
+	const struct mtk_ccci_lk *lk = &ccci->lk;
+	unsigned int i;
+
+	for (i = 0; i < lk->md_mem_num; i++)
+		seq_printf(s, "md ap %#011llx md %#010x size %#010x inf %#x attr %#x\n",
+			   le64_to_cpu(lk->md_mem[i].ap_phys),
+			   le32_to_cpu(lk->md_mem[i].md_offset),
+			   le32_to_cpu(lk->md_mem[i].size),
+			   le32_to_cpu(lk->md_mem[i].inf_flag),
+			   le32_to_cpu(lk->md_mem[i].attr_flag));
+	mtk_ccci_smem_show(s, "nc", lk->nc_smem, lk->nc_smem_num);
+	mtk_ccci_smem_show(s, "c", lk->c_smem, lk->c_smem_num);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_lk_layout);
+
+/* the CCB control area: per buffer the DL and UL headers both sides keep */
+static int mtk_ccci_ccb_ctrl_show(struct seq_file *s, void *unused)
+{
+	const struct mtk_ccci *ccci = s->private;
+	const struct mtk_ccci_smem_region *r;
+	u32 size, off, w[8];
+	void __iomem *p;
+	unsigned int i;
+
+	r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_CCB_CTRL);
+	if (!r)
+		return -ENODEV;
+	size = le32_to_cpu(r->size) & ~(sizeof(w) - 1);
+	p = ioremap_wc(le64_to_cpu(r->ap_phys), size);
+	if (!p)
+		return -ENOMEM;
+	for (off = 0; off < size; off += sizeof(w)) {
+		for (i = 0; i < ARRAY_SIZE(w); i++)
+			w[i] = readl(p + off + 4 * i);
+		if (!memchr_inv(w, 0, sizeof(w)))
+			continue;
+		seq_printf(s, "%04x: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			   off, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+	}
+	iounmap(p);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_ccb_ctrl);
+
+void mtk_ccci_lk_debugfs_init(struct mtk_ccci *ccci)
+{
+	debugfs_create_file("ccb_ctrl", 0400, ccci->debugfs, ccci,
+			    &mtk_ccci_ccb_ctrl_fops);
+	debugfs_create_file("lk_tags", 0400, ccci->debugfs, ccci,
+			    &mtk_ccci_lk_tags_fops);
+	debugfs_create_file("lk_layout", 0400, ccci->debugfs, ccci,
+			    &mtk_ccci_lk_layout_fops);
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_md.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_md.c
new file mode 100644
index 000000000..e543eceaf
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_md.c
@@ -0,0 +1,459 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: driver for the modem built into MediaTek smartphone SoCs
+ * (MT6878: modem generation 6299, CCIF control path + DPMAIF v3 data path).
+ *
+ * At probe the driver only finds out what the bootloader set up and
+ * checks it:
+ *  - the reserved memory LK carved out for the modem and the AP/modem
+ *    shared memory,
+ *  - the modem arguments LK left in its tag area,
+ *  - the CCIF0 windows, clocks, supplies (got, never switched).
+ *
+ * Probing does not power, clock, reset or start the modem, issues no
+ * TF-A calls, enables no interrupt (with data=1 the DPMAIF one is
+ * requested, disabled) and writes no register or shared memory. With
+ * ccif_regs=1 it reads CCIF0 to tell what state LK left the modem in.
+ * Restarting the modem the downstream way is a debugfs command, refused unless
+ * power_ctrl=1 and the DT describes everything it needs.
+ *
+ * System sleep (s2idle) works with the modem running, as on the downstream
+ * kernel: the modem keeps its network registration and wakes the AP for
+ * an incoming call, SMS or downlink data. The modem power domain is left
+ * alone by genpd because the device is a wakeup device in an active-wakeup
+ * domain; the CCIF, DPMAIF and watchdog interrupts are armed as wakeup
+ * interrupts; the FSM is locked for the duration. The per-block work is in
+ * mtk_ccci_ccif.c, mtk_ccci_hif.c and mtk_ccci_dpmaif.c.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/io.h>
+#include <linux/io-64-nonatomic-lo-hi.h>
+#include <linux/math64.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/seq_file.h>
+
+#include "mtk_ccci.h"
+
+static const char * const mtk_ccci_resv_compat[MTK_CCCI_RESV_NUM] = {
+	[MTK_CCCI_RESV_TAGS] = "mediatek,ccci_tag_mem",
+	[MTK_CCCI_RESV_NC_SMEM] = "mediatek,ap_md_nc_smem",
+	[MTK_CCCI_RESV_C_SMEM] = "mediatek,ap_md_c_smem",
+};
+
+/*
+ * LK creates the carveouts at boot ("/reserved-memory/mblock-N-<name>",
+ * no-map, no phandle), so they can only be found by compatible.
+ */
+static int mtk_ccci_find_resv(struct mtk_ccci *ccci)
+{
+	struct device_node *parent;
+	unsigned int i;
+	int ret = 0;
+
+	parent = of_find_node_by_path("/reserved-memory");
+	if (!parent)
+		return -ENODEV;
+
+	for_each_available_child_of_node_scoped(parent, np) {
+		struct resource r;
+
+		if (of_address_to_resource(np, 0, &r))
+			continue;
+
+		if (of_device_is_compatible(np, "mediatek,md_mem_usage")) {
+			if (ccci->md_mem_num < MTK_CCCI_MD_MEM_MAX)
+				ccci->md_mem[ccci->md_mem_num++] = r;
+			continue;
+		}
+
+		for (i = 0; i < MTK_CCCI_RESV_NUM; i++) {
+			if (!of_device_is_compatible(np, mtk_ccci_resv_compat[i]))
+				continue;
+			if (!of_property_read_bool(np, "no-map")) {
+				dev_err(ccci->dev, "%pOF is mapped\n", np);
+				ret = -EINVAL;
+			}
+			ccci->resv[i] = r;
+		}
+	}
+	of_node_put(parent);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < MTK_CCCI_RESV_NUM; i++) {
+		if (!ccci->resv[i].end) {
+			dev_info(ccci->dev, "no %s carveout\n",
+				 mtk_ccci_resv_compat[i]);
+			return -ENODEV;
+		}
+		dev_dbg(ccci->dev, "%s: %pR\n", mtk_ccci_resv_compat[i],
+			&ccci->resv[i]);
+	}
+	if (!ccci->md_mem_num) {
+		dev_info(ccci->dev, "no modem memory carveout\n");
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static int mtk_ccci_md_mem_show(struct seq_file *s, void *unused)
+{
+	const struct mtk_ccci *ccci = s->private;
+	unsigned int i;
+
+	for (i = 0; i < MTK_CCCI_RESV_NUM; i++)
+		seq_printf(s, "%-24s %pa+%#llx\n", mtk_ccci_resv_compat[i],
+			   &ccci->resv[i].start,
+			   (u64)resource_size(&ccci->resv[i]));
+	for (i = 0; i < ccci->md_mem_num; i++)
+		seq_printf(s, "%-24s %pa+%#llx\n", "mediatek,md_mem_usage",
+			   &ccci->md_mem[i].start,
+			   (u64)resource_size(&ccci->md_mem[i]));
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_md_mem);
+
+/*
+ * The modem's sleep record, which the downstream lpm debug logger reads
+ * before and after every system sleep ("md_slp_duration", struct
+ * md_sleep_status, at the factory device tree's md_low_power_addr = SMEM LOW_POWER):
+ *
+ *	0x000	u64 guard 0x536c702e (low word), record count (high word)
+ *	0x028	u64 total sleep, 32 kHz ticks
+ *	0x038	u64 sleep of MD, 2G, 3G, 4G, 5G FR1, us (5 words)
+ *	0x1f8	u64 record count (low word), guard (high word)
+ *
+ * The record is valid if both guards are there and both counts agree;
+ * the modem bumps the count when it updates the record.
+ */
+#define MTK_CCCI_MD_LP_SIZE		0x200
+#define MTK_CCCI_MD_LP_GUARD		0x536c702e
+#define MTK_CCCI_MD_LP_HEAD		0x000
+#define MTK_CCCI_MD_LP_SLEEP_32K	0x028
+#define MTK_CCCI_MD_LP_RAT_US		0x038
+#define MTK_CCCI_MD_LP_TAIL		0x1f8
+
+static void mtk_ccci_md_lp_init(struct mtk_ccci *ccci)
+{
+	const struct mtk_ccci_smem_region *r;
+
+	r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_LOW_POWER);
+	if (!r || le32_to_cpu(r->size) < MTK_CCCI_MD_LP_SIZE)
+		return;
+	ccci->sleep.md_lp = devm_ioremap_wc(ccci->dev, le64_to_cpu(r->ap_phys),
+					    MTK_CCCI_MD_LP_SIZE);
+	if (ccci->sleep.md_lp)
+		dev_info(ccci->dev, "modem sleep record (SMEM LOW_POWER) at %#llx\n",
+			 le64_to_cpu(r->ap_phys));
+}
+
+static void mtk_ccci_md_lp_read(struct mtk_ccci *ccci,
+				struct mtk_ccci_md_lp *lp)
+{
+	void __iomem *b = ccci->sleep.md_lp;
+	unsigned int i;
+	u64 head, tail;
+
+	memset(lp, 0, sizeof(*lp));
+	if (!b)
+		return;
+	head = readq(b + MTK_CCCI_MD_LP_HEAD);
+	tail = readq(b + MTK_CCCI_MD_LP_TAIL);
+	if (lower_32_bits(head) != MTK_CCCI_MD_LP_GUARD ||
+	    upper_32_bits(tail) != MTK_CCCI_MD_LP_GUARD ||
+	    upper_32_bits(head) != lower_32_bits(tail))
+		return;
+	lp->cnt = upper_32_bits(head);
+	lp->sleep_32k = readq(b + MTK_CCCI_MD_LP_SLEEP_32K);
+	for (i = 0; i < ARRAY_SIZE(lp->rat_us); i++)
+		lp->rat_us[i] = readq(b + MTK_CCCI_MD_LP_RAT_US + 8 * i);
+	lp->valid = true;
+}
+
+static u64 mtk_ccci_us_to_ms(u64 after, u64 before)
+{
+	return after >= before ? div_u64(after - before, 1000) : 0;
+}
+
+/* did the modem sleep while the AP slept? one line, as the downstream logger */
+static void mtk_ccci_md_lp_report(struct mtk_ccci *ccci)
+{
+	struct mtk_ccci_sleep *sl = &ccci->sleep;
+	const struct mtk_ccci_md_lp *b = &sl->md_lp_before;
+	struct mtk_ccci_md_lp a;
+	u64 ms[ARRAY_SIZE(a.rat_us)];
+	unsigned int i;
+
+	mtk_ccci_md_lp_read(ccci, &a);
+	sl->md_lp_slept_ms = 0;
+	if (!b->valid || !a.valid) {
+		sl->md_lp_state = -1;
+		if (sl->md_lp)
+			dev_info(ccci->dev, "modem sleep record not valid\n");
+		return;
+	}
+	if (a.cnt == b->cnt) {
+		/* nothing completed: awake all the time, or still asleep */
+		sl->md_lp_state = 0;
+		dev_info(ccci->dev, "modem sleep record not updated in the AP sleep (count %u)\n",
+			 a.cnt);
+		return;
+	}
+	sl->md_lp_state = 1;
+	sl->md_lp_slept_ms = a.sleep_32k >= b->sleep_32k ?
+			     div_u64((a.sleep_32k - b->sleep_32k) * 1000, 32768) : 0;
+	for (i = 0; i < ARRAY_SIZE(ms); i++)
+		ms[i] = mtk_ccci_us_to_ms(a.rat_us[i], b->rat_us[i]);
+	dev_info(ccci->dev, "modem slept %llu ms in the AP sleep (MD/2G/3G/4G/5G %llu/%llu/%llu/%llu/%llu ms, %u updates)\n",
+		 sl->md_lp_slept_ms, ms[0], ms[1], ms[2], ms[3], ms[4],
+		 a.cnt - b->cnt);
+}
+
+static int mtk_ccci_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mtk_ccci *ccci;
+	int ret;
+
+	ccci = devm_kzalloc(dev, sizeof(*ccci), GFP_KERNEL);
+	if (!ccci)
+		return -ENOMEM;
+	ccci->dev = dev;
+	platform_set_drvdata(pdev, ccci);
+
+	ret = mtk_ccci_find_resv(ccci);
+	if (ret)
+		return dev_err_probe(dev, ret, "modem memory not reserved\n");
+
+	ret = mtk_ccci_lk_parse(ccci);
+	if (ret)
+		return dev_err_probe(dev, ret, "no usable modem setup from LK\n");
+
+	ret = mtk_ccci_ccif_init(ccci);
+	if (ret)
+		return ret;
+
+	ret = mtk_ccci_hif_init(ccci);
+	if (ret)
+		return ret;
+
+	ret = mtk_ccci_fsm_init(ccci);
+	if (ret)
+		return ret;
+
+	ret = mtk_ccci_port_init(ccci);
+	if (ret)
+		return ret;
+
+	ret = mtk_ccci_cdev_init(ccci);
+	if (ret)
+		return ret;
+
+	ret = mtk_ccci_ee_init(ccci);
+	if (ret)
+		return ret;
+
+	/* only with data=1; allocates, set up only with the modem start */
+	ret = mtk_ccci_dpmaif_init(ccci);
+	if (ret)
+		return ret;
+
+	mtk_ccci_md_lp_init(ccci);
+
+	/*
+	 * The modem wakes the AP from system sleep. Being a wakeup device
+	 * also puts this device on the wakeup path in suspend, which keeps
+	 * genpd from switching the modem power domain (GENPD_FLAG_ACTIVE_WAKEUP
+	 * on the MD domain): off behind the running modem, or on again after
+	 * a stop. Userspace can turn it off in power/wakeup; suspend is then
+	 * refused while the domain is attached, see mtk_ccci_prepare().
+	 */
+	ret = devm_device_init_wakeup(dev);
+	if (ret)
+		return ret;
+
+	ccci->debugfs = debugfs_create_dir(dev_name(dev), NULL);
+	debugfs_create_file("md_mem", 0400, ccci->debugfs, ccci,
+			    &mtk_ccci_md_mem_fops);
+	mtk_ccci_lk_debugfs_init(ccci);
+	mtk_ccci_ccif_debugfs_init(ccci);
+	mtk_ccci_fsm_debugfs_init(ccci);
+	mtk_ccci_hif_debugfs_init(ccci);
+	mtk_ccci_port_debugfs_init(ccci);
+	mtk_ccci_ee_debugfs_init(ccci);
+	mtk_ccci_dpmaif_debugfs_init(ccci);
+
+	/* only with ccif_regs=1: reads, logs what LK left */
+	mtk_ccci_ccif_log_state(ccci);
+
+	dev_info(dev, "modem set up by LK, left alone\n");
+	return 0;
+}
+
+static void mtk_ccci_remove(struct platform_device *pdev)
+{
+	struct mtk_ccci *ccci = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(ccci->debugfs);
+}
+
+/*
+ * System sleep, modelled on the downstream kernel, which keeps the modem running
+ * and never touches the MTCMOS in suspend:
+ *
+ *  prepare       the FSM is locked, no command switches the modem until
+ *                complete; refused if the device may not wake the system
+ *                (genpd would then switch the domain, see below)
+ *  suspend       nothing; the PM core puts the device on the wakeup path
+ *                because it may wake the system, so genpd's noirq callbacks
+ *                leave the modem power domain as it is (active wakeup)
+ *  suspend_late  the CCIF, watchdog and DPMAIF interrupts become wakeup
+ *                interrupts; DPMAIF transmit is held
+ *  suspend_noirq what is in flight is logged (CCIF channels both ways,
+ *                unread rings, the modem asleep or not, the wake IRQs) and
+ *                the modem's sleep record read; the CCIF poll timer
+ *                stops; DPMAIF backs up its DL mask
+ *  resume_noirq  how long the modem slept; TF-A is asked whether CCIF0 or
+ *                the DPMAIF woke the AP, and the CCIF0 channels raised in
+ *                the sleep are logged even if TF-A does not say so;
+ *                DPMAIF restores its masks if its PD block lost power;
+ *                the RX worker takes what arrived and names the first
+ *                packet
+ *  resume_early  wakeup interrupts disarmed
+ *  resume        DPMAIF transmit resumes
+ *
+ * With the modem stopped or never started nothing but the lock happens:
+ * the domain, off (or LK's, which genpd sees as off), stays as it is.
+ */
+static int mtk_ccci_prepare(struct device *dev)
+{
+	struct mtk_ccci *ccci = dev_get_drvdata(dev);
+
+	if (!mutex_trylock(&ccci->fsm_lock)) {
+		dev_warn(dev, "modem command in progress, not suspending\n");
+		return -EBUSY;
+	}
+	if (ccci->md_domain && !device_may_wakeup(dev)) {
+		dev_warn(dev, "wakeup disabled: genpd would switch the modem power domain, not suspending\n");
+		mutex_unlock(&ccci->fsm_lock);
+		return -EBUSY;
+	}
+	return 0;
+}
+
+static void mtk_ccci_complete(struct device *dev)
+{
+	struct mtk_ccci *ccci = dev_get_drvdata(dev);
+
+	mutex_unlock(&ccci->fsm_lock);
+}
+
+static int mtk_ccci_suspend(struct device *dev)
+{
+	struct mtk_ccci *ccci = dev_get_drvdata(dev);
+
+	dev_info(dev, "suspending, modem %s%s\n",
+		 mtk_ccci_fsm_state_name(ccci->state),
+		 ccci->md_domain_held ? " (power domain held)" : "");
+	return 0;
+}
+
+static int mtk_ccci_suspend_late(struct device *dev)
+{
+	struct mtk_ccci *ccci = dev_get_drvdata(dev);
+
+	mtk_ccci_irq_wake(ccci, true);
+	mtk_ccci_dpmaif_suspend_late(ccci);
+	return 0;
+}
+
+static int mtk_ccci_suspend_noirq(struct device *dev)
+{
+	struct mtk_ccci *ccci = dev_get_drvdata(dev);
+
+	if (READ_ONCE(ccci->hif_on)) {
+		ccci->sleep.suspends++;
+		mtk_ccci_md_lp_read(ccci, &ccci->sleep.md_lp_before);
+		mtk_ccci_ccif_suspend_noirq(ccci);
+	}
+	mtk_ccci_hif_suspend(ccci);
+	mtk_ccci_dpmaif_suspend_noirq(ccci);
+	return 0;
+}
+
+static int mtk_ccci_resume_noirq(struct device *dev)
+{
+	struct mtk_ccci *ccci = dev_get_drvdata(dev);
+
+	if (READ_ONCE(ccci->hif_on))
+		mtk_ccci_md_lp_report(ccci);
+	mtk_ccci_ccif_resume_noirq(ccci);
+	mtk_ccci_dpmaif_resume_noirq(ccci);
+	mtk_ccci_hif_resume(ccci);
+	return 0;
+}
+
+static int mtk_ccci_resume_early(struct device *dev)
+{
+	struct mtk_ccci *ccci = dev_get_drvdata(dev);
+
+	mtk_ccci_dpmaif_resume_early(ccci);
+	mtk_ccci_irq_wake(ccci, false);
+	return 0;
+}
+
+static int mtk_ccci_resume(struct device *dev)
+{
+	struct mtk_ccci *ccci = dev_get_drvdata(dev);
+
+	mtk_ccci_dpmaif_resume(ccci);
+	dev_info(dev, "resumed, modem %s%s\n",
+		 mtk_ccci_fsm_state_name(ccci->state),
+		 READ_ONCE(ccci->exception) ? ", EXCEPTION flagged" : "");
+	return 0;
+}
+
+static const struct dev_pm_ops mtk_ccci_pm_ops = {
+	.prepare = mtk_ccci_prepare,
+	.complete = mtk_ccci_complete,
+	.suspend = mtk_ccci_suspend,
+	.resume = mtk_ccci_resume,
+	.suspend_late = mtk_ccci_suspend_late,
+	.resume_early = mtk_ccci_resume_early,
+	.suspend_noirq = mtk_ccci_suspend_noirq,
+	.resume_noirq = mtk_ccci_resume_noirq,
+};
+
+static const struct of_device_id mtk_ccci_of_match[] = {
+	{ .compatible = "mediatek,mt6878-ccci" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_ccci_of_match);
+
+static struct platform_driver mtk_ccci_driver = {
+	.probe = mtk_ccci_probe,
+	.remove = mtk_ccci_remove,
+	.driver = {
+		.name = "mtk-ccci-md",
+		.of_match_table = mtk_ccci_of_match,
+		.pm = pm_sleep_ptr(&mtk_ccci_pm_ops),
+		/* unbinding could power the modem off, see mtk_ccci_fsm_init() */
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(mtk_ccci_driver);
+
+MODULE_DESCRIPTION("MediaTek CCCI driver for SoC-integrated modems");
+MODULE_LICENSE("GPL");
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_net.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_net.c
new file mode 100644
index 000000000..27963f199
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_net.c
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: WWAN network devices (downstream ccmni0..20).
+ *
+ * As t7xx: the WWAN core creates the links ("ip link add wwan0-N link
+ * wwan0 type wwan linkid N"), link id N is the CCMNI index the modem tags
+ * packets with (message PIT on receive, message DRB on transmit). Raw IP,
+ * no link layer: the IP version is the first nibble of the packet. The
+ * packets go through DPMAIF (mtk_ccci_dpmaif.c); the links are kept by
+ * CCMNI index for its receive path.
+ *
+ * Copyright (C) 2021 Intel Corporation (t7xx ccmni)
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/if_arp.h>
+#include <linux/netdevice.h>
+#include <linux/rtnetlink.h>
+#include <linux/skbuff.h>
+#include <linux/wwan.h>
+
+#include "mtk_ccci.h"
+
+/* what the runtime data tells the modem (AP_CCMNI_MTU) */
+#define MTK_CCCI_NET_MTU_MAX	0xdf0
+
+struct mtk_ccci_net {
+	struct mtk_ccci *ccci;
+	u32 link_id;
+};
+
+static int mtk_ccci_net_open(struct net_device *dev)
+{
+	netif_start_queue(dev);
+	return 0;
+}
+
+static int mtk_ccci_net_stop(struct net_device *dev)
+{
+	netif_stop_queue(dev);
+	return 0;
+}
+
+static netdev_tx_t mtk_ccci_net_xmit(struct sk_buff *skb,
+				     struct net_device *dev)
+{
+	struct mtk_ccci_net *net = wwan_netdev_drvpriv(dev);
+	u8 ver = skb->len ? skb->data[0] >> 4 : 0;
+
+	if (ver != 4 && ver != 6) {
+		dev->stats.tx_dropped++;
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+	return mtk_ccci_dpmaif_xmit(net->ccci, dev, skb, net->link_id);
+}
+
+static const struct net_device_ops mtk_ccci_net_ops = {
+	.ndo_open = mtk_ccci_net_open,
+	.ndo_stop = mtk_ccci_net_stop,
+	.ndo_start_xmit = mtk_ccci_net_xmit,
+};
+
+static void mtk_ccci_net_setup(struct net_device *dev)
+{
+	dev->mtu = ETH_DATA_LEN;
+	dev->min_mtu = ETH_MIN_MTU;
+	dev->max_mtu = MTK_CCCI_NET_MTU_MAX;
+	dev->hard_header_len = 0;
+	dev->addr_len = 0;
+	dev->tx_queue_len = 1000;
+	dev->flags = IFF_POINTOPOINT | IFF_NOARP;
+	dev->type = ARPHRD_NONE;
+	/* the hardware checks the received IP/TCP/UDP checksums */
+	dev->features = NETIF_F_RXCSUM;
+	dev->hw_features = NETIF_F_RXCSUM;
+	dev->pcpu_stat_type = NETDEV_PCPU_STAT_TSTATS;
+	dev->needs_free_netdev = true;
+	dev->netdev_ops = &mtk_ccci_net_ops;
+}
+
+static int mtk_ccci_net_newlink(void *ctxt, struct net_device *dev,
+				u32 if_id, struct netlink_ext_ack *extack)
+{
+	struct mtk_ccci_net *net = wwan_netdev_drvpriv(dev);
+	struct mtk_ccci *ccci = ctxt;
+	int ret;
+
+	if (if_id >= MTK_CCCI_NET_LINKS) {
+		NL_SET_ERR_MSG(extack, "link id is the CCMNI index, 0..20");
+		return -EINVAL;
+	}
+	if (rtnl_dereference(ccci->net_link[if_id]))
+		return -EBUSY;
+	net->ccci = ccci;
+	net->link_id = if_id;
+	ret = register_netdevice(dev);
+	if (ret)
+		return ret;
+	rcu_assign_pointer(ccci->net_link[if_id], dev);
+	return 0;
+}
+
+/* unregistering waits for an RCU grace period before the device goes */
+static void mtk_ccci_net_dellink(void *ctxt, struct net_device *dev,
+				 struct list_head *head)
+{
+	struct mtk_ccci_net *net = wwan_netdev_drvpriv(dev);
+	struct mtk_ccci *ccci = ctxt;
+
+	RCU_INIT_POINTER(ccci->net_link[net->link_id], NULL);
+	unregister_netdevice_queue(dev, head);
+}
+
+static const struct wwan_ops mtk_ccci_wwan_net_ops = {
+	.priv_size = sizeof(struct mtk_ccci_net),
+	.setup = mtk_ccci_net_setup,
+	.newlink = mtk_ccci_net_newlink,
+	.dellink = mtk_ccci_net_dellink,
+};
+
+static void mtk_ccci_net_cleanup(void *data)
+{
+	struct mtk_ccci *ccci = data;
+
+	wwan_unregister_ops(ccci->dev);
+}
+
+/* only with DPMAIF set up (data=1) */
+int mtk_ccci_net_init(struct mtk_ccci *ccci)
+{
+	int ret;
+
+	ret = wwan_register_ops(ccci->dev, &mtk_ccci_wwan_net_ops, ccci,
+				WWAN_NO_DEFAULT_LINK);
+	if (ret)
+		return ret;
+	return devm_add_action_or_reset(ccci->dev, mtk_ccci_net_cleanup, ccci);
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_port.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_port.c
new file mode 100644
index 000000000..09f76ac4a
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_port.c
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: control ports exported as WWAN ports.
+ *
+ * A port is a pair of logical channels on one CCIF ring queue. The AT
+ * port (stock /dev/ttyC0) and the ten MIPC ports (stock /dev/ttyCMIPC*)
+ * become WWAN_PORT_AT and WWAN_PORT_MIPC character devices, as the t7xx
+ * driver does for its MIPC port. Queue numbers follow the port
+ * table of the MediaTek downstream driver (port_cfg.c).
+ *
+ * Nothing is registered yet: the ports are created only once the FSM
+ * reaches READY, which needs the runtime data step that does not exist
+ * yet, and only with the module parameter wwan_ports=1.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2021 Intel Corporation (t7xx port layout)
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/bitfield.h>
+#include <linux/debugfs.h>
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/seq_file.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+#include <linux/wwan.h>
+
+#include "mtk_ccci.h"
+
+static bool wwan_ports = true;
+module_param(wwan_ports, bool, 0444);
+MODULE_PARM_DESC(wwan_ports, "create the AT/MIPC WWAN ports once the modem is ready");
+
+/* the modem accepts at most this per packet on the control queues */
+#define MTK_CCCI_PORT_MTU	3456
+
+struct mtk_ccci_port_conf {
+	const char *name;
+	u16 tx_ch;
+	u16 rx_ch;
+	u8 txq;
+	u8 rxq;
+	enum wwan_port_type type;
+};
+
+#define MIPC_PORT(n) {						\
+	.name = "mipc" #n,					\
+	.tx_ch = MTK_CCCI_CH_MIPC0_TX + 2 * (n),		\
+	.rx_ch = MTK_CCCI_CH_MIPC0_RX + 2 * (n),		\
+	.txq = MTK_CCCI_Q_AT, .rxq = MTK_CCCI_Q_AT,		\
+	.type = WWAN_PORT_MIPC,					\
+}
+
+static const struct mtk_ccci_port_conf mtk_ccci_port_confs[] = {
+	{
+		.name = "at",
+		.tx_ch = MTK_CCCI_CH_UART2_TX,
+		.rx_ch = MTK_CCCI_CH_UART2_RX,
+		.txq = MTK_CCCI_Q_AT, .rxq = MTK_CCCI_Q_AT,
+		.type = WWAN_PORT_AT,
+	},
+	MIPC_PORT(0), MIPC_PORT(1), MIPC_PORT(2), MIPC_PORT(3),
+	MIPC_PORT(4), MIPC_PORT(5), MIPC_PORT(6), MIPC_PORT(7),
+	MIPC_PORT(8), MIPC_PORT(9),
+};
+
+static int mtk_ccci_port_send(struct mtk_ccci_port *port, struct sk_buff *skb)
+{
+	struct mtk_ccci *ccci = port->ccci;
+	struct mtk_ccci_header *hdr;
+	int ret;
+
+	if (READ_ONCE(ccci->state) != MTK_CCCI_FSM_READY)
+		return -ENODEV;
+	if (skb_cow_head(skb, sizeof(*hdr)))
+		return -ENOMEM;
+
+	hdr = skb_push(skb, sizeof(*hdr));
+	hdr->data[0] = 0;
+	hdr->data[1] = cpu_to_le32(skb->len);
+	/* sequence number and check bit: mtk_ccci_send_skb() */
+	hdr->status = cpu_to_le32(port->conf->tx_ch);
+	hdr->reserved = 0;
+
+	ret = mtk_ccci_send_skb(ccci, port->conf->txq, skb);
+	if (ret)
+		skb_pull(skb, sizeof(*hdr));
+	return ret;
+}
+
+static int mtk_ccci_wwan_start(struct wwan_port *wport)
+{
+	return 0;
+}
+
+static void mtk_ccci_wwan_stop(struct wwan_port *wport)
+{
+}
+
+static int mtk_ccci_wwan_tx(struct wwan_port *wport, struct sk_buff *skb)
+{
+	struct mtk_ccci_port *port = wwan_port_get_drvdata(wport);
+
+	if (skb->len > MTK_CCCI_PORT_MTU - sizeof(struct mtk_ccci_header))
+		return -EMSGSIZE;
+	return mtk_ccci_port_send(port, skb);
+}
+
+static const struct wwan_port_ops mtk_ccci_wwan_ops = {
+	.start = mtk_ccci_wwan_start,
+	.stop = mtk_ccci_wwan_stop,
+	.tx = mtk_ccci_wwan_tx,
+};
+
+/**
+ * mtk_ccci_port_recv() - hand a modem packet to its port
+ * @ccci: driver state
+ * @skb: CCCI header and payload; consumed
+ *
+ * Return: 0, or -ENOENT if no WWAN port takes the channel.
+ */
+int mtk_ccci_port_recv(struct mtk_ccci *ccci, struct sk_buff *skb)
+{
+	const struct mtk_ccci_header *hdr = (const void *)skb->data;
+	unsigned int i, ch;
+
+	if (skb->len < sizeof(*hdr))
+		goto drop;
+	ch = FIELD_GET(MTK_CCCI_H_CHANNEL, le32_to_cpu(hdr->status));
+
+	for (i = 0; i < ccci->num_ports; i++) {
+		struct mtk_ccci_port *port = &ccci->ports[i];
+
+		if (port->conf->rx_ch != ch)
+			continue;
+		if (!port->wwan)
+			break;
+		skb_pull(skb, sizeof(*hdr));
+		wwan_port_rx(port->wwan, skb);
+		return 0;
+	}
+drop:
+	dev_kfree_skb_any(skb);
+	return -ENOENT;
+}
+
+/* create the WWAN ports; the FSM calls this on READY */
+int mtk_ccci_port_register(struct mtk_ccci *ccci)
+{
+	struct wwan_port_caps caps = {
+		.frag_len = MTK_CCCI_PORT_MTU - sizeof(struct mtk_ccci_header),
+		.headroom_len = sizeof(struct mtk_ccci_header),
+	};
+	unsigned int i;
+
+	if (!wwan_ports || ccci->ports_registered)
+		return 0;
+
+	for (i = 0; i < ccci->num_ports; i++) {
+		struct mtk_ccci_port *port = &ccci->ports[i];
+		struct wwan_port *wport;
+
+		wport = wwan_create_port(ccci->dev, port->conf->type,
+					 &mtk_ccci_wwan_ops, &caps, port);
+		if (IS_ERR(wport)) {
+			dev_err(ccci->dev, "WWAN port %s: %pe\n",
+				port->conf->name, wport);
+			continue;
+		}
+		port->wwan = wport;
+	}
+	ccci->ports_registered = true;
+	return 0;
+}
+
+void mtk_ccci_port_unregister(struct mtk_ccci *ccci)
+{
+	unsigned int i;
+
+	for (i = 0; i < ccci->num_ports; i++) {
+		if (!ccci->ports[i].wwan)
+			continue;
+		wwan_remove_port(ccci->ports[i].wwan);
+		ccci->ports[i].wwan = NULL;
+	}
+	ccci->ports_registered = false;
+}
+
+static int mtk_ccci_ports_show(struct seq_file *s, void *unused)
+{
+	struct mtk_ccci *ccci = s->private;
+	unsigned int i;
+
+	for (i = 0; i < ccci->num_ports; i++) {
+		const struct mtk_ccci_port *port = &ccci->ports[i];
+
+		seq_printf(s, "%-6s tx ch %3u q%u rx ch %3u q%u %s\n",
+			   port->conf->name, port->conf->tx_ch,
+			   port->conf->txq, port->conf->rx_ch,
+			   port->conf->rxq,
+			   port->wwan ? "registered" : "-");
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mtk_ccci_ports);
+
+void mtk_ccci_port_debugfs_init(struct mtk_ccci *ccci)
+{
+	debugfs_create_file("ports", 0400, ccci->debugfs, ccci,
+			    &mtk_ccci_ports_fops);
+}
+
+static void mtk_ccci_port_cleanup(void *data)
+{
+	mtk_ccci_port_unregister(data);
+}
+
+int mtk_ccci_port_init(struct mtk_ccci *ccci)
+{
+	unsigned int i, n = ARRAY_SIZE(mtk_ccci_port_confs);
+
+	ccci->ports = devm_kcalloc(ccci->dev, n, sizeof(*ccci->ports),
+				   GFP_KERNEL);
+	if (!ccci->ports)
+		return -ENOMEM;
+
+	for (i = 0; i < n; i++) {
+		ccci->ports[i].ccci = ccci;
+		ccci->ports[i].conf = &mtk_ccci_port_confs[i];
+	}
+	ccci->num_ports = n;
+
+	return devm_add_action_or_reset(ccci->dev, mtk_ccci_port_cleanup,
+					ccci);
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_ring.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_ring.c
new file mode 100644
index 000000000..a23a5691c
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_ring.c
@@ -0,0 +1,387 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: ring buffer queues in the CCISM shared memory.
+ *
+ * The AP lays out 16 queues back to back. Each one is
+ *
+ *	u32 0xee0000ee, 0xee0000ee
+ *	u32 rx_read, rx_write, rx_length	(modem -> AP)
+ *	u32 tx_read, tx_write, tx_length	(AP -> modem)
+ *	u8  rx_buffer[rx_length]
+ *	u8  tx_buffer[tx_length]
+ *	u32 0xff0000ff, 0xff0000ff
+ *
+ * and a packet in a buffer is
+ *
+ *	u32 0xaabbaabb, u32 len, u8 data[len] padded to 8, u32 0xccddeeff x2
+ *
+ * The writer owns the write index, the reader the read index; offsets
+ * wrap at the buffer length and are kept 8-byte aligned. One byte is
+ * always left free so that read == write means empty.
+ *
+ * The queue sizes are the MediaTek downstream driver's for modem generations from
+ * 6298 on; the modem only finds the queues through the layout, so they
+ * must match what it expects.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/align.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/sizes.h>
+
+#include "mtk_ccci.h"
+
+#define RB_CTL_MAGIC		0xee0000ee
+#define RB_END_MAGIC		0xff0000ff
+#define PKT_HEAD_MAGIC		0xaabbaabb
+#define PKT_TAIL_MAGIC		0xccddeeff
+
+#define RB_CTL_LEN		(8 + 24 + 8)
+#define PKT_OVERHEAD		16	/* head magic + length + tail */
+
+/* control words, from the start of the queue + 8 */
+#define RB_RX_READ		0x00
+#define RB_RX_WRITE		0x04
+#define RB_RX_LEN		0x08
+#define RB_TX_READ		0x0c
+#define RB_TX_WRITE		0x10
+#define RB_TX_LEN		0x14
+
+static const u32 mtk_ccci_rx_size[MTK_CCCI_RINGQ_NUM] = {
+	80 * SZ_1K, 80 * SZ_1K, 40 * SZ_1K, 80 * SZ_1K,
+	20 * SZ_1K, 20 * SZ_1K, 48 * SZ_1K, 0,
+	8 * SZ_1K, 16 * SZ_1K,
+};
+
+static const u32 mtk_ccci_tx_size[MTK_CCCI_RINGQ_NUM] = {
+	128 * SZ_1K, 40 * SZ_1K, 8 * SZ_1K, 40 * SZ_1K,
+	20 * SZ_1K, 20 * SZ_1K, 48 * SZ_1K, 0,
+	8 * SZ_1K, 16 * SZ_1K,
+};
+
+/* the queues the modem switches to on an exception (CCISM_MCU_EXP) */
+static const u32 mtk_ccci_exp_size[MTK_CCCI_RINGQ_NUM] = {
+	12 * SZ_1K, 32 * SZ_1K, 8 * SZ_1K, 0, 0, 0, 8 * SZ_1K,
+};
+
+static int mtk_ccci_rings_layout(struct mtk_ccci *ccci, const char *what,
+				 struct mtk_ccci_ring *ring, void __iomem *base,
+				 u32 size, const u32 *rx_size,
+				 const u32 *tx_size)
+{
+	u32 off = 0, total = 0;
+	unsigned int i;
+
+	for (i = 0; i < MTK_CCCI_RINGQ_NUM; i++)
+		total += RB_CTL_LEN + rx_size[i] + tx_size[i];
+	if (total > size) {
+		dev_err(ccci->dev, "%s %#x too small for the queues (%#x)\n",
+			what, size, total);
+		return -ENOSPC;
+	}
+
+	/* the MediaTek downstream driver clears the whole region */
+	memset_io(base, 0, size);
+	for (i = 0; i < MTK_CCCI_RINGQ_NUM; i++) {
+		struct mtk_ccci_ring *r = &ring[i];
+		u32 len = RB_CTL_LEN + rx_size[i] + tx_size[i];
+		void __iomem *q = base + off;
+
+		writel(RB_CTL_MAGIC, q);
+		writel(RB_CTL_MAGIC, q + 4);
+		writel(RB_END_MAGIC, q + len - 8);
+		writel(RB_END_MAGIC, q + len - 4);
+
+		r->ctl = q + 8;
+		r->rx_len = rx_size[i];
+		r->tx_len = tx_size[i];
+		r->rx_buf = r->ctl + 24;
+		r->tx_buf = r->rx_buf + r->rx_len;
+		writel(r->rx_len, r->ctl + RB_RX_LEN);
+		writel(r->tx_len, r->ctl + RB_TX_LEN);
+
+		off += len;
+	}
+
+	return total;
+}
+
+/**
+ * mtk_ccci_rings_init() - lay out empty queues
+ * @ccci: driver state, ring[] is filled in and ccism_size set to what the
+ *	queues use (the MediaTek downstream driver reports that, not the region size, to
+ *	the modem in the runtime data)
+ * @base: mapping of the CCISM_MCU region
+ * @size: its size
+ *
+ * Return: 0, or -ENOSPC if the region is too small.
+ */
+int mtk_ccci_rings_init(struct mtk_ccci *ccci, void __iomem *base, u32 size)
+{
+	int ret;
+
+	ret = mtk_ccci_rings_layout(ccci, "CCISM", ccci->ring, base, size,
+				    mtk_ccci_rx_size, mtk_ccci_tx_size);
+	if (ret < 0)
+		return ret;
+	ccci->ccism_size = ret;
+	return 0;
+}
+
+/**
+ * mtk_ccci_rings_exp_init() - lay out the exception queues
+ * @ccci: driver state, ring_exp[] is filled in
+ * @base: mapping of the CCISM_MCU_EXP region
+ * @size: its size
+ *
+ * The same queue format, with each queue sharing one buffer size both
+ * ways. The driver does not switch to them (no exception handshake yet),
+ * but the modem is told where they are and expects them laid out.
+ *
+ * Return: 0, or -ENOSPC if the region is too small.
+ */
+int mtk_ccci_rings_exp_init(struct mtk_ccci *ccci, void __iomem *base,
+			    u32 size)
+{
+	int ret;
+
+	ret = mtk_ccci_rings_layout(ccci, "CCISM_EXP", ccci->ring_exp, base,
+				    size, mtk_ccci_exp_size,
+				    mtk_ccci_exp_size);
+	return ret < 0 ? ret : 0;
+}
+
+static void mtk_ccci_ring_copy_from(void *dst, const void __iomem *buf,
+				    u32 len, u32 pos, u32 n)
+{
+	u32 first = min(n, len - pos);
+
+	memcpy_fromio(dst, buf + pos, first);
+	if (n > first)
+		memcpy_fromio(dst + first, buf, n - first);
+}
+
+static void mtk_ccci_ring_copy_to(void __iomem *buf, u32 len, u32 pos,
+				  const void *src, u32 n)
+{
+	u32 first = min(n, len - pos);
+
+	memcpy_toio(buf + pos, src, first);
+	if (n > first)
+		memcpy_toio(buf, src + first, n - first);
+}
+
+/* the indices come from memory the modem writes: check before use */
+static int mtk_ccci_ring_rx_idx(const struct mtk_ccci_ring *r, u32 *rd,
+				u32 *wr)
+{
+	*rd = readl(r->ctl + RB_RX_READ);
+	*wr = readl(r->ctl + RB_RX_WRITE);
+	if (!r->rx_len || *rd >= r->rx_len || *rd & 7)
+		return -EIO;
+	/* the write index is the modem's: see mtk_ccci_ring_write() */
+	if (*wr == r->rx_len)
+		*wr = 0;
+	if (*wr > r->rx_len) {
+		pr_warn_ratelimited("mtk_ccci: RX write index %#x of %#x\n",
+				    *wr, r->rx_len);
+		return -EIO;
+	}
+	return 0;
+}
+
+/**
+ * mtk_ccci_ring_readable() - length of the next modem packet
+ * @ring: queue
+ *
+ * Return: the packet length (CCCI header included), -EAGAIN if the queue
+ * is empty or the packet not complete, -EIO if the queue is corrupted.
+ */
+int mtk_ccci_ring_readable(const struct mtk_ccci_ring *ring)
+{
+	u32 rd, wr, used, len, frame, pos;
+	__le32 w[2];
+
+	if (mtk_ccci_ring_rx_idx(ring, &rd, &wr))
+		return -EIO;
+
+	used = wr >= rd ? wr - rd : wr + ring->rx_len - rd;
+	if (used < PKT_OVERHEAD + sizeof(struct mtk_ccci_header))
+		return -EAGAIN;
+
+	mtk_ccci_ring_copy_from(w, ring->rx_buf, ring->rx_len, rd, 8);
+	if (le32_to_cpu(w[0]) != PKT_HEAD_MAGIC)
+		return -EIO;
+	len = le32_to_cpu(w[1]);
+	if (len < sizeof(struct mtk_ccci_header) || len > ring->rx_len)
+		return -EIO;
+
+	frame = ALIGN(len + PKT_OVERHEAD, 8);
+	if (frame > used)
+		return -EAGAIN;
+
+	pos = (rd + frame - 8) % ring->rx_len;
+	mtk_ccci_ring_copy_from(w, ring->rx_buf, ring->rx_len, pos, 8);
+	if (le32_to_cpu(w[0]) != PKT_TAIL_MAGIC ||
+	    le32_to_cpu(w[1]) != PKT_TAIL_MAGIC)
+		return -EIO;
+
+	return len;
+}
+
+/* an index of the peer may stand at the very end instead of at 0 */
+static bool mtk_ccci_ring_idx_differ(u32 a, u32 b, u32 len)
+{
+	return (a == len ? 0 : a) != (b == len ? 0 : b);
+}
+
+/**
+ * mtk_ccci_rings_pending() - which queues hold data their reader has not taken
+ * @ccci: driver state, rings set up
+ * @rx: bit q: queue q has modem data the AP has not read
+ * @tx: bit q: queue q has AP data the modem has not read
+ *
+ * Only the indices are compared, nothing is checked or consumed: for the
+ * log at system sleep.
+ */
+void mtk_ccci_rings_pending(struct mtk_ccci *ccci, u32 *rx, u32 *tx)
+{
+	unsigned int q;
+
+	*rx = 0;
+	*tx = 0;
+	for (q = 0; q < MTK_CCCI_RINGQ_NUM; q++) {
+		const struct mtk_ccci_ring *r = &ccci->ring[q];
+
+		if (!r->ctl)
+			continue;
+		if (r->rx_len &&
+		    mtk_ccci_ring_idx_differ(readl(r->ctl + RB_RX_READ),
+					     readl(r->ctl + RB_RX_WRITE),
+					     r->rx_len))
+			*rx |= BIT(q);
+		if (r->tx_len &&
+		    mtk_ccci_ring_idx_differ(readl(r->ctl + RB_TX_READ),
+					     readl(r->ctl + RB_TX_WRITE),
+					     r->tx_len))
+			*tx |= BIT(q);
+	}
+}
+
+/**
+ * mtk_ccci_ring_peek() - copy the next modem packet, leave it queued
+ * @ring: queue
+ * @buf: destination
+ * @len: from mtk_ccci_ring_readable()
+ *
+ * Return: @len, or a negative error.
+ */
+int mtk_ccci_ring_peek(const struct mtk_ccci_ring *ring, void *buf, u32 len)
+{
+	u32 rd, wr;
+
+	if (mtk_ccci_ring_rx_idx(ring, &rd, &wr))
+		return -EIO;
+
+	mtk_ccci_ring_copy_from(buf, ring->rx_buf, ring->rx_len,
+				(rd + 8) % ring->rx_len, len);
+	return len;
+}
+
+/**
+ * mtk_ccci_ring_consume() - drop the next modem packet from the queue
+ * @ring: queue
+ * @len: from mtk_ccci_ring_readable(), after mtk_ccci_ring_peek()
+ */
+void mtk_ccci_ring_consume(struct mtk_ccci_ring *ring, u32 len)
+{
+	u32 rd, wr;
+
+	if (mtk_ccci_ring_rx_idx(ring, &rd, &wr))
+		return;
+
+	rd = (rd + ALIGN(len + PKT_OVERHEAD, 8)) % ring->rx_len;
+	/* the data is copied out before the modem may reuse the space */
+	mb();
+	writel(rd, ring->ctl + RB_RX_READ);
+}
+
+/**
+ * mtk_ccci_ring_read() - take the next modem packet
+ * @ring: queue
+ * @buf: destination
+ * @len: from mtk_ccci_ring_readable()
+ *
+ * Return: @len, or a negative error.
+ */
+int mtk_ccci_ring_read(struct mtk_ccci_ring *ring, void *buf, u32 len)
+{
+	int ret = mtk_ccci_ring_peek(ring, buf, len);
+
+	if (ret >= 0)
+		mtk_ccci_ring_consume(ring, len);
+	return ret;
+}
+
+/**
+ * mtk_ccci_ring_write() - queue a packet for the modem
+ * @ring: queue
+ * @data: CCCI header and payload
+ * @len: its length
+ *
+ * The caller then raises the queue's CCIF channel.
+ *
+ * Return: @len, -ENOSPC if the queue is full, another negative error.
+ */
+int mtk_ccci_ring_write(struct mtk_ccci_ring *ring, const void *data,
+			u32 len)
+{
+	static const __le32 tail[2] = {
+		cpu_to_le32(PKT_TAIL_MAGIC), cpu_to_le32(PKT_TAIL_MAGIC),
+	};
+	u32 rd, wr, free, frame, pad;
+	__le32 head[2];
+
+	if (!ring->tx_len || !len)
+		return -EINVAL;
+	rd = readl(ring->ctl + RB_TX_READ);
+	wr = readl(ring->ctl + RB_TX_WRITE);
+	/*
+	 * The read index is the modem's: it may stand at the very end
+	 * instead of 0, and while the modem takes a packet it is not on a
+	 * packet boundary. The downstream driver checks neither; only an
+	 * index beyond the ring is not usable, and that one only for now.
+	 */
+	if (wr >= ring->tx_len || wr & 7)
+		return -EIO;
+	if (rd == ring->tx_len)
+		rd = 0;
+	if (rd > ring->tx_len) {
+		pr_warn_ratelimited("mtk_ccci: TX read index %#x of %#x\n",
+				    rd, ring->tx_len);
+		return -ENOSPC;
+	}
+
+	frame = ALIGN(len + PKT_OVERHEAD, 8);
+	free = rd > wr ? rd - wr - 1 : ring->tx_len - wr + rd - 1;
+	if (frame >= free)
+		return -ENOSPC;
+
+	head[0] = cpu_to_le32(PKT_HEAD_MAGIC);
+	head[1] = cpu_to_le32(len);
+	mtk_ccci_ring_copy_to(ring->tx_buf, ring->tx_len, wr, head, 8);
+	mtk_ccci_ring_copy_to(ring->tx_buf, ring->tx_len,
+			      (wr + 8) % ring->tx_len, data, len);
+	/* the padding is left as it is, as the MediaTek downstream driver does */
+	pad = ALIGN(len, 8) - len;
+	mtk_ccci_ring_copy_to(ring->tx_buf, ring->tx_len,
+			      (wr + 8 + len + pad) % ring->tx_len, tail, 8);
+
+	/* the packet must be complete before the modem sees the index */
+	wmb();
+	writel((wr + frame) % ring->tx_len, ring->ctl + RB_TX_WRITE);
+	return len;
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_rpc.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_rpc.c
new file mode 100644
index 000000000..887f4b5f4
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_rpc.c
@@ -0,0 +1,704 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: the kernel side of the modem's remote procedure calls.
+ *
+ * Between the runtime data and HS2 the modem asks the AP for board
+ * facts over the RPC channels (queue 1): which pins its SIM and band
+ * detection lines are on, their levels, a board ADC reading, and
+ * attributes LK put into the device tree.
+ * A request is
+ *
+ *	CCCI header, u32 op, u32 count, count x { u32 len, data, pad to 4 }
+ *
+ * and the answer has the same layout with op | 0xffff0000 and the slot
+ * (header reserved word) kept. Handled here, as the stock in-kernel RPC
+ * port does:
+ *
+ *  - 0x4002 GET_GPIO_NUM: modem pin number for a pin name, from the
+ *    board's "mediatek,md-gpio-names"/"mediatek,md-gpios";
+ *  - 0x4005 GET_EINT_ATTR: one attribute of a SIM hot plug interrupt,
+ *    from the board's "mediatek,md-sim-eints";
+ *  - 0x4009 GET_GPIO_ADC: pin numbers and levels for up to 3 (10 in the
+ *    second version) pin names, and the board ADC ("mediatek,md-adc");
+ *  - 0x400E DTSI_QUERY: a u32 property of the "mediatek,md_attr_node"
+ *    node LK creates;
+ *  - 0x400D CCCI_LHIF_MAPPING: once the modem is up, and again when it
+ *    activates a PDN, it tells which DPMAIF UL queue a CCMNI sends on
+ *    (its "logical HIF" queue); the downstream driver records the queue and
+ *    answers 0, and the modem repeats the request until it does;
+ *  - 0x4016 RF_ECID_DATA: the RF chips' ECIDs; the downstream driver only
+ *    acknowledges them.
+ *
+ * The four operations the kernel does not answer itself
+ * (system property, SAR table, DRDI copy, crystal calibration) go to
+ * /dev/ccci_rpc unchanged, the answer comes back the same way. Every
+ * other operation is answered "no such operation", the downstream answer to
+ * an unknown one.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio/driver.h>
+#include <linux/of.h>
+#include <linux/skbuff.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "mtk_ccci.h"
+
+#define RPC_GET_GPIO_NUM	0x4002
+#define RPC_GET_EINT_ATTR	0x4005
+#define RPC_GET_GPIO_ADC	0x4009
+#define RPC_LHIF_MAPPING	0x400d
+#define RPC_DTSI_QUERY		0x400e
+#define RPC_RF_ECID_DATA	0x4016
+/* served by userspace */
+#define RPC_QUERY_AP_SYS_PROP	0x400f
+#define RPC_SAR_TABLE_IDX	0x4010
+#define RPC_AMMS_DRDI_CONTROL	0x4014
+#define RPC_SAVE_MD_CAPID	0x4015
+#define RPC_RESP		0xffff0000
+
+#define RPC_MAX_ARGS		6
+#define RPC_MAX_BUF		2048	/* request, header included */
+#define RPC_SLOTS		2	/* concurrent requests */
+#define RPC_HDR_LEN		(sizeof(struct mtk_ccci_header) + 8)
+
+/* return codes of the modem's FS/RPC API */
+#define RPC_NO_OP		-1
+#define RPC_PARAM_ERROR		-2
+#define RPC_FUNC_FAIL		-5
+
+/* GET_EINT_ATTR: attributes per SIM, errors */
+#define RPC_EINT_ATTRS		7	/* eint, debounce, polarity, ... */
+#define RPC_EINT_SIMS		4
+#define RPC_EINT_BAD_TYPE	-12
+#define RPC_EINT_BAD_NAME	-11
+
+/* DTSI_QUERY */
+#define RPC_REQ_PROP_VALUE	1
+#define RPC_DTSI_NAME_LEN	64
+
+struct mtk_ccci_rpc_dtsi_in {
+	u8 req;
+	u8 index;
+	char name[RPC_DTSI_NAME_LEN];
+} __packed;
+
+struct mtk_ccci_rpc_dtsi_out {
+	__le32 value;
+	char str[RPC_DTSI_NAME_LEN];
+} __packed;
+
+/* GET_GPIO_ADC: what to look up (reqMask) */
+#define RPC_REQ_GPIO_PIN	BIT(0)
+#define RPC_REQ_GPIO_VALUE	BIT(1)
+#define RPC_REQ_ADC_PIN		BIT(4)
+#define RPC_REQ_ADC_VALUE	BIT(5)
+
+#define RPC_GPIO_NAME_LEN	34
+#define RPC_ADC_NAME_LEN	33
+#define RPC_GPIO_ADC_PINS_V1	3
+#define RPC_GPIO_ADC_PINS_V2	10
+
+/*
+ * The two versions differ in the number of pins and the width of the
+ * two masks only; the modem tells them apart by size.
+ */
+#define DEFINE_RPC_GPIO_ADC(_v, _mask_t, _pins)				\
+struct mtk_ccci_rpc_gpio_adc_in_##_v {					\
+	_mask_t req;							\
+	_mask_t valid_pins;						\
+	char pin_name[_pins][RPC_GPIO_NAME_LEN];			\
+	__le32 pin[_pins];						\
+	char adc_name[RPC_ADC_NAME_LEN];				\
+	__le32 adc_ch;							\
+	__le32 adc_count;						\
+} __packed;								\
+struct mtk_ccci_rpc_gpio_adc_out_##_v {					\
+	__le32 pin[_pins];						\
+	__le32 level[_pins];						\
+	__le32 adc_ch;							\
+	__le32 adc_sum;							\
+} __packed
+
+DEFINE_RPC_GPIO_ADC(v1, u8, RPC_GPIO_ADC_PINS_V1);
+DEFINE_RPC_GPIO_ADC(v2, __le16, RPC_GPIO_ADC_PINS_V2);
+static_assert(sizeof(struct mtk_ccci_rpc_gpio_adc_in_v1) == 157);
+static_assert(sizeof(struct mtk_ccci_rpc_gpio_adc_in_v2) == 425);
+static_assert(sizeof(struct mtk_ccci_rpc_gpio_adc_out_v2) == 88);
+
+#define RPC_REPLY_MAX		sizeof(struct mtk_ccci_rpc_gpio_adc_out_v2)
+static_assert(RPC_REPLY_MAX >= sizeof(struct mtk_ccci_rpc_dtsi_out));
+
+struct mtk_ccci_rpc_arg {
+	u32 len;
+	const void *buf;
+};
+
+/* CCCI_LHIF_MAPPING: the modem's logical HIF queues */
+enum {
+	RPC_LHIF_HWQ_SW_DL,
+	RPC_LHIF_HWQ_SW_UL,
+	RPC_LHIF_HWQ_AP_UL_Q0,		/* DPMAIF UL queue 0: data */
+	RPC_LHIF_HWQ_AP_UL_Q1,		/* DPMAIF UL queue 3: IMS */
+	RPC_LHIF_HWQ_DIRECT_DL,
+};
+
+struct mtk_ccci_rpc_lhif_map {
+	__le32 net_if;			/* CCMNI index */
+	__le32 lhif_q;
+} __packed;
+
+struct mtk_ccci_rpc_reply {
+	unsigned int num;
+	struct {
+		u32 len;
+		u8 data[RPC_REPLY_MAX];
+	} arg[2];
+};
+
+static void rpc_reply_u32(struct mtk_ccci_rpc_reply *r, s32 v)
+{
+	r->arg[r->num].len = 4;
+	put_unaligned_le32(v, r->arg[r->num].data);
+	r->num++;
+}
+
+/*
+ * The pin behind a modem pin name: "mediatek,md-gpios" holds a specifier
+ * per name in "mediatek,md-gpio-names". The modem numbers the pins as
+ * the GPIO controller does.
+ */
+static int mtk_ccci_rpc_gpio_spec(struct mtk_ccci *ccci, const char *name,
+				  u32 len, struct of_phandle_args *spec)
+{
+	struct device_node *np = ccci->dev->of_node;
+	const char *dt_name;
+	int i, n;
+
+	len = strnlen(name, len);
+	n = of_property_count_strings(np, "mediatek,md-gpio-names");
+	for (i = 0; i < n; i++) {
+		if (of_property_read_string_index(np, "mediatek,md-gpio-names",
+						  i, &dt_name))
+			break;
+		if (strlen(dt_name) != len || memcmp(dt_name, name, len))
+			continue;
+		return of_parse_phandle_with_args(np, "mediatek,md-gpios",
+						  "#gpio-cells", i, spec);
+	}
+	return -ENOENT;
+}
+
+static int mtk_ccci_rpc_gpio_pin(struct mtk_ccci *ccci, const char *name,
+				 u32 len, u32 *pin)
+{
+	struct of_phandle_args spec;
+	int ret;
+
+	ret = mtk_ccci_rpc_gpio_spec(ccci, name, len, &spec);
+	if (ret)
+		return ret;
+	of_node_put(spec.np);
+	if (spec.args_count < 1)
+		return -EINVAL;
+	*pin = spec.args[0];
+	return 0;
+}
+
+/*
+ * The level of a pin. The pin is read, not requested: requesting it
+ * would switch it to its GPIO function, and the SIM lines among these
+ * must stay with the modem. Reading the input level does not touch the
+ * pin setup.
+ */
+static int mtk_ccci_rpc_gpio_level(struct mtk_ccci *ccci, u32 pin)
+{
+	struct device_node *np = ccci->dev->of_node;
+	struct of_phandle_args spec;
+	struct gpio_device *gdev;
+	struct gpio_desc *desc;
+	int ret;
+
+	/* all md-gpios are on one controller: take the first one's */
+	ret = of_parse_phandle_with_args(np, "mediatek,md-gpios",
+					 "#gpio-cells", 0, &spec);
+	if (ret)
+		return ret;
+	gdev = gpio_device_find_by_fwnode(of_fwnode_handle(spec.np));
+	of_node_put(spec.np);
+	if (!gdev)
+		return -EPROBE_DEFER;
+	desc = gpio_device_get_desc(gdev, pin);
+	ret = IS_ERR(desc) ? PTR_ERR(desc) :
+			     gpiod_get_raw_value_cansleep(desc);
+	gpio_device_put(gdev);
+	return ret;
+}
+
+static void mtk_ccci_rpc_gpio_num(struct mtk_ccci *ccci,
+				  const struct mtk_ccci_rpc_arg *arg,
+				  unsigned int num,
+				  struct mtk_ccci_rpc_reply *r)
+{
+	s32 val;
+	u32 pin;
+
+	if (num < 2 || !arg[0].len) {
+		val = RPC_PARAM_ERROR;
+	} else if (mtk_ccci_rpc_gpio_pin(ccci, arg[0].buf, arg[0].len, &pin)) {
+		dev_info(ccci->dev, "RPC: no modem pin for %.*s\n",
+			 (int)strnlen(arg[0].buf, arg[0].len), (char *)arg[0].buf);
+		val = RPC_FUNC_FAIL;
+	} else {
+		dev_info(ccci->dev, "RPC: %.*s is modem pin %u\n",
+			 (int)strnlen(arg[0].buf, arg[0].len),
+			 (char *)arg[0].buf, pin);
+		val = pin;
+	}
+	/* the stock answer carries the result twice */
+	rpc_reply_u32(r, val);
+	rpc_reply_u32(r, val);
+}
+
+/*
+ * The SIM a hot plug interrupt name stands for: the modem asks for
+ * "MD1_SIM<n>_HOT_PLUG_EINT" (the factory device tree node is named with
+ * dashes, which the downstream driver accepts too). Returns 0-based, or -1.
+ */
+static int mtk_ccci_rpc_eint_sim(const char *name, u32 len)
+{
+	char want[24];
+	int sim;
+
+	len = strnlen(name, len);
+	for (sim = 0; sim < RPC_EINT_SIMS; sim++) {
+		snprintf(want, sizeof(want), "MD1_SIM%d_HOT_PLUG_EINT", sim + 1);
+		if (len == strlen(want) && !memcmp(name, want, len))
+			return sim;
+		strreplace(want, '_', '-');
+		if (len == strlen(want) && !memcmp(name, want, len))
+			return sim;
+	}
+	return -1;
+}
+
+/*
+ * "mediatek,md-sim-eints" has one row per SIM of RPC_EINT_ATTRS values
+ * in the modem's order and units: interrupt number, debounce (ms),
+ * polarity (1 high), sensitivity (1 edge), socket type, dedicated, source
+ * pin. A negative value means "not set".
+ */
+static void mtk_ccci_rpc_eint_attr(struct mtk_ccci *ccci,
+				   const struct mtk_ccci_rpc_arg *arg,
+				   unsigned int num,
+				   struct mtk_ccci_rpc_reply *r)
+{
+	u32 type, val;
+	s32 ret;
+	int sim;
+
+	if (num < 3 || !arg[0].len || arg[2].len < 4) {
+		rpc_reply_u32(r, RPC_PARAM_ERROR);
+		rpc_reply_u32(r, RPC_PARAM_ERROR);
+		return;
+	}
+	type = get_unaligned_le32(arg[2].buf);
+	sim = mtk_ccci_rpc_eint_sim(arg[0].buf, arg[0].len);
+	if (type >= RPC_EINT_ATTRS)
+		ret = RPC_EINT_BAD_TYPE;
+	else if (sim < 0 ||
+		 of_property_read_u32_index(ccci->dev->of_node,
+					    "mediatek,md-sim-eints",
+					    sim * RPC_EINT_ATTRS + type, &val) ||
+		 (s32)val < 0)
+		ret = RPC_EINT_BAD_NAME;
+	else
+		ret = 0;
+	dev_info(ccci->dev, "RPC: EINT %.*s attribute %u -> %d%s\n",
+		 (int)strnlen(arg[0].buf, arg[0].len), (char *)arg[0].buf,
+		 type, ret ? ret : (s32)val, ret ? " (error)" : "");
+	rpc_reply_u32(r, ret);
+	if (ret)
+		rpc_reply_u32(r, ret);
+	else
+		rpc_reply_u32(r, val);
+}
+
+/* a GET_GPIO_ADC request of either version, and the answer to it */
+struct mtk_ccci_rpc_gpio_adc {
+	unsigned int pins;
+	u16 req;
+	u16 valid;
+	const char (*name)[RPC_GPIO_NAME_LEN];
+	u32 pin_in[RPC_GPIO_ADC_PINS_V2];
+	u32 adc_count;
+	/* answer, 0x0f bytes where nothing was found (as the downstream driver) */
+	u32 pin[RPC_GPIO_ADC_PINS_V2];
+	u32 level[RPC_GPIO_ADC_PINS_V2];
+	u32 adc_ch;
+	u32 adc_sum;
+};
+
+/*
+ * The board ADC: "mediatek,md-adc" = <channel raw>, the channel number
+ * the modem is told and one raw reading, as the downstream driver takes once
+ * at boot and repeats for every sample the modem asks for.
+ */
+static int mtk_ccci_rpc_adc(struct mtk_ccci *ccci, u32 *ch, u32 *raw)
+{
+	struct device_node *np = ccci->dev->of_node;
+	int ret;
+
+	ret = of_property_read_u32_index(np, "mediatek,md-adc", 0, ch);
+	if (!ret)
+		ret = of_property_read_u32_index(np, "mediatek,md-adc", 1, raw);
+	return ret;
+}
+
+static void mtk_ccci_rpc_gpio_adc_do(struct mtk_ccci *ccci,
+				     struct mtk_ccci_rpc_gpio_adc *g)
+{
+	bool want_pin = g->req & RPC_REQ_GPIO_PIN;
+	bool want_level = g->req & RPC_REQ_GPIO_VALUE;
+	unsigned int i;
+	u32 ch, raw, pin;
+	int level;
+
+	memset(g->pin, 0xf, sizeof(g->pin));
+	memset(g->level, 0xf, sizeof(g->level));
+	memset(&g->adc_ch, 0xf, sizeof(g->adc_ch));
+	memset(&g->adc_sum, 0xf, sizeof(g->adc_sum));
+
+	for (i = 0; i < g->pins; i++) {
+		if (!(g->valid & BIT(i)))
+			continue;
+		if (want_pin) {
+			/* by name; with both bits, the level of that pin */
+			if (mtk_ccci_rpc_gpio_pin(ccci, g->name[i],
+						  RPC_GPIO_NAME_LEN, &pin)) {
+				dev_info(ccci->dev, "RPC: no modem pin for %.*s\n",
+					 RPC_GPIO_NAME_LEN, g->name[i]);
+				continue;
+			}
+			g->pin[i] = pin;
+		} else {
+			/* by the number the modem gave */
+			pin = g->pin_in[i];
+		}
+		if (!want_level)
+			continue;
+		level = mtk_ccci_rpc_gpio_level(ccci, pin);
+		if (level < 0) {
+			dev_info(ccci->dev, "RPC: pin %u level: %d\n", pin,
+				 level);
+			continue;
+		}
+		g->level[i] = level;
+	}
+
+	if (!(g->req & (RPC_REQ_ADC_PIN | RPC_REQ_ADC_VALUE)))
+		return;
+	if (mtk_ccci_rpc_adc(ccci, &ch, &raw)) {
+		dev_info(ccci->dev, "RPC: no board ADC described\n");
+		return;
+	}
+	/* the downstream driver has one ADC for the modem and ignores the name */
+	if (g->req & RPC_REQ_ADC_PIN)
+		g->adc_ch = ch;
+	if (g->req & RPC_REQ_ADC_VALUE)
+		g->adc_sum = raw * g->adc_count;
+}
+
+static void mtk_ccci_rpc_gpio_adc(struct mtk_ccci *ccci,
+				  const struct mtk_ccci_rpc_arg *arg,
+				  unsigned int num,
+				  struct mtk_ccci_rpc_reply *r)
+{
+	struct mtk_ccci_rpc_gpio_adc *g;
+	unsigned int i;
+
+	g = kzalloc(sizeof(*g), GFP_KERNEL);
+	if (!g || num != 1)
+		goto err;
+
+	if (arg[0].len == sizeof(struct mtk_ccci_rpc_gpio_adc_in_v1)) {
+		const struct mtk_ccci_rpc_gpio_adc_in_v1 *in = arg[0].buf;
+
+		g->pins = RPC_GPIO_ADC_PINS_V1;
+		g->req = in->req;
+		g->valid = in->valid_pins;
+		g->name = in->pin_name;
+		for (i = 0; i < g->pins; i++)
+			g->pin_in[i] = get_unaligned_le32(&in->pin[i]);
+		g->adc_count = get_unaligned_le32(&in->adc_count);
+	} else if (arg[0].len == sizeof(struct mtk_ccci_rpc_gpio_adc_in_v2)) {
+		const struct mtk_ccci_rpc_gpio_adc_in_v2 *in = arg[0].buf;
+
+		g->pins = RPC_GPIO_ADC_PINS_V2;
+		g->req = get_unaligned_le16(&in->req);
+		g->valid = get_unaligned_le16(&in->valid_pins);
+		g->name = in->pin_name;
+		for (i = 0; i < g->pins; i++)
+			g->pin_in[i] = get_unaligned_le32(&in->pin[i]);
+		g->adc_count = get_unaligned_le32(&in->adc_count);
+	} else {
+		dev_err(ccci->dev, "RPC GPIO/ADC: unknown request size %u\n",
+			arg[0].len);
+		goto err;
+	}
+
+	mtk_ccci_rpc_gpio_adc_do(ccci, g);
+	dev_info(ccci->dev, "RPC GPIO/ADC v%u: request %#x pins %#x -> pins %*ph levels %*ph ADC %#x/%#x\n",
+		 g->pins == RPC_GPIO_ADC_PINS_V1 ? 1 : 2, g->req, g->valid,
+		 (int)(g->pins * 4), g->pin, (int)(g->pins * 4), g->level,
+		 g->adc_ch, g->adc_sum);
+
+	/* a status word, then the answer of the request's version */
+	rpc_reply_u32(r, 0);
+	r->arg[1].len = 2 * 4 * g->pins + 8;
+	for (i = 0; i < g->pins; i++) {
+		put_unaligned_le32(g->pin[i], r->arg[1].data + 4 * i);
+		put_unaligned_le32(g->level[i],
+				   r->arg[1].data + 4 * (g->pins + i));
+	}
+	put_unaligned_le32(g->adc_ch, r->arg[1].data + 8 * g->pins);
+	put_unaligned_le32(g->adc_sum, r->arg[1].data + 8 * g->pins + 4);
+	r->num = 2;
+	kfree(g);
+	return;
+
+err:
+	kfree(g);
+	rpc_reply_u32(r, RPC_PARAM_ERROR);
+	rpc_reply_u32(r, RPC_PARAM_ERROR);
+}
+
+static void mtk_ccci_rpc_dtsi(struct mtk_ccci *ccci,
+			      const struct mtk_ccci_rpc_arg *arg,
+			      unsigned int num, struct mtk_ccci_rpc_reply *r)
+{
+	struct mtk_ccci_rpc_dtsi_out out;
+	struct mtk_ccci_rpc_dtsi_in in;
+	struct device_node *np;
+	char name[RPC_DTSI_NAME_LEN + 1];
+	u32 val;
+
+	if (num != 1 || arg[0].len < sizeof(in)) {
+		rpc_reply_u32(r, RPC_PARAM_ERROR);
+		rpc_reply_u32(r, RPC_PARAM_ERROR);
+		return;
+	}
+	memcpy(&in, arg[0].buf, sizeof(in));
+	memcpy(name, in.name, sizeof(in.name));
+	name[RPC_DTSI_NAME_LEN] = '\0';
+
+	/* "failure" is a buffer of 0x0f bytes, as in the MediaTek downstream driver */
+	memset(&out, 0xf, sizeof(out));
+	np = of_find_compatible_node(NULL, NULL, "mediatek,md_attr_node");
+	if (np && in.req == RPC_REQ_PROP_VALUE &&
+	    !of_property_read_u32(np, name, &val))
+		out.value = cpu_to_le32(val);
+	of_node_put(np);
+	dev_info(ccci->dev, "RPC: %s = %#x%s\n", name, le32_to_cpu(out.value),
+		 np ? "" : " (no md_attr_node)");
+
+	rpc_reply_u32(r, 0);
+	r->arg[1].len = sizeof(out);
+	memcpy(r->arg[1].data, &out, sizeof(out));
+	r->num = 2;
+}
+
+/*
+ * The modem binds a CCMNI to one of the DPMAIF UL queues: the downstream
+ * driver puts normal data on queue 0 and the IMS CCMNI on queue 3. The
+ * answer is 0 whatever the mapping, as in the MediaTek downstream driver,
+ * which only logs a CCMNI or queue it does not know.
+ */
+static void mtk_ccci_rpc_lhif_map(struct mtk_ccci *ccci,
+				  const struct mtk_ccci_rpc_arg *arg,
+				  unsigned int num,
+				  struct mtk_ccci_rpc_reply *r)
+{
+	struct mtk_ccci_rpc_lhif_map map;
+	u32 net_if, lhif_q;
+	int txq = -1;
+
+	if (num != 1 || arg[0].len < sizeof(map)) {
+		rpc_reply_u32(r, RPC_PARAM_ERROR);
+		rpc_reply_u32(r, RPC_PARAM_ERROR);
+		return;
+	}
+	memcpy(&map, arg[0].buf, sizeof(map));
+	net_if = le32_to_cpu(map.net_if);
+	lhif_q = le32_to_cpu(map.lhif_q);
+
+	if (lhif_q == RPC_LHIF_HWQ_AP_UL_Q0)
+		txq = 0;
+	else if (lhif_q == RPC_LHIF_HWQ_AP_UL_Q1)
+		txq = 3;
+
+	if (net_if >= MTK_CCCI_NET_LINKS || txq < 0)
+		dev_warn(ccci->dev, "RPC: LHIF mapping of CCMNI %u to queue %u ignored\n",
+			 net_if, lhif_q);
+	else {
+		WRITE_ONCE(ccci->net_txq[net_if], txq);
+		dev_info(ccci->dev, "RPC: CCMNI %u sends on DPMAIF UL queue %d (LHIF queue %u)\n",
+			 net_if, txq, lhif_q);
+	}
+
+	rpc_reply_u32(r, 0);
+	rpc_reply_u32(r, 0);
+}
+
+static int mtk_ccci_rpc_send(struct mtk_ccci *ccci,
+			     const struct mtk_ccci_header *req_hdr, u32 op,
+			     const struct mtk_ccci_rpc_reply *r)
+{
+	struct mtk_ccci_header *hdr;
+	struct sk_buff *skb;
+	unsigned int i, len = RPC_HDR_LEN;
+	u8 *p;
+	int ret;
+
+	for (i = 0; i < r->num; i++)
+		len += 4 + ALIGN(r->arg[i].len, 4);
+	skb = mtk_ccci_alloc_skb(len, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+	p = skb_put_zero(skb, len);
+
+	hdr = (void *)p;
+	hdr->data[0] = req_hdr->data[0];
+	hdr->data[1] = cpu_to_le32(len);
+	hdr->status = cpu_to_le32(MTK_CCCI_CH_RPC_TX);
+	hdr->reserved = req_hdr->reserved;
+	put_unaligned_le32(op | RPC_RESP, p + sizeof(*hdr));
+	put_unaligned_le32(r->num, p + sizeof(*hdr) + 4);
+	p += RPC_HDR_LEN;
+	for (i = 0; i < r->num; i++) {
+		put_unaligned_le32(r->arg[i].len, p);
+		memcpy(p + 4, r->arg[i].data, r->arg[i].len);
+		p += 4 + ALIGN(r->arg[i].len, 4);
+	}
+
+	ret = mtk_ccci_send_skb(ccci, MTK_CCCI_Q_RPC, skb);
+	if (ret)
+		kfree_skb(skb);
+	return ret;
+}
+
+static bool mtk_ccci_rpc_for_userspace(u32 op)
+{
+	switch (op) {
+	case RPC_QUERY_AP_SYS_PROP:
+	case RPC_SAR_TABLE_IDX:
+	case RPC_AMMS_DRDI_CONTROL:
+	case RPC_SAVE_MD_CAPID:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/**
+ * mtk_ccci_rpc_recv() - answer a modem RPC request
+ * @ccci: driver state
+ * @skb: request with its CCCI header; always taken
+ *
+ * Malformed requests are dropped without an answer, as in the MediaTek downstream
+ * driver. Requests for the userspace server wait in /dev/ccci_rpc, also
+ * while nobody has it open: the modem waits for its answer.
+ *
+ * Return: 0, or -EBUSY when /dev/ccci_rpc is full (the request stays in
+ * the ring).
+ */
+int mtk_ccci_rpc_recv(struct mtk_ccci *ccci, struct sk_buff *skb)
+{
+	struct mtk_ccci_rpc_arg arg[RPC_MAX_ARGS];
+	struct mtk_ccci_rpc_reply *r;
+	struct mtk_ccci_header hdr;
+	u32 op, num, off, i;
+	int ret;
+
+	if (skb->len < RPC_HDR_LEN)
+		goto bad;
+	op = get_unaligned_le32(skb->data + sizeof(hdr));
+	if (mtk_ccci_rpc_for_userspace(op)) {
+		dev_info(ccci->dev, "RPC %#x (%u bytes) to /dev/%s\n", op,
+			 skb->len, ccci->cdev_rpc.misc.name);
+		return mtk_ccci_cdev_recv(&ccci->cdev_rpc, skb);
+	}
+
+	if (skb->len > RPC_MAX_BUF)
+		goto bad;
+	memcpy(&hdr, skb->data, sizeof(hdr));
+	num = get_unaligned_le32(skb->data + sizeof(hdr) + 4);
+	if (le32_to_cpu(hdr.reserved) > RPC_SLOTS || num > RPC_MAX_ARGS)
+		goto bad;
+
+	off = RPC_HDR_LEN;
+	for (i = 0; i < num; i++) {
+		if (off + 4 > skb->len)
+			goto bad;
+		arg[i].len = get_unaligned_le32(skb->data + off);
+		off += 4;
+		if (arg[i].len > skb->len - off)
+			goto bad;
+		arg[i].buf = skb->data + off;
+		off += ALIGN(arg[i].len, 4);
+	}
+
+	r = kzalloc(sizeof(*r), GFP_KERNEL);
+	if (!r)
+		goto out;
+	switch (op) {
+	case RPC_GET_GPIO_NUM:
+		mtk_ccci_rpc_gpio_num(ccci, arg, num, r);
+		break;
+	case RPC_GET_EINT_ATTR:
+		mtk_ccci_rpc_eint_attr(ccci, arg, num, r);
+		break;
+	case RPC_GET_GPIO_ADC:
+		mtk_ccci_rpc_gpio_adc(ccci, arg, num, r);
+		break;
+	case RPC_DTSI_QUERY:
+		mtk_ccci_rpc_dtsi(ccci, arg, num, r);
+		break;
+	case RPC_LHIF_MAPPING:
+		mtk_ccci_rpc_lhif_map(ccci, arg, num, r);
+		break;
+	case RPC_RF_ECID_DATA:
+		/* acknowledged, not kept, as in the MediaTek downstream driver */
+		if (num == 1) {
+			dev_info(ccci->dev, "RPC: RF ECID data, %u bytes\n",
+				 arg[0].len);
+			rpc_reply_u32(r, 0);
+			rpc_reply_u32(r, 0);
+		} else {
+			rpc_reply_u32(r, RPC_PARAM_ERROR);
+			rpc_reply_u32(r, RPC_PARAM_ERROR);
+		}
+		break;
+	default:
+		dev_info(ccci->dev, "RPC %#x (%u args) not handled\n", op, num);
+		rpc_reply_u32(r, RPC_NO_OP);
+		break;
+	}
+	ret = mtk_ccci_rpc_send(ccci, &hdr, op, r);
+	if (ret)
+		dev_err(ccci->dev, "RPC %#x answer: %d\n", op, ret);
+	kfree(r);
+	goto out;
+
+bad:
+	dev_err_ratelimited(ccci->dev, "malformed RPC request (%u bytes)\n",
+			    skb->len);
+out:
+	consume_skb(skb);
+	return 0;
+}
diff --git a/drivers/net/wwan/mtk_ccci/mtk_ccci_rt.c b/drivers/net/wwan/mtk_ccci/mtk_ccci_rt.c
new file mode 100644
index 000000000..b0f9825c5
--- /dev/null
+++ b/drivers/net/wwan/mtk_ccci/mtk_ccci_rt.c
@@ -0,0 +1,743 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek CCCI: the runtime data, the AP answer to HS1.
+ *
+ * With HS1 the modem lists the runtime features it knows (64 feature
+ * bytes: support level and version). The AP answers in two places:
+ *
+ *  - the RUNTIME_DATA shared memory (first 2 KiB, the AP half): one record
+ *    per feature, in feature order, with the support level agreed on and
+ *    the data the feature needs (where a shared memory region is, the
+ *    time, a random seed...);
+ *  - the CCIF SRAM, after the modem's query: a control header and the AP
+ *    feature block, which tells the modem where the runtime data is and
+ *    which shared memory it may use (its MPU windows). CCIF channel 15
+ *    then tells the modem the answer is there.
+ *
+ * The modem then asks the AP for files (FS) and board data (RPC) and
+ * reports HS2 on the control channel: it is ready.
+ *
+ * The agreement and the records follow the MediaTek downstream driver
+ * (ccci_fsm.c: config_ap_side_feature, ccci_md_prepare_runtime_data;
+ * modem_sys1.c: config_ap_runtime_data_v2_1), the values of a normal
+ * boot of the Titan 2 are the defaults of the
+ * module parameters below. Where the data comes from LK, a missing tag is
+ * treated as the downstream driver does.
+ *
+ * Copyright (C) 2016 MediaTek Inc.
+ * Copyright (C) 2026 serlk
+ */
+
+#include <linux/bitfield.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/random.h>
+#include <linux/seq_file.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/timekeeping.h>
+
+#include <asm/arch_timer.h>
+
+#include "mtk_ccci.h"
+
+static bool runtime_data = true;
+module_param(runtime_data, bool, 0444);
+MODULE_PARM_DESC(runtime_data,
+		 "answer HS1 and let the modem boot to READY (default: stop at HS1)");
+
+/* what a normal boot passes to the modem */
+static uint sbp_code;
+module_param(sbp_code, uint, 0444);
+MODULE_PARM_DESC(sbp_code, "operator (SBP) code given to the modem (default 0)");
+
+static uint rat_bitmap = 0x7d;
+module_param(rat_bitmap, uint, 0444);
+MODULE_PARM_DESC(rat_bitmap,
+		 "radio technologies the modem may use, modem bit order (default 0x7d: N/C/Lf/Lt/W/G)");
+
+static bool ccb_data_lk;
+module_param(ccb_data_lk, bool, 0444);
+MODULE_PARM_DESC(ccb_data_lk,
+		 "announce the whole CCB data LK set aside (default: what the CCB buffers use)");
+
+/* modem side RAT bits (0 | N | Lf | Lt | W | C | T | G) */
+#define MTK_CCCI_RAT_CDMA2000		BIT(2)
+
+/* runtime feature ids (downstream MD_CCCI_RUNTIME_FEATURE_ID) */
+enum {
+	FT_BOOT_INFO = 0,
+	FT_EXCEPTION_SHARE_MEMORY = 1,
+	FT_CCIF_SHARE_MEMORY = 2,
+	FT_SMART_LOGGING_SHARE_MEMORY = 3,
+	FT_MD1MD3_SHARE_MEMORY = 4,
+	FT_MISC_INFO_HIF_DMA_REMAP = 5,
+	FT_MISC_INFO_RTC_32K_LESS = 6,
+	FT_MISC_INFO_RANDOM_SEED_NUM = 7,
+	FT_MISC_INFO_GPS_COCLOCK = 8,
+	FT_MISC_INFO_SBP_ID = 9,
+	FT_MISC_INFO_CCCI = 10,
+	FT_MISC_INFO_CLIB_TIME = 11,
+	FT_MISC_INFO_C2K = 12,
+	FT_MD_IMAGE_START_MEMORY = 13,
+	FT_CCISM_SHARE_MEMORY = 14,
+	FT_CCB_SHARE_MEMORY = 15,
+	FT_DHL_RAW_SHARE_MEMORY = 16,
+	FT_DT_NETD_SHARE_MEMORY = 17,
+	FT_DT_USB_SHARE_MEMORY = 18,
+	FT_EE_AFTER_EPOF = 19,
+	FT_AP_CCMNI_MTU = 20,
+	FT_MISC_INFO_CUSTOMER_VAL = 21,
+	FT_CCCI_FAST_HEADER = 22,
+	FT_MISC_INFO_C2K_MEID = 24,
+	FT_LWA_SHARE_MEMORY = 25,
+	FT_AUDIO_RAW_SHARE_MEMORY = 26,
+	FT_MULTI_MD_MPU = 27,
+	FT_CCISM_SHARE_MEMORY_EXP = 28,
+	FT_MD_PHY_CAPTURE = 29,
+	FT_MD_CONSYS_SHARE_MEMORY = 30,
+	FT_MD_USIP_SHARE_MEMORY = 31,
+	FT_MD_MTEE_SHARE_MEMORY_ENABLE = 32,
+	FT_MD_POS_SHARE_MEMORY = 33,
+	FT_UDC_RAW_SHARE_MEMORY = 34,
+	FT_MD_WIFI_PROXY_SHARE_MEMORY = 35,
+	FT_NVRAM_CACHE_SHARE_MEMORY = 36,
+	FT_SECURITY_SHARE_MEMORY = 37,
+	FT_MD_MEM_AP_VIEW_INF = 38,
+	FT_AMMS_DRDI_COPY = 45,
+	FT_MD_POST_DUMP = 55,
+};
+
+/* version of MISC_INFO_CLIB_TIME with microseconds and the AP counter */
+#define FT_CLIB_TIME_HIRES		1
+
+/* BOOT_INFO */
+#define MTK_CCCI_BOOT_MODE_NORMAL	0
+#define MTK_CCCI_BOOT_ATTR_PHONE	BIT(1)	/* not an EVB */
+/* the upper half of mdlg_mode, as a normal boot of the phone sends it */
+#define MTK_CCCI_BOOT_MDLG_NORMAL	0x000f0000
+
+/* MISC_INFO_CCCI */
+#define MTK_CCCI_MISC_SEQ_CHECK		BIT(0)
+#define MTK_CCCI_MISC_POLL_MD_STATUS	BIT(1)
+
+/* MISC_INFO_C2K */
+#define MTK_CCCI_C2K_ON			BIT(2)
+
+/* the exception area the modem fills in MDCCCI_DBG */
+#define MTK_CCCI_EE_SMEM_SIZE		SZ_64K
+
+/* largest packet the AP takes on a CCMNI port, header excluded */
+#define MTK_CCCI_CCMNI_MTU		(MTK_CCCI_MTU + 128 - \
+					 sizeof(struct mtk_ccci_header))
+
+/* the second half of RUNTIME_DATA is the modem's */
+#define MTK_CCCI_RT_MD_SIZE		0x800
+
+/* share_memory_support: an AP that sets the MPU windows of the modem */
+#define MTK_CCCI_SHM_MULTI_MD_MPU	2
+
+/* one runtime data record, followed by data_len bytes */
+struct mtk_ccci_rt_feature {
+	u8 feature_id;
+	u8 support;		/* MTK_CCCI_FT_MASK | MTK_CCCI_FT_VER */
+	u8 reserved[2];
+	__le32 data_len;
+};
+static_assert(sizeof(struct mtk_ccci_rt_feature) == 8);
+
+struct mtk_ccci_rt_shm {
+	__le32 addr;		/* modem view */
+	__le32 size;
+};
+
+/* the AP feature block in the CCIF SRAM (downstream ap_query_md_feature_v2_1) */
+struct mtk_ccci_ap_feature {
+	__le32 head_pattern;
+	u8 feature[MTK_CCCI_FEATURE_COUNT];
+	__le32 share_memory_support;
+	__le32 ap_runtime_data_addr;
+	__le32 ap_runtime_data_size;
+	__le32 md_runtime_data_addr;
+	__le32 md_runtime_data_size;
+	__le32 noncached_mpu_start_addr;
+	__le32 noncached_mpu_total_size;
+	__le32 cached_mpu_start_addr;
+	__le32 cached_mpu_total_size;
+	__le32 reserve_addr[12];
+	__le32 tail_pattern;
+};
+static_assert(sizeof(struct mtk_ccci_ap_feature) == 156);
+
+/* LK tags read here (downstream ccci_util), only the leading fields used */
+struct mtk_ccci_lk_hdr_tbl {		/* "hdr_tbl_inf": modem banks 0/1 */
+	__le64 base;
+	__le32 size;
+};
+
+struct mtk_ccci_lk_smem_layout {	/* "smem_layout": non-cached smem */
+	__le64 base;
+	__le32 md1_offset;
+	__le32 md1_size;
+};
+
+struct mtk_ccci_lk_csmem {		/* "md1_bank4_cache_info" */
+	__le64 base;
+	__le32 md_offset;
+	__le32 size;
+};
+
+struct mtk_ccci_lk_sib {		/* "md1_sib_info" */
+	__le64 addr;
+	__le32 size;
+};
+
+/* a record of the modem view of one bank (MD_MEM_AP_VIEW_INF) */
+struct mtk_ccci_rt_mem_view {
+	__le32 md_addr;
+	__le32 size;
+	__le32 ap_lo;
+	__le32 ap_hi;
+};
+
+static u8 ft_byte(unsigned int support, unsigned int ver)
+{
+	return FIELD_PREP(MTK_CCCI_FT_MASK, support) |
+	       FIELD_PREP(MTK_CCCI_FT_VER, ver);
+}
+
+static const void *rt_tag(struct mtk_ccci *ccci, const char *name,
+			  u32 min_size)
+{
+	const void *p;
+	u32 size;
+
+	p = mtk_ccci_lk_find(ccci, name, &size);
+	return p && size >= min_size ? p : NULL;
+}
+
+static u32 rt_tag_u32(struct mtk_ccci *ccci, const char *name, u32 def)
+{
+	const __le32 *p = rt_tag(ccci, name, sizeof(*p));
+
+	return p ? le32_to_cpu(*p) : def;
+}
+
+static u32 rt_phy_cap_size(struct mtk_ccci *ccci)
+{
+	return rt_tag_u32(ccci, "md1_phy_cap", 0);
+}
+
+static u32 rt_sib_size(struct mtk_ccci *ccci)
+{
+	const struct mtk_ccci_lk_sib *sib = rt_tag(ccci, "md1_sib_info",
+						   sizeof(*sib));
+
+	return sib && le64_to_cpu(sib->addr) ? le32_to_cpu(sib->size) : 0;
+}
+
+static u32 rt_smem_size(struct mtk_ccci *ccci, enum mtk_ccci_smem_id id)
+{
+	const struct mtk_ccci_smem_region *r = mtk_ccci_lk_smem(ccci, id);
+
+	return r ? le32_to_cpu(r->size) : 0;
+}
+
+/*
+ * The CCB data announced. The downstream driver places the CCB users back
+ * to back at the start of the CCB data LK handed over, each as large as
+ * its buffers (mtk_ccci_ccb.c), and announces their sum, not the size of
+ * the LK block (on Titan 2: 0x17c000 of 0x1600000; the rest of the block
+ * is the raw DHL/MDM logging memory).
+ */
+/* the part of LK's CCB block the CCB users get; the rest is raw DHL/MDM */
+#define MTK_CCCI_CCB_SECTION_A		SZ_2M
+
+static u32 rt_ccb_data_size(struct mtk_ccci *ccci)
+{
+	u32 lk = 0, need = mtk_ccci_ccb_data_size();
+	unsigned int id;
+
+	for (id = MTK_CCCI_SMEM_CCB_DHL; id <= MTK_CCCI_SMEM_CCB_META; id++)
+		lk += rt_smem_size(ccci, id);
+	if (ccb_data_lk)
+		return lk;
+	if (need > lk) {
+		dev_warn(ccci->dev, "CCB data of %#x bytes, %#x needed\n",
+			 lk, need);
+		return lk;
+	}
+	return need;
+}
+
+/* what this AP supports, as the downstream driver configures it */
+static void rt_ap_features(struct mtk_ccci *ccci, u8 ap[MTK_CCCI_FEATURE_COUNT])
+{
+	static const u8 must[] = {
+		FT_BOOT_INFO, FT_EXCEPTION_SHARE_MEMORY, FT_CCIF_SHARE_MEMORY,
+		FT_CCISM_SHARE_MEMORY, FT_CCISM_SHARE_MEMORY_EXP,
+		FT_MD_CONSYS_SHARE_MEMORY, FT_CCB_SHARE_MEMORY,
+		FT_DHL_RAW_SHARE_MEMORY, FT_LWA_SHARE_MEMORY,
+		FT_DT_NETD_SHARE_MEMORY, FT_DT_USB_SHARE_MEMORY,
+		FT_AUDIO_RAW_SHARE_MEMORY, FT_MISC_INFO_HIF_DMA_REMAP,
+		FT_MULTI_MD_MPU, FT_MISC_INFO_RTC_32K_LESS,
+		FT_MISC_INFO_RANDOM_SEED_NUM, FT_MISC_INFO_GPS_COCLOCK,
+		FT_MISC_INFO_SBP_ID, FT_MISC_INFO_CCCI, FT_MISC_INFO_CLIB_TIME,
+		FT_MISC_INFO_C2K, FT_EE_AFTER_EPOF, FT_AP_CCMNI_MTU,
+		FT_NVRAM_CACHE_SHARE_MEMORY, FT_AMMS_DRDI_COPY,
+	};
+	static const u8 optional[] = {
+		FT_MD_IMAGE_START_MEMORY, FT_MD_USIP_SHARE_MEMORY,
+		FT_MD_MTEE_SHARE_MEMORY_ENABLE, FT_MD_WIFI_PROXY_SHARE_MEMORY,
+		FT_MD_MEM_AP_VIEW_INF, FT_MD_POST_DUMP,
+	};
+	static const u8 unsupported[] = {
+		FT_MD1MD3_SHARE_MEMORY, FT_MISC_INFO_CUSTOMER_VAL,
+		FT_MISC_INFO_C2K_MEID, FT_SMART_LOGGING_SHARE_MEMORY,
+		FT_SECURITY_SHARE_MEMORY,
+	};
+	unsigned int i, md_ver;
+	bool on;
+
+	memset(ap, 0, MTK_CCCI_FEATURE_COUNT);
+	for (i = 0; i < ARRAY_SIZE(must); i++)
+		ap[must[i]] = ft_byte(MTK_CCCI_FT_MUST_SUPPORT, 0);
+	for (i = 0; i < ARRAY_SIZE(optional); i++)
+		ap[optional[i]] = ft_byte(MTK_CCCI_FT_OPTIONAL_SUPPORT, 0);
+	for (i = 0; i < ARRAY_SIZE(unsupported); i++)
+		ap[unsupported[i]] = ft_byte(MTK_CCCI_FT_NOT_SUPPORT, 0);
+
+	/* the regions LK may or may not have set up */
+	on = rt_phy_cap_size(ccci) || rt_sib_size(ccci);
+	ap[FT_MD_PHY_CAPTURE] = ft_byte(on ? MTK_CCCI_FT_MUST_SUPPORT :
+					MTK_CCCI_FT_NOT_SUPPORT, 0);
+	on = rt_smem_size(ccci, MTK_CCCI_SMEM_UDC_DATA) &&
+	     rt_smem_size(ccci, MTK_CCCI_SMEM_UDC_DESCTAB);
+	ap[FT_UDC_RAW_SHARE_MEMORY] = ft_byte(on ? MTK_CCCI_FT_MUST_SUPPORT :
+					      MTK_CCCI_FT_NOT_SUPPORT, 0);
+	on = rt_tag_u32(ccci, "smem_amms_pos_size", 0);
+	ap[FT_MD_POS_SHARE_MEMORY] = ft_byte(on ? MTK_CCCI_FT_MUST_SUPPORT :
+					     MTK_CCCI_FT_NOT_SUPPORT, 0);
+
+	/* the high resolution time, if the modem knows it */
+	md_ver = FIELD_GET(MTK_CCCI_FT_VER,
+			   ccci->hs1_query.feature[FT_MISC_INFO_CLIB_TIME]);
+	if (md_ver == FT_CLIB_TIME_HIRES)
+		ap[FT_MISC_INFO_CLIB_TIME] = ft_byte(MTK_CCCI_FT_MUST_SUPPORT,
+						     FT_CLIB_TIME_HIRES);
+}
+
+/*
+ * Agree on one feature. Return the support byte of the record, or -EPROTO
+ * if the modem must have a feature this AP does not support.
+ */
+static int rt_agree(u8 md, u8 ap)
+{
+	unsigned int md_sup = FIELD_GET(MTK_CCCI_FT_MASK, md);
+	unsigned int md_ver = FIELD_GET(MTK_CCCI_FT_VER, md);
+	unsigned int ap_sup = FIELD_GET(MTK_CCCI_FT_MASK, ap);
+	unsigned int ap_ver = FIELD_GET(MTK_CCCI_FT_VER, ap);
+	bool ok;
+
+	switch (md_sup) {
+	case MTK_CCCI_FT_NOT_EXIST:
+		return md;
+	case MTK_CCCI_FT_MUST_SUPPORT:
+		return ap_sup < MTK_CCCI_FT_MUST_SUPPORT ? -EPROTO : md;
+	case MTK_CCCI_FT_OPTIONAL_SUPPORT:
+		ok = md_ver == ap_ver && ap_sup >= MTK_CCCI_FT_MUST_SUPPORT;
+		break;
+	case MTK_CCCI_FT_BACKWARD_COMPAT:
+		ok = md_ver >= ap_ver;
+		break;
+	default:
+		/* the downstream driver leaves the record empty */
+		return 0;
+	}
+	return ft_byte(ok ? MTK_CCCI_FT_MUST_SUPPORT : MTK_CCCI_FT_NOT_SUPPORT,
+		       ap_ver);
+}
+
+struct rt_writer {
+	u8 *p;
+	u32 left;
+	int err;
+};
+
+static void rt_append(struct rt_writer *w, u8 id, u8 support,
+		      const void *data, u32 len)
+{
+	struct mtk_ccci_rt_feature f = {
+		.feature_id = id,
+		.support = support,
+		.data_len = cpu_to_le32(len),
+	};
+
+	if (w->err)
+		return;
+	if (sizeof(f) + len > w->left) {
+		w->err = -ENOSPC;
+		return;
+	}
+	memcpy(w->p, &f, sizeof(f));
+	w->p += sizeof(f);
+	if (len)
+		memcpy(w->p, data, len);
+	w->p += len;
+	w->left -= sizeof(f) + len;
+}
+
+static void rt_shm_of(struct mtk_ccci *ccci, enum mtk_ccci_smem_id id,
+		      struct mtk_ccci_rt_shm *shm)
+{
+	const struct mtk_ccci_smem_region *r = mtk_ccci_lk_smem(ccci, id);
+
+	shm->addr = cpu_to_le32(r ? mtk_ccci_lk_smem_md_addr(r) : 0);
+	shm->size = r ? r->size : 0;
+}
+
+/* the modem view of its banks (bank 0/1, non-cached and cached smem) */
+static u32 rt_mem_view(struct mtk_ccci *ccci, struct mtk_ccci_rt_mem_view *v)
+{
+	const struct mtk_ccci_lk_hdr_tbl *md;
+	const struct mtk_ccci_lk_smem_layout *nc;
+	const struct mtk_ccci_lk_csmem *c;
+	u64 ap;
+
+	md = rt_tag(ccci, "hdr_tbl_inf", sizeof(*md));
+	nc = rt_tag(ccci, "smem_layout", sizeof(*nc));
+	c = rt_tag(ccci, "md1_bank4_cache_info", sizeof(*c));
+	if (!md || !nc || !c)
+		return 0;
+
+	ap = le64_to_cpu(md->base);
+	v[0] = (struct mtk_ccci_rt_mem_view){
+		.md_addr = 0,
+		.size = md->size,
+		.ap_lo = cpu_to_le32(lower_32_bits(ap)),
+		.ap_hi = cpu_to_le32(upper_32_bits(ap)),
+	};
+	ap = le64_to_cpu(nc->base) + le32_to_cpu(nc->md1_offset);
+	v[1] = (struct mtk_ccci_rt_mem_view){
+		.md_addr = cpu_to_le32(MTK_CCCI_SMEM_MD_VIEW_BASE),
+		.size = nc->md1_size,
+		.ap_lo = cpu_to_le32(lower_32_bits(ap)),
+		.ap_hi = cpu_to_le32(upper_32_bits(ap)),
+	};
+	ap = le64_to_cpu(c->base);
+	v[2] = (struct mtk_ccci_rt_mem_view){
+		.md_addr = cpu_to_le32(MTK_CCCI_SMEM_MD_VIEW_BASE +
+				       rt_tag_u32(ccci, "md1_smem_cahce_offset",
+						  SZ_128M)),
+		.size = c->size,
+		.ap_lo = cpu_to_le32(lower_32_bits(ap)),
+		.ap_hi = cpu_to_le32(upper_32_bits(ap)),
+	};
+	return 3 * sizeof(*v);
+}
+
+/*
+ * The data of one feature agreed on, into buf (16 words). Return its length,
+ * or -ENODATA when the downstream driver leaves the record out entirely.
+ */
+static int rt_data_of(struct mtk_ccci *ccci, u8 id, u8 support, void *buf)
+{
+	struct mtk_ccci_rt_shm *shm = buf;
+	__le32 *w = buf;
+	const struct mtk_ccci_smem_region *r;
+	struct timespec64 ts;
+	u64 usec, cnt;
+	unsigned int j;
+
+	/* most features are a shared memory region */
+	static const u8 region[][2] = {
+		{ FT_CCISM_SHARE_MEMORY, MTK_CCCI_SMEM_CCISM_SCP },
+		{ FT_LWA_SHARE_MEMORY, MTK_CCCI_SMEM_RAW_LWA },
+		{ FT_DT_NETD_SHARE_MEMORY, MTK_CCCI_SMEM_RAW_NETD },
+		{ FT_DT_USB_SHARE_MEMORY, MTK_CCCI_SMEM_RAW_USB },
+		{ FT_SMART_LOGGING_SHARE_MEMORY, MTK_CCCI_SMEM_SMART_LOGGING },
+		{ FT_MD1MD3_SHARE_MEMORY, MTK_CCCI_SMEM_RAW_MD2MD },
+		{ FT_AUDIO_RAW_SHARE_MEMORY, MTK_CCCI_SMEM_RAW_AUDIO },
+		{ FT_CCISM_SHARE_MEMORY_EXP, MTK_CCCI_SMEM_CCISM_MCU_EXP },
+		{ FT_MD_CONSYS_SHARE_MEMORY, MTK_CCCI_SMEM_MD_CONSYS },
+		{ FT_MD_USIP_SHARE_MEMORY, MTK_CCCI_SMEM_USIP },
+		{ FT_MD_POS_SHARE_MEMORY, MTK_CCCI_SMEM_AMMS_POS },
+		{ FT_MD_WIFI_PROXY_SHARE_MEMORY, MTK_CCCI_SMEM_WIFI_PROXY },
+		{ FT_NVRAM_CACHE_SHARE_MEMORY, MTK_CCCI_SMEM_NVRAM_CACHE },
+		{ FT_AMMS_DRDI_COPY, MTK_CCCI_SMEM_DRDI },
+		{ FT_MD_POST_DUMP, MTK_CCCI_SMEM_POST_DUMP },
+	};
+
+	for (j = 0; j < ARRAY_SIZE(region); j++) {
+		if (region[j][0] == id) {
+			rt_shm_of(ccci, region[j][1], shm);
+			/*
+			 * LWA is announced as an empty region at the address
+			 * that follows (that of DRDI); LK has no LWA entry.
+			 */
+			if (id == FT_LWA_SHARE_MEMORY && !shm->addr) {
+				rt_shm_of(ccci, MTK_CCCI_SMEM_DRDI, shm);
+				shm->size = 0;
+			}
+			return sizeof(*shm);
+		}
+	}
+
+	/* the "misc info" features carry four words, zero unless set */
+	memset(buf, 0, 8 * sizeof(*w));
+
+	switch (id) {
+	case FT_BOOT_INFO:
+		w[0] = cpu_to_le32(MTK_CCCI_CH_CONTROL_RX);
+		/* log mode 0, normal boot, no wait time for a memory dump */
+		w[1] = cpu_to_le32(MTK_CCCI_BOOT_MODE_NORMAL | MTK_CCCI_BOOT_MDLG_NORMAL);
+		w[2] = cpu_to_le32(MTK_CCCI_BOOT_ATTR_PHONE);
+		return 4 * sizeof(*w);
+	case FT_EXCEPTION_SHARE_MEMORY:
+		/* the downstream driver leaves the record out without it */
+		r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_MDCCCI_DBG);
+		if (!r)
+			return -ENODATA;
+		shm->addr = cpu_to_le32(mtk_ccci_lk_smem_md_addr(r));
+		shm->size = cpu_to_le32(MTK_CCCI_EE_SMEM_SIZE);
+		return sizeof(*shm);
+	case FT_CCIF_SHARE_MEMORY:
+		/* CCISM_MCU: what the ring queues use of it */
+		rt_shm_of(ccci, MTK_CCCI_SMEM_CCISM_MCU, shm);
+		shm->size = cpu_to_le32(ccci->ccism_size);
+		return sizeof(*shm);
+	case FT_CCB_SHARE_MEMORY:
+		r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_CCB_CTRL);
+		if (r) {
+			w[0] = cpu_to_le32(mtk_ccci_lk_smem_md_addr(r));
+			w[1] = r->size;
+		}
+		r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_CCB_DHL);
+		if (r) {
+			w[2] = cpu_to_le32(mtk_ccci_lk_smem_md_addr(r));
+			w[3] = cpu_to_le32(rt_ccb_data_size(ccci));
+		}
+		return 4 * sizeof(*w);
+	case FT_DHL_RAW_SHARE_MEMORY:
+		/*
+		 * LK sets aside one cached block for the CCB data; the
+		 * downstream driver keeps its first 2 MiB for the CCB users and
+		 * gives the rest to the raw DHL and MDM logs (no entries of
+		 * their own in LK's tables on Titan 2).
+		 */
+		if (mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_RAW_DHL)) {
+			rt_shm_of(ccci, MTK_CCCI_SMEM_RAW_DHL, shm);
+			return sizeof(*shm);
+		}
+		r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_CCB_DHL);
+		memset(shm, 0, sizeof(*shm));
+		if (r && le32_to_cpu(r->size) > MTK_CCCI_CCB_SECTION_A) {
+			shm->addr = cpu_to_le32(mtk_ccci_lk_smem_md_addr(r) +
+						MTK_CCCI_CCB_SECTION_A);
+			shm->size = cpu_to_le32(le32_to_cpu(r->size) -
+						MTK_CCCI_CCB_SECTION_A);
+		}
+		return sizeof(*shm);
+	case FT_MULTI_MD_MPU:
+		return 0;
+	case FT_MISC_INFO_RANDOM_SEED_NUM:
+		w[0] = cpu_to_le32(get_random_u32());
+		return 4 * sizeof(*w);
+	case FT_MISC_INFO_SBP_ID:
+		w[0] = cpu_to_le32(sbp_code);
+		w[1] = cpu_to_le32(rat_bitmap);
+		return 4 * sizeof(*w);
+	case FT_MISC_INFO_CCCI:
+		w[0] = cpu_to_le32(MTK_CCCI_MISC_SEQ_CHECK |
+				   MTK_CCCI_MISC_POLL_MD_STATUS);
+		return 4 * sizeof(*w);
+	case FT_MISC_INFO_CLIB_TIME:
+		/* seconds, time zone (minutes west, none set), DST flag */
+		ktime_get_real_ts64(&ts);
+		w[0] = cpu_to_le32(lower_32_bits(ts.tv_sec));
+		w[1] = cpu_to_le32(upper_32_bits(ts.tv_sec));
+		if (FIELD_GET(MTK_CCCI_FT_VER, support) != FT_CLIB_TIME_HIRES)
+			return 4 * sizeof(*w);
+		/* then microseconds and the AP system counter */
+		usec = ts.tv_nsec / NSEC_PER_USEC;
+		cnt = arch_timer_read_counter();
+		w[4] = cpu_to_le32(lower_32_bits(usec));
+		w[5] = cpu_to_le32(upper_32_bits(usec));
+		w[6] = cpu_to_le32(lower_32_bits(cnt));
+		w[7] = cpu_to_le32(upper_32_bits(cnt));
+		return 8 * sizeof(*w);
+	case FT_MISC_INFO_C2K:
+		if (rat_bitmap & MTK_CCCI_RAT_CDMA2000)
+			w[0] = cpu_to_le32(MTK_CCCI_C2K_ON);
+		return 4 * sizeof(*w);
+	case FT_MISC_INFO_HIF_DMA_REMAP:
+	case FT_MISC_INFO_RTC_32K_LESS:
+	case FT_MISC_INFO_GPS_COCLOCK:
+	case FT_EE_AFTER_EPOF:
+		return 4 * sizeof(*w);
+	case FT_MD_IMAGE_START_MEMORY: {
+		/* where LK loaded the image (0xd0000000 on the Titan 2), its raw size */
+		const struct mtk_ccci_lk_hdr_tbl *md;
+
+		md = rt_tag(ccci, "hdr_tbl_inf", sizeof(*md));
+		shm->addr = cpu_to_le32(md ? lower_32_bits(le64_to_cpu(md->base)) : 0);
+		shm->size = cpu_to_le32(rt_tag_u32(ccci, "md1img", 0));
+		return sizeof(*shm);
+	}
+	case FT_AP_CCMNI_MTU:
+		w[0] = cpu_to_le32(MTK_CCCI_CCMNI_MTU);
+		return sizeof(*w);
+	case FT_MD_PHY_CAPTURE:
+		shm->addr = 0;
+		shm->size = cpu_to_le32(rt_sib_size(ccci));
+		return sizeof(*shm);
+	case FT_UDC_RAW_SHARE_MEMORY:
+		r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_UDC_DATA);
+		if (r) {
+			w[0] = cpu_to_le32(mtk_ccci_lk_smem_md_addr(r));
+			w[1] = r->size;
+		}
+		r = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_UDC_DESCTAB);
+		if (r) {
+			w[2] = cpu_to_le32(mtk_ccci_lk_smem_md_addr(r));
+			w[3] = r->size;
+		}
+		return 4 * sizeof(*w);
+	case FT_MD_MTEE_SHARE_MEMORY_ENABLE:
+		w[0] = cpu_to_le32(rt_tag_u32(ccci, "mtee_support", 0));
+		return sizeof(*w);
+	case FT_MD_MEM_AP_VIEW_INF:
+		return rt_mem_view(ccci, buf);
+	default:
+		/* agreed on, but not handled downstream: no record */
+		return -ENODATA;
+	}
+}
+
+/* the MPU windows: the whole non-cached and cached shared memory */
+static void rt_mpu_window(const struct mtk_ccci_smem_region *tbl,
+			  unsigned int num, __le32 *start, __le32 *total)
+{
+	u32 size = 0;
+	unsigned int i;
+
+	if (!num)
+		return;
+	for (i = 0; i < num; i++)
+		size += le32_to_cpu(tbl[i].size);
+	*start = cpu_to_le32(mtk_ccci_lk_smem_md_addr(&tbl[0]));
+	*total = cpu_to_le32(size);
+}
+
+/**
+ * mtk_ccci_rt_enabled() - whether start answers HS1
+ *
+ * Return: the runtime_data module parameter.
+ */
+bool mtk_ccci_rt_enabled(void)
+{
+	return runtime_data;
+}
+
+/**
+ * mtk_ccci_rt_send() - answer HS1
+ * @ccci: driver state, with the HS1 query read and the shared memory
+ *	mapped (mtk_ccci_ccif_start)
+ *
+ * Writes the runtime data records, then the AP feature block into the
+ * CCIF SRAM, and notifies the modem on the SRAM channel. What was agreed
+ * on is kept in ccci->rt_answer for debugfs.
+ *
+ * Return: 0, -EPROTO if the modem needs a feature this AP does not have,
+ * or another negative error.
+ */
+int mtk_ccci_rt_send(struct mtk_ccci *ccci)
+{
+	u8 ap[MTK_CCCI_FEATURE_COUNT];
+	struct mtk_ccci_ap_feature af = { };
+	const struct mtk_ccci_smem_region *rt;
+	struct rt_writer w = {
+		.p = ccci->rt_copy,
+		.left = MTK_CCCI_RT_AP_SIZE,
+	};
+	__le32 buf[16];
+	unsigned int i;
+	u32 rt_md;
+
+	rt = mtk_ccci_lk_smem(ccci, MTK_CCCI_SMEM_RUNTIME_DATA);
+	if (!rt || !ccci->rt_data || !ccci->hs1_valid ||
+	    ccci->rt_data_size < MTK_CCCI_RT_AP_SIZE + MTK_CCCI_RT_MD_SIZE)
+		return -EINVAL;
+
+	rt_ap_features(ccci, ap);
+	for (i = 0; i < MTK_CCCI_FEATURE_COUNT; i++) {
+		int sup, len = 0;
+
+		sup = rt_agree(ccci->hs1_query.feature[i], ap[i]);
+		if (sup < 0) {
+			dev_err(ccci->dev,
+				"modem needs runtime feature %u (%#x), not supported\n",
+				i, ccci->hs1_query.feature[i]);
+			return sup;
+		}
+		ccci->rt_answer[i] = sup;
+		if (FIELD_GET(MTK_CCCI_FT_MASK, sup) == MTK_CCCI_FT_MUST_SUPPORT) {
+			len = rt_data_of(ccci, i, sup, buf);
+			if (len < 0) {
+				dev_dbg(ccci->dev, "runtime feature %u: no record\n", i);
+				continue;
+			}
+		}
+		rt_append(&w, i, sup, buf, len);
+	}
+	if (w.err) {
+		dev_err(ccci->dev, "runtime data does not fit in %#x bytes\n",
+			MTK_CCCI_RT_AP_SIZE);
+		return w.err;
+	}
+	ccci->rt_len = MTK_CCCI_RT_AP_SIZE - w.left;
+	memset_io(ccci->rt_data, 0, MTK_CCCI_RT_AP_SIZE);
+	memcpy_toio(ccci->rt_data, ccci->rt_copy, ccci->rt_len);
+
+	rt_md = mtk_ccci_lk_smem_md_addr(rt);
+	af.head_pattern = cpu_to_le32(MTK_CCCI_AP_FEATURE_PATTERN);
+	af.share_memory_support = cpu_to_le32(MTK_CCCI_SHM_MULTI_MD_MPU);
+	af.ap_runtime_data_addr = cpu_to_le32(rt_md);
+	af.ap_runtime_data_size = cpu_to_le32(MTK_CCCI_RT_AP_SIZE);
+	af.md_runtime_data_addr = cpu_to_le32(rt_md + MTK_CCCI_RT_AP_SIZE);
+	af.md_runtime_data_size = cpu_to_le32(MTK_CCCI_RT_MD_SIZE);
+	rt_mpu_window(ccci->lk.nc_smem, ccci->lk.nc_smem_num,
+		      &af.noncached_mpu_start_addr, &af.noncached_mpu_total_size);
+	rt_mpu_window(ccci->lk.c_smem, ccci->lk.c_smem_num,
+		      &af.cached_mpu_start_addr, &af.cached_mpu_total_size);
+	/* feature 1: support 0, version 1 = MPU size is AP-MD1 + MD1-MD3 */
+	af.feature[1] = ft_byte(0, 1);
+	af.tail_pattern = cpu_to_le32(MTK_CCCI_AP_FEATURE_PATTERN);
+
+	dev_info(ccci->dev,
+		 "runtime data: %u bytes at %#x, MPU nc %#x+%#x c %#x+%#x\n",
+		 ccci->rt_len, rt_md, le32_to_cpu(af.noncached_mpu_start_addr),
+		 le32_to_cpu(af.noncached_mpu_total_size),
+		 le32_to_cpu(af.cached_mpu_start_addr),
+		 le32_to_cpu(af.cached_mpu_total_size));
+
+	mtk_ccci_ccif_write_rt(ccci, &af, sizeof(af));
+	return mtk_ccci_ccif_notify(ccci, MTK_CCIF_CH_SRAM);
+}
+
+/* debugfs: what was agreed on and the AP half of the runtime data */
+void mtk_ccci_rt_show(struct mtk_ccci *ccci, struct seq_file *s)
+{
+	unsigned int i;
+
+	if (!ccci->rt_len)
+		return;
+	seq_puts(s, "runtime answer:");
+	for (i = 0; i < MTK_CCCI_FEATURE_COUNT; i++)
+		if (ccci->rt_answer[i])
+			seq_printf(s, " %u:%#x", i, ccci->rt_answer[i]);
+	seq_printf(s, "\nruntime data: %u bytes\n", ccci->rt_len);
+	seq_hex_dump(s, "  ", DUMP_PREFIX_OFFSET, 16, 4, ccci->rt_copy,
+		     ccci->rt_len, false);
+}
