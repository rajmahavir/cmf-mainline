+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/memory-controllers/mediatek,mt6878-smi-larb-native.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 native display SMI local arbiters
+
+maintainers:
+  - Yong Wu <yong.wu@mediatek.com>
+
+description: |
+  Display larb0 and larb1 occupy 4 KiB at 0x1401e000 and 0x1401f000
+  respectively. Each uses the MMSYS SMI_COMMON gate as its only clock and
+  depends on the native display SMI common at 0x1e801000. The display power
+  and IOMMU providers establish cold ownership before a DMA client can run.
+
+properties:
+  compatible:
+    const: mediatek,mt6878-smi-larb-native
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: MMSYS SMI_COMMON gate for register access.
+
+  clock-names:
+    const: apb
+
+  power-domains:
+    maxItems: 1
+    description: DISP (8) from the native MT6878 display power controller.
+
+  mediatek,smi:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the MT6878 native display SMI common.
+
+  mediatek,larb-id:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1]
+    description: Hardware local arbiter ID corresponding to the register bank.
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - power-domains
+  - mediatek,smi
+  - mediatek,larb-id
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/memory-controllers/mediatek,mt6878-smi-native.yaml b/Documentation/devicetree/bindings/memory-controllers/mediatek,mt6878-smi-native.yaml
new file mode 100644
index 000000000..1a455f277
--- /dev/null
+++ b/Documentation/devicetree/bindings/memory-controllers/mediatek,mt6878-smi-native.yaml
@@ -0,0 +1,85 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/memory-controllers/mediatek,mt6878-smi-native.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 native display SMI Gen3 commons
+
+maintainers:
+  - Yong Wu <yong.wu@mediatek.com>
+
+description: |
+  The display common at 0x1e801000 has two independent sub-common suppliers,
+  SSC0 at 0x1e807000 and SSC1 at 0x1e808000. The GCE 3x1 sub-common at
+  0x1e809000 depends on the display common. All four 4 KiB banks belong to MM_INFRA. These profiles have no separate clock inputs. This is
+  a native ownership interface, without the vendor initialization-on-probe
+  or decoupled-power properties. The native display power provider must
+  already have established exclusive, cold ownership; firmware takeover is
+  not performed by these nodes. System sleep and live removal are unsupported.
+
+properties:
+  compatible:
+    enum:
+      - mediatek,mt6878-smi-common-native
+      - mediatek,mt6878-smi-sub-common-native
+      - mediatek,mt6878-smi-gce-sub-common-native
+
+  reg:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+    description: |
+      The dedicated mediatek,mt6878-display-power-controller provider with
+      one argument, MM_INFRA (7), shared by the common and both suppliers.
+
+  mediatek,smi-suppliers:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 1
+    maxItems: 2
+    items:
+      maxItems: 1
+    description: |
+      Display common references SSC0 then SSC1. The GCE sub-common references
+      display common. Each consumer holds explicit runtime references to its
+      suppliers while active.
+
+required:
+  - compatible
+  - reg
+  - power-domains
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: mediatek,mt6878-smi-common-native
+    then:
+      properties:
+        mediatek,smi-suppliers:
+          minItems: 2
+      required:
+        - mediatek,smi-suppliers
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: mediatek,mt6878-smi-gce-sub-common-native
+    then:
+      properties:
+        mediatek,smi-suppliers:
+          maxItems: 1
+      required:
+        - mediatek,smi-suppliers
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: mediatek,mt6878-smi-sub-common-native
+    then:
+      properties:
+        mediatek,smi-suppliers: false
+
+additionalProperties: false
