@@ -0,0 +1,131 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/mediatek,mt6878-display-power-controller.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 display power hierarchy
+
+maintainers:
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+  - Matthias Brugger <mbrugger@suse.com>
+
+description: |
+  This controller is a child of the SPM syscon and a sibling of the existing
+  connectivity power controller. MM_INFRA (7) uses the separate hardware voter
+  syscon and parents the direct SPM-controlled DISP domain (8). The driver
+  requires both domains to be idle and off for cold registration. Firmware
+  display takeover is a prerequisite for both registration modes. The
+  existing connectivity controller and its domain IDs remain unchanged.
+
+properties:
+  mediatek,retain-boot-display:
+    type: boolean
+    description: |
+      Adopt coherent powered MM_INFRA and DISP domains with critical boot
+      voter clocks and both DISP SMI gates already retained. Keep both domains
+      on until reboot. System
+      sleep and dynamic removal are unsupported in this mode.
+
+  mediatek,boot-on-adoption:
+    type: boolean
+    description: |
+      Trial-only adoption of the already-powered LK display. Requires the
+      retained clock and gate checks and adds a missing MM_INFRA AP power
+      vote. Allows DISP status bit 18 with all DISP protection requests
+      clear. Both domains remain on until reboot.
+
+  $nodename:
+    const: display-power-controller
+
+  compatible:
+    const: mediatek,mt6878-display-power-controller
+
+  '#power-domain-cells':
+    const: 1
+
+  '#address-cells':
+    const: 1
+
+  '#size-cells':
+    const: 0
+
+  mediatek,hw-voter:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Separate hardware voter syscon register bank.
+
+  access-controllers:
+    minItems: 1
+    maxItems: 1
+    description: INFRACFG register bank providing DISP bus protection.
+
+  power-domain@7:
+    $ref: /schemas/power/mediatek,power-controller.yaml#/$defs/power-domain-node
+    type: object
+    properties:
+      reg:
+        const: 7
+      '#power-domain-cells':
+        const: 0
+      '#address-cells':
+        const: 1
+      '#size-cells':
+        const: 0
+      clocks:
+        maxItems: 1
+      clock-names:
+        items:
+          - const: mm_infra
+      domain-supply: false
+      mediatek,infracfg: false
+      mediatek,infracfg-nao: false
+      mediatek,smi: false
+      power-domain@8:
+        $ref: /schemas/power/mediatek,power-controller.yaml#/$defs/power-domain-node
+        type: object
+        properties:
+          reg:
+            const: 8
+          '#power-domain-cells':
+            const: 0
+          '#address-cells': false
+          '#size-cells': false
+          clocks:
+            minItems: 3
+            maxItems: 3
+          clock-names:
+            items:
+              - const: disp
+              - const: disp0-0
+              - const: disp0-1
+          domain-supply: false
+          mediatek,infracfg: false
+          mediatek,infracfg-nao: false
+          mediatek,smi: false
+        required:
+          - '#power-domain-cells'
+          - clocks
+          - clock-names
+        unevaluatedProperties: false
+    required:
+      - '#power-domain-cells'
+      - '#address-cells'
+      - '#size-cells'
+      - clocks
+      - clock-names
+      - power-domain@8
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - '#power-domain-cells'
+  - '#address-cells'
+  - '#size-cells'
+  - mediatek,hw-voter
+  - access-controllers
+  - power-domain@7
+
+dependencies:
+  mediatek,boot-on-adoption: ["mediatek,retain-boot-display"]
+
+additionalProperties: false
