+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6878-mdpsys.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 MDPSYS clock controller
+
+maintainers:
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+  - Matthias Brugger <mbrugger@suse.com>
+
+description:
+  MDPSYS provides twelve gate clocks, including the SMI gate used by the DISP
+  power sequence. Gate IDs are defined in mediatek,mt6878-clock.h. The input
+  is TOPCKGEN's DISP0 clock. This is a clock provider, not an MDP engine driver.
+
+properties:
+  compatible:
+    const: mediatek,mt6878-mdpsys
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: disp0
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mediatek,mt6878-clock.h>
+
+    clock-controller@1f000000 {
+        compatible = "mediatek,mt6878-mdpsys";
+        reg = <0x1f000000 0x1000>;
+        clocks = <&topckgen CLK_TOP_DISP0>;
+        clock-names = "disp0";
+        #clock-cells = <1>;
+    };
