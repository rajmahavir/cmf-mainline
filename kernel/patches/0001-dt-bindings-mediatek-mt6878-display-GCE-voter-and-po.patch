+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6878-gce-clocks.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 GCE-D clock votes
+
+maintainers:
+  - Houlong Wei <houlong.wei@mediatek.com>
+
+description: |
+  The MM_INFRA gate bank at 0x1e800000 exposes the GCE-D core and timer
+  clock status. Clock requests are issued through the hardware voter.
+  The consumer must keep this provider runtime-active in the MM_INFRA
+  power domain before preparing the clocks.
+
+properties:
+  compatible:
+    const: mediatek,mt6878-gce-clocks
+
+  reg:
+    maxItems: 1
+
+  "#clock-cells":
+    const: 1
+    description: Clock ID 0 for GCE-D or 2 for the timer.
+
+  clocks:
+    maxItems: 1
+    description: The native MM_INFRA parent vote.
+
+  clock-names:
+    const: mminfra
+
+  power-domains:
+    maxItems: 1
+    description: MM_INFRA from the native MT6878 display power controller.
+
+  mediatek,hardware-voter:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Hardware-voter syscon at 0x10320000.
+
+required:
+  - compatible
+  - reg
+  - "#clock-cells"
+  - clocks
+  - clock-names
+  - power-domains
+  - mediatek,hardware-voter
+
+additionalProperties: false
