@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/arm/mediatek/mediatek,mt6878-mmsys0-native.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 native MMSYS route controller
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+description:
+  Powered MMSYS route and DSI-lane controller. Gate clocks are registered by
+  the independent mediatek,mt6878-display-gates provider, which shares this
+  configuration bank. This node does not register a clock-provider child.
+  This split permits DISP registration before the powered controller probes.
+
+properties:
+  compatible:
+    const: mediatek,mt6878-mmsys0-native
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: Top-level DISP vote supplying the configuration bus.
+
+  clock-names:
+    const: bus
+
+  power-domains:
+    maxItems: 1
+    description: DISP power domain.
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - power-domains
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mediatek,mt6878-display-voter.h>
+    #include <dt-bindings/power/mediatek,mt6878-power.h>
+
+    system-controller@14000000 {
+        compatible = "mediatek,mt6878-mmsys0-native";
+        reg = <0x14000000 0x1000>;
+        clocks = <&display_voter CLK_MT6878_DISP_VOTE>;
+        clock-names = "bus";
+        power-domains = <&display_power MT6878_POWER_DOMAIN_DISP>;
+    };
diff --git a/Documentation/devicetree/bindings/clock/mediatek,mt6878-display-clock-voter.yaml b/Documentation/devicetree/bindings/clock/mediatek,mt6878-display-clock-voter.yaml
new file mode 100644
index 000000000..1ee88dfb5
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6878-display-clock-voter.yaml
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6878-display-clock-voter.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 display clock voter
+
+maintainers:
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+  - Matthias Brugger <mbrugger@suse.com>
+
+description: |
+  Two clock vote gates parented by the existing TOPCKGEN DISP0 and MMINFRA
+  selectors. The voter writes separate HWV vote registers and waits for the
+  corresponding TOPCKGEN physical gate to open. Existing mux IDs and operations
+  are unchanged. Output IDs are defined in mediatek,mt6878-display-voter.h.
+  Both votes must be idle and unowned for cold registration. This fixed built-in
+  provider cannot be removed while a failed transaction retains parent clocks;
+  recovery of a latched fault requires reboot. It does not perform firmware
+  display takeover or provide power ownership for downstream gate providers.
+
+properties:
+  mediatek,retain-boot-clocks:
+    type: boolean
+    description: |
+      Retain inherited enabled clocks as critical until reboot. Requires
+      coherent live hardware state and fixed built-in ownership. The gate
+      provider also requires retention on its native display voter parent.
+      This is a staged boot-adoption mode; domain adoption is separate.
+
+  mediatek,acquire-boot-clock-votes:
+    type: boolean
+    description: |
+      Add missing AP votes for both physically enabled boot clocks. Use only
+      after firmware has transferred clock control and the boot owner will
+      preserve the live clock state through acquisition. Requires retained
+      registration. The provider pins the upstream references and rate
+      protection before adding votes and keeps them until reboot.
+
+  compatible:
+    const: mediatek,mt6878-display-clock-voter
+
+  mediatek,topckgen:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: MT6878 TOPCKGEN syscon also supplying both input clocks.
+
+  mediatek,hardware-voter:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Separate hardware voter syscon register bank.
+
+  clocks:
+    items:
+      - description: TOPCKGEN CLK_TOP_DISP0_SEL input.
+      - description: TOPCKGEN CLK_TOP_MMINFRA_SEL input.
+
+  clock-names:
+    items:
+      - const: disp
+      - const: mminfra
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - mediatek,topckgen
+  - mediatek,hardware-voter
+  - clocks
+  - clock-names
+  - '#clock-cells'
+
+dependencies:
+  mediatek,acquire-boot-clock-votes: ["mediatek,retain-boot-clocks"]
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mediatek,mt6878-clock.h>
+
+    clock-controller {
+        compatible = "mediatek,mt6878-display-clock-voter";
+        mediatek,topckgen = <&topckgen>;
+        mediatek,hardware-voter = <&hwv>;
+        clocks = <&topckgen CLK_TOP_DISP0_SEL>,
+                 <&topckgen CLK_TOP_MMINFRA_SEL>;
+        clock-names = "disp", "mminfra";
+        #clock-cells = <1>;
+    };
diff --git a/Documentation/devicetree/bindings/clock/mediatek,mt6878-display-gates.yaml b/Documentation/devicetree/bindings/clock/mediatek,mt6878-display-gates.yaml
new file mode 100644
index 000000000..7505701a8
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6878-display-gates.yaml
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6878-display-gates.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 independent native display gate provider
+
+maintainers:
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+  - Matthias Brugger <mbrugger@suse.com>
+
+description: |
+  Registers MMSYS and MDPSYS clocks before the DISP power domain, avoiding a
+  clock-provider and power-domain registration cycle. The register resource is
+  the MDPSYS configuration bank. MMSYS configuration is shared with the native
+  route controller referenced by mediatek,mmsys. The old MMSYS and MDPSYS clock
+  providers must be disabled. Cold registration requires DISP off.
+  It does not acquire a DISP domain reference; consumers must hold that domain
+  before preparing a gate, except its own power sequence's SMI bootstrap clocks.
+  SPM state is checked before gate-bank access. No gate registers are accessed
+  by initial clock-state queries. This is not firmware takeover.
+  The first clock argument is MT6878_DISPLAY_GATE_MM or MT6878_DISPLAY_GATE_MDP
+  from mediatek,mt6878-display-gates.h; the second is the corresponding existing
+  CLK_MM_* or CLK_MDP_* ID from mediatek,mt6878-clock.h. Failed gate transactions
+  can pin parent references until reboot; this fixed built-in provider does not
+  support dynamic removal.
+
+properties:
+  mediatek,retain-boot-clocks:
+    type: boolean
+    description: |
+      Retain inherited enabled clocks as critical until reboot. Requires
+      coherent live hardware state and fixed built-in ownership. The gate
+      provider also requires retention on its native display voter parent.
+      This is a staged boot-adoption mode; domain adoption is separate.
+
+  compatible:
+    const: mediatek,mt6878-display-gates
+
+  reg:
+    maxItems: 1
+    description: MDPSYS configuration at 0x1f000000.
+
+  mediatek,mmsys:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Native MT6878 MMSYS route controller at 0x14000000.
+
+  mediatek,spm:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Always-on SPM syscon at 0x1c001000 providing DISP status.
+
+  clocks:
+    maxItems: 1
+    description: DISP vote output from the MT6878 display clock voter.
+
+  clock-names:
+    const: disp
+
+  '#clock-cells':
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - mediatek,mmsys
+  - mediatek,spm
+  - clocks
+  - clock-names
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mediatek,mt6878-display-voter.h>
+
+    clock-controller@1f000000 {
+        compatible = "mediatek,mt6878-display-gates";
+        reg = <0x1f000000 0x1000>;
+        mediatek,mmsys = <&mmsys>;
+        mediatek,spm = <&spm>;
+        clocks = <&display_voter CLK_MT6878_DISP_VOTE>;
+        clock-names = "disp";
+        #clock-cells = <2>;
+    };
diff --git a/Documentation/devicetree/bindings/clock/mediatek,mt6878-gce-clocks.yaml b/Documentation/devicetree/bindings/clock/mediatek,mt6878-gce-clocks.yaml
