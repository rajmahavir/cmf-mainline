diff --git a/Documentation/devicetree/bindings/power/mediatek,mt6878-display-power-controller.yaml b/Documentation/devicetree/bindings/power/mediatek,mt6878-display-power-controller.yaml
new file mode 100644
index 000000000..09a398990
--- /dev/null
