From 7f3d6a3292110a78c54814f81f23f4c56c915519 Mon Sep 17 00:00:00 2001
From: CMF Mainline Port <cmf-mainline@users.noreply.github.com>
Date: Fri, 27 Nov 2026 07:12:10 +0000
Subject: [PATCH 09/13] pinctrl/mmc: mediatek: EINT and MSDC fixes for MT6878

CMF Phone 1 (MT6878) mainline port, Stage 95c. Rebased onto MT6878-Mainline/linux 12f2e9f04.

Signed-off-by: CMF Mainline Port <cmf-mainline@users.noreply.github.com>
---
 drivers/mmc/host/mtk-sd.c                | 20 ++++++++++++++++++++
 drivers/pinctrl/mediatek/mtk-eint.c      |  5 +++++
 drivers/pinctrl/mediatek/pinctrl-paris.h |  2 +-
 3 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/drivers/mmc/host/mtk-sd.c b/drivers/mmc/host/mtk-sd.c
index b2680cc05..360d1f732 100644
--- a/drivers/mmc/host/mtk-sd.c
+++ b/drivers/mmc/host/mtk-sd.c
@@ -712,7 +712,27 @@ static const struct mtk_mmc_compatible mt8196_compat = {
 	.support_new_rx = true,
 };
 
+/* MT6878 vendor TX-v2 timing matches msdc_new_tx_setting(). */
+static const struct mtk_mmc_compatible mt6878_compat = {
+	.clk_div_bits = 12,
+	.recheck_sdio_irq = false,
+	.hs400_tune = false,
+	.needs_top_base = true,
+	.pad_tune_reg = MSDC_PAD_TUNE0,
+	.async_fifo = true,
+	.data_tune = true,
+	.busy_check = true,
+	.stop_clk_fix = true,
+	.stop_dly_sel = 3,
+	.pop_en_cnt = 8,
+	.enhance_rx = true,
+	.support_64g = true,
+	.support_new_tx = true,
+	.support_new_rx = true,
+};
+
 static const struct of_device_id msdc_of_ids[] = {
+	{ .compatible = "mediatek,mt6878-mmc", .data = &mt6878_compat},
 	{ .compatible = "mediatek,mt2701-mmc", .data = &mt2701_compat},
 	{ .compatible = "mediatek,mt2712-mmc", .data = &mt2712_compat},
 	{ .compatible = "mediatek,mt6779-mmc", .data = &mt6779_compat},
diff --git a/drivers/pinctrl/mediatek/mtk-eint.c b/drivers/pinctrl/mediatek/mtk-eint.c
index 47ac92ea9..ea19d0898 100644
--- a/drivers/pinctrl/mediatek/mtk-eint.c
+++ b/drivers/pinctrl/mediatek/mtk-eint.c
@@ -525,6 +525,9 @@ int mtk_eint_do_init(struct mtk_eint *eint, struct mtk_eint_pin *eint_pin)
 	if (eint_pin) {
 		eint->pins = eint_pin;
 		for (i = 0; i < eint->hw->ap_num; i++) {
+			/* Sparse tables leave unused EINT numbers zero-filled. */
+			if (eint->pins[i].number != i)
+				continue;
 			inst = eint->pins[i].instance;
 			if (inst >= eint->nbase)
 				continue;
@@ -588,6 +591,8 @@ int mtk_eint_do_init(struct mtk_eint *eint, struct mtk_eint_pin *eint_pin)
 
 	mtk_eint_hw_init(eint);
 	for (i = 0; i < eint->hw->ap_num; i++) {
+		if (eint_pin && eint->pins[i].number != i)
+			continue;
 		inst = eint->pins[i].instance;
 		if (inst >= eint->nbase)
 			continue;
diff --git a/drivers/pinctrl/mediatek/pinctrl-paris.h b/drivers/pinctrl/mediatek/pinctrl-paris.h
index d8c182266..a793f0ac8 100644
--- a/drivers/pinctrl/mediatek/pinctrl-paris.h
+++ b/drivers/pinctrl/mediatek/pinctrl-paris.h
@@ -49,7 +49,7 @@
 			__VA_ARGS__, { } },				\
 	}
 
-#define MTK_EINT_PIN(_number, _instance, _index, _debounce) {	\
+#define MTK_EINT_PIN(_number, _instance, _index, _debounce) [_number] = {	\
 		.number = _number,				\
 		.instance = _instance,				\
 		.index = _index,				\
-- 
2.53.0

