@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef MTK_DSI_N4_H
+#define MTK_DSI_N4_H
+
+#include <linux/types.h>
+
+/* MT6878 DSI0/1 fixed FIFO depth from the vendor Tetris v/16b driver. */
+#define MT6878_DSI_FIFO_WORDS 1554
+
+/*
+ * Stage 57: the vendor computes the DSI FIFO/urgency thresholds from
+ * mtk_drm_get_mmclk(), the MMDVFS level, and falls back to 208 MHz when no
+ * level is set; it is not the DISP0 clock rate. LK's live thresholds equal
