diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c b/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c
new file mode 100644
index 000000000..09dcbe544
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e8fc3x02.c
@@ -0,0 +1,400 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S6E8FC3X02 panel used by the CMF Phone 1.
+ * Power sequence and commands adapted from the MediaTek vendor driver.
+ * Copyright (c) 2019 MediaTek Inc.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+/* The vendor sends bytes 0..88 via DCS 0x9e, not a DSI PPS packet. */
+#define S6E8FC3X02_PPS_LEN 89
+
+struct s6e8fc3x02 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset;
+	struct gpio_desc *vddi_en;
+	struct gpio_desc *vci_en;
+	struct mutex lock;
+	bool prepared;
+};
+
+static const struct drm_dsc_config s6e8fc3x02_dsc = {
+	.dsc_version_major = 1,
+	.dsc_version_minor = 1,
+	.line_buf_depth = 9,
+	.bits_per_component = 8,
+	.block_pred_enable = true,
+	.convert_rgb = true,
+	.bits_per_pixel = 128,
+	.pic_height = 2400,
+	.pic_width = 1080,
+	.slice_height = 40,
+	.slice_width = 540,
+	.slice_count = 2,
+	.slice_chunk_size = 540,
+	.initial_xmit_delay = 512,
+	.initial_dec_delay = 526,
+	.initial_scale_value = 32,
+	.scale_increment_interval = 989,
+	.scale_decrement_interval = 7,
+	.first_line_bpg_offset = 12,
+	.nfl_bpg_offset = 631,
+	.slice_bpg_offset = 651,
+	.initial_offset = 6144,
+	.final_offset = 4336,
+	.flatness_min_qp = 3,
+	.flatness_max_qp = 12,
+	.rc_model_size = 8192,
+	.rc_edge_factor = 6,
+	.rc_quant_incr_limit0 = 11,
+	.rc_quant_incr_limit1 = 11,
+	.rc_tgt_offset_high = 3,
+	.rc_tgt_offset_low = 3,
+	.mux_word_size = 48,
+	.rc_buf_thresh = { 14, 28, 42, 56, 70, 84, 98, 105, 112, 119, 121, 123, 125, 126 },
+	.rc_range_params = {
+		{ 0, 4, 2 },
+		{ 0, 4, 0 },
+		{ 1, 5, 0 },
+		{ 1, 6, 62 },
+		{ 3, 7, 60 },
+		{ 3, 7, 58 },
+		{ 3, 7, 56 },
+		{ 3, 8, 56 },
+		{ 3, 9, 56 },
+		{ 3, 10, 54 },
+		{ 5, 11, 54 },
+		{ 5, 12, 52 },
+		{ 5, 13, 52 },
+		{ 7, 13, 52 },
+		{ 13, 15, 52 },
+	},
+};
+
+static void s6e8fc3x02_write(struct mipi_dsi_multi_context *ctx,
+			   const u8 *data, size_t len)
+{
+	/* Match the vendor's DCS/generic packet split exactly. */
+	if (data[0] < 0xb0)
+		mipi_dsi_dcs_write_buffer_multi(ctx, data, len);
+	else
+		mipi_dsi_generic_write_multi(ctx, data, len);
+}
+
+#define s6e8fc3x02_write_seq(ctx, seq...) do { \
+	static const u8 data[] = { seq }; \
+	s6e8fc3x02_write(ctx, data, ARRAY_SIZE(data)); \
+} while (0)
+
+static void s6e8fc3x02_power_off(struct s6e8fc3x02 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(1000, 5000);
+	gpiod_set_value_cansleep(ctx->vci_en, 0);
+	usleep_range(1000, 5000);
+	gpiod_set_value_cansleep(ctx->vddi_en, 0);
+}
+
+/*
+ * A panel driver is not told which mode was chosen, so the rate is fixed per
+ * boot: only the matching mode is advertised and prepare sends the matching
+ * frame-rate command, so the DSI timing and the panel can never disagree.
+ */
+static unsigned int refresh_hz = 120;
+module_param(refresh_hz, uint, 0444);
+MODULE_PARM_DESC(refresh_hz, "Panel refresh rate: 120 (default) or 60");
+
+static int s6e8fc3x02_prepare(struct drm_panel *panel)
+{
+	struct s6e8fc3x02 *ctx = container_of(panel, struct s6e8fc3x02, panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	u8 pps_cmd[1 + sizeof(struct drm_dsc_picture_parameter_set)];
+
+	mutex_lock(&ctx->lock);
+	if (ctx->prepared)
+		goto out;
+
+	gpiod_set_value_cansleep(ctx->vddi_en, 1);
+	usleep_range(1000, 5000);
+	gpiod_set_value_cansleep(ctx->vci_en, 1);
+	usleep_range(1000, 5000);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(10000, 11000);
+
+	pps_cmd[0] = 0x9e;
+	drm_dsc_pps_payload_pack((struct drm_dsc_picture_parameter_set *)(pps_cmd + 1),
+				 &ctx->dsc);
+
+	s6e8fc3x02_write_seq(&dsi_ctx, 0x9F, 0xA5, 0xA5);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xF0, 0x5A, 0x5A);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xFC, 0x5A, 0x5A);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0x11);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0x35, 0x00);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xB2, 0x01, 0x31);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xDF, 0x09, 0x30, 0x95, 0x41, 0x3A, 0x41, 0x3A);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0x9D, 0x01);
+	s6e8fc3x02_write(&dsi_ctx, pps_cmd, 1 + S6E8FC3X02_PPS_LEN);
+
+	/* Flat Gamma Control */
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xB0, 0x00, 0x89, 0xB1);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xB1, 0x2D);
+
+	/* Frame-rate select (vendor dfps table): 0x01 = 120 Hz, 0x21 = 60 Hz. */
+	if (refresh_hz == 120)
+		s6e8fc3x02_write_seq(&dsi_ctx, 0x60, 0x01);
+	else
+		s6e8fc3x02_write_seq(&dsi_ctx, 0x60, 0x21);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xF7, 0x0B);
+
+	/* VINT Voltage control */
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xB0, 0x00, 0x11, 0xFE);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xFE, 0x00);
+
+	/* Dimming Setting */
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xB0, 0x00, 0x0D, 0xB2);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xB2, 0x01);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xB0, 0x00, 0x0C, 0xB2);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xB2, 0x20);
+
+
+	/* Normal brightness only; do not enter the vendor HBM range. */
+	s6e8fc3x02_write_seq(&dsi_ctx, 0x53, 0x20);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0x51, 0x00, 0x00);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xf7, 0x0b);
+
+	/* Error-flag configuration from the panel vendor sequence. */
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xed, 0x01, 0xcd, 0x00);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xe1, 0x83);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xb0, 0x00, 0x06, 0xf4);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xf4, 0x1f);
+	mipi_dsi_msleep(&dsi_ctx, 100);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0x29);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+
+	if (dsi_ctx.accum_err)
+		s6e8fc3x02_power_off(ctx);
+	else
+		ctx->prepared = true;
+out:
+	mutex_unlock(&ctx->lock);
+	return dsi_ctx.accum_err;
+}
+
+static int s6e8fc3x02_unprepare(struct drm_panel *panel)
+{
+	struct s6e8fc3x02 *ctx = container_of(panel, struct s6e8fc3x02, panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mutex_lock(&ctx->lock);
+	if (ctx->prepared) {
+		mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+		mipi_dsi_msleep(&dsi_ctx, 20);
+		mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+		mipi_dsi_msleep(&dsi_ctx, 160);
+		s6e8fc3x02_power_off(ctx);
+		ctx->prepared = false;
+	}
+	mutex_unlock(&ctx->lock);
+
+	return dsi_ctx.accum_err;
+}
+
+/* Keep the vendor pixel clock and extend VFP for exactly 60 Hz. */
+static const struct drm_display_mode s6e8fc3x02_mode = {
+	.clock = 377349,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 173,
+	.hsync_end = 1080 + 173 + 16,
+	.htotal = 1080 + 173 + 16 + 24,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 2452,
+	.vsync_end = 2400 + 2452 + 2,
+	.vtotal = 2400 + 2452 + 2 + 10,
+};
+
+/*
+ * Same link, clock and horizontal timing; VFP 20 halves vtotal (4864 -> 2432)
+ * for ~119.3 Hz, matching the vendor dfps mode (Stage 53/78).
+ */
+static const struct drm_display_mode s6e8fc3x02_mode_120 = {
+	.clock = 377349,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 173,
+	.hsync_end = 1080 + 173 + 16,
+	.htotal = 1080 + 173 + 16 + 24,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 20,
+	.vsync_end = 2400 + 20 + 2,
+	.vtotal = 2400 + 20 + 2 + 10,
+};
+
+static int s6e8fc3x02_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, refresh_hz == 120 ?
+				  &s6e8fc3x02_mode_120 : &s6e8fc3x02_mode);
+	if (!mode)
+		return -ENOMEM;
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.bpc = 8;
+	/* Vendor-reported dimensions; verify physical size before upstreaming. */
+	connector->display_info.width_mm = 83;
+	connector->display_info.height_mm = 148;
+
+	return 1;
+}
+
+static const struct drm_panel_funcs s6e8fc3x02_panel_funcs = {
+	.prepare = s6e8fc3x02_prepare,
+	.unprepare = s6e8fc3x02_unprepare,
+	.get_modes = s6e8fc3x02_get_modes,
+};
+
+static int s6e8fc3x02_bl_update_status(struct backlight_device *bl)
+{
+	struct s6e8fc3x02 *ctx = bl_get_data(bl);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	u16 level = backlight_get_brightness(bl);
+	u8 brightness[] = { 0x51, 0x00, 0x00 };
+	unsigned long flags;
+
+	/* Preserve the panel vendor's normal-brightness exclusion range. */
+	if (level >= 417 && level <= 424)
+		level = 425;
+	brightness[1] = level >> 8;
+	brightness[2] = level & 0xff;
+
+	mutex_lock(&ctx->lock);
+	if (!ctx->prepared)
+		goto out;
+
+	/* The vendor backlight command pack is sent in HS mode. */
+	flags = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	s6e8fc3x02_write_seq(&dsi_ctx, 0x53, 0x20);
+	s6e8fc3x02_write(&dsi_ctx, brightness, sizeof(brightness));
+	s6e8fc3x02_write_seq(&dsi_ctx, 0xf7, 0x0b);
+	ctx->dsi->mode_flags = flags;
+out:
+	mutex_unlock(&ctx->lock);
+	return dsi_ctx.accum_err;
+}
+
+static const struct backlight_ops s6e8fc3x02_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = s6e8fc3x02_bl_update_status,
+};
+
+static int s6e8fc3x02_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e8fc3x02 *ctx;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = 2047,
+		.brightness = 256,
+	};
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e8fc3x02, panel,
+				    &s6e8fc3x02_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	mutex_init(&ctx->lock);
+	ctx->dsi = dsi;
+	ctx->dsc = s6e8fc3x02_dsc;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	/*
+	 * LK leaves the panel powered and out of reset. Keep that state at probe:
+	 * cutting VDDI/VCI and asserting reset here, milliseconds before the first
+	 * prepare, left the panel unable to take its first command (Stage 68).
+	 * Prepare still pulses reset on the settled panel.
+	 * New DT must describe reset as GPIO_ACTIVE_LOW, unlike the vendor DT.
+	 */
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset), "Failed to get reset GPIO\n");
+	ctx->vddi_en = devm_gpiod_get(dev, "vddi-en", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->vddi_en))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddi_en), "Failed to get VDDI GPIO\n");
+	ctx->vci_en = devm_gpiod_get(dev, "vci-en", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->vci_en))
+		return dev_err_probe(dev, PTR_ERR(ctx->vci_en), "Failed to get VCI GPIO\n");
+
+	/* Vendor ext_params specifies data_rate = 1140 Mbps per lane. */
+	dsi->hs_rate = 1140000000;
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	dsi->dsc = &ctx->dsc;
+	ctx->panel.prepare_prev_first = true;
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev), dev,
+							    ctx, &s6e8fc3x02_bl_ops, &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to register backlight\n");
+
+	drm_panel_add(&ctx->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach DSI device\n");
+	}
+
+	return 0;
+}
+
+static void s6e8fc3x02_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e8fc3x02 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret)
+		dev_warn(&dsi->dev, "Failed to detach DSI device: %d\n", ret);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e8fc3x02_of_match[] = {
+	{ .compatible = "samsung,s6e8fc3x02" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s6e8fc3x02_of_match);
+
+static struct mipi_dsi_driver s6e8fc3x02_driver = {
+	.probe = s6e8fc3x02_probe,
+	.remove = s6e8fc3x02_remove,
+	.driver = {
+		.name = "panel-samsung-s6e8fc3x02",
+		.of_match_table = s6e8fc3x02_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e8fc3x02_driver);
+
+MODULE_DESCRIPTION("Samsung S6E8FC3X02 CMF Phone 1 panel driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/gpu/drm/panthor/panthor_drv.c b/drivers/gpu/drm/panthor/panthor_drv.c
index e8dc4096c..1defae3a5 100644
--- a/drivers/gpu/drm/panthor/panthor_drv.c
+++ b/drivers/gpu/drm/panthor/panthor_drv.c
@@ -39,6 +39,10 @@
 #include "panthor_mmu.h"
 #include "panthor_sched.h"
 
+#include <linux/device.h>
+#include <linux/platform_device.h>
+#include <linux/workqueue.h>
+
 /**
  * DOC: user <-> kernel object copy helpers.
  */
@@ -1903,6 +1907,44 @@ static struct platform_driver panthor_driver = {
  */
 struct workqueue_struct *panthor_cleanup_wq;
 
+#if !defined(MODULE) && IS_ENABLED(CONFIG_DRM_MEDIATEK)
+/*
+ * CMF Phone 1: keep the display on DRM card0. Built in, Panthor would
+ * register at ~0.2 s, long before mediatek-drm binds (~10 s), and the
+ * userspace stack addresses the display as card0. Register the Panthor
+ * platform driver once mediatek-drm is bound, or after 30 s regardless.
+ */
+static struct delayed_work panthor_cmf_reg_work;
+static unsigned int panthor_cmf_waits;
+
+static bool panthor_cmf_display_bound(void)
+{
+	struct device *dev;
+	bool bound;
+
+	dev = bus_find_device_by_name(&platform_bus_type, NULL,
+				      "mediatek-drm.0.auto");
+	if (!dev)
+		return false;
+	bound = device_is_bound(dev);
+	put_device(dev);
+	return bound;
+}
+
+static void panthor_cmf_register(struct work_struct *work)
+{
+	int ret;
+
+	if (!panthor_cmf_display_bound() && ++panthor_cmf_waits < 300) {
+		schedule_delayed_work(&panthor_cmf_reg_work, msecs_to_jiffies(100));
+		return;
+	}
+	ret = platform_driver_register(&panthor_driver);
+	pr_info("panthor: registered after waiting %u ms for the display: %d\n",
+		panthor_cmf_waits * 100, ret);
+}
+#endif
+
 static int __init panthor_init(void)
 {
 	int ret;
