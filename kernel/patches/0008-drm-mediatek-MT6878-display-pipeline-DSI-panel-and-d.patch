 	mtk_crtc->enabled = true;
+	/* Stage 86: switch the fixed DSC path to translated scanout once per boot. */
+	if (mtk_crtc->fixed_dsc_path)
+		mt6878_disp_iommu_schedule_attach();
 }
 
 static void mtk_crtc_atomic_disable(struct drm_crtc *crtc,
@@ -853,6 +1038,16 @@ static void mtk_crtc_atomic_begin(struct drm_crtc *crtc,
 	struct drm_device *dev = mtk_crtc->base.dev;
 	unsigned long flags;
 
+	if (mtk_crtc->fixed_dsc_path && !mtk_crtc->enabled) {
+		if (mtk_crtc_state->base.event) {
+			spin_lock_irqsave(&crtc->dev->event_lock, flags);
+			drm_crtc_send_vblank_event(crtc, mtk_crtc_state->base.event);
+			mtk_crtc_state->base.event = NULL;
+			spin_unlock_irqrestore(&crtc->dev->event_lock, flags);
+		}
+		return;
+	}
+
 	if (mtk_crtc->event && mtk_crtc_state->base.event)
 		drm_err(dev, "new event while there is still a pending event\n");
 
@@ -874,6 +1069,9 @@ static void mtk_crtc_atomic_flush(struct drm_crtc *crtc,
