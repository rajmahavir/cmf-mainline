diff --git a/drivers/gpu/drm/tiny/cmf-lk-handoff.c b/drivers/gpu/drm/tiny/cmf-lk-handoff.c
new file mode 100644
index 000000000..f10c4ceb9
--- /dev/null
+++ b/drivers/gpu/drm/tiny/cmf-lk-handoff.c
@@ -0,0 +1,658 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CMF Phone 1 (Nothing A015 / MT6878) "LK handoff" display driver.
+ *
+ * The stock bootloader (LK) already brings up the panel, the DSI0 host
+ * (burst mode, DSC) and the OVL0_2L scanout, and leaves that pipeline running
+ * when it hands off to Linux. This driver deliberately does not re-initialise
+ * any of it: it only takes over OVL0_2L layer 0 so that Linux can provide a
+ * real KMS device (framebuffer, page flips, fbdev console) on top of the
+ * still-live pipeline.
+ *
+ * Register values and the fixed mode come from a captured known-good baseline
+ * (display-build/reference/lk-baseline): OVL size 0x09600438 (2400x1080),
+ * stride 0x1100 (4352), layer-0 address 0xfe0d0000, DSI VFP 2452.
+ *
+ * This is a bring-up driver, not a native DRM/KMS port. Panel init, DSC
+ * encoding and DSI/PHY programming remain on the roadmap.
+ */
+
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/interrupt.h>
+#include <linux/genalloc.h>
+#include <linux/scatterlist.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_device.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_dumb_buffers.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_vma_manager.h>
+#include <drm/drm_vblank.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_mode_config.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_module.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+
+/* OVL0_2L registers, same layout as vendor/mtk_disp_ovl.c. */
+#define OVL_INTEN		0x004
+#define OVL_INTSTA		0x008
+#define OVL_IRQ_FRAME_DONE	BIT(1)
+#define OVL_READ_WORK_REG	BIT(20)
+#define OVL_EN			0x00c
+#define OVL_SRC_CON		0x02c
+#define OVL_SRC_SIZE(n)		(0x038 + 0x20 * (n))
+#define OVL_PITCH(n)		(0x044 + 0x20 * (n))
+#define OVL_ADDR(n)		(0x0f40 + 0x20 * (n))
+
+/* Vendor DISP_OVL_LAYER_CONST_BLD: ignore pixel alpha for XRGB. */
+#define OVL_PITCH_CONST_BLEND	BIT(28)
+
+#define OVL_CON_EN		BIT(0)
+#define OVL_SRC_CON_L0_EN	BIT(0)
+
+/* Panel timing from the vendor panel driver: 377349 kHz, VFP 2452. */
+#define CMF_HDISPLAY		1080
+#define CMF_HFP			173
+#define CMF_HSYNC		16
+#define CMF_HBP			24
+#define CMF_VDISPLAY		2400
+#define CMF_VFP			2452
+#define CMF_VSYNC		2
+#define CMF_VBP			10
+
+struct cmf_disp {
+	struct drm_device drm;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector connector;
+	void __iomem *ovl;
+	struct drm_display_mode mode;
+	struct gen_pool *pool;
+	void *pool_vaddr;
+	int irq;
+	/* Protected by drm.event_lock; each pending event owns a vblank ref. */
+	struct drm_pending_vblank_event *pending_event;
+	u64 pending_sequence;
+	u32 pending_addr;
+	u32 pending_pitch;
+	u32 pending_size;
+};
+
+static const struct drm_display_mode cmf_disp_mode = {
+	.name		= "1080x2400",
+	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+	.clock		= 377349,
+	.hdisplay	= CMF_HDISPLAY,
+	.hsync_start	= CMF_HDISPLAY + CMF_HFP,
+	.hsync_end	= CMF_HDISPLAY + CMF_HFP + CMF_HSYNC,
+	.htotal		= CMF_HDISPLAY + CMF_HFP + CMF_HSYNC + CMF_HBP,
+	.vdisplay	= CMF_VDISPLAY,
+	.vsync_start	= CMF_VDISPLAY + CMF_VFP,
+	.vsync_end	= CMF_VDISPLAY + CMF_VFP + CMF_VSYNC,
+	.vtotal		= CMF_VDISPLAY + CMF_VFP + CMF_VSYNC + CMF_VBP,
+};
+
+static struct cmf_disp *pipe_to_cmf(struct drm_simple_display_pipe *pipe)
+{
+	return container_of(pipe, struct cmf_disp, pipe);
+}
+
+static u32 cmf_disp_fb_pitch(struct drm_framebuffer *fb)
+{
+	u32 pitch = fb->pitches[0];
+
+	if (fb->format->format == DRM_FORMAT_XRGB8888)
+		pitch |= OVL_PITCH_CONST_BLEND;
+	return pitch;
+}
+
+static void cmf_disp_program_fb(struct cmf_disp *priv,
+				struct drm_framebuffer *fb)
+{
+	struct drm_gem_dma_object *gem;
+	u32 addr, size, pitch;
+
+	if (!fb)
+		return;
+
+	gem = drm_fb_dma_get_gem_obj(fb, 0);
+	if (!gem)
+		return;
+
+	addr = gem->dma_addr + fb->offsets[0];
+	size = (fb->height << 16) | fb->width;
+	pitch = cmf_disp_fb_pitch(fb);
+
+	writel_relaxed(size, priv->ovl + OVL_SRC_SIZE(0));
+	writel_relaxed(pitch, priv->ovl + OVL_PITCH(0));
+	writel_relaxed(addr, priv->ovl + OVL_ADDR(0));
+	/* Make the new address visible before the next frame is scanned. */
+	wmb();
+
+	dev_dbg(priv->drm.dev,
+		"OVL0_2L layer0 addr=%#x size=%ux%u pitch=%u\n",
+		addr, fb->width, fb->height, pitch);
+}
+
+static bool cmf_disp_send_pending(struct cmf_disp *priv)
+{
+	struct drm_pending_vblank_event *event = priv->pending_event;
+
+	assert_spin_locked(&priv->drm.event_lock);
+	if (!event)
+		return false;
+	priv->pending_event = NULL;
+	drm_crtc_send_vblank_event(&priv->pipe.crtc, event);
+	return true;
+}
+
+static irqreturn_t cmf_disp_irq(int irq, void *data)
+{
+	struct cmf_disp *priv = data;
+	struct drm_crtc *crtc = &priv->pipe.crtc;
+	unsigned long flags;
+	u64 sequence;
+	bool put = false;
+	u32 status;
+
+	status = readl(priv->ovl + OVL_INTSTA);
+	if (!(status & OVL_IRQ_FRAME_DONE))
+		return IRQ_NONE;
+	/* MT6878 status bits are write-zero-to-clear. Own only frame complete. */
+	writel(~(u32)OVL_IRQ_FRAME_DONE, priv->ovl + OVL_INTSTA);
+	if (!drm_crtc_handle_vblank(crtc))
+		return IRQ_HANDLED;
+	sequence = drm_crtc_vblank_count(crtc);
+
+	spin_lock_irqsave(&priv->drm.event_lock, flags);
+	/* READ_WORK_REG selects latched registers, not the pending shadow copy.
+	 * Check both the frame count and the complete programmed scanout state:
+	 * a delayed IRQ must not complete an update that has not latched yet.
+	 */
+	if (priv->pending_event && sequence > priv->pending_sequence &&
+	    readl(priv->ovl + OVL_ADDR(0)) == priv->pending_addr &&
+	    readl(priv->ovl + OVL_PITCH(0)) == priv->pending_pitch &&
+	    readl(priv->ovl + OVL_SRC_SIZE(0)) == priv->pending_size)
+		put = cmf_disp_send_pending(priv);
+	spin_unlock_irqrestore(&priv->drm.event_lock, flags);
+	if (put)
+		drm_crtc_vblank_put(crtc);
+	return IRQ_HANDLED;
+}
+
+static int cmf_disp_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+	u32 mask;
+
+	/* Discard the stale LK frame flag before accepting a fresh interrupt. */
+	writel(~(u32)OVL_IRQ_FRAME_DONE, priv->ovl + OVL_INTSTA);
+	mask = readl(priv->ovl + OVL_INTEN);
+	writel(mask | OVL_IRQ_FRAME_DONE, priv->ovl + OVL_INTEN);
+	return 0;
+}
+
+static void cmf_disp_disable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+	u32 mask = readl(priv->ovl + OVL_INTEN);
+
+	writel(mask & ~OVL_IRQ_FRAME_DONE, priv->ovl + OVL_INTEN);
+	readl(priv->ovl + OVL_INTEN);
+}
+
+static void cmf_disp_irq_stop(void *data)
+{
+	struct cmf_disp *priv = data;
+
+	cmf_disp_disable_vblank(&priv->pipe);
+	synchronize_irq(priv->irq);
+}
+
+static int cmf_disp_connector_get_modes(struct drm_connector *connector)
+{
+	struct cmf_disp *priv = container_of(connector, struct cmf_disp, connector);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &priv->mode);
+	if (!mode)
+		return 0;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_connector_helper_funcs cmf_disp_connector_helper_funcs = {
+	.get_modes = cmf_disp_connector_get_modes,
+};
+
+static enum drm_connector_status
+cmf_disp_connector_detect(struct drm_connector *connector, bool force)
+{
+	return connector_status_connected;
+}
+
+static const struct drm_connector_funcs cmf_disp_connector_funcs = {
+	.detect			= cmf_disp_connector_detect,
+	.fill_modes		= drm_helper_probe_single_connector_modes,
+	.destroy		= drm_connector_cleanup,
+	.reset			= drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
+};
+
+static enum drm_mode_status
+cmf_disp_pipe_mode_valid(struct drm_simple_display_pipe *pipe,
+			 const struct drm_display_mode *mode)
+{
+	if (mode->hdisplay == CMF_HDISPLAY && mode->vdisplay == CMF_VDISPLAY)
+		return MODE_OK;
+
+	return MODE_BAD;
+}
+
+static void cmf_disp_pipe_enable(struct drm_simple_display_pipe *pipe,
+				 struct drm_crtc_state *crtc_state,
+				 struct drm_plane_state *plane_state)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+
+	cmf_disp_program_fb(priv, plane_state->fb);
+
+	/* Layer 0 is the only source; keep the DSI/PHY untouched. */
+	writel_relaxed(OVL_SRC_CON_L0_EN, priv->ovl + OVL_SRC_CON);
+	/* Keep v4 shadow mode; bit 20 changes readback selection only. */
+	writel_relaxed(OVL_CON_EN | OVL_READ_WORK_REG, priv->ovl + OVL_EN);
+	/* Order all enable writes before completing the commit. */
+	wmb();
+	drm_crtc_vblank_on(&pipe->crtc);
+}
+
+static void cmf_disp_pipe_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+	unsigned long flags;
+	bool put;
+
+	drm_crtc_vblank_off(&pipe->crtc);
+	spin_lock_irqsave(&priv->drm.event_lock, flags);
+	put = cmf_disp_send_pending(priv);
+	spin_unlock_irqrestore(&priv->drm.event_lock, flags);
+	if (put)
+		drm_crtc_vblank_put(&pipe->crtc);
+	writel_relaxed(0, priv->ovl + OVL_EN);
+	/* Order the disable write before completing the commit. */
+	wmb();
+}
+
+static void cmf_disp_pipe_update(struct drm_simple_display_pipe *pipe,
+				 struct drm_plane_state *old_state)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+	struct drm_crtc *crtc = &pipe->crtc;
+	struct drm_framebuffer *fb = pipe->plane.state->fb;
+	struct drm_pending_vblank_event *event = crtc->state->event;
+	unsigned long flags;
+	bool put = false;
+
+	spin_lock_irqsave(&priv->drm.event_lock, flags);
+	cmf_disp_program_fb(priv, fb);
+	if (event) {
+		crtc->state->event = NULL;
+		/* Atomic helper dependencies serialize event-bearing commits. */
+		if (WARN_ON_ONCE(priv->pending_event))
+			put = cmf_disp_send_pending(priv);
+		if (fb && crtc->state->active && !drm_crtc_vblank_get(crtc)) {
+			struct drm_gem_dma_object *gem = drm_fb_dma_get_gem_obj(fb, 0);
+
+			priv->pending_addr = gem->dma_addr + fb->offsets[0];
+			priv->pending_pitch = cmf_disp_fb_pitch(fb);
+			priv->pending_size = (fb->height << 16) | fb->width;
+			priv->pending_sequence = drm_crtc_vblank_count(crtc);
+			priv->pending_event = event;
+		} else {
+			/* Disabled/initial modesets have no running scanout to wait for. */
+			drm_crtc_send_vblank_event(crtc, event);
+		}
+	}
+	spin_unlock_irqrestore(&priv->drm.event_lock, flags);
+	if (put)
+		drm_crtc_vblank_put(crtc);
+}
+
+static int cmf_disp_pipe_check(struct drm_simple_display_pipe *pipe,
+			       struct drm_plane_state *plane_state,
+			       struct drm_crtc_state *crtc_state)
+{
+	struct drm_framebuffer *fb = plane_state->fb;
+
+	/* OVL always scans the full, unrotated panel-sized buffer. */
+	if (fb && (fb->width != CMF_HDISPLAY || fb->height != CMF_VDISPLAY ||
+		   plane_state->src_x || plane_state->src_y))
+		return -EINVAL;
+
+	return 0;
+}
+
+static const struct drm_simple_display_pipe_funcs cmf_disp_pipe_funcs = {
+	.mode_valid	= cmf_disp_pipe_mode_valid,
+	.check		= cmf_disp_pipe_check,
+	.enable		= cmf_disp_pipe_enable,
+	.disable	= cmf_disp_pipe_disable,
+	.update		= cmf_disp_pipe_update,
+	.enable_vblank	= cmf_disp_enable_vblank,
+	.disable_vblank	= cmf_disp_disable_vblank,
+};
+
+static const u32 cmf_disp_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+};
+
+static const struct drm_mode_config_funcs cmf_disp_mode_config_funcs = {
+	.fb_create	= drm_gem_fb_create,
+	.atomic_check	= drm_atomic_helper_check,
+	.atomic_commit	= drm_atomic_helper_commit,
+};
+
+/*
+ * Keep allocation granularity at one page: the LK reservation fits three
+ * full-screen buffers, but cannot fit two power-of-two 16 MiB DMA slots.
+ * Allocate scanout locally so the display only scans out reserved memory.
+ */
+static void cmf_gem_free(struct drm_gem_object *obj)
+{
+	struct cmf_disp *priv = container_of(obj->dev, struct cmf_disp, drm);
+	struct drm_gem_dma_object *dma = to_drm_gem_dma_obj(obj);
+
+	gen_pool_free(priv->pool, (unsigned long)dma->vaddr, obj->size);
+	drm_gem_object_release(obj);
+	kfree(dma);
+}
+
+static int cmf_gem_mmap(struct drm_gem_object *obj, struct vm_area_struct *vma)
+{
+	struct drm_gem_dma_object *dma = to_drm_gem_dma_obj(obj);
+	unsigned long offset = vma->vm_pgoff - drm_vma_node_start(&obj->vma_node);
+	unsigned long pages = obj->size >> PAGE_SHIFT;
+
+	if (offset >= pages || vma_pages(vma) > pages - offset)
+		return -EINVAL;
+
+	vm_flags_set(vma, VM_IO | VM_PFNMAP | VM_DONTEXPAND | VM_DONTDUMP);
+	vma->vm_page_prot = pgprot_writecombine(vm_get_page_prot(vma->vm_flags));
+
+	return remap_pfn_range(vma, vma->vm_start,
+			      (dma->dma_addr >> PAGE_SHIFT) + offset,
+			      vma->vm_end - vma->vm_start, vma->vm_page_prot);
+}
+
+/*
+ * A render-only GPU can import an allocation from this scanout pool.
+ * It must stay backed by the original contiguous, reserved RAM.
+ */
+static struct sg_table *cmf_gem_get_sg_table(struct drm_gem_object *obj)
+{
+	struct drm_gem_dma_object *dma = to_drm_gem_dma_obj(obj);
+	unsigned long pfn = PHYS_PFN(dma->dma_addr);
+	unsigned long count = obj->size >> PAGE_SHIFT;
+	struct sg_table *sgt;
+	unsigned long i;
+	int ret;
+
+	for (i = 0; i < count; i++) {
+		if (!pfn_valid(pfn + i) || !PageReserved(pfn_to_page(pfn + i)))
+			return ERR_PTR(-ENXIO);
+	}
+
+	sgt = kzalloc_obj(*sgt);
+	if (!sgt)
+		return ERR_PTR(-ENOMEM);
+
+	ret = sg_alloc_table(sgt, 1, GFP_KERNEL);
+	if (ret) {
+		kfree(sgt);
+		return ERR_PTR(ret);
+	}
+
+	sg_set_page(sgt->sgl, pfn_to_page(pfn), obj->size, 0);
+	return sgt;
+}
+
+static const struct drm_gem_object_funcs cmf_gem_funcs = {
+	.free = cmf_gem_free,
+	.print_info = drm_gem_dma_object_print_info,
+	.get_sg_table = cmf_gem_get_sg_table,
+	.vmap = drm_gem_dma_object_vmap,
+	.mmap = cmf_gem_mmap,
+	.vm_ops = &drm_gem_dma_vm_ops,
+};
+
+static int cmf_dumb_create(struct drm_file *file, struct drm_device *drm,
+			   struct drm_mode_create_dumb *args)
+{
+	struct cmf_disp *priv = container_of(drm, struct cmf_disp, drm);
+	struct drm_gem_dma_object *dma;
+	int ret;
+
+	if (args->bpp != 32)
+		return -EINVAL;
+
+	ret = drm_mode_size_dumb(drm, args, 0, 0);
+	if (ret)
+		return ret;
+	if (args->size > gen_pool_size(priv->pool))
+		return -ENOMEM;
+	args->size = PAGE_ALIGN(args->size);
+
+	dma = kzalloc_obj(*dma);
+	if (!dma)
+		return -ENOMEM;
+	dma->vaddr = gen_pool_dma_alloc(priv->pool, args->size, &dma->dma_addr);
+	if (!dma->vaddr) {
+		kfree(dma);
+		return -ENOMEM;
+	}
+	memset(dma->vaddr, 0, args->size);
+	ret = drm_gem_object_init(drm, &dma->base, args->size);
+	if (ret) {
+		gen_pool_free(priv->pool, (unsigned long)dma->vaddr, args->size);
+		kfree(dma);
+		return ret;
+	}
+	dma->base.funcs = &cmf_gem_funcs;
+	ret = drm_gem_create_mmap_offset(&dma->base);
+	if (!ret)
+		ret = drm_gem_handle_create(file, &dma->base, &args->handle);
+	drm_gem_object_put(&dma->base);
+	return ret;
+}
+
+static void cmf_pool_cleanup(struct drm_device *drm, void *data)
+{
+	struct cmf_disp *priv = data;
+
+	gen_pool_destroy(priv->pool);
+	memunmap(priv->pool_vaddr);
+}
+
+static int cmf_pool_init(struct cmf_disp *priv)
+{
+	struct drm_device *drm = &priv->drm;
+	struct device_node *node;
+	struct reserved_mem *rmem;
+	int ret;
+
+	node = of_parse_phandle(drm->dev->of_node, "memory-region", 0);
+	if (!node)
+		return -ENODEV;
+	rmem = of_reserved_mem_lookup(node);
+	of_node_put(node);
+	if (!rmem || !rmem->size || !IS_ALIGNED(rmem->base, PAGE_SIZE) ||
+	    !IS_ALIGNED(rmem->size, PAGE_SIZE) ||
+	    rmem->base > U32_MAX || rmem->size - 1 > U32_MAX - rmem->base)
+		return -EINVAL;
+
+	priv->pool_vaddr = memremap(rmem->base, rmem->size, MEMREMAP_WC);
+	if (!priv->pool_vaddr)
+		return -ENOMEM;
+	priv->pool = gen_pool_create(PAGE_SHIFT, -1);
+	if (!priv->pool) {
+		memunmap(priv->pool_vaddr);
+		return -ENOMEM;
+	}
+	ret = gen_pool_add_virt(priv->pool, (unsigned long)priv->pool_vaddr,
+				rmem->base, rmem->size, -1);
+	if (ret) {
+		cmf_pool_cleanup(drm, priv);
+		return ret;
+	}
+	ret = drmm_add_action_or_reset(drm, cmf_pool_cleanup, priv);
+	if (ret)
+		return ret;
+	dev_info(drm->dev, "page-granular scanout pool: %pa bytes at %pa\n",
+		 &rmem->size, &rmem->base);
+	return 0;
+}
+
+DEFINE_DRM_GEM_DMA_FOPS(cmf_disp_fops);
+
+static const struct drm_driver cmf_disp_driver = {
+	.driver_features	= DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.dumb_create		= cmf_dumb_create,
+	DRM_FBDEV_DMA_DRIVER_OPS,
+	.fops			= &cmf_disp_fops,
+	.name			= "cmf-lk-handoff",
+	.desc			= "CMF Phone 1 LK-handoff display",
+	.major			= 1,
+	.minor			= 0,
+};
+
+static int cmf_disp_probe(struct platform_device *pdev)
+{
+	struct cmf_disp *priv;
+	struct drm_device *drm;
+	int ret;
+
+	priv = devm_drm_dev_alloc(&pdev->dev, &cmf_disp_driver,
+				  struct cmf_disp, drm);
+	if (IS_ERR(priv))
+		return PTR_ERR(priv);
+
+	drm = &priv->drm;
+	priv->mode = cmf_disp_mode;
+
+	priv->ovl = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->ovl))
+		return PTR_ERR(priv->ovl);
+
+	ret = dma_set_mask_and_coherent(drm->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	ret = cmf_pool_init(priv);
+	if (ret)
+		return dev_err_probe(drm->dev, ret, "scanout pool setup failed\n");
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+
+	drm->mode_config.min_width = CMF_HDISPLAY;
+	/* Xorg may use a landscape desktop with a portrait rotation buffer. */
+	drm->mode_config.min_height = CMF_HDISPLAY;
+	drm->mode_config.max_width = CMF_VDISPLAY;
+	drm->mode_config.max_height = CMF_VDISPLAY;
+	drm->mode_config.preferred_depth = 32;
+	drm->mode_config.funcs = &cmf_disp_mode_config_funcs;
+
+	drm_connector_helper_add(&priv->connector,
+				 &cmf_disp_connector_helper_funcs);
+	ret = drm_connector_init(drm, &priv->connector,
+				 &cmf_disp_connector_funcs,
+				 DRM_MODE_CONNECTOR_VIRTUAL);
+	if (ret)
+		return ret;
+
+	ret = drm_simple_display_pipe_init(drm, &priv->pipe,
+					   &cmf_disp_pipe_funcs,
+					   cmf_disp_formats,
+					   ARRAY_SIZE(cmf_disp_formats),
+					   NULL, &priv->connector);
+	if (ret)
+		return ret;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+	priv->irq = platform_get_irq(pdev, 0);
+	if (priv->irq < 0)
+		return priv->irq;
+	cmf_disp_disable_vblank(&priv->pipe);
+	ret = devm_request_irq(drm->dev, priv->irq, cmf_disp_irq, 0,
+			       "cmf-lk-handoff-vblank", priv);
+	if (ret)
+		return dev_err_probe(drm->dev, ret, "frame IRQ request failed\n");
+	ret = devm_add_action_or_reset(drm->dev, cmf_disp_irq_stop, priv);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+
+	platform_set_drvdata(pdev, priv);
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+
+	drm_client_setup(drm, NULL);
+
+	dev_info(drm->dev, "CMF LK-handoff display ready (1080x2400)\n");
+
+	return 0;
+}
+
+static void cmf_disp_remove(struct platform_device *pdev)
+{
+	struct cmf_disp *priv = platform_get_drvdata(pdev);
+
+	drm_dev_unregister(&priv->drm);
+	drm_atomic_helper_shutdown(&priv->drm);
+}
+
+static const struct of_device_id cmf_disp_of_match[] = {
+	{ .compatible = "cmf,mt6878-lk-handoff-display" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cmf_disp_of_match);
+
+static struct platform_driver cmf_disp_platform_driver = {
+	.probe	= cmf_disp_probe,
+	.remove	= cmf_disp_remove,
+	.driver	= {
+		.name		= "cmf-lk-handoff-display",
+		.of_match_table	= cmf_disp_of_match,
+	},
+};
+module_platform_driver(cmf_disp_platform_driver);
+
+MODULE_DESCRIPTION("CMF Phone 1 LK-handoff display driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/gpu/drm/tiny/cmf-lk-handoff.c.orig b/drivers/gpu/drm/tiny/cmf-lk-handoff.c.orig
new file mode 100644
index 000000000..565896237
--- /dev/null
+++ b/drivers/gpu/drm/tiny/cmf-lk-handoff.c.orig
@@ -0,0 +1,624 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CMF Phone 1 (Nothing A015 / MT6878) "LK handoff" display driver.
+ *
+ * The stock bootloader (LK) already brings up the panel, the DSI0 host
+ * (burst mode, DSC) and the OVL0_2L scanout, and leaves that pipeline running
+ * when it hands off to Linux. This driver deliberately does not re-initialise
+ * any of it: it only takes over OVL0_2L layer 0 so that Linux can provide a
+ * real KMS device (framebuffer, page flips, fbdev console) on top of the
+ * still-live pipeline.
+ *
+ * Register values and the fixed mode come from a captured known-good baseline
+ * (display-build/reference/lk-baseline): OVL size 0x09600438 (2400x1080),
+ * stride 0x1100 (4352), layer-0 address 0xfe0d0000, DSI VFP 2452.
+ *
+ * This is a bring-up driver, not a native DRM/KMS port. Panel init, DSC
+ * encoding and DSI/PHY programming remain on the roadmap.
+ */
+
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/interrupt.h>
+#include <linux/genalloc.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_device.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_dumb_buffers.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_vma_manager.h>
+#include <drm/drm_vblank.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_mode_config.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_module.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+
+/* OVL0_2L registers, same layout as vendor/mtk_disp_ovl.c. */
+#define OVL_INTEN		0x004
+#define OVL_INTSTA		0x008
+#define OVL_IRQ_FRAME_DONE	BIT(1)
+#define OVL_READ_WORK_REG	BIT(20)
+#define OVL_EN			0x00c
+#define OVL_SRC_CON		0x02c
+#define OVL_SRC_SIZE(n)		(0x038 + 0x20 * (n))
+#define OVL_PITCH(n)		(0x044 + 0x20 * (n))
+#define OVL_ADDR(n)		(0x0f40 + 0x20 * (n))
+
+/* Vendor DISP_OVL_LAYER_CONST_BLD: ignore pixel alpha for XRGB. */
+#define OVL_PITCH_CONST_BLEND	BIT(28)
+
+#define OVL_CON_EN		BIT(0)
+#define OVL_SRC_CON_L0_EN	BIT(0)
+
+/* Panel timing from the vendor panel driver: 377349 kHz, VFP 2452. */
+#define CMF_HDISPLAY		1080
+#define CMF_HFP			173
+#define CMF_HSYNC		16
+#define CMF_HBP			24
+#define CMF_VDISPLAY		2400
+#define CMF_VFP			2452
+#define CMF_VSYNC		2
+#define CMF_VBP			10
+
+struct cmf_disp {
+	struct drm_device drm;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector connector;
+	void __iomem *ovl;
+	struct drm_display_mode mode;
+	struct gen_pool *pool;
+	void *pool_vaddr;
+	int irq;
+	/* Protected by drm.event_lock; each pending event owns a vblank ref. */
+	struct drm_pending_vblank_event *pending_event;
+	u64 pending_sequence;
+	u32 pending_addr;
+	u32 pending_pitch;
+	u32 pending_size;
+};
+
+static const struct drm_display_mode cmf_disp_mode = {
+	.name		= "1080x2400",
+	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+	.clock		= 377349,
+	.hdisplay	= CMF_HDISPLAY,
+	.hsync_start	= CMF_HDISPLAY + CMF_HFP,
+	.hsync_end	= CMF_HDISPLAY + CMF_HFP + CMF_HSYNC,
+	.htotal		= CMF_HDISPLAY + CMF_HFP + CMF_HSYNC + CMF_HBP,
+	.vdisplay	= CMF_VDISPLAY,
+	.vsync_start	= CMF_VDISPLAY + CMF_VFP,
+	.vsync_end	= CMF_VDISPLAY + CMF_VFP + CMF_VSYNC,
+	.vtotal		= CMF_VDISPLAY + CMF_VFP + CMF_VSYNC + CMF_VBP,
+};
+
+static struct cmf_disp *pipe_to_cmf(struct drm_simple_display_pipe *pipe)
+{
+	return container_of(pipe, struct cmf_disp, pipe);
+}
+
+static u32 cmf_disp_fb_pitch(struct drm_framebuffer *fb)
+{
+	u32 pitch = fb->pitches[0];
+
+	if (fb->format->format == DRM_FORMAT_XRGB8888)
+		pitch |= OVL_PITCH_CONST_BLEND;
+	return pitch;
+}
+
+static void cmf_disp_program_fb(struct cmf_disp *priv,
+				struct drm_framebuffer *fb)
+{
+	struct drm_gem_dma_object *gem;
+	u32 addr, size, pitch;
+
+	if (!fb)
+		return;
+
+	gem = drm_fb_dma_get_gem_obj(fb, 0);
+	if (!gem)
+		return;
+
+	addr = gem->dma_addr + fb->offsets[0];
+	size = (fb->height << 16) | fb->width;
+	pitch = cmf_disp_fb_pitch(fb);
+
+	writel_relaxed(size, priv->ovl + OVL_SRC_SIZE(0));
+	writel_relaxed(pitch, priv->ovl + OVL_PITCH(0));
+	writel_relaxed(addr, priv->ovl + OVL_ADDR(0));
+	/* Make the new address visible before the next frame is scanned. */
+	wmb();
+
+	dev_dbg(priv->drm.dev,
+		"OVL0_2L layer0 addr=%#x size=%ux%u pitch=%u\n",
+		addr, fb->width, fb->height, pitch);
+}
+
+static bool cmf_disp_send_pending(struct cmf_disp *priv)
+{
+	struct drm_pending_vblank_event *event = priv->pending_event;
+
+	assert_spin_locked(&priv->drm.event_lock);
+	if (!event)
+		return false;
+	priv->pending_event = NULL;
+	drm_crtc_send_vblank_event(&priv->pipe.crtc, event);
+	return true;
+}
+
+static irqreturn_t cmf_disp_irq(int irq, void *data)
+{
+	struct cmf_disp *priv = data;
+	struct drm_crtc *crtc = &priv->pipe.crtc;
+	unsigned long flags;
+	u64 sequence;
+	bool put = false;
+	u32 status;
+
+	status = readl(priv->ovl + OVL_INTSTA);
+	if (!(status & OVL_IRQ_FRAME_DONE))
+		return IRQ_NONE;
+	/* MT6878 status bits are write-zero-to-clear. Own only frame complete. */
+	writel(~(u32)OVL_IRQ_FRAME_DONE, priv->ovl + OVL_INTSTA);
+	if (!drm_crtc_handle_vblank(crtc))
+		return IRQ_HANDLED;
+	sequence = drm_crtc_vblank_count(crtc);
+
+	spin_lock_irqsave(&priv->drm.event_lock, flags);
+	/* READ_WORK_REG selects latched registers, not the pending shadow copy.
+	 * Check both the frame count and the complete programmed scanout state:
+	 * a delayed IRQ must not complete an update that has not latched yet.
+	 */
+	if (priv->pending_event && sequence > priv->pending_sequence &&
+	    readl(priv->ovl + OVL_ADDR(0)) == priv->pending_addr &&
+	    readl(priv->ovl + OVL_PITCH(0)) == priv->pending_pitch &&
+	    readl(priv->ovl + OVL_SRC_SIZE(0)) == priv->pending_size)
+		put = cmf_disp_send_pending(priv);
+	spin_unlock_irqrestore(&priv->drm.event_lock, flags);
+	if (put)
+		drm_crtc_vblank_put(crtc);
+	return IRQ_HANDLED;
+}
+
+static int cmf_disp_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+	u32 mask;
+
+	/* Discard the stale LK frame flag before accepting a fresh interrupt. */
+	writel(~(u32)OVL_IRQ_FRAME_DONE, priv->ovl + OVL_INTSTA);
+	mask = readl(priv->ovl + OVL_INTEN);
+	writel(mask | OVL_IRQ_FRAME_DONE, priv->ovl + OVL_INTEN);
+	return 0;
+}
+
+static void cmf_disp_disable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+	u32 mask = readl(priv->ovl + OVL_INTEN);
+
+	writel(mask & ~OVL_IRQ_FRAME_DONE, priv->ovl + OVL_INTEN);
+	readl(priv->ovl + OVL_INTEN);
+}
+
+static void cmf_disp_irq_stop(void *data)
+{
+	struct cmf_disp *priv = data;
+
+	cmf_disp_disable_vblank(&priv->pipe);
+	synchronize_irq(priv->irq);
+}
+
+static int cmf_disp_connector_get_modes(struct drm_connector *connector)
+{
+	struct cmf_disp *priv = container_of(connector, struct cmf_disp, connector);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &priv->mode);
+	if (!mode)
+		return 0;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_connector_helper_funcs cmf_disp_connector_helper_funcs = {
+	.get_modes = cmf_disp_connector_get_modes,
+};
+
+static enum drm_connector_status
+cmf_disp_connector_detect(struct drm_connector *connector, bool force)
+{
+	return connector_status_connected;
+}
+
+static const struct drm_connector_funcs cmf_disp_connector_funcs = {
+	.detect			= cmf_disp_connector_detect,
+	.fill_modes		= drm_helper_probe_single_connector_modes,
+	.destroy		= drm_connector_cleanup,
+	.reset			= drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state	= drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_connector_destroy_state,
+};
+
+static enum drm_mode_status
+cmf_disp_pipe_mode_valid(struct drm_simple_display_pipe *pipe,
+			 const struct drm_display_mode *mode)
+{
+	if (mode->hdisplay == CMF_HDISPLAY && mode->vdisplay == CMF_VDISPLAY)
+		return MODE_OK;
+
+	return MODE_BAD;
+}
+
+static void cmf_disp_pipe_enable(struct drm_simple_display_pipe *pipe,
+				 struct drm_crtc_state *crtc_state,
+				 struct drm_plane_state *plane_state)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+
+	cmf_disp_program_fb(priv, plane_state->fb);
+
+	/* Layer 0 is the only source; keep the DSI/PHY untouched. */
+	writel_relaxed(OVL_SRC_CON_L0_EN, priv->ovl + OVL_SRC_CON);
+	/* Keep v4 shadow mode; bit 20 changes readback selection only. */
+	writel_relaxed(OVL_CON_EN | OVL_READ_WORK_REG, priv->ovl + OVL_EN);
+	/* Order all enable writes before completing the commit. */
+	wmb();
+	drm_crtc_vblank_on(&pipe->crtc);
+}
+
+static void cmf_disp_pipe_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+	unsigned long flags;
+	bool put;
+
+	drm_crtc_vblank_off(&pipe->crtc);
+	spin_lock_irqsave(&priv->drm.event_lock, flags);
+	put = cmf_disp_send_pending(priv);
+	spin_unlock_irqrestore(&priv->drm.event_lock, flags);
+	if (put)
+		drm_crtc_vblank_put(&pipe->crtc);
+	writel_relaxed(0, priv->ovl + OVL_EN);
+	/* Order the disable write before completing the commit. */
+	wmb();
+}
+
+static void cmf_disp_pipe_update(struct drm_simple_display_pipe *pipe,
+				 struct drm_plane_state *old_state)
+{
+	struct cmf_disp *priv = pipe_to_cmf(pipe);
+	struct drm_crtc *crtc = &pipe->crtc;
+	struct drm_framebuffer *fb = pipe->plane.state->fb;
+	struct drm_pending_vblank_event *event = crtc->state->event;
+	unsigned long flags;
+	bool put = false;
+
+	spin_lock_irqsave(&priv->drm.event_lock, flags);
+	cmf_disp_program_fb(priv, fb);
+	if (event) {
+		crtc->state->event = NULL;
+		/* Atomic helper dependencies serialize event-bearing commits. */
+		if (WARN_ON_ONCE(priv->pending_event))
+			put = cmf_disp_send_pending(priv);
+		if (fb && crtc->state->active && !drm_crtc_vblank_get(crtc)) {
+			struct drm_gem_dma_object *gem = drm_fb_dma_get_gem_obj(fb, 0);
+
+			priv->pending_addr = gem->dma_addr + fb->offsets[0];
+			priv->pending_pitch = cmf_disp_fb_pitch(fb);
+			priv->pending_size = (fb->height << 16) | fb->width;
+			priv->pending_sequence = drm_crtc_vblank_count(crtc);
+			priv->pending_event = event;
+		} else {
+			/* Disabled/initial modesets have no running scanout to wait for. */
+			drm_crtc_send_vblank_event(crtc, event);
+		}
+	}
+	spin_unlock_irqrestore(&priv->drm.event_lock, flags);
+	if (put)
+		drm_crtc_vblank_put(crtc);
+}
+
+static int cmf_disp_pipe_check(struct drm_simple_display_pipe *pipe,
+			       struct drm_plane_state *plane_state,
+			       struct drm_crtc_state *crtc_state)
+{
+	struct drm_framebuffer *fb = plane_state->fb;
+
+	/* OVL always scans the full, unrotated panel-sized buffer. */
+	if (fb && (fb->width != CMF_HDISPLAY || fb->height != CMF_VDISPLAY ||
+		   plane_state->src_x || plane_state->src_y))
+		return -EINVAL;
+
+	return 0;
+}
+
+static const struct drm_simple_display_pipe_funcs cmf_disp_pipe_funcs = {
+	.mode_valid	= cmf_disp_pipe_mode_valid,
+	.check		= cmf_disp_pipe_check,
+	.enable		= cmf_disp_pipe_enable,
+	.disable	= cmf_disp_pipe_disable,
+	.update		= cmf_disp_pipe_update,
+	.enable_vblank	= cmf_disp_enable_vblank,
+	.disable_vblank	= cmf_disp_disable_vblank,
+};
+
+static const u32 cmf_disp_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+};
+
+static const struct drm_mode_config_funcs cmf_disp_mode_config_funcs = {
+	.fb_create	= drm_gem_fb_create,
+	.atomic_check	= drm_atomic_helper_check,
+	.atomic_commit	= drm_atomic_helper_commit,
+};
+
+/*
+ * Keep allocation granularity at one page: the LK reservation fits three
+ * full-screen buffers, but cannot fit two power-of-two 16 MiB DMA slots.
+ * This pool is private to scanout; external PRIME buffers are unsupported.
+ */
+static void cmf_gem_free(struct drm_gem_object *obj)
+{
+	struct cmf_disp *priv = container_of(obj->dev, struct cmf_disp, drm);
+	struct drm_gem_dma_object *dma = to_drm_gem_dma_obj(obj);
+
+	gen_pool_free(priv->pool, (unsigned long)dma->vaddr, obj->size);
+	drm_gem_object_release(obj);
+	kfree(dma);
+}
+
+static int cmf_gem_mmap(struct drm_gem_object *obj, struct vm_area_struct *vma)
+{
+	struct drm_gem_dma_object *dma = to_drm_gem_dma_obj(obj);
+	unsigned long offset = vma->vm_pgoff - drm_vma_node_start(&obj->vma_node);
+	unsigned long pages = obj->size >> PAGE_SHIFT;
+
+	if (offset >= pages || vma_pages(vma) > pages - offset)
+		return -EINVAL;
+
+	vm_flags_set(vma, VM_IO | VM_PFNMAP | VM_DONTEXPAND | VM_DONTDUMP);
+	vma->vm_page_prot = pgprot_writecombine(vm_get_page_prot(vma->vm_flags));
+
+	return remap_pfn_range(vma, vma->vm_start,
+			      (dma->dma_addr >> PAGE_SHIFT) + offset,
+			      vma->vm_end - vma->vm_start, vma->vm_page_prot);
+}
+
+static const struct drm_gem_object_funcs cmf_gem_funcs = {
+	.free = cmf_gem_free,
+	.print_info = drm_gem_dma_object_print_info,
+	.vmap = drm_gem_dma_object_vmap,
+	.mmap = cmf_gem_mmap,
+	.vm_ops = &drm_gem_dma_vm_ops,
+};
+
+static int cmf_dumb_create(struct drm_file *file, struct drm_device *drm,
+			   struct drm_mode_create_dumb *args)
+{
+	struct cmf_disp *priv = container_of(drm, struct cmf_disp, drm);
+	struct drm_gem_dma_object *dma;
+	int ret;
+
+	if (args->bpp != 32)
+		return -EINVAL;
+
+	ret = drm_mode_size_dumb(drm, args, 0, 0);
+	if (ret)
+		return ret;
+	if (args->size > gen_pool_size(priv->pool))
+		return -ENOMEM;
+	args->size = PAGE_ALIGN(args->size);
+
+	dma = kzalloc_obj(*dma);
+	if (!dma)
+		return -ENOMEM;
+	dma->vaddr = gen_pool_dma_alloc(priv->pool, args->size, &dma->dma_addr);
+	if (!dma->vaddr) {
+		kfree(dma);
+		return -ENOMEM;
+	}
+	memset(dma->vaddr, 0, args->size);
+	ret = drm_gem_object_init(drm, &dma->base, args->size);
+	if (ret) {
+		gen_pool_free(priv->pool, (unsigned long)dma->vaddr, args->size);
+		kfree(dma);
+		return ret;
+	}
+	dma->base.funcs = &cmf_gem_funcs;
+	ret = drm_gem_create_mmap_offset(&dma->base);
+	if (!ret)
+		ret = drm_gem_handle_create(file, &dma->base, &args->handle);
+	drm_gem_object_put(&dma->base);
+	return ret;
+}
+
+static void cmf_pool_cleanup(struct drm_device *drm, void *data)
+{
+	struct cmf_disp *priv = data;
+
+	gen_pool_destroy(priv->pool);
+	memunmap(priv->pool_vaddr);
+}
+
+static int cmf_pool_init(struct cmf_disp *priv)
+{
+	struct drm_device *drm = &priv->drm;
+	struct device_node *node;
+	struct reserved_mem *rmem;
+	int ret;
+
+	node = of_parse_phandle(drm->dev->of_node, "memory-region", 0);
+	if (!node)
+		return -ENODEV;
+	rmem = of_reserved_mem_lookup(node);
+	of_node_put(node);
+	if (!rmem || !rmem->size || !IS_ALIGNED(rmem->base, PAGE_SIZE) ||
+	    !IS_ALIGNED(rmem->size, PAGE_SIZE) ||
+	    rmem->base > U32_MAX || rmem->size - 1 > U32_MAX - rmem->base)
+		return -EINVAL;
+
+	priv->pool_vaddr = memremap(rmem->base, rmem->size, MEMREMAP_WC);
+	if (!priv->pool_vaddr)
+		return -ENOMEM;
+	priv->pool = gen_pool_create(PAGE_SHIFT, -1);
+	if (!priv->pool) {
+		memunmap(priv->pool_vaddr);
+		return -ENOMEM;
+	}
+	ret = gen_pool_add_virt(priv->pool, (unsigned long)priv->pool_vaddr,
+				rmem->base, rmem->size, -1);
+	if (ret) {
+		cmf_pool_cleanup(drm, priv);
+		return ret;
+	}
+	ret = drmm_add_action_or_reset(drm, cmf_pool_cleanup, priv);
+	if (ret)
+		return ret;
+	dev_info(drm->dev, "page-granular scanout pool: %pa bytes at %pa\n",
+		 &rmem->size, &rmem->base);
+	return 0;
+}
+
+DEFINE_DRM_GEM_DMA_FOPS(cmf_disp_fops);
+
+static const struct drm_driver cmf_disp_driver = {
+	.driver_features	= DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.dumb_create		= cmf_dumb_create,
+	DRM_FBDEV_DMA_DRIVER_OPS,
+	.fops			= &cmf_disp_fops,
+	.name			= "cmf-lk-handoff",
+	.desc			= "CMF Phone 1 LK-handoff display",
+	.major			= 1,
+	.minor			= 0,
+};
+
+static int cmf_disp_probe(struct platform_device *pdev)
+{
+	struct cmf_disp *priv;
+	struct drm_device *drm;
+	int ret;
+
+	priv = devm_drm_dev_alloc(&pdev->dev, &cmf_disp_driver,
+				  struct cmf_disp, drm);
+	if (IS_ERR(priv))
+		return PTR_ERR(priv);
+
+	drm = &priv->drm;
+	priv->mode = cmf_disp_mode;
+
+	priv->ovl = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->ovl))
+		return PTR_ERR(priv->ovl);
+
+	ret = dma_set_mask_and_coherent(drm->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	ret = cmf_pool_init(priv);
+	if (ret)
+		return dev_err_probe(drm->dev, ret, "scanout pool setup failed\n");
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+
+	drm->mode_config.min_width = CMF_HDISPLAY;
+	/* Xorg may use a landscape desktop with a portrait rotation buffer. */
+	drm->mode_config.min_height = CMF_HDISPLAY;
+	drm->mode_config.max_width = CMF_VDISPLAY;
+	drm->mode_config.max_height = CMF_VDISPLAY;
+	drm->mode_config.preferred_depth = 32;
+	drm->mode_config.funcs = &cmf_disp_mode_config_funcs;
+
+	drm_connector_helper_add(&priv->connector,
+				 &cmf_disp_connector_helper_funcs);
+	ret = drm_connector_init(drm, &priv->connector,
+				 &cmf_disp_connector_funcs,
+				 DRM_MODE_CONNECTOR_VIRTUAL);
+	if (ret)
+		return ret;
+
+	ret = drm_simple_display_pipe_init(drm, &priv->pipe,
+					   &cmf_disp_pipe_funcs,
+					   cmf_disp_formats,
+					   ARRAY_SIZE(cmf_disp_formats),
+					   NULL, &priv->connector);
+	if (ret)
+		return ret;
+
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+	priv->irq = platform_get_irq(pdev, 0);
+	if (priv->irq < 0)
+		return priv->irq;
+	cmf_disp_disable_vblank(&priv->pipe);
+	ret = devm_request_irq(drm->dev, priv->irq, cmf_disp_irq, 0,
+			       "cmf-lk-handoff-vblank", priv);
+	if (ret)
+		return dev_err_probe(drm->dev, ret, "frame IRQ request failed\n");
+	ret = devm_add_action_or_reset(drm->dev, cmf_disp_irq_stop, priv);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+
+	platform_set_drvdata(pdev, priv);
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+
+	drm_client_setup(drm, NULL);
+
+	dev_info(drm->dev, "CMF LK-handoff display ready (1080x2400)\n");
+
+	return 0;
+}
+
+static void cmf_disp_remove(struct platform_device *pdev)
+{
+	struct cmf_disp *priv = platform_get_drvdata(pdev);
+
+	drm_dev_unregister(&priv->drm);
+	drm_atomic_helper_shutdown(&priv->drm);
+}
+
+static const struct of_device_id cmf_disp_of_match[] = {
+	{ .compatible = "cmf,mt6878-lk-handoff-display" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cmf_disp_of_match);
+
+static struct platform_driver cmf_disp_platform_driver = {
+	.probe	= cmf_disp_probe,
+	.remove	= cmf_disp_remove,
+	.driver	= {
+		.name		= "cmf-lk-handoff-display",
+		.of_match_table	= cmf_disp_of_match,
+	},
+};
+module_platform_driver(cmf_disp_platform_driver);
+
+MODULE_DESCRIPTION("CMF Phone 1 LK-handoff display driver");
+MODULE_LICENSE("GPL");
