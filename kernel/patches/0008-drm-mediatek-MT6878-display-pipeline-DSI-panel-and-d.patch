diff --git a/drivers/gpu/drm/mediatek/mtk_dsi_n4.c b/drivers/gpu/drm/mediatek/mtk_dsi_n4.c
new file mode 100644
index 000000000..d1cf63a78
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/mtk_dsi_n4.c
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2021 MediaTek Inc.
+ * MT6878 single-port D-PHY video/DSC calculations, adapted from vendor mtk_dsi.c.
+ */
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/units.h>
+#include <video/videomode.h>
+#include <drm/display/drm_dsc.h>
+
+#include "mtk_disp_dsc.h"
+#include "mtk_dsi_n4.h"
+
+int mtk_dsi_n4_build_phy(u32 data_rate, struct mtk_dsi_n4_phy *phy)
+{
+	struct mtk_dsi_n4_phy p = { 0 };
+	u32 rate = DIV_ROUND_UP_ULL(data_rate, HZ_PER_MHZ);
+	u32 lpx, prep, zero, trail, exit;
+	u32 clk_prep, clk_zero, clk_trail, clk_post, clk_exit;
+	u32 ta_go, ta_get, ta_sure;
+
+	if (!phy || data_rate < 125000000)
+		return -EINVAL;
+	/* N4 selects vendor dphy_timconfig_v2, not the older N6 v1 formulas. */
+	lpx = ALIGN(rate * 80 / 8000 + 1, 2);
+	prep = ALIGN((rate * 59 + 4000) / 8000 + 1, 2);
+	zero = (rate * 163 + 11000) / 8000 + 1;
+	if (zero < prep)
+		return -ERANGE;
+	zero -= prep;
+	trail = (rate * 66 + (rate < 740 ? 44300 : 42000)) / 8000 + 1;
+	exit = rate * 118 / 8000 + 1;
+	/* Vendor exit rule rounds an odd value up by two, an even value by one. */
+	exit += (exit & 1) ? 2 : 1;
+	clk_prep = ALIGN(rate * 57 / 8000 + 1, 2);
+	clk_zero = rate * 330 / 8000 + 1;
+	if (clk_zero < clk_prep)
+		return -ERANGE;
+	clk_zero -= clk_prep;
+	clk_trail = (rate * 65 + 52000) / 8000 + 1;
+	clk_post = (rate * 65 + 53000) / 8000 + 1;
+	clk_exit = rate * 118 / 8000 + 1;
+	ta_go = 4 * lpx;
+	ta_get = 5 * lpx;
+	ta_sure = 3 * lpx / 2;
+	if (lpx > 0xff || prep > 0xff || zero > 0xff || trail > 0xff ||
+	    exit > 0xff || clk_prep > 0xff || clk_zero > 0xff ||
+	    clk_trail > 0xff || clk_post > 0xff || clk_exit > 0xff ||
+	    ta_go > 0xff || ta_get > 0xff || ta_sure > 0xff)
+		return -ERANGE;
+	p.timecon[0] = lpx | prep << 8 | zero << 16 | trail << 24;
+	p.timecon[1] = ta_go | ta_sure << 8 | ta_get << 16 | exit << 24;
+	p.timecon[2] = BIT(8) | clk_zero << 16 | clk_trail << 24;
+	p.timecon[3] = clk_prep | clk_post << 8 | clk_exit << 16;
+	p.data_phy_cycle = (exit + 1) + lpx + prep + zero + 1;
+	*phy = p;
+	return 0;
+}
+
+int mtk_dsi_n4_build_config(const struct videomode *vm,
+			    const struct drm_dsc_config *dsc,
+			    unsigned int lanes, unsigned long hs_rate,
+			    struct mtk_dsi_n4_config *config)
+{
+	struct mtk_dsi_n4_config c = { 0 };
+	struct mtk_dsc_reg_config encoder;
+	u64 htotal, line_ns;
+	u32 bytes, urgent_lines;
+	int ret;
+
+	if (!vm || !config)
+		return -EINVAL;
+	/* Start with the vendor panel's known 4-lane / 1140 Mbps operating point. */
+	if (lanes != 4 || hs_rate != 1140UL * HZ_PER_MHZ)
+		return -EOPNOTSUPP;
+	ret = mtk_dsc_build_regs(dsc, &encoder);
+	if (ret)
+		return ret;
+	if (!vm->pixelclock || vm->pixelclock > U32_MAX || vm->hactive != dsc->pic_width ||
+	    vm->vactive != dsc->pic_height || vm->vactive > 0x7fff ||
+	    vm->vfront_porch > 0x7ffe || vm->vsync_len > 0x7fff ||
+	    vm->vback_porch > 0x7fff || vm->hsync_len < 2 ||
+	    vm->hfront_porch < 4 || vm->hsync_len > 0x3fff ||
+	    vm->hback_porch > 0x3fff || vm->hfront_porch > 0x3fff ||
+	    vm->hback_porch + vm->hsync_len < 4)
+		return -EINVAL;
+	if (DIV_ROUND_UP_ULL((u64)vm->pixelclock * dsc->bits_per_pixel,
+			     16 * lanes) > hs_rate)
+		return -ERANGE;
+	bytes = (u32)dsc->slice_chunk_size * dsc->slice_count;
+	if (bytes > 0x7fff)
+		return -ERANGE;
+	c.data_rate = hs_rate;
+	ret = mtk_dsi_n4_build_phy(c.data_rate, &c.phy);
+	if (ret)
+		return ret;
+	c.psctrl = 5 << 16 | bytes;
+	c.size = vm->vactive << 16 | DIV_ROUND_UP(bytes, 3);
+	/* Vendor video burst/sync-event timing uses RGB input bytes for porches. */
+	c.hsa = ALIGN(vm->hsync_len * 3 - 4, 4);
+	c.hbp = ALIGN((vm->hback_porch + vm->hsync_len) * 3 - 10, 4);
+	c.hfp = ALIGN(vm->hfront_porch * 3 - 12, 4);
+	if (c.hsa > 0xffff || c.hbp > 0xffff || c.hfp > 0xffff)
+		return -ERANGE;
+	c.vsa = vm->vsync_len;
+	c.vbp = vm->vback_porch;
+	c.vfp = vm->vfront_porch;
+	c.vact = vm->vactive;
+	/* N4 accepts 16 bytes per SRAM transaction, including a partial tail. */
+	c.rw_times = DIV_ROUND_UP(bytes * vm->vactive, 16);
+	htotal = (u64)vm->hactive + vm->hfront_porch + vm->hsync_len + vm->hback_porch;
+	line_ns = div64_u64(htotal * NSEC_PER_SEC, vm->pixelclock);
+	if (!line_ns || line_ns > U32_MAX)
+		return -ERANGE;
+	urgent_lines = DIV_ROUND_UP(15000, (u32)line_ns);
+	/* Saturate rather than reproduce vendor unsigned prefetch underflow. */
+	c.preurgent = c.vsa + c.vbp > urgent_lines ? c.vsa + c.vbp - urgent_lines : 0;
+	*config = c;
+	return 0;
+}
+
+int mtk_dsi_n4_build_buffer(u32 data_rate, unsigned long mmclk,
+			    u32 sram_words, struct mtk_dsi_n4_buffer *buffer)
+{
+	struct mtk_dsi_n4_buffer b = { 0 };
+	u32 rate_mhz = DIV_ROUND_UP_ULL(data_rate, HZ_PER_MHZ);
+	u64 fill, drain, margin;
+
+	if (!buffer || !data_rate || !mmclk || !sram_words || sram_words > 0xffff)
+		return -EINVAL;
+	/* MT6878 uses 32-byte SRAM/buffer units and a one-pixel/cycle relay. */
+	fill = div64_u64((u64)(mmclk / HZ_PER_MHZ) * 3, 32);
+	drain = (u64)rate_mhz * 4 / 8 / 32;
+	if (fill <= drain)
+		return -ERANGE;
+	margin = 12 * (fill - drain) / 10;
+	if (margin >= sram_words)
+		return -ERANGE;
+	b.sodi_hi = sram_words - margin;
+	b.sodi_lo = (u64)28 * rate_mhz * 4 / 8 / 32;
+	b.preultra_hi = (u64)26 * rate_mhz * 4 / 8 / 32;
+	b.preultra_lo = (u64)25 * rate_mhz * 4 / 8 / 32;
+	b.ultra_hi = b.preultra_lo;
+	b.ultra_lo = (u64)23 * rate_mhz * 4 / 8 / 32;
+	b.urgent_hi = (u64)15 * rate_mhz * 4 / 8 / 32;
+	b.urgent_lo = (u64)14 * rate_mhz * 4 / 8 / 32;
+	if (b.sodi_lo >= b.sodi_hi)
+		return -ERANGE;
+	*buffer = b;
+	return 0;
+}
