@@ -93,6 +100,97 @@ static inline struct mtk_crtc_state *to_mtk_crtc_state(struct drm_crtc_state *s)
 	return container_of(s, struct mtk_crtc_state, base);
 }
 
+static bool mtk_crtc_fixed_path_valid(const unsigned int *path, unsigned int length,
+				      unsigned int num_conn_routes)
+{
+	return path && length == 3 && !num_conn_routes &&
+		path[0] == DDP_COMPONENT_OVL_2L0 &&
+		path[1] == DDP_COMPONENT_DSC0 && path[2] == DDP_COMPONENT_DSI0;
+}
+
+static int mtk_crtc_dsc_path_check(struct mtk_crtc *mtk_crtc,
+				   struct mtk_crtc_state *state)
+{
+	unsigned int path[3];
+	unsigned int i;
+
+	if (!mtk_crtc->fixed_dsc_path)
+		return 0;
+	if (!state->dsc_enabled || mtk_crtc->ddp_comp_nr != ARRAY_SIZE(path))
+		return -EOPNOTSUPP;
+	for (i = 0; i < ARRAY_SIZE(path); i++) {
+		if (!mtk_crtc->ddp_comp[i])
+			return -EINVAL;
+		path[i] = mtk_crtc->ddp_comp[i]->id;
+	}
+	if (!mtk_crtc_fixed_path_valid(path, ARRAY_SIZE(path), mtk_crtc->num_conn_routes))
+		return -EOPNOTSUPP;
+	if (!mtk_crtc->ddp_comp[1]->funcs ||
+	    !mtk_crtc->ddp_comp[1]->funcs->config_dsc ||
+	    !mtk_crtc->ddp_comp[2]->funcs ||
+	    !mtk_crtc->ddp_comp[2]->funcs->start_checked)
+		return -EOPNOTSUPP;
+	return 0;
+}
+
+bool mtk_crtc_dsc_path_ready(struct drm_crtc *crtc)
+{
+	struct mtk_crtc *mtk_crtc;
+
+	if (!crtc)
+		return false;
+	mtk_crtc = to_mtk_crtc(crtc);
+	return mtk_crtc->enabled &&
+		(!mtk_crtc->fixed_dsc_path || mtk_crtc->dsc_path_held);
+}
+
+static int mtk_crtc_atomic_check(struct drm_crtc *crtc, struct drm_atomic_commit *commit)
+{
+	struct drm_crtc_state *state = drm_atomic_get_new_crtc_state(commit, crtc);
+
+	return mtk_crtc_dsc_path_check(to_mtk_crtc(crtc), to_mtk_crtc_state(state));
+}
+
+/* Called from bridge atomic_check; never program hardware in this path. */
+int mtk_crtc_set_dsc_config(struct drm_crtc_state *state,
+			    const struct drm_dsc_config *dsc)
+{
+	struct mtk_crtc *mtk_crtc = to_mtk_crtc(state->crtc);
+	struct mtk_crtc_state *new = to_mtk_crtc_state(state);
+	struct mtk_crtc_state *old = to_mtk_crtc_state(state->crtc->state);
+	struct mtk_dsc_reg_config regs, old_regs;
+	unsigned int capable = 0;
+	int i, ret;
+
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
+		struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[i];
+
+		if (comp->funcs && comp->funcs->config_dsc)
+			capable++;
+	}
+	/* This MT6878 encoder path supports compression, not RGB relay. */
+	if (!dsc && capable)
+		return -EOPNOTSUPP;
+	if (dsc) {
+		if (capable != 1 || mtk_crtc->num_conn_routes)
+			return -EOPNOTSUPP;
+		ret = mtk_dsc_build_regs(dsc, &regs);
+		if (ret)
+			return ret;
+		if (dsc->pic_width != state->adjusted_mode.hdisplay ||
+		    dsc->pic_height != state->adjusted_mode.vdisplay)
+			return -EINVAL;
+		if (!old->dsc_enabled || mtk_dsc_build_regs(&old->dsc, &old_regs) ||
+		    memcmp(&regs, &old_regs, sizeof(regs)))
+			state->mode_changed = true;
+		new->dsc = *dsc;
+	} else if (old->dsc_enabled) {
+		state->mode_changed = true;
+	}
+	new->dsc_enabled = !!dsc;
+	return 0;
+}
+
 static void mtk_crtc_finish_page_flip(struct mtk_crtc *mtk_crtc)
 {
 	struct drm_crtc *crtc = &mtk_crtc->base;
@@ -177,6 +275,8 @@ static struct drm_crtc_state *mtk_crtc_duplicate_state(struct drm_crtc *crtc)
 
 	WARN_ON(state->base.crtc != crtc);
 	state->base.crtc = crtc;
+	state->dsc_enabled = to_mtk_crtc_state(crtc->state)->dsc_enabled;
