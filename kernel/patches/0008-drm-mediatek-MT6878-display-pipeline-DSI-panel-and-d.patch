+static bool mtk_drm_has_scanout_region(struct device *dev)
+{
+	return dev && of_device_is_compatible(dev->of_node, "mediatek,mt6878-disp-ovl-2l") &&
+	       of_property_present(dev->of_node, "memory-region");
+}
+
+static int mtk_drm_init_scanout_pool(struct drm_device *drm, struct device *dma_dev)
+{
+#ifdef CONFIG_DMA_DECLARE_COHERENT
+	struct device_node *np;
+	struct reserved_mem *pool = NULL;
+	int ret;
+
+	if (!mtk_drm_has_scanout_region(dma_dev) || device_iommu_mapped(dma_dev) ||
+	    dma_dev->dma_range_map ||
+	    of_property_present(dma_dev->of_node, "iommus"))
+		return -EINVAL;
+	if (dma_dev->dma_mem)
+		return -EBUSY;
+	if (of_property_count_elems_of_size(dma_dev->of_node, "memory-region",
+					    sizeof(u32)) != 1)
+		return -EINVAL;
+
+	np = of_parse_phandle(dma_dev->of_node, "memory-region", 0);
+	if (of_device_is_compatible(np, "shared-dma-pool") && of_device_is_available(np) &&
+	    of_property_present(np, "no-map") && !of_property_present(np, "reusable"))
+		pool = of_reserved_mem_lookup(np);
+	of_node_put(np);
+	if (!pool || !pool->size || !PAGE_ALIGNED(pool->base) ||
+	    !PAGE_ALIGNED(pool->size) || pool->base > U32_MAX ||
+	    pool->size - 1 > U32_MAX - pool->base ||
+	    pool->base + pool->size - 1 > dma_dev->coherent_dma_mask ||
+	    (dma_dev->bus_dma_limit && pool->base + pool->size - 1 > dma_dev->bus_dma_limit))
+		return -EINVAL;
+
+	ret = of_reserved_mem_device_init(dma_dev);
+	if (ret)
+		return ret;
+
+	return drmm_add_action_or_reset(drm, mtk_drm_release_scanout_pool, dma_dev);
+#else
+	return -EOPNOTSUPP;
+#endif
+}
