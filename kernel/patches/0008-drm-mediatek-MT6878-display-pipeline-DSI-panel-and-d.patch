+	u32 psctrl;
+	u32 size;
+	u32 hsa;
+	u32 hbp;
+	u32 hfp;
+	u32 vsa;
+	u32 vbp;
+	u32 vfp;
+	u32 vact;
+	u32 rw_times;
+	u32 preurgent;
+};
+
+struct mtk_dsi_n4_buffer {
+	u32 sodi_hi;
+	u32 sodi_lo;
+	u32 preultra_hi;
+	u32 preultra_lo;
+	u32 ultra_hi;
+	u32 ultra_lo;
+	u32 urgent_hi;
+	u32 urgent_lo;
+};
+
+int mtk_dsi_n4_build_phy(u32 data_rate, struct mtk_dsi_n4_phy *phy);
+int mtk_dsi_n4_build_config(const struct videomode *vm,
+			    const struct drm_dsc_config *dsc,
+			    unsigned int lanes, unsigned long hs_rate,
+			    struct mtk_dsi_n4_config *config);
+int mtk_dsi_n4_build_buffer(u32 data_rate, unsigned long mmclk,
+			    u32 sram_words, struct mtk_dsi_n4_buffer *buffer);
+#endif
