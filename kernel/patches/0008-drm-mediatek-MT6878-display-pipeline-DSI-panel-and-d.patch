+ * 624 MHz, and no DISP0 parent is 208 MHz. Use the fallback as the fixed
+ * threshold input; the real (faster) engine clock only makes the FIFO fill
+ * sooner, so the thresholds stay conservative. Refuse an engine clock below
+ * the threshold input, where they would no longer be.
+ */
+#define MT6878_DSI_N4_FIFO_MMCLK_HZ	208000000UL
+
+struct drm_dsc_config;
+struct videomode;
+
