-	height = crtc->state->adjusted_mode.vdisplay;
-	vrefresh = drm_mode_vrefresh(&crtc->state->adjusted_mode);
+	width = crtc_state->adjusted_mode.hdisplay;
+	height = crtc_state->adjusted_mode.vdisplay;
+	vrefresh = drm_mode_vrefresh(&crtc_state->adjusted_mode);
 
 	drm_for_each_encoder(encoder, crtc->dev) {
 		if (encoder->crtc != crtc)
@@ -371,6 +478,9 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 		drm_connector_list_iter_end(&conn_iter);
 	}
 
+	if (state->dsc_enabled)
+		bpc = state->dsc.bits_per_component;
+
 	ret = pm_runtime_resume_and_get(crtc->dev->dev);
 	if (ret < 0) {
 		drm_err(dev, "Failed to enable power domain: %d\n", ret);
@@ -389,8 +499,40 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 		goto err_mutex_unprepare;
 	}
 
+	if (mtk_crtc->fixed_dsc_path) {
+		/*
+		 * The first enable takes over LK's running OVL/DSC mid-frame. A
+		 * re-modeset stops them in hw_fini first; do the same here so the
+		 * route switch and OVL_RST in config never hit a running engine,
+		 * which left OVL underflowing without a frame done (Stage 79).
+		 * The DSI host is stopped and restarted by its bridge.
+		 */
+		for (i = 0; i < mtk_crtc->ddp_comp_nr - 1; i++)
+			mtk_ddp_comp_stop(mtk_crtc->ddp_comp[i]);
+		ret = mtk_mmsys_dsc_path_get(mtk_crtc->mmsys_dev);
+		if (ret) {
+			drm_err(dev, "Stage 85c: fixed DSC path get failed: %d\n", ret);
+			goto err_clk_disable;
+		}
+		mtk_crtc->dsc_path_held = true;
+	}
+
+	/* Configure DSC before starting any component or enabling the mutex. */
+	if (state->dsc_enabled) {
+		for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
+			struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[i];
+
+			if (!comp->funcs || !comp->funcs->config_dsc)
+				continue;
+			ret = comp->funcs->config_dsc(comp->dev, &state->dsc, NULL);
+			if (ret)
+				goto err_dsc_path_put;
+		}
+	}
+
 	for (i = 0; i < mtk_crtc->ddp_comp_nr - 1; i++) {
-		if (!mtk_ddp_comp_connect(mtk_crtc->ddp_comp[i], mtk_crtc->mmsys_dev,
+		if (!mtk_crtc->fixed_dsc_path &&
+		    !mtk_ddp_comp_connect(mtk_crtc->ddp_comp[i], mtk_crtc->mmsys_dev,
 					  mtk_crtc->ddp_comp[i + 1]->id))
 			mtk_mmsys_ddp_connect(mtk_crtc->mmsys_dev,
 					      mtk_crtc->ddp_comp[i]->id,
@@ -406,11 +548,17 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
 		struct mtk_ddp_comp *comp = mtk_crtc->ddp_comp[i];
 
-		if (i == 1)
+		if (i == 1 && !mtk_crtc->fixed_dsc_path)
 			mtk_ddp_comp_bgclr_in_on(comp);
 
 		mtk_ddp_comp_config(comp, width, height, vrefresh, bpc, NULL);
-		mtk_ddp_comp_start(comp);
+		if (mtk_crtc->fixed_dsc_path) {
+			ret = mtk_ddp_comp_start_checked(comp);
+			if (ret)
+				goto err_stop_components;
+		} else {
+			mtk_ddp_comp_start(comp);
+		}
 	}
 
 	/* Initially configure all planes */
@@ -432,6 +580,20 @@ static int mtk_crtc_ddp_hw_init(struct mtk_crtc *mtk_crtc)
 
 	return 0;
 
+err_stop_components:
+	while (--i >= 0)
+		mtk_ddp_comp_stop(mtk_crtc->ddp_comp[i]);
+	mtk_mutex_disable(mtk_crtc->mutex);
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++)
+		if (!mtk_ddp_comp_remove(mtk_crtc->ddp_comp[i], mtk_crtc->mutex))
+			mtk_mutex_remove_comp(mtk_crtc->mutex, mtk_crtc->ddp_comp[i]->id);
+err_dsc_path_put:
+	if (mtk_crtc->dsc_path_held) {
+		mtk_mmsys_dsc_path_put(mtk_crtc->mmsys_dev);
+		mtk_crtc->dsc_path_held = false;
+	}
+err_clk_disable:
+	mtk_crtc_ddp_clk_disable(mtk_crtc);
 err_mutex_unprepare:
 	mtk_mutex_unprepare(mtk_crtc->mutex);
 err_pm_runtime_put:
@@ -446,6 +608,21 @@ static void mtk_crtc_ddp_hw_fini(struct mtk_crtc *mtk_crtc)
 	unsigned long flags;
 	int i;
 
+	if (mtk_crtc->fixed_dsc_path) {
+		for (i = mtk_crtc->ddp_comp_nr - 1; i >= 0; i--)
+			mtk_ddp_comp_stop(mtk_crtc->ddp_comp[i]);
+		mtk_mutex_disable(mtk_crtc->mutex);
+		for (i = 0; i < mtk_crtc->ddp_comp_nr; i++)
+			if (!mtk_ddp_comp_remove(mtk_crtc->ddp_comp[i], mtk_crtc->mutex))
+				mtk_mutex_remove_comp(mtk_crtc->mutex,
+						      mtk_crtc->ddp_comp[i]->id);
+		if (mtk_crtc->dsc_path_held) {
+			mtk_mmsys_dsc_path_put(mtk_crtc->mmsys_dev);
+			mtk_crtc->dsc_path_held = false;
+		}
+		goto disable_clocks;
+	}
+
 	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++) {
 		mtk_ddp_comp_stop(mtk_crtc->ddp_comp[i]);
 		if (i == 1)
@@ -469,6 +646,7 @@ static void mtk_crtc_ddp_hw_fini(struct mtk_crtc *mtk_crtc)
 	}
 	if (!mtk_ddp_comp_remove(mtk_crtc->ddp_comp[i], mtk_crtc->mutex))
 		mtk_mutex_remove_comp(mtk_crtc->mutex, mtk_crtc->ddp_comp[i]->id);
+disable_clocks:
 	mtk_crtc_ddp_clk_disable(mtk_crtc);
 	mtk_mutex_unprepare(mtk_crtc->mutex);
 
@@ -566,6 +744,9 @@ static void mtk_crtc_update_config(struct mtk_crtc *mtk_crtc, bool needs_vblank)
 	int i;
 	unsigned long flags;
 
+	if (mtk_crtc->fixed_dsc_path && !mtk_crtc->enabled)
+		return;
+
 	mutex_lock(&mtk_crtc->hw_lock);
 
 	spin_lock_irqsave(&mtk_crtc->config_lock, flags);
@@ -792,7 +973,8 @@ static void mtk_crtc_atomic_enable(struct drm_crtc *crtc,
 
 	mtk_crtc_update_output(crtc, state);
 
-	ret = mtk_crtc_ddp_hw_init(mtk_crtc);
+	ret = mtk_crtc_ddp_hw_init(mtk_crtc,
+				   drm_atomic_get_new_crtc_state(state, crtc));
