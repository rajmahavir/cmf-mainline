diff --git a/drivers/gpu/drm/mediatek/mtk_disp_dsc.c b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
new file mode 100644
index 000000000..59b1bf699
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/mtk_disp_dsc.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2021 MediaTek Inc.
+ *
+ * MT6878 encoder register adaptation from the vendor mtk_disp_dsc.c.
+ * This is a register programming API, not a complete display component driver.
+ * The caller owns clocks, power, routing, atomic state and frame synchronization.
+ */
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <drm/display/drm_dsc.h>
+
+#include "mtk_ddp_comp.h"
+#include "mtk_disp_dsc.h"
+
+#define DSC_CON			0x000
+#define DSC_EN			BIT(0)
+#define DSC_SW_RESET		BIT(8)
+#define DSC_UFOE_SEL		BIT(16)
+#define DSC_SPR			0x014
+#define DSC_PIC_W		0x018
+#define DSC_PIC_H		0x01c
+#define DSC_SLICE_W		0x020
+#define DSC_SLICE_H		0x024
+#define DSC_CHUNK_SIZE		0x028
+#define DSC_BUF_SIZE		0x02c
+#define DSC_MODE		0x030
+#define DSC_CFG			0x034
+#define DSC_PAD			0x038
+#define DSC_ENC_WIDTH		0x03c
+#define DSC_DBG_CON		0x060
+#define DSC_OBUF		0x070
+#define DSC_PPS0		0x080
+#define DSC_SHADOW		0x200
+#define DSC_SHADOW_CTRL		0x228
+#define DSC_FORCE_COMMIT	BIT(0)
+#define DSC_BYPASS_SHADOW	BIT(1)
+#define DSC_CKSM_CAL_EN		BIT(9)
+
+int mtk_dsc_build_regs(const struct drm_dsc_config *d,
+		       struct mtk_dsc_reg_config *regs)
+{
+	struct mtk_dsc_reg_config r = { 0 };
+	u32 rows, group_w, slice_group_w, bytes_per_line;
+	unsigned int i;
+
+	if (!d || !regs)
+		return -EINVAL;
+	/* Do not silently map unsupported PPS modes onto the vendor RGB path. */
+	if (d->dsc_version_major != 1 || d->dsc_version_minor != 1 ||
+	    d->bits_per_component != 8 || d->bits_per_pixel != 128 ||
+	    d->line_buf_depth != 9 || !d->convert_rgb || d->simple_422 ||
+	    d->native_422 || d->native_420 || d->vbr_enable)
+		return -EOPNOTSUPP;
+	if (!d->pic_width || !d->pic_height || !d->slice_width ||
+	    !d->slice_height || (d->slice_count != 1 && d->slice_count != 2) ||
+	    d->pic_width != (u32)d->slice_width * d->slice_count ||
+	    d->pic_height % d->slice_height || d->slice_width % 3 ||
+	    d->slice_chunk_size != d->slice_width)
+		return -EINVAL;
+	rows = d->pic_height / d->slice_height;
+	if (rows > 0x4000 || d->initial_xmit_delay > 0x3ff ||
+	    d->initial_scale_value > 0x3f || d->scale_decrement_interval > 0xfff ||
+	    d->first_line_bpg_offset > 0x1f || d->flatness_min_qp > 0x1f ||
+	    d->flatness_max_qp > 0x1f || d->flatness_min_qp > d->flatness_max_qp ||
+	    d->rc_edge_factor > 0xf || d->rc_quant_incr_limit0 > 0x1f ||
+	    d->rc_quant_incr_limit1 > 0x1f || d->rc_tgt_offset_high > 0xf ||
+	    d->rc_tgt_offset_low > 0xf || !d->rc_model_size ||
+	    d->initial_offset >= d->rc_model_size || d->final_offset >= d->rc_model_size)
+		return -EINVAL;
+	for (i = 0; i < DSC_NUM_BUF_RANGES - 1; i++)
+		if (!d->rc_buf_thresh[i] || d->rc_buf_thresh[i] > 0xff ||
+		    (i && d->rc_buf_thresh[i] <= d->rc_buf_thresh[i - 1]))
+			return -EINVAL;
+	for (i = 0; i < DSC_NUM_BUF_RANGES; i++)
+		if (d->rc_range_params[i].range_min_qp > 0x1f ||
+		    d->rc_range_params[i].range_max_qp > 0x1f ||
+		    d->rc_range_params[i].range_min_qp > d->rc_range_params[i].range_max_qp ||
+		    d->rc_range_params[i].range_bpg_offset > 0x3f)
+			return -EINVAL;
+
+	group_w = DIV_ROUND_UP(d->pic_width, 3);
+	slice_group_w = DIV_ROUND_UP(d->slice_width, 3);
+	bytes_per_line = (u32)d->slice_chunk_size * d->slice_count;
+	r.con = DSC_UFOE_SEL | BIT(7);
+	r.pic_w = (group_w - 1) << 16 | d->pic_width;
+	r.pic_h = (u32)(d->pic_height - 1) << 16 | (d->pic_height - 1);
+	r.slice_w = (slice_group_w - 1) << 16 | d->slice_width;
+	r.slice_h = (rows - 1) << 16 | (d->slice_height - 1);
+	r.chunk_size = DIV_ROUND_UP(bytes_per_line, 3) << 16 | d->slice_chunk_size;
+	r.buf_size = (u32)d->slice_chunk_size * d->slice_height;
+	/* N4 DSI has its own buffer, so initial delay height is zero. */
+	r.mode = d->slice_count == 2;
+	r.pad = DIV_ROUND_UP(bytes_per_line, 3) * 3 - bytes_per_line;
+	r.enc_width = (u32)d->pic_width << 16 | d->slice_width;
+	r.pps[0] = d->line_buf_depth | d->bits_per_component << 4 |
+		   d->bits_per_pixel << 8 | d->convert_rgb << 18 |
+		   d->block_pred_enable << 19;
+	r.pps[1] = d->initial_xmit_delay | (u32)d->initial_dec_delay << 16;
+	r.pps[2] = d->initial_scale_value | (u32)d->scale_increment_interval << 16;
+	r.pps[3] = d->scale_decrement_interval | d->first_line_bpg_offset << 16;
+	r.pps[4] = d->nfl_bpg_offset | (u32)d->slice_bpg_offset << 16;
+	r.pps[5] = d->initial_offset | (u32)d->final_offset << 16;
+	r.pps[6] = d->flatness_min_qp | d->flatness_max_qp << 8 |
+		   (u32)d->rc_model_size << 16;
+	r.pps[7] = d->rc_edge_factor | d->rc_quant_incr_limit0 << 8 |
+		   d->rc_quant_incr_limit1 << 16 | d->rc_tgt_offset_high << 24 |
+		   (u32)d->rc_tgt_offset_low << 28;
+	/* DRM thresholds already carry the PPS /64 scaling; never shift again. */
+	for (i = 0; i < DSC_NUM_BUF_RANGES - 1; i++)
+		r.pps[8 + i / 4] |= (u32)d->rc_buf_thresh[i] << (8 * (i % 4));
+	/* Hardware range words store min/max/BPG in the reverse bit order to PPS. */
+	for (i = 0; i < DSC_NUM_BUF_RANGES; i++) {
+		u32 range = d->rc_range_params[i].range_min_qp |
+			    d->rc_range_params[i].range_max_qp << 5 |
+			    d->rc_range_params[i].range_bpg_offset << 10;
+
+		r.pps[12 + i / 2] |= range << (16 * (i % 2));
+	}
+	*regs = r;
+	return 0;
+}
+
+int mt6878_dsc_configure(void __iomem *base, struct cmdq_client_reg *cmdq_reg,
+			const struct drm_dsc_config *dsc, struct cmdq_pkt *pkt)
+{
+	struct mtk_dsc_reg_config r;
+	unsigned int i;
+	int ret;
+
+	ret = mtk_dsc_build_regs(dsc, &r);
+	if (ret)
+		return ret;
+	/*
+	 * LK hands over DSC0 mid-stream; once the route changes its frame stalls
+	 * and the partial state blocks the DSI link (Stage 67). Stop and soft-reset
+	 * the encoder before reprogramming, as the vendor does after EOF.
+	 */
+	mtk_ddp_write_mask(pkt, 0, cmdq_reg, base, DSC_CON, DSC_EN);
+	mtk_ddp_write_mask(pkt, DSC_SW_RESET, cmdq_reg, base, DSC_CON, DSC_SW_RESET);
+	mtk_ddp_write_mask(pkt, 0, cmdq_reg, base, DSC_CON, DSC_SW_RESET);
+	mtk_ddp_write(pkt, 0, cmdq_reg, base, DSC_SPR);
+	if (dsc->pic_width < 1440)
+		mtk_ddp_write(pkt, 0x800002d9, cmdq_reg, base, DSC_OBUF);
+	mtk_ddp_write(pkt, r.enc_width, cmdq_reg, base, DSC_ENC_WIDTH);
+	mtk_ddp_write(pkt, r.con, cmdq_reg, base, DSC_CON);
+	mtk_ddp_write(pkt, r.pic_w, cmdq_reg, base, DSC_PIC_W);
+	mtk_ddp_write(pkt, r.pic_h, cmdq_reg, base, DSC_PIC_H);
+	mtk_ddp_write(pkt, r.slice_w, cmdq_reg, base, DSC_SLICE_W);
+	mtk_ddp_write(pkt, r.slice_h, cmdq_reg, base, DSC_SLICE_H);
+	mtk_ddp_write(pkt, r.chunk_size, cmdq_reg, base, DSC_CHUNK_SIZE);
+	mtk_ddp_write(pkt, r.pad, cmdq_reg, base, DSC_PAD);
+	mtk_ddp_write(pkt, r.buf_size, cmdq_reg, base, DSC_BUF_SIZE);
+	mtk_ddp_write_mask(pkt, r.mode, cmdq_reg, base, DSC_MODE, 0xffff);
+	mtk_ddp_write(pkt, 0x22, cmdq_reg, base, DSC_CFG);
+	mtk_ddp_write_mask(pkt, DSC_CKSM_CAL_EN, cmdq_reg, base,
+			   DSC_DBG_CON, DSC_CKSM_CAL_EN);
+	/* PPS version selection is at 0x200; shadow commit control is at 0x228. */
+	mtk_ddp_write_mask(pkt, 0x20, cmdq_reg, base, DSC_SHADOW, 0x60);
+	for (i = 0; i < ARRAY_SIZE(r.pps); i++)
+		mtk_ddp_write(pkt, r.pps[i], cmdq_reg, base, DSC_PPS0 + i * 4);
+	return 0;
+}
+
+void mt6878_dsc_start(void __iomem *base, struct cmdq_client_reg *cmdq_reg,
+		      struct cmdq_pkt *pkt)
+{
+	mtk_ddp_write_mask(pkt, DSC_FORCE_COMMIT | DSC_BYPASS_SHADOW,
+			   cmdq_reg, base, DSC_SHADOW_CTRL,
+			   DSC_FORCE_COMMIT | DSC_BYPASS_SHADOW);
+	mtk_ddp_write_mask(pkt, DSC_EN, cmdq_reg, base, DSC_CON, DSC_EN);
+}
+
+void mt6878_dsc_stop(void __iomem *base, struct cmdq_client_reg *cmdq_reg,
+		     struct cmdq_pkt *pkt)
+{
+	mtk_ddp_write_mask(pkt, 0, cmdq_reg, base, DSC_CON, DSC_EN);
+}
+
+void mt6878_dsc_reset_after_eof(void __iomem *base,
+			      struct cmdq_client_reg *cmdq_reg, struct cmdq_pkt *pkt)
+{
+	mtk_ddp_write_mask(pkt, DSC_SW_RESET, cmdq_reg, base, DSC_CON, DSC_SW_RESET);
+	mtk_ddp_write_mask(pkt, 0, cmdq_reg, base, DSC_CON, DSC_SW_RESET);
+}
diff --git a/drivers/gpu/drm/mediatek/mtk_disp_dsc.h b/drivers/gpu/drm/mediatek/mtk_disp_dsc.h
