--- /dev/null
+++ b/drivers/gpu/drm/mediatek/mtk_disp_dsc.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef MTK_DISP_DSC_H
+#define MTK_DISP_DSC_H
+
+#include <linux/io.h>
+#include <linux/types.h>
+
+struct cmdq_client_reg;
+struct cmdq_pkt;
+struct drm_dsc_config;
+
+/* MT6878, single DSI port, DSC 1.1 RGB 8 bpc / 8 bpp only. */
+struct mtk_dsc_reg_config {
+	u32 con;
+	u32 pic_w;
+	u32 pic_h;
+	u32 slice_w;
+	u32 slice_h;
+	u32 chunk_size;
+	u32 buf_size;
+	u32 mode;
+	u32 pad;
+	u32 enc_width;
+	u32 pps[20];
+};
+
+int mtk_dsc_build_regs(const struct drm_dsc_config *dsc,
+		       struct mtk_dsc_reg_config *regs);
+/*
+ * Configure only while stopped, with clocks/power enabled. Start only after
+ * successful configuration; callers must provide atomic validation/lifetime.
+ */
+int mt6878_dsc_configure(void __iomem *base, struct cmdq_client_reg *cmdq_reg,
+			const struct drm_dsc_config *dsc, struct cmdq_pkt *pkt);
+void mt6878_dsc_start(void __iomem *base, struct cmdq_client_reg *cmdq_reg,
+		      struct cmdq_pkt *pkt);
+void mt6878_dsc_stop(void __iomem *base, struct cmdq_client_reg *cmdq_reg,
+		     struct cmdq_pkt *pkt);
+/* Caller must synchronize this operation with frame EOF, as in vendor CMDQ. */
+void mt6878_dsc_reset_after_eof(void __iomem *base,
+			      struct cmdq_client_reg *cmdq_reg, struct cmdq_pkt *pkt);
+#endif
